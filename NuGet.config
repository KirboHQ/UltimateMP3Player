<?xml version="1.0" encoding="utf-8"?>
<!-- Discord.Net's own nightly feed, for Discord.Net's packages only (the Discord bot, src/UltimateMP3Player/Services/VoiceBot.cs):
     3.20.2 on nuget.org fails Discord's voice encryption with other people in the channel and loops until the whole call
     lags (discord-net/Discord.Net issue 3281, fixed by PR 3288 in 3.20.2-nightly.20261111.899). Back to nuget.org alone
     when a release has the fix. Everything else comes from nuget.org only. -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="discord-net-nightly" value="https://baget.discordnet.dev/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="discord-net-nightly">
      <package pattern="Discord.Net.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
