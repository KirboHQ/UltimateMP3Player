<UserControl x:Class="UltimateMP3Player.Views.NowPlayingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UltimateMP3Player"
             xmlns:vm="clr-namespace:UltimateMP3Player.ViewModels"
             xmlns:views="clr-namespace:UltimateMP3Player.Views">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <!-- ======================================================== stage -->
        <Grid x:Name="Stage" Margin="20,0,10,16" ClipToBounds="True" SizeChanged="Stage_SizeChanged">
            <Border CornerRadius="16" Background="{StaticResource SurfaceBrush}"/>
            <!-- backdrop: the cover, or the video itself blurred -->
            <Border CornerRadius="16" Opacity="0.22" Visibility="{Binding ShowCover, Converter={StaticResource BoolVis}}">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding Player.Current.Cover160}" Stretch="UniformToFill"/>
                </Border.Background>
            </Border>
            <Grid x:Name="StageVideo" Opacity="0.6" Visibility="{Binding ShowCover, Converter={StaticResource InvBoolVis}}">
                <Rectangle Margin="-80">
                    <Rectangle.Fill>
                        <VisualBrush Visual="{Binding ElementName=Video}" Stretch="UniformToFill"/>
                    </Rectangle.Fill>
                    <Rectangle.Effect>
                        <BlurEffect Radius="60" KernelType="Gaussian" RenderingBias="Performance"/>
                    </Rectangle.Effect>
                </Rectangle>
            </Grid>
            <Border CornerRadius="16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#550E1014" Offset="0"/>
                        <GradientStop Color="#EE0E1014" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Grid Margin="28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- cover, tilting in 3D with the mouse -->
                <Grid x:Name="CoverArea" Visibility="{Binding ShowCover, Converter={StaticResource BoolVis}}">
                    <Viewbox MaxWidth="460" MaxHeight="460" Stretch="Uniform">
                        <Grid Width="460" Height="460">
                            <!-- shadow drawn once and cached, under the tilting cover -->
                            <Border Width="330" Height="330" CornerRadius="30" Background="Black" Opacity="0.8" CacheMode="BitmapCache"
                                    IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <TranslateTransform Y="18"/>
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <BlurEffect Radius="70" KernelType="Gaussian"/>
                                </Border.Effect>
                            </Border>
                            <Viewport3D x:Name="Tilt" IsHitTestVisible="False" ClipToBounds="False">
                                <Viewport3D.Camera>
                                    <PerspectiveCamera Position="0,0,4.29" LookDirection="0,0,-1" FieldOfView="30"/>
                                </Viewport3D.Camera>
                                <ModelVisual3D>
                                    <ModelVisual3D.Content>
                                        <AmbientLight Color="White"/>
                                    </ModelVisual3D.Content>
                                </ModelVisual3D>
                                <ModelVisual3D>
                                    <ModelVisual3D.Transform>
                                        <Transform3DGroup>
                                            <RotateTransform3D>
                                                <RotateTransform3D.Rotation>
                                                    <AxisAngleRotation3D x:Name="TiltY" Axis="0,1,0" Angle="0"/>
                                                </RotateTransform3D.Rotation>
                                            </RotateTransform3D>
                                            <RotateTransform3D>
                                                <RotateTransform3D.Rotation>
                                                    <AxisAngleRotation3D x:Name="TiltX" Axis="1,0,0" Angle="0"/>
                                                </RotateTransform3D.Rotation>
                                            </RotateTransform3D>
                                        </Transform3DGroup>
                                    </ModelVisual3D.Transform>
                                    <ModelVisual3D.Content>
                                        <GeometryModel3D>
                                            <GeometryModel3D.Geometry>
                                                <MeshGeometry3D Positions="-1,1,0 -1,-1,0 1,-1,0 1,1,0" TextureCoordinates="0,0 0,1 1,1 1,0" TriangleIndices="0 1 2 0 2 3"/>
                                            </GeometryModel3D.Geometry>
                                            <GeometryModel3D.Material>
                                                <MaterialGroup>
                                                    <!-- the cover as a baked image (NowPlayingView.BakeCover) -->
                                                    <DiffuseMaterial>
                                                        <DiffuseMaterial.Brush>
                                                            <ImageBrush x:Name="CoverImage"/>
                                                        </DiffuseMaterial.Brush>
                                                    </DiffuseMaterial>
                                                    <!-- glare that follows the mouse -->
                                                    <EmissiveMaterial>
                                                        <EmissiveMaterial.Brush>
                                                            <DrawingBrush x:Name="GlareLayer" Opacity="0" Stretch="Fill">
                                                                <DrawingBrush.Drawing>
                                                                    <GeometryDrawing>
                                                                        <GeometryDrawing.Geometry>
                                                                            <RectangleGeometry Rect="0,0,400,400" RadiusX="14" RadiusY="14"/>
                                                                        </GeometryDrawing.Geometry>
                                                                        <GeometryDrawing.Brush>
                                                                            <RadialGradientBrush x:Name="GlareBrush" RadiusX="0.6" RadiusY="0.6" Center="0.5,0.5" GradientOrigin="0.5,0.5">
                                                                                <GradientStop Color="#34FFFFFF" Offset="0"/>
                                                                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                                                                            </RadialGradientBrush>
                                                                        </GeometryDrawing.Brush>
                                                                    </GeometryDrawing>
                                                                </DrawingBrush.Drawing>
                                                            </DrawingBrush>
                                                        </EmissiveMaterial.Brush>
                                                    </EmissiveMaterial>
                                                </MaterialGroup>
                                            </GeometryModel3D.Material>
                                        </GeometryModel3D>
                                    </ModelVisual3D.Content>
                                </ModelVisual3D>
                            </Viewport3D>
                            <Border x:Name="CoverHit" Width="400" Height="400" Background="Transparent" Cursor="Hand"
                                    MouseMove="Cover_MouseMove" MouseLeave="Cover_MouseLeave" MouseRightButtonUp="Current_RightClick"
                                    ToolTip="{local:T 'Tasto destro per le opzioni del brano'}" ToolTipService.InitialShowDelay="1500"/>
                        </Grid>
                    </Viewbox>
                </Grid>

                <!-- video framed like a cover (the backdrop above is its blurred copy) -->
                <Grid x:Name="VideoArea" Background="Transparent" Visibility="{Binding ShowCover, Converter={StaticResource InvBoolVis}}"
                      MouseRightButtonUp="Current_RightClick" SizeChanged="VideoArea_SizeChanged">
                    <Grid x:Name="VideoFrame" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border CornerRadius="14" Background="Black">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.6" Color="Black"/>
                            </Border.Effect>
                        </Border>
                        <MediaElement x:Name="Video" LoadedBehavior="Manual" UnloadedBehavior="Close" IsMuted="True" ScrubbingEnabled="True" Stretch="Fill"/>
                        <Border CornerRadius="14" BorderThickness="1" BorderBrush="#30FFFFFF" IsHitTestVisible="False"/>
                    </Grid>
                </Grid>

                <Grid Grid.Row="1" Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Background="Transparent" MouseRightButtonUp="Current_RightClick">
                        <TextBlock Text="{Binding Player.Current.Title}" FontSize="30" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Player.Current.Artist}" FontSize="17" Foreground="{StaticResource SubTextBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock FontSize="12.5" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"
                                   Visibility="{Binding Player.ContextName, Converter={StaticResource NotNullVis}}">
                            <Run Text="{local:T 'In riproduzione da:'}"/>
                            <Run Text="{Binding Player.ContextName, Mode=OneWay}" Foreground="{StaticResource SubTextBrush}"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Style="{StaticResource ControlButton}" Content="&#xE712;" Click="More_Click" ToolTip="{local:T 'Altre opzioni'}"
                                AutomationProperties.Name="{local:T 'Altre opzioni'}" Visibility="{Binding Player.HasTrack, Converter={StaticResource BoolVis}}"/>
                        <ToggleButton Style="{StaticResource ToggleIcon}" Width="Auto" Height="36" IsChecked="{Binding ShowVideo}" Margin="6,0,0,0"
                                      Visibility="{Binding HasVideo, Converter={StaticResource BoolVis}}" ToolTip="{local:T 'Mostra il video al posto della copertina'}">
                            <StackPanel Orientation="Horizontal" Margin="8,0">
                                <TextBlock Text="&#xE714;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                                <TextBlock Text="Video" FontFamily="{StaticResource UiFont}" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- ======================================================== up next -->
        <Border Grid.Column="1" Margin="0,0,20,16" Style="{StaticResource Card}" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="6,2,0,10">
                    <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Padding="8,4" FontSize="12.5" Content="{local:T 'Svuota coda'}"
                            Command="{Binding Player.ClearQueueCommand}" VerticalAlignment="Top"
                            Visibility="{Binding Player.HasManualQueue, Converter={StaticResource BoolVis}}"
                            ToolTip="{local:T 'Togli tutti i brani aggiunti a mano alla coda'}"/>
                    <StackPanel>
                        <TextBlock Text="{local:T Successivi}" FontSize="17" FontWeight="Bold"/>
                        <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap"
                                   Text="{local:T 'Doppio clic per saltare a un brano, trascina per riordinare.'}"/>
                    </StackPanel>
                </DockPanel>
                <ListBox x:Name="QueueList" Grid.Row="1" Style="{StaticResource PlainList}" ItemsSource="{Binding Player.UpNext}"
                         AllowDrop="True" DragOver="Queue_DragOver" DragLeave="Queue_DragLeave" Drop="Queue_Drop" AutomationProperties.Name="{local:T Successivi}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:QueueRow}">
                            <StackPanel>
                                <TextBlock Text="{Binding Header}" Style="{StaticResource SmallCaps}" Margin="8,10,0,6" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding Header, Converter={StaticResource NotNullVis}}"/>
                                <Border x:Name="Row" CornerRadius="8" Padding="6" Background="Transparent"
                                        MouseRightButtonUp="Row_RightClick" PreviewMouseLeftButtonDown="Row_MouseDown" MouseMove="Row_MouseMove">
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding PlayCommand}"/>
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter Width="40" Height="40" Content="{Binding Track}" ContentTemplate="{StaticResource TrackCoverSmall}"/>
                                        <Button x:Name="PlayBtn" Width="40" Height="40" Style="{StaticResource IconButton}" Content="&#xE768;" Foreground="White"
                                                Background="#99000000" Command="{Binding PlayCommand}" Visibility="Hidden" ToolTip="{local:T 'Riproduci ora'}"
                                                AutomationProperties.Name="{Binding Track.Title}"/>
                                        <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Track.Title}" TextTrimming="CharacterEllipsis" FontSize="13.5"/>
                                            <TextBlock Text="{Binding Track.Artist}" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{StaticResource SubTextBrush}"/>
                                        </StackPanel>
                                        <Button x:Name="RemoveBtn" Grid.Column="2" Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="11"
                                                Content="&#xE711;" Command="{Binding RemoveCommand}" Visibility="Hidden" ToolTip="{local:T 'Togli dai successivi'}"
                                                AutomationProperties.Name="{local:T 'Togli dai successivi'}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource RowHoverBrush}"/>
                                    <Setter TargetName="PlayBtn" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="RemoveBtn" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="1" Text="{local:T 'Nessun altro brano in coda.'}" Style="{StaticResource Hint}" Margin="6,4,0,0"
                           Visibility="{Binding Player.UpNextCount, Converter={StaticResource ZeroVis}}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
