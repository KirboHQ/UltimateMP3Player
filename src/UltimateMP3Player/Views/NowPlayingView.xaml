<UserControl x:Class="UltimateMP3Player.Views.NowPlayingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UltimateMP3Player"
             xmlns:vm="clr-namespace:UltimateMP3Player.ViewModels"
             xmlns:views="clr-namespace:UltimateMP3Player.Views">
    <UserControl.Resources>
        <!-- Round icon button of the "next up" header. -->
        <Style x:Key="QueueIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Template" Value="{StaticResource PillButtonTemplate}"/>
        </Style>
        <!-- Frosted pill floating on the stage. -->
        <Style x:Key="StagePill" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Template" Value="{StaticResource PillButtonTemplate}"/>
            <Setter Property="Background" Value="#A6101318"/>
            <Setter Property="BorderBrush" Value="#30FFFFFF"/>
            <Setter Property="local:Ui.HoverBrush" Value="#E61D2129"/>
            <Setter Property="Padding" Value="14,7,8,7"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ======================================================== stage -->
        <Grid x:Name="Stage" Margin="20,0,0,16" ClipToBounds="True" SizeChanged="Stage_SizeChanged">
            <Border CornerRadius="16" Background="{StaticResource SurfaceBrush}"/>
            <!-- backdrop: the cover, or the video itself blurred -->
            <Border CornerRadius="16" Opacity="0.22" Visibility="{Binding ShowCover, Converter={StaticResource BoolVis}}">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding Player.Current.Cover160}" Stretch="UniformToFill"/>
                </Border.Background>
            </Border>
            <Grid x:Name="StageVideo" Opacity="0.6" Visibility="{Binding ShowCover, Converter={StaticResource InvBoolVis}}">
                <Rectangle Margin="-80">
                    <Rectangle.Fill>
                        <VisualBrush Visual="{Binding ElementName=Video}" Stretch="UniformToFill"/>
                    </Rectangle.Fill>
                    <Rectangle.Effect>
                        <BlurEffect Radius="60" KernelType="Gaussian" RenderingBias="Performance"/>
                    </Rectangle.Effect>
                </Rectangle>
            </Grid>
            <Border CornerRadius="16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#550E1014" Offset="0"/>
                        <GradientStop Color="#EE0E1014" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Grid Margin="28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- cover, tilting in 3D with the mouse -->
                <Grid x:Name="CoverArea" Visibility="{Binding ShowCover, Converter={StaticResource BoolVis}}">
                    <Viewbox MaxWidth="460" MaxHeight="460" Stretch="Uniform">
                        <Grid Width="460" Height="460">
                            <!-- shadow drawn once and cached, under the tilting cover -->
                            <Border Width="330" Height="330" CornerRadius="30" Background="Black" Opacity="0.8" CacheMode="BitmapCache"
                                    IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <TranslateTransform Y="18"/>
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <BlurEffect Radius="70" KernelType="Gaussian"/>
                                </Border.Effect>
                            </Border>
                            <Viewport3D x:Name="Tilt" IsHitTestVisible="False" ClipToBounds="False">
                                <Viewport3D.Camera>
                                    <PerspectiveCamera Position="0,0,4.29" LookDirection="0,0,-1" FieldOfView="30"/>
                                </Viewport3D.Camera>
                                <ModelVisual3D>
                                    <ModelVisual3D.Content>
                                        <AmbientLight Color="White"/>
                                    </ModelVisual3D.Content>
                                </ModelVisual3D>
                                <ModelVisual3D>
                                    <ModelVisual3D.Transform>
                                        <Transform3DGroup>
                                            <RotateTransform3D>
                                                <RotateTransform3D.Rotation>
                                                    <AxisAngleRotation3D x:Name="TiltY" Axis="0,1,0" Angle="0"/>
                                                </RotateTransform3D.Rotation>
                                            </RotateTransform3D>
                                            <RotateTransform3D>
                                                <RotateTransform3D.Rotation>
                                                    <AxisAngleRotation3D x:Name="TiltX" Axis="1,0,0" Angle="0"/>
                                                </RotateTransform3D.Rotation>
                                            </RotateTransform3D>
                                        </Transform3DGroup>
                                    </ModelVisual3D.Transform>
                                    <ModelVisual3D.Content>
                                        <GeometryModel3D>
                                            <GeometryModel3D.Geometry>
                                                <MeshGeometry3D Positions="-1,1,0 -1,-1,0 1,-1,0 1,1,0" TextureCoordinates="0,0 0,1 1,1 1,0" TriangleIndices="0 1 2 0 2 3"/>
                                            </GeometryModel3D.Geometry>
                                            <GeometryModel3D.Material>
                                                <MaterialGroup>
                                                    <!-- the cover as a baked image (NowPlayingView.BakeCover) -->
                                                    <DiffuseMaterial>
                                                        <DiffuseMaterial.Brush>
                                                            <ImageBrush x:Name="CoverImage"/>
                                                        </DiffuseMaterial.Brush>
                                                    </DiffuseMaterial>
                                                    <!-- glossy sheen (added as light): diagonal streaks sliding against the mouse, a slower wide band behind -->
                                                    <EmissiveMaterial>
                                                        <EmissiveMaterial.Brush>
                                                            <DrawingBrush x:Name="GlareLayer" Opacity="0" Stretch="Fill">
                                                                <DrawingBrush.Drawing>
                                                                    <DrawingGroup>
                                                                        <DrawingGroup.ClipGeometry>
                                                                            <RectangleGeometry Rect="0,0,400,400" RadiusX="14" RadiusY="14"/>
                                                                        </DrawingGroup.ClipGeometry>
                                                                        <GeometryDrawing Brush="Transparent" Geometry="M0,0 H400 V400 H0 Z"/>
                                                                        <!-- the streaks, brightest near the light (opposite the mouse) -->
                                                                        <DrawingGroup>
                                                                        <DrawingGroup.ClipGeometry>
                                                                            <RectangleGeometry Rect="0,0,400,400"/>
                                                                        </DrawingGroup.ClipGeometry>
                                                                        <DrawingGroup.OpacityMask>
                                                                            <RadialGradientBrush x:Name="SheenMask" MappingMode="Absolute" Center="200,200" GradientOrigin="200,200" RadiusX="330" RadiusY="330">
                                                                                <GradientStop Color="#FF000000" Offset="0"/>
                                                                                <GradientStop Color="#40000000" Offset="1"/>
                                                                            </RadialGradientBrush>
                                                                        </DrawingGroup.OpacityMask>
                                                                        <GeometryDrawing Brush="Transparent" Geometry="M0,0 H400 V400 H0 Z"/>
                                                                        <!-- far layer: one wide soft band, moving slower -->
                                                                        <DrawingGroup>
                                                                            <DrawingGroup.Transform>
                                                                                <TransformGroup>
                                                                                    <TranslateTransform x:Name="SheenFar"/>
                                                                                    <RotateTransform Angle="28" CenterX="200" CenterY="200"/>
                                                                                </TransformGroup>
                                                                            </DrawingGroup.Transform>
                                                                            <GeometryDrawing Geometry="M-60,-250 H160 V650 H-60 Z">
                                                                                <GeometryDrawing.Brush>
                                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                                                                                        <GradientStop Color="#12FFFFFF" Offset="0.5"/>
                                                                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                                                                    </LinearGradientBrush>
                                                                                </GeometryDrawing.Brush>
                                                                            </GeometryDrawing>
                                                                        </DrawingGroup>
                                                                        <!-- near layer: glass band, crisp lines and an iridescent fringe -->
                                                                        <DrawingGroup>
                                                                            <DrawingGroup.Transform>
                                                                                <TransformGroup>
                                                                                    <TranslateTransform x:Name="SheenNear"/>
                                                                                    <RotateTransform Angle="28" CenterX="200" CenterY="200"/>
                                                                                </TransformGroup>
                                                                            </DrawingGroup.Transform>
                                                                            <GeometryDrawing Geometry="M140,-250 H260 V650 H140 Z">
                                                                                <GeometryDrawing.Brush>
                                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                                                                                        <GradientStop Color="#12FFFFFF" Offset="0.3"/>
                                                                                        <GradientStop Color="#22FFFFFF" Offset="0.5"/>
                                                                                        <GradientStop Color="#12FFFFFF" Offset="0.7"/>
                                                                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                                                                    </LinearGradientBrush>
                                                                                </GeometryDrawing.Brush>
                                                                            </GeometryDrawing>
                                                                            <GeometryDrawing Geometry="M258,-250 H272 V650 H258 Z">
                                                                                <GeometryDrawing.Brush>
                                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                                        <GradientStop Color="#0070E4FF" Offset="0"/>
                                                                                        <GradientStop Color="#2A70E4FF" Offset="1"/>
                                                                                    </LinearGradientBrush>
                                                                                </GeometryDrawing.Brush>
                                                                            </GeometryDrawing>
                                                                            <GeometryDrawing Geometry="M272,-250 H280 V650 H272 Z">
                                                                                <GeometryDrawing.Brush>
                                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                                        <GradientStop Color="#18FFFFFF" Offset="0"/>
                                                                                        <GradientStop Color="#5CFFFFFF" Offset="0.5"/>
                                                                                        <GradientStop Color="#18FFFFFF" Offset="1"/>
                                                                                    </LinearGradientBrush>
                                                                                </GeometryDrawing.Brush>
                                                                            </GeometryDrawing>
                                                                            <GeometryDrawing Geometry="M280,-250 H294 V650 H280 Z">
                                                                                <GeometryDrawing.Brush>
                                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                                        <GradientStop Color="#2AFF7ACF" Offset="0"/>
                                                                                        <GradientStop Color="#00FF7ACF" Offset="1"/>
                                                                                    </LinearGradientBrush>
                                                                                </GeometryDrawing.Brush>
                                                                            </GeometryDrawing>
                                                                            <GeometryDrawing Brush="#40FFFFFF" Geometry="M304,-250 H306.5 V650 H304 Z"/>
                                                                            <GeometryDrawing Brush="#26FFFFFF" Geometry="M116,-250 H118 V650 H116 Z"/>
                                                                        </DrawingGroup>
                                                                        </DrawingGroup>
                                                                        <!-- the edge catching the light -->
                                                                        <GeometryDrawing>
                                                                            <GeometryDrawing.Geometry>
                                                                                <RectangleGeometry Rect="1,1,398,398" RadiusX="13" RadiusY="13"/>
                                                                            </GeometryDrawing.Geometry>
                                                                            <GeometryDrawing.Pen>
                                                                                <Pen Thickness="2.5">
                                                                                    <Pen.Brush>
                                                                                        <LinearGradientBrush x:Name="RimBrush" MappingMode="Absolute" StartPoint="0,0" EndPoint="400,400" Opacity="0">
                                                                                            <GradientStop Color="#80FFFFFF" Offset="0"/>
                                                                                            <GradientStop Color="#00FFFFFF" Offset="0.45"/>
                                                                                        </LinearGradientBrush>
                                                                                    </Pen.Brush>
                                                                                </Pen>
                                                                            </GeometryDrawing.Pen>
                                                                        </GeometryDrawing>
                                                                    </DrawingGroup>
                                                                </DrawingBrush.Drawing>
                                                            </DrawingBrush>
                                                        </EmissiveMaterial.Brush>
                                                    </EmissiveMaterial>
                                                </MaterialGroup>
                                            </GeometryModel3D.Material>
                                        </GeometryModel3D>
                                    </ModelVisual3D.Content>
                                </ModelVisual3D>
                            </Viewport3D>
                            <Border x:Name="CoverHit" Width="400" Height="400" Background="Transparent" Cursor="Hand"
                                    MouseMove="Cover_MouseMove" MouseLeave="Cover_MouseLeave" MouseRightButtonUp="Current_RightClick"/>
                        </Grid>
                    </Viewbox>
                </Grid>

                <!-- video framed like a cover (the backdrop above is its blurred copy) -->
                <Grid x:Name="VideoArea" Background="Transparent" Visibility="{Binding ShowCover, Converter={StaticResource InvBoolVis}}"
                      MouseRightButtonUp="Current_RightClick" SizeChanged="VideoArea_SizeChanged">
                    <Grid x:Name="VideoFrame" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border CornerRadius="14" Background="Black">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.6" Color="Black"/>
                            </Border.Effect>
                        </Border>
                        <MediaElement x:Name="Video" LoadedBehavior="Manual" UnloadedBehavior="Close" IsMuted="True" ScrubbingEnabled="True" Stretch="Fill"/>
                        <Border CornerRadius="14" BorderThickness="1" BorderBrush="#30FFFFFF" IsHitTestVisible="False"/>
                    </Grid>
                </Grid>

                <Grid Grid.Row="1" Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Background="Transparent" MouseRightButtonUp="Current_RightClick" local:Marquee.Host="True">
                        <TextBlock Text="{Binding Player.Current.Title}" FontSize="30" FontWeight="Bold" TextTrimming="CharacterEllipsis" local:Marquee.IsEnabled="True"/>
                        <TextBlock Text="{Binding Player.Current.Artist}" FontSize="17" Foreground="{StaticResource SubTextBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                                   local:Marquee.IsEnabled="True"/>
                        <TextBlock FontSize="12.5" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"
                                   Visibility="{Binding Player.ContextName, Converter={StaticResource NotNullVis}}">
                            <Run Text="{local:T 'In riproduzione da:'}"/>
                            <Run Text="{Binding Player.ContextName, Mode=OneWay}" Foreground="{StaticResource SubTextBrush}"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Style="{StaticResource ControlButton}" Content="&#xE712;" Click="More_Click" ToolTip="{local:T 'Altre opzioni'}"
                                AutomationProperties.Name="{local:T 'Altre opzioni'}" Visibility="{Binding Player.HasTrack, Converter={StaticResource BoolVis}}"/>
                        <ToggleButton Style="{StaticResource ToggleIcon}" Width="Auto" Height="36" IsChecked="{Binding ShowVideo}" Margin="6,0,0,0"
                                      Visibility="{Binding HasVideo, Converter={StaticResource BoolVis}}" ToolTip="{local:T 'Mostra il video al posto della copertina'}">
                            <StackPanel Orientation="Horizontal" Margin="8,0">
                                <TextBlock Text="&#xE714;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                                <TextBlock Text="Video" FontFamily="{StaticResource UiFont}" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- brings back "next up" when it's folded away (NowPlayingView.PlaceQueue) -->
            <Button x:Name="ShowQueueBtn" Style="{StaticResource StagePill}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0"
                    Command="{Binding ToggleQueueCommand}" Visibility="Collapsed" Opacity="0"
                    ToolTip="{local:T 'Mostra i successivi'}" AutomationProperties.Name="{local:T 'Mostra i successivi'}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8A0;" Style="{StaticResource Glyph}" FontSize="13"/>
                    <TextBlock Text="{local:T Successivi}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                    <Border CornerRadius="9" MinWidth="22" Height="18" Padding="6,0" Margin="8,0,0,0" Background="{DynamicResource AccentBrush}"
                            Visibility="{Binding Player.UpcomingBadge, Converter={StaticResource NotNullVis}}">
                        <TextBlock Text="{Binding Player.UpcomingBadge}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource OnAccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ======================================================== up next -->
        <!-- the pane shrinks and the card slides out to the right when folded away -->
        <Grid x:Name="QueuePane" Grid.Column="1" Width="350" ClipToBounds="True">
            <Border x:Name="QueueCard" Width="320" HorizontalAlignment="Left" Margin="10,0,0,16" Style="{StaticResource Card}" Padding="14">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="QueueShift"/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="6,2,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{local:T Successivi}" FontSize="17" FontWeight="Bold"/>
                            <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap"
                                       Text="{Binding Player.QueueHint}"
                                       Visibility="{Binding Player.HasUpNext, Converter={StaticResource BoolVis}}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,-3,-4,0">
                            <!-- your own queue only: in a room the queue is the room's -->
                            <StackPanel Orientation="Horizontal" Visibility="{Binding Player.InRoom, Converter={StaticResource InvBoolVis}}">
                            <Button Style="{StaticResource QueueIconButton}" Content="&#xE895;" Command="{Binding Player.GenerateQueueCommand}"
                                    Visibility="{Binding Player.HasTrack, Converter={StaticResource BoolVis}}"
                                    AutomationProperties.Name="{local:T 'Completa la coda (se è già piena, la rigenera da capo)'}">
                                <Button.ToolTip>
                                    <StackPanel MaxWidth="260">
                                        <TextBlock Text="{local:T 'Completa la coda (se è già piena, la rigenera da capo)'}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Player.GenerateHint}" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap"
                                                   Visibility="{Binding Player.GenerateHint, Converter={StaticResource NotNullVis}}"/>
                                    </StackPanel>
                                </Button.ToolTip>
                            </Button>
                            <Button Style="{StaticResource QueueIconButton}" Content="&#xE74D;" Command="{Binding Player.ClearQueueCommand}"
                                    Visibility="{Binding Player.HasUpNext, Converter={StaticResource BoolVis}}"
                                    ToolTip="{local:T 'Svuota la coda: finito questo brano, la musica si ferma'}" AutomationProperties.Name="{local:T 'Svuota coda'}"/>
                            </StackPanel>
                            <Button Style="{StaticResource QueueIconButton}" Content="&#xE89F;" Command="{Binding ToggleQueueCommand}"
                                    ToolTip="{local:T 'Nascondi di lato'}" AutomationProperties.Name="{local:T 'Nascondi i successivi'}"/>
                        </StackPanel>
                    </Grid>
                    <!-- at most 150 rows: no virtualization, so scrolling and dragging stay exact -->
                    <ListBox x:Name="QueueList" Grid.Row="1" Style="{StaticResource PlainList}" ItemsSource="{Binding Player.UpNext}"
                             VirtualizingPanel.IsVirtualizing="False" ScrollViewer.CanContentScroll="False"
                             AllowDrop="True" DragOver="Queue_DragOver" Drop="Queue_Drop" AutomationProperties.Name="{local:T Successivi}">
                        <!-- the rows, then how many more don't fit -->
                        <ListBox.Template>
                            <ControlTemplate TargetType="ListBox">
                                <ScrollViewer Focusable="False" CanContentScroll="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <ItemsPresenter/>
                                        <TextBlock Text="{Binding Player.MoreText}" Style="{StaticResource SmallCaps}" HorizontalAlignment="Center" Margin="0,14,0,8"
                                                   Visibility="{Binding Player.MoreText, Converter={StaticResource NotNullVis}}"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ListBox.Template>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:QueueRow}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Header}" Style="{StaticResource SmallCaps}" Margin="8,10,0,6" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding Header, Converter={StaticResource NotNullVis}}"/>
                                    <Border x:Name="Row" CornerRadius="8" Padding="6" Background="Transparent" local:Marquee.Host="True"
                                            MouseRightButtonUp="Row_RightClick" PreviewMouseLeftButtonDown="Row_MouseDown" MouseMove="Row_MouseMove">
                                        <Border.InputBindings>
                                            <MouseBinding Gesture="LeftDoubleClick" Command="{Binding PlayCommand}"/>
                                        </Border.InputBindings>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter Width="40" Height="40" Content="{Binding Track}" ContentTemplate="{StaticResource TrackCoverSmall}"/>
                                            <!-- small round play over the cover, so the cover stays visible -->
                                            <Button x:Name="PlayBtn" Width="26" Height="26" Style="{StaticResource IconButton}" Template="{StaticResource PillButtonTemplate}"
                                                    Content="&#xE768;" FontSize="10.5" Foreground="White" Background="#B8000000" local:Ui.HoverBrush="#E6000000"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Command="{Binding PlayCommand}" Visibility="Hidden" ToolTip="{local:T 'Riproduci ora'}"
                                                    AutomationProperties.Name="{Binding Track.Title}"/>
                                            <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Track.Title}" TextTrimming="CharacterEllipsis" FontSize="13.5" local:Marquee.IsEnabled="True"/>
                                                <TextBlock Text="{Binding Track.Artist}" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{StaticResource SubTextBrush}"
                                                           local:Marquee.IsEnabled="True"/>
                                            </StackPanel>
                                            <Button x:Name="RemoveBtn" Grid.Column="2" Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="11"
                                                    Content="&#xE711;" Command="{Binding RemoveCommand}" Visibility="Hidden" ToolTip="{local:T 'Togli dai successivi'}"
                                                    AutomationProperties.Name="{local:T 'Togli dai successivi'}"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource RowHoverBrush}"/>
                                        <Setter TargetName="PlayBtn" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="RemoveBtn" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <!-- empty queue: what happens next, and the way to fill it -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="14,0,14,40" MaxWidth="250"
                                Visibility="{Binding Player.UpNextCount, Converter={StaticResource ZeroVis}}">
                        <Grid Width="76" Height="76" HorizontalAlignment="Center">
                            <Ellipse Fill="{DynamicResource AccentSoftBrush}"/>
                            <Ellipse Stroke="{DynamicResource AccentGradient}" StrokeThickness="1.5" Opacity="0.7"/>
                            <TextBlock Text="&#xE90B;" FontFamily="{StaticResource IconFont}" FontSize="30" Foreground="{DynamicResource AccentTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{local:T 'La coda è vuota'}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                        <TextBlock Text="{Binding Player.QueueEndHint}" Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,6,0,0"/>
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding Player.GenerateQueueCommand}" HorizontalAlignment="Center" Margin="0,18,0,0"
                                Visibility="{Binding Player.CanGenerate, Converter={StaticResource BoolVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE895;" Style="{StaticResource Glyph}" FontSize="13"/>
                                <TextBlock Text="{local:T 'Genera coda'}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding Player.GenerateHint}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="{Binding Player.CanGenerate, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- floats left of the queue while dragging (over the stage, the layout doesn't move): drop a song on it to take it out -->
        <Grid x:Name="TrashZone" Width="64" Height="64" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,16"
              Visibility="Collapsed" AllowDrop="True" DragOver="Queue_DragOver" Drop="Queue_Drop" RenderTransformOrigin="0.5,0.5"
              AutomationProperties.Name="{local:T 'Trascina qui per togliere'}">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="TrashScale"/>
                    <ScaleTransform x:Name="TrashPop"/>
                    <TranslateTransform x:Name="TrashShift"/>
                </TransformGroup>
            </Grid.RenderTransform>
            <Ellipse x:Name="TrashRipple" Stroke="#E5484D" StrokeThickness="2" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="RippleScale"/>
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Stroke="#E5484D" StrokeThickness="2">
                <Ellipse.Fill>
                    <SolidColorBrush x:Name="TrashFill" Color="#F22A1216"/>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.6" Color="#E5484D"/>
                </Ellipse.Effect>
            </Ellipse>
            <TextBlock x:Name="TrashIcon" Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="24" Foreground="#FF7076"
                       HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                <TextBlock.RenderTransform>
                    <RotateTransform x:Name="TrashTilt"/>
                </TextBlock.RenderTransform>
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>
