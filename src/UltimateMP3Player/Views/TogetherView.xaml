<UserControl x:Class="UltimateMP3Player.Views.TogetherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UltimateMP3Player"
             xmlns:vm="clr-namespace:UltimateMP3Player.ViewModels"
             xmlns:views="clr-namespace:UltimateMP3Player.Views">
    <UserControl.Resources>
        <!-- a person: their colour and initial, or their picture -->
        <DataTemplate x:Key="MemberAvatar" DataType="{x:Type vm:MemberViewModel}">
            <Grid>
                <Ellipse Fill="{Binding Brush}"/>
                <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Ellipse Margin="2" Visibility="{Binding Avatar, Converter={StaticResource NotNullVis}}">
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/>
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>
        </DataTemplate>

        <!-- the host's crown: gold, three points with round jewels, a darker band (drawn, so it stays sharp at any size) -->
        <LinearGradientBrush x:Key="CrownGold" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFF1A8" Offset="0"/>
            <GradientStop Color="#FFCB2E" Offset="0.45"/>
            <GradientStop Color="#E99A00" Offset="1"/>
        </LinearGradientBrush>
        <ControlTemplate x:Key="Crown" TargetType="ContentControl">
            <Viewbox Stretch="Uniform">
                <Canvas Width="24" Height="20">
                    <Path Fill="{StaticResource CrownGold}" Stroke="#3A2600" StrokeThickness="1" StrokeLineJoin="Round"
                          Data="M3.2,7.4 L7.7,11.4 L12,4.6 L16.3,11.4 L20.8,7.4 L19.1,15.4 Q18.9,16.4 17.9,16.4 L6.1,16.4 Q5.1,16.4 4.9,15.4 Z"/>
                    <Path Fill="#D08400" Stroke="#3A2600" StrokeThickness="1" StrokeLineJoin="Round"
                          Data="M5.4,17.3 L18.6,17.3 Q19.5,17.3 19.5,18.2 Q19.5,19.1 18.6,19.1 L5.4,19.1 Q4.5,19.1 4.5,18.2 Q4.5,17.3 5.4,17.3 Z"/>
                    <Path Fill="{StaticResource CrownGold}" Stroke="#3A2600" StrokeThickness="1">
                        <Path.Data>
                            <GeometryGroup>
                                <EllipseGeometry Center="3.2,6.6" RadiusX="1.7" RadiusY="1.7"/>
                                <EllipseGeometry Center="12,3.4" RadiusX="1.9" RadiusY="1.9"/>
                                <EllipseGeometry Center="20.8,6.6" RadiusX="1.7" RadiusY="1.7"/>
                            </GeometryGroup>
                        </Path.Data>
                    </Path>
                    <!-- a glint on the middle point -->
                    <Path Fill="#FFFBE0" Opacity="0.8" Data="M12,8.2 L13.3,12.6 L12,14.2 L10.7,12.6 Z"/>
                </Canvas>
            </Viewbox>
        </ControlTemplate>

        <!-- one permission of a person: lit when they have it -->
        <Style x:Key="PermIcon" TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Foreground" Value="{DynamicResource BorderStrongBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- a permission to switch on and off: a pill with its icon, tinted when on (dashed look when only some have it) -->
        <Style x:Key="PermChip" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="16" Height="32" Padding="12,0" Background="{DynamicResource Surface2Brush}"
                                BorderBrush="Transparent" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Ico" Text="{TemplateBinding local:Ui.Glyph}" FontFamily="{StaticResource IconFont}" FontSize="12" FontWeight="Normal"
                                           VerticalAlignment="Center"/>
                                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface3Brush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Ico" Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Ico" Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- a permission to switch on and off: just its icon in a circle, tinted when on (only the ring when some of the
             selected people have it); the name is in the tooltip -->
        <Style x:Key="PermToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="250"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="18" Background="{DynamicResource Surface2Brush}" BorderBrush="Transparent" BorderThickness="1">
                            <TextBlock x:Name="Ico" Text="{TemplateBinding local:Ui.Glyph}" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface3Brush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Ico" Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Ico" Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- a row of small round choices (how many random songs) -->
        <Style x:Key="CountPills" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" MinWidth="36" Height="32" CornerRadius="16" Margin="0,0,6,0" Padding="10,0" Background="{DynamicResource Surface3Brush}"
                                            BorderBrush="Transparent" BorderThickness="1">
                                        <TextBlock x:Name="Tx" Text="{Binding Label}" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SubTextBrush}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Tx" Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            <Setter TargetName="Tx" Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- a pulse going out, behind the "searching" icon -->
        <Style x:Key="Pulse" TargetType="Ellipse">
            <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.6" To="1.5" Duration="0:0:2.2"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.6" To="1.5" Duration="0:0:2.2"/>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.7" To="0" Duration="0:0:2.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border Height="260" VerticalAlignment="Top" Background="{DynamicResource HeaderGradient}" Opacity="0.55" IsHitTestVisible="False"/>

        <!-- ============================================================ lobby: create a room or join one -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="{Binding InRoom, Converter={StaticResource InvBoolVis}}">
            <StackPanel Margin="28,8,28,28">
                <Grid Margin="0,0,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="148" Height="148" CornerRadius="10" Background="{DynamicResource AccentGradient}">
                        <TextBlock Text="&#xE716;" Style="{StaticResource Glyph}" FontSize="58" Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Bottom">
                        <TextBlock Text="{local:T 'LISTEN TOGETHER'}" Style="{StaticResource SmallCaps}" Foreground="{DynamicResource SubTextBrush}"/>
                        <TextBlock Text="{local:T 'Listen with friends'}" FontSize="40" FontWeight="Bold" Margin="0,2,0,6" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Style="{StaticResource Hint}" FontSize="13.5" LineHeight="20" MaxWidth="820" HorizontalAlignment="Left"
                                   Text="{local:T 'The same music, at the same moment, for everyone in the room, with a chat. It works on the same network (Wi-Fi or cable); from afar, all join the same Radmin VPN network.'}"/>
                    </StackPanel>
                </Grid>

                <!-- why the last room ended / a join failed -->
                <Border Margin="0,0,0,16" CornerRadius="10" Padding="14,6,6,6" Background="{DynamicResource WarningSoftBrush}"
                        Visibility="{Binding LobbyMessage, Converter={StaticResource NotNullVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="10" Content="&#xE711;"
                                Command="{Binding DismissMessageCommand}" ToolTip="{local:T Close}"/>
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Glyph}" Foreground="{DynamicResource WarningBrush}"/>
                        <TextBlock Text="{Binding LobbyMessage}" Margin="10,0,10,0" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}"/>
                    </DockPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="320" MaxWidth="420"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1.4*"/>
                    </Grid.ColumnDefinitions>

                    <!-- create -->
                    <Border Style="{StaticResource Card}" Padding="22" VerticalAlignment="Top">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,18">
                                <Grid Width="44" Height="44">
                                    <Ellipse Fill="{DynamicResource AccentSoftBrush}"/>
                                    <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="18" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center"/>
                                </Grid>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{local:T 'Create a room'}" FontSize="17" FontWeight="Bold"/>
                                    <TextBlock Text="{local:T 'Others on the network see it and can join.'}" Style="{StaticResource Hint}" FontSize="12"/>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Text="{local:T 'Room name'}" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource BoxTextBox}" Text="{Binding NewRoomName, UpdateSourceTrigger=PropertyChanged}" MaxLength="60"
                                     AutomationProperties.Name="{local:T 'Room name'}"/>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{local:T 'Max people'}" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding MaxChoices}" SelectedItem="{Binding MaxChoice}" AutomationProperties.Name="{local:T 'Max people'}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{local:T 'Password (optional)'}" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Style="{StaticResource BoxTextBox}" Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" MaxLength="40"
                                             Tag="{local:T none}" AutomationProperties.Name="{local:T 'Password (optional)'}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{local:T 'People who join can'}" Style="{StaticResource FieldLabel}" Margin="2,16,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton Style="{StaticResource PermToggle}" local:Ui.Glyph="&#xE710;" IsChecked="{Binding DefAdd}"
                                              ToolTip="{local:T 'Add songs to the queue'}" AutomationProperties.Name="{local:T 'Add songs to the queue'}"/>
                                <ToggleButton Style="{StaticResource PermToggle}" local:Ui.Glyph="&#xE738;" IsChecked="{Binding DefRemove}"
                                              ToolTip="{local:T 'Remove and move songs in the queue'}" AutomationProperties.Name="{local:T 'Remove and move songs in the queue'}"/>
                                <ToggleButton Style="{StaticResource PermToggle}" local:Ui.Glyph="&#xE893;" IsChecked="{Binding DefSkip}"
                                              ToolTip="{local:T 'Skip the song playing'}" AutomationProperties.Name="{local:T 'Skip the song playing'}"/>
                                <ToggleButton Style="{StaticResource PermToggle}" local:Ui.Glyph="&#xE769;" IsChecked="{Binding DefPause}"
                                              ToolTip="{local:T 'Pause, move forward and back in the song and put it on loop'}"
                                              AutomationProperties.Name="{local:T 'Pause, move forward and back in the song and put it on loop'}"/>
                                <ToggleButton Style="{StaticResource PermToggle}" local:Ui.Glyph="&#xE916;" IsChecked="{Binding DefSpeed}" Margin="0"
                                              ToolTip="{local:T 'Change the playback speed for everyone'}" AutomationProperties.Name="{local:T 'Change the playback speed for everyone'}"/>
                            </StackPanel>
                            <TextBlock Text="{local:T 'Vote to skip'}" Style="{StaticResource FieldLabel}" Margin="2,16,0,8"/>
                            <ComboBox ItemsSource="{Binding VoteChoices}" SelectedItem="{Binding VoteChoice}" AutomationProperties.Name="{local:T 'Vote to skip'}"
                                      ToolTip="{local:T 'Who isn\'t allowed to skip votes instead: the song goes once this much of the room voted'}"/>
                            <Button Style="{StaticResource PrimaryButton}" Margin="0,20,0,0" Padding="18,11" Command="{Binding CreateCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE716;" Style="{StaticResource Glyph}"/>
                                    <TextBlock Text="{local:T 'Create the room'}" Margin="9,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- rooms on the network -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22" VerticalAlignment="Top" MinHeight="440">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;" VerticalAlignment="Top" Command="{Binding RefreshCommand}"
                                        ToolTip="{local:T 'Search again'}" AutomationProperties.Name="{local:T 'Search again'}"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{local:T 'Rooms on the network'}" FontSize="17" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <Ellipse Style="{StaticResource Spinner}" Width="12" Height="12" StrokeThickness="2" Margin="0,0,7,0"
                                                 Visibility="{Binding Scanning, Converter={StaticResource BoolVis}}"/>
                                        <TextBlock Text="{local:T 'The list updates by itself.'}" Style="{StaticResource Hint}" FontSize="12" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>

                            <ItemsControl Grid.Row="1" ItemsSource="{Binding Rooms}" Margin="0,16,0,0" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:RoomAdViewModel}">
                                        <Border x:Name="Card" CornerRadius="12" Padding="12" Margin="0,0,0,8" Background="{DynamicResource BgBrush}"
                                                BorderBrush="Transparent" BorderThickness="1" local:Marquee.Host="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="48" Height="48">
                                                    <Ellipse Fill="{Binding HostBrush}"/>
                                                    <TextBlock Text="{Binding Initial}" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                                                        <TextBlock Text="&#xE72E;" Style="{StaticResource Glyph}" FontSize="12" Margin="8,0,0,0" Foreground="{DynamicResource SubTextBrush}"
                                                                   Visibility="{Binding Locked, Converter={StaticResource BoolVis}}" ToolTip="{local:T 'Needs a password'}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Detail}" FontSize="12.5" Foreground="{DynamicResource SubTextBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Playing}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                               local:Marquee.IsEnabled="True" Visibility="{Binding Playing, Converter={StaticResource NotNullVis}}"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Padding="20,8" VerticalAlignment="Center" Content="{Binding JoinText}"
                                                        IsEnabled="{Binding CanJoin}" Command="{Binding DataContext.JoinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- nobody around yet -->
                            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400" Margin="0,24"
                                        Visibility="{Binding HasRooms, Converter={StaticResource InvBoolVis}}">
                                <Grid Width="96" Height="96" HorizontalAlignment="Center">
                                    <Ellipse Style="{StaticResource Pulse}"/>
                                    <Ellipse Margin="14" Fill="{DynamicResource AccentSoftBrush}"/>
                                    <TextBlock Text="&#xE701;" Style="{StaticResource Glyph}" FontSize="28" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="{local:T 'No rooms yet'}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                                <TextBlock Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,6,0,0"
                                           Text="{local:T 'Ask a friend to create one on the same network, or create it yourself. If a room doesn\'t show up, join with its address.'}"/>
                            </StackPanel>

                            <!-- rooms the search doesn't find (another network, broadcasts blocked) -->
                            <Button Grid.Row="2" Style="{StaticResource GhostButton}" Padding="14,7" Margin="0,12,0,0" HorizontalAlignment="Left"
                                    Command="{Binding JoinByAddressCommand}" ToolTip="{local:T 'If the room doesn\'t show up: type the address of the computer hosting it'}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE71B;" Style="{StaticResource Glyph}" FontSize="13"/>
                                    <TextBlock Text="{local:T 'Join by address'}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>

                            <Border Grid.Row="3" Margin="0,14,0,0" CornerRadius="10" Background="{DynamicResource BgBrush}" Padding="14,10">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="12,6" FontSize="12.5" Margin="10,0,0,0" VerticalAlignment="Center"
                                            Command="{Binding FirewallCommand}" Content="{local:T 'Allow through the firewall'}"
                                            ToolTip="{local:T 'Let other people\'s connections in on every network (needs administrator confirmation)'}"/>
                                    <TextBlock Text="&#xEA18;" Style="{StaticResource Glyph}" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Top" Margin="0,2,10,0"/>
                                    <TextBlock Style="{StaticResource Hint}" FontSize="12"
                                               Text="{local:T 'The first time, Windows asks whether the app may use the network: allow access. With Radmin VPN also tick “Public networks”, or use the button next to this.'}"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="4,16,0,0" Visibility="{Binding BusyText, Converter={StaticResource NotNullVis}}">
                    <Ellipse Style="{StaticResource Spinner}" Width="18" Height="18" StrokeThickness="3"/>
                    <TextBlock Text="{Binding BusyText}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ============================================================ in the room -->
        <Grid Margin="28,8,20,16" Visibility="{Binding InRoom, Converter={StaticResource BoolVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel x:Name="RoomHeader" Margin="0,0,8,16">
                <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Padding="16,9" VerticalAlignment="Center" Command="{Binding LeaveCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE89B;" Style="{StaticResource Glyph}" FontSize="13"/>
                        <TextBlock Text="{local:T 'Leave the room'}" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <Border x:Name="RoomIcon" Width="68" Height="68" CornerRadius="14" Background="{DynamicResource AccentGradient}">
                    <TextBlock Text="&#xE716;" Style="{StaticResource Glyph}" FontSize="28" Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Center"/>
                </Border>
                <StackPanel x:Name="RoomTitle" Margin="18,0,16,0" VerticalAlignment="Center">
                    <TextBlock x:Name="RoomNameText" Text="{Binding RoomName}" FontSize="28" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding RoomSubtitle}" Foreground="{DynamicResource SubTextBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    <StackPanel x:Name="RoomAddress" Orientation="Horizontal" Margin="0,2,0,0" Visibility="{Binding AddressText, Converter={StaticResource NotNullVis}}">
                        <TextBlock Text="{Binding AddressText}" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <Button Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="11" Content="&#xE8C8;" Margin="4,0,0,0" Command="{Binding CopyAddressCommand}"
                                ToolTip="{local:T 'Copy the address'}" AutomationProperties.Name="{local:T 'Copy the address'}"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <!-- the host's PC went away: the room moves to someone else -->
            <Border Grid.Row="1" Margin="0,0,8,14" CornerRadius="10" Padding="14,9" Background="{DynamicResource WarningSoftBrush}"
                    Visibility="{Binding Reconnecting, Converter={StaticResource BoolVis}}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Style="{StaticResource Spinner}" Width="16" Height="16" StrokeThickness="2.5" Stroke="{DynamicResource WarningBrush}"/>
                    <TextBlock Text="{local:T 'Lost the connection to the room: reconnecting (if the host left, the room moves to someone else)…'}" Margin="10,0,0,0"
                               Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- two columns that share the width (the side one between 270 and 380 px); TogetherView.Adapt tightens them on small windows -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="360"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="0.62*" MinWidth="270" MaxWidth="380"/>
                </Grid.ColumnDefinitions>

                <!-- ======================================================== the song and the queue -->
                <Grid x:Name="LeftCol">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource Card}" Padding="18,16" MouseRightButtonUp="Current_RightClick" Background="{DynamicResource SurfaceBrush}">
                        <Grid local:Marquee.Host="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid x:Name="NowCover" Width="112" Height="112" VerticalAlignment="Top">
                                <Grid.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.45" Color="Black"/>
                                </Grid.Effect>
                                <Border CornerRadius="10" Background="{DynamicResource PlaceholderGradient}">
                                    <TextBlock Text="&#xEC4F;" Style="{StaticResource Glyph}" FontSize="38" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                                </Border>
                                <ContentPresenter Content="{Binding Main.Player.Current}" ContentTemplate="{StaticResource TrackCoverMedium}"
                                                  Visibility="{Binding Main.Player.Current, Converter={StaticResource NotNullVis}}"/>
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                <DockPanel>
                                    <!-- the library icon, then the download arrow, as everywhere else -->
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="12,5" FontSize="12.5" VerticalAlignment="Top"
                                            Command="{Binding CurrentItem.KeepCommand}" ToolTip="{Binding CurrentItem.KeepTip}"
                                            Visibility="{Binding CurrentItem.ShowKeep, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding CurrentItem.KeepGlyph}" Style="{StaticResource Glyph}" FontSize="12"/>
                                            <TextBlock Text="{Binding CurrentItem.KeepLabel}" Margin="7,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <WrapPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding NowKicker}" Style="{StaticResource SmallCaps}" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>
                                        <!-- the room's loop and speed, when on (the buttons are in the player bar) -->
                                        <Border CornerRadius="9" Padding="7,1,8,1" Margin="0,0,6,0" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center"
                                                Visibility="{Binding RoomLoop, Converter={StaticResource BoolVis}}"
                                                ToolTip="{local:T 'The song starts over when it ends, until someone turns the loop off'}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8ED;" Style="{StaticResource Glyph}" FontSize="10.5" Foreground="{DynamicResource AccentTextBrush}"/>
                                                <TextBlock Text="{local:T 'On loop'}" FontSize="11" FontWeight="SemiBold" Margin="5,0,0,0" Foreground="{DynamicResource AccentTextBrush}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border CornerRadius="9" Padding="7,1,8,1" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center"
                                                Visibility="{Binding HasSpeedBadge, Converter={StaticResource BoolVis}}"
                                                ToolTip="{local:T 'The room\'s playback speed'}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE916;" Style="{StaticResource Glyph}" FontSize="10.5" Foreground="{DynamicResource AccentTextBrush}"/>
                                                <TextBlock Text="{Binding SpeedBadge}" FontSize="11" FontWeight="SemiBold" Margin="5,0,0,0" Foreground="{DynamicResource AccentTextBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>
                                </DockPanel>
                                <TextBlock Text="{Binding Main.Player.Current.Title}" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                                           local:Marquee.IsEnabled="True"/>
                                <TextBlock Text="{Binding Main.Player.Current.Artist}" FontSize="14" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis"
                                           local:Marquee.IsEnabled="True"/>
                                <StackPanel x:Name="NowAddedBy" Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding HasCurrent, Converter={StaticResource BoolVis}}">
                                    <Grid Width="18" Height="18">
                                        <Ellipse Fill="{Binding CurrentItem.AddedByBrush}"/>
                                        <TextBlock Text="{Binding CurrentItem.AddedByInitial}" FontSize="9" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="{Binding CurrentItem.AddedByText}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Ellipse Style="{StaticResource Spinner}" Width="13" Height="13" StrokeThickness="2" Margin="0,0,8,0"
                                             Visibility="{Binding NowBusy, Converter={StaticResource BoolVis}}"/>
                                    <TextBlock Text="{Binding NowStatus}" Style="{StaticResource Hint}" FontSize="12.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>


                    <!-- the queue -->
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Margin="6,2,4,10">
                                <!-- a few songs at random from your songs, a playlist or a tag -->
                                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource PermChip}" Margin="10,0,0,0" VerticalAlignment="Top" local:Ui.Glyph="&#xE8B1;"
                                              Content="{local:T 'Random songs'}" IsChecked="{Binding ShowRandom, Mode=OneWay}" Command="{Binding ToggleRandomCommand}"
                                              Visibility="{Binding CanAdd, Converter={StaticResource BoolVis}}"
                                              ToolTip="{local:T 'Add random songs to the queue from all your songs, a playlist or a tag, or songs suggested online'}"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding QueueCountText}" Foreground="{DynamicResource MutedBrush}" FontSize="12.5" VerticalAlignment="Top" Margin="0,8,0,0"/>
                                <StackPanel>
                                    <TextBlock Text="{local:T Queued}" FontSize="17" FontWeight="Bold"/>
                                    <TextBlock x:Name="QueueHint" Text="{Binding AddHint}" Style="{StaticResource Hint}" FontSize="12" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DockPanel>
                            <Border Grid.Row="1" Margin="2,0,2,12" CornerRadius="12" Background="{DynamicResource Surface2Brush}" BorderBrush="Transparent"
                                    BorderThickness="1" Padding="14,10,8,12" Visibility="{Binding ShowRandom, Converter={StaticResource BoolVis}}">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="10" Content="&#xE711;"
                                                Command="{Binding ToggleRandomCommand}" ToolTip="{local:T Close}" AutomationProperties.Name="{local:T Close}"/>
                                        <TextBlock Text="{Binding RandomTitle}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <Grid Margin="0,8,6,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="150"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{Binding RandomSources}" SelectedItem="{Binding RandomSource}" AutomationProperties.Name="{local:T From}"
                                                  ToolTip="{local:T 'Where to take them from'}"/>
                                        <ListBox Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource CountPills}" ItemsSource="{Binding RandomCounts}"
                                                 SelectedItem="{Binding RandomCount}" VerticalAlignment="Center" AutomationProperties.Name="{local:T 'How many'}"
                                                 ToolTip="{local:T 'How many songs'}"/>
                                    </Grid>
                                    <DockPanel Margin="0,10,6,0">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Padding="16,7" Margin="10,0,0,0" Command="{Binding AddRandomCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <Grid>
                                                    <TextBlock Text="{Binding RandomGlyph}" Style="{StaticResource Glyph}" FontSize="12"
                                                               Visibility="{Binding RandomBusy, Converter={StaticResource InvBoolVis}}"/>
                                                    <Ellipse Style="{StaticResource Spinner}" Width="13" Height="13" StrokeThickness="1.6" Stroke="{DynamicResource OnAccentBrush}"
                                                             Visibility="{Binding RandomBusy, Converter={StaticResource BoolVis}}"/>
                                                </Grid>
                                                <TextBlock Text="{Binding RandomAddText}" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <TextBlock Text="{Binding RandomHint}" Style="{StaticResource Hint}" FontSize="12" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                            <ListBox x:Name="RoomQueue" Grid.Row="2" Style="{StaticResource PlainList}" ItemsSource="{Binding Queue}" AutomationProperties.Name="{local:T Queued}"
                                     AllowDrop="True" DragOver="Queue_DragOver">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:RoomItemViewModel}">
                                        <Border x:Name="Row" CornerRadius="8" Padding="6" Margin="0,0,0,1" Background="Transparent" local:Marquee.Host="True"
                                                MouseRightButtonUp="Item_RightClick" ToolTipService.InitialShowDelay="900"
                                                PreviewMouseLeftButtonDown="Row_MouseDown" MouseMove="Row_MouseMove">
                                            <Border.InputBindings>
                                                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding PlayNowCommand}"/>
                                            </Border.InputBindings>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="34"/>
                                                    <ColumnDefinition Width="70"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Number}" Foreground="{DynamicResource SubTextBrush}" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <ContentPresenter Grid.Column="1" Width="40" Height="40" Content="{Binding Track}" ContentTemplate="{StaticResource TrackCoverSmall}"/>
                                                <StackPanel Grid.Column="2" Margin="12,0,10,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Track.Title}" FontSize="13.5" TextTrimming="CharacterEllipsis" local:Marquee.IsEnabled="True"/>
                                                    <TextBlock Text="{Binding Track.Artist}" FontSize="12" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis"
                                                               local:Marquee.IsEnabled="True"/>
                                                </StackPanel>
                                                <!-- who added it -->
                                                <Border Grid.Column="3" CornerRadius="10" Padding="3,2" Background="{DynamicResource Surface3Brush}" VerticalAlignment="Center"
                                                        Margin="0,0,8,0" ToolTip="{Binding AddedByText}" MaxWidth="130">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Grid Width="16" Height="16">
                                                            <Ellipse Fill="{Binding AddedByBrush}"/>
                                                            <TextBlock Text="{Binding AddedByInitial}" FontSize="8.5" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Grid>
                                                        <TextBlock x:Name="AddedName" Text="{Binding AddedByName}" FontSize="11.5" Margin="5,0,6,0" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>
                                                <!-- this computer's copy: ready, on its way, or not yet -->
                                                <Grid Grid.Column="4" Width="30" Height="30" ToolTip="{Binding StateTip}" Background="Transparent">
                                                    <Ellipse x:Name="Dot" Width="6" Height="6" Fill="{DynamicResource BorderStrongBrush}"/>
                                                    <TextBlock x:Name="Ready" Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource SuccessBrush}"
                                                               HorizontalAlignment="Center" Visibility="Collapsed"/>
                                                    <TextBlock x:Name="Failed" Text="&#xE7BA;" Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource WarningBrush}"
                                                               HorizontalAlignment="Center" Visibility="Collapsed"/>
                                                    <Grid x:Name="Busy" Visibility="Collapsed">
                                                        <Ellipse Style="{StaticResource Spinner}" Width="26" Height="26" StrokeThickness="2"/>
                                                        <TextBlock Text="{Binding PctText}" FontSize="8.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Grid>
                                                <!-- the length, or on hover the actions in its place -->
                                                <TextBlock x:Name="Length" Grid.Column="5" Text="{Binding Track.DurationText}" FontSize="12.5" Foreground="{DynamicResource SubTextBrush}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <StackPanel x:Name="Actions" Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Hidden">
                                                    <Button Style="{StaticResource RowIconButton}" Content="{Binding KeepGlyph}" Command="{Binding KeepCommand}"
                                                            ToolTip="{Binding KeepTip}" Visibility="{Binding ShowKeep, Converter={StaticResource BoolVis}}"/>
                                                    <Button Style="{StaticResource RowIconButton}" Content="&#xE711;" FontSize="11" Command="{Binding RemoveCommand}"
                                                            IsEnabled="{Binding CanRemove}" ToolTip="{Binding RemoveTip}" ToolTipService.ShowOnDisabled="True"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                                <Setter TargetName="Actions" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="Length" Property="Visibility" Value="Hidden"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding Narrow, RelativeSource={RelativeSource AncestorType=views:TogetherView}}" Value="True">
                                                <Setter TargetName="AddedName" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsReady}" Value="True">
                                                <Setter TargetName="Ready" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="Dot" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter TargetName="Busy" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="Dot" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                <Setter TargetName="Failed" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="Dot" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="320" Margin="0,0,0,20"
                                        Visibility="{Binding HasQueue, Converter={StaticResource InvBoolVis}}">
                                <Grid Width="72" Height="72" HorizontalAlignment="Center">
                                    <Ellipse Fill="{DynamicResource AccentSoftBrush}"/>
                                    <Ellipse Stroke="{DynamicResource AccentGradient}" StrokeThickness="1.5" Opacity="0.7"/>
                                    <TextBlock Text="&#xE90B;" Style="{StaticResource Glyph}" FontSize="28" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="{local:T 'The queue is empty'}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                                <TextBlock Text="{Binding AddHint}" Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ======================================================== people and chat -->
                <Grid x:Name="RightCol" Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*" MinHeight="130"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource Card}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Margin="6,2,0,8">
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="30" Height="30" Content="&#xE712;" VerticalAlignment="Top"
                                        Command="{Binding MemberMenuCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                                        Visibility="{Binding IsHost, Converter={StaticResource BoolVis}}"
                                        ToolTip="{local:T 'Permissions, host and kicks for the selected people'}"/>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{local:T People}" FontSize="17" FontWeight="Bold"/>
                                        <Border Margin="8,0,0,0" CornerRadius="9" MinWidth="20" Height="18" Padding="6,0" Background="{DynamicResource Surface3Brush}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding MemberCount}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="RoleHint" Text="{Binding MyRoleText}" Style="{StaticResource Hint}" FontSize="12" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DockPanel>
                            <ListBox x:Name="MemberList" Grid.Row="1" Style="{StaticResource PlainList}" ItemsSource="{Binding Members}" MaxHeight="300"
                                     SelectionMode="Extended" AutomationProperties.Name="{local:T People}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:MemberViewModel}">
                                        <Border x:Name="Row" CornerRadius="10" Padding="8,7" Margin="0,0,0,2" Background="Transparent" MouseRightButtonUp="Member_RightClick">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid x:Name="Face" Width="38" Height="38" VerticalAlignment="Top">
                                                    <!-- the host: a gold ring and a crown sitting on the picture -->
                                                    <Ellipse x:Name="HostRing" Margin="-3" Stroke="{StaticResource CrownGold}" StrokeThickness="2" Visibility="Collapsed"/>
                                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource MemberAvatar}"/>
                                                    <ContentControl x:Name="HostCrown" Template="{StaticResource Crown}" Width="30" Height="25" HorizontalAlignment="Center" VerticalAlignment="Top"
                                                                    Margin="6,-22,-6,0" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed" Focusable="False" IsTabStop="False"
                                                                    ToolTip="{local:T 'Host of the room'}">
                                                        <ContentControl.RenderTransform>
                                                            <RotateTransform Angle="14"/>
                                                        </ContentControl.RenderTransform>
                                                        <ContentControl.Effect>
                                                            <DropShadowEffect BlurRadius="5" ShadowDepth="1.5" Direction="290" Opacity="0.7" Color="Black"/>
                                                        </ContentControl.Effect>
                                                    </ContentControl>
                                                </Grid>
                                                <StackPanel Grid.Column="1" Margin="11,0,0,0">
                                                    <DockPanel>
                                                        <Border x:Name="RolePill" DockPanel.Dock="Right" CornerRadius="8" Padding="7,1" Background="{DynamicResource Surface3Brush}" VerticalAlignment="Center">
                                                            <TextBlock x:Name="RoleText" Text="{Binding RoleText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding NameText}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                    </DockPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,4" Background="Transparent" ToolTip="{Binding PermsTip}">
                                                        <TextBlock Text="&#xE710;" Style="{StaticResource PermIcon}" Tag="{Binding PermAdd}"/>
                                                        <TextBlock Text="&#xE738;" Style="{StaticResource PermIcon}" Tag="{Binding PermRemove}"/>
                                                        <TextBlock Text="&#xE893;" Style="{StaticResource PermIcon}" Tag="{Binding PermSkip}"/>
                                                        <TextBlock Text="&#xE769;" Style="{StaticResource PermIcon}" Tag="{Binding PermPause}"/>
                                                        <TextBlock Text="&#xE916;" Style="{StaticResource PermIcon}" Tag="{Binding PermSpeed}"/>
                                                        <Border CornerRadius="6" Padding="5,0,5,1" Margin="6,0,0,0" Background="{DynamicResource Surface3Brush}" VerticalAlignment="Center"
                                                                Visibility="{Binding NoP2P, Converter={StaticResource BoolVis}}"
                                                                ToolTip="{local:T 'Doesn\'t exchange songs with the others: gets them only from their library or the links (P2P off)'}">
                                                            <TextBlock Text="{local:T 'no P2P'}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <!-- their download: a thin bar while it comes -->
                                                    <ProgressBar Height="3" Maximum="100" Value="{Binding StatusPct, Mode=OneWay}" Margin="0,1,0,3"
                                                                 Visibility="{Binding StatusBusy, Converter={StaticResource BoolVis}}"/>
                                                    <TextBlock x:Name="Status" Text="{Binding StatusText}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusReady}" Value="True">
                                                <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusFailed}" Value="True">
                                                <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Away}" Value="True">
                                                <Setter TargetName="Face" Property="Opacity" Value="0.4"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsHost}" Value="True">
                                                <Setter TargetName="HostRing" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="HostCrown" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="Face" Property="Margin" Value="0,16,0,0"/>
                                                <Setter TargetName="RolePill" Property="Background" Value="{DynamicResource WarningSoftBrush}"/>
                                                <Setter TargetName="RoleText" Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- host: what the selected people may do -->
                            <Border Grid.Row="2" Margin="0,8,0,0" CornerRadius="10" Background="{DynamicResource Surface2Brush}" Padding="12,10,8,6"
                                    Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="10" Content="&#xE711;"
                                                Command="{Binding ClearSelectionCommand}" ToolTip="{local:T Deselect}"/>
                                        <TextBlock Text="{Binding SelectionText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <ToggleButton Style="{StaticResource PermToggle}" local:Ui.Glyph="&#xE710;" IsThreeState="True"
                                                      IsChecked="{Binding SelAdd, Mode=OneWay}" Command="{Binding TogglePermCommand}" CommandParameter="Add"
                                                      ToolTip="{local:T 'Add songs to the queue'}" AutomationProperties.Name="{local:T 'Add songs to the queue'}"/>
                                        <ToggleButton Style="{StaticResource PermToggle}" local:Ui.Glyph="&#xE738;" IsThreeState="True"
                                                      IsChecked="{Binding SelRemove, Mode=OneWay}" Command="{Binding TogglePermCommand}" CommandParameter="Remove"
                                                      ToolTip="{local:T 'Remove and move songs in the queue'}" AutomationProperties.Name="{local:T 'Remove and move songs in the queue'}"/>
                                        <ToggleButton Style="{StaticResource PermToggle}" local:Ui.Glyph="&#xE893;" IsThreeState="True"
                                                      IsChecked="{Binding SelSkip, Mode=OneWay}" Command="{Binding TogglePermCommand}" CommandParameter="Skip"
                                                      ToolTip="{local:T 'Skip the song playing'}" AutomationProperties.Name="{local:T 'Skip the song playing'}"/>
                                        <ToggleButton Style="{StaticResource PermToggle}" local:Ui.Glyph="&#xE769;" IsThreeState="True"
                                                      IsChecked="{Binding SelPause, Mode=OneWay}" Command="{Binding TogglePermCommand}" CommandParameter="Pause"
                                                      ToolTip="{local:T 'Pause, move forward and back in the song and put it on loop'}"
                                                      AutomationProperties.Name="{local:T 'Pause, move forward and back in the song and put it on loop'}"/>
                                        <ToggleButton Style="{StaticResource PermToggle}" local:Ui.Glyph="&#xE916;" IsThreeState="True" Margin="0"
                                                      IsChecked="{Binding SelSpeed, Mode=OneWay}" Command="{Binding TogglePermCommand}" CommandParameter="Speed"
                                                      ToolTip="{local:T 'Change the playback speed for everyone'}" AutomationProperties.Name="{local:T 'Change the playback speed for everyone'}"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource DangerButton}" Padding="12,5" FontSize="12.5" HorizontalAlignment="Left" Margin="0,10,0,4"
                                            Command="{Binding KickSelectedCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8F8;" Style="{StaticResource Glyph}" FontSize="12"/>
                                            <TextBlock Text="{local:T 'Kick…'}" Margin="7,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- chat -->
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Chat" FontSize="17" FontWeight="Bold" Margin="6,2,0,8"/>
                            <ListBox x:Name="ChatList" Grid.Row="1" Style="{StaticResource PlainList}" ItemsSource="{Binding Chat}" AutomationProperties.Name="Chat">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ChatLineViewModel}">
                                        <StackPanel Margin="6,0,6,5">
                                            <StackPanel x:Name="Head" Orientation="Horizontal" Margin="0,7,0,1" Visibility="{Binding ShowName, Converter={StaticResource BoolVis}}">
                                                <TextBlock Text="{Binding Name}" Foreground="{Binding Brush}" FontWeight="SemiBold" FontSize="12.5"/>
                                                <TextBlock Text="{Binding Time}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="7,0,0,0" VerticalAlignment="Bottom"/>
                                            </StackPanel>
                                            <TextBlock x:Name="Body" Text="{Binding Text}" TextWrapping="Wrap" FontSize="13.5" LineHeight="19"/>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSystem}" Value="True">
                                                <Setter TargetName="Body" Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                                <Setter TargetName="Body" Property="FontStyle" Value="Italic"/>
                                                <Setter TargetName="Body" Property="FontSize" Value="12"/>
                                                <Setter TargetName="Body" Property="TextAlignment" Value="Center"/>
                                                <Setter TargetName="Body" Property="Margin" Value="0,4"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Grid Grid.Row="2" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ChatBox" Style="{StaticResource BoxTextBox}" Text="{Binding ChatInput, UpdateSourceTrigger=PropertyChanged}" MaxLength="500"
                                         Tag="{local:T 'Write a message…'}" KeyDown="Chat_KeyDown" AutomationProperties.Name="{local:T 'Write a message…'}"/>
                                <Button Grid.Column="1" Style="{StaticResource PillPrimaryButton}" Width="38" Height="38" Padding="0" Margin="8,0,0,0" Command="{Binding SendCommand}"
                                        ToolTip="{local:T 'Send (Enter)'}" AutomationProperties.Name="{local:T Send}">
                                    <TextBlock Text="&#xE724;" Style="{StaticResource Glyph}" FontSize="14"/>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
