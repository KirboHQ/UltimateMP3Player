<UserControl x:Class="UltimateMP3Player.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UltimateMP3Player"
             xmlns:vm="clr-namespace:UltimateMP3Player.ViewModels"
             xmlns:views="clr-namespace:UltimateMP3Player.Views">
    <Grid>
        <Border Height="260" VerticalAlignment="Top" Background="{DynamicResource HeaderGradient}" Opacity="0.55" IsHitTestVisible="False"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel x:Name="HomeRows" Margin="28,12,20,28">
                <TextBlock Text="{Binding Greeting}" FontSize="30" FontWeight="Bold" Margin="0,4,0,22"/>

                <!-- December to mid January: the year's recap -->
                <Border CornerRadius="16" Padding="24,20" Margin="0,0,8,26" Cursor="Hand" Background="{DynamicResource AccentGradient}"
                        TextElement.Foreground="{DynamicResource OnAccentBrush}" Visibility="{Binding HasRecap, Converter={StaticResource BoolVis}}">
                    <Border.InputBindings>
                        <MouseBinding Gesture="LeftClick" Command="{Binding OpenRecapCommand}"/>
                    </Border.InputBindings>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" CornerRadius="20" Padding="20,10" Background="{DynamicResource OnAccentBrush}" VerticalAlignment="Center">
                            <TextBlock Text="{local:T Open}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock DockPanel.Dock="Left" Text="&#xE787;" Style="{StaticResource Glyph}" FontSize="34" Margin="0,0,20,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{local:T RECAP}" FontSize="12" FontWeight="Bold" Opacity="0.85"/>
                            <TextBlock Text="{Binding RecapTitle}" FontSize="24" FontWeight="Bold" Margin="0,2,0,2" TextWrapping="Wrap"/>
                            <TextBlock Text="{local:T 'Your songs, your artists, your minutes: page after page, like stories.'}" Opacity="0.9" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- first run -->
                <Border Style="{StaticResource Card}" Padding="28" Margin="0,0,8,24" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="{StaticResource LogoImage}" Width="96" Height="96" VerticalAlignment="Top"/>
                        <StackPanel Grid.Column="1" Margin="24,0,0,0">
                            <TextBlock Text="{local:T 'Your music, offline and ad-free'}" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Style="{StaticResource Hint}" FontSize="14" LineHeight="21" Margin="0,8,0,16"
                                       Text="{local:T 'Paste the link to a song or playlist in Search (YouTube Music, Spotify, SoundCloud, YouTube, TikTok, Instagram and almost any other site): it gets downloaded and saved here. You can also add music you already have on your computer, or drag files into the window.'}"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryButton}" Padding="18,10"
                                        Command="{Binding DataContext.PasteLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE77F;" Style="{StaticResource Glyph}"/>
                                        <TextBlock Text="{local:T 'Paste a link'}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Padding="18,10" Margin="10,0,0,0"
                                        Command="{Binding DataContext.ImportCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8E5;" Style="{StaticResource Glyph}"/>
                                        <TextBlock Text="{local:T 'Add files from your computer'}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <!-- coming from Spotify or Last.fm: the library, the playlists and the plays -->
                            <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,20,0,10" TextWrapping="Wrap"
                                       Text="{local:T 'Coming from Spotify or Last.fm? Bring your liked songs, your playlists and your plays.'}"/>
                            <WrapPanel>
                                <Button Style="{StaticResource GhostButton}" Padding="16,9" Margin="0,0,10,0" Command="{Binding ImportSpotifyCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8E5;" Style="{StaticResource Glyph}"/>
                                        <TextBlock Text="{local:T 'Import from Spotify'}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Padding="16,9" Command="{Binding ImportLastFmCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8E5;" Style="{StaticResource Glyph}"/>
                                        <TextBlock Text="{local:T 'Import from Last.fm'}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- one row each, scrolling sideways: its arrows, its bar (Shelf, in Controls.cs) -->
                <views:Shelf Tag="recent" Title="{local:T 'Recently played'}" Items="{Binding Recent}"
                             Visibility="{Binding HasRecent, Converter={StaticResource BoolVis}}">
                    <ListBox x:Name="RecentList" Style="{StaticResource BareList}" ItemTemplate="{StaticResource TrackCard}" ItemsPanel="{StaticResource CardRowTemplate}"/>
                </views:Shelf>

                <!-- for you: mixes made from what you listen to -->
                <views:Shelf Tag="foryou" Title="{local:T 'For you'}" Items="{Binding ForYou}"
                             Visibility="{Binding HasForYou, Converter={StaticResource BoolVis}}">
                    <ItemsControl ItemTemplate="{StaticResource MixCard}" ItemsPanel="{StaticResource CardRowTemplate}"/>
                </views:Shelf>

                <!-- the followed artists' new releases -->
                <views:Shelf Tag="releases" Title="{local:T 'New releases'}" Items="{Binding Artists.Releases}"
                             Visibility="{Binding Artists.HasReleases, Converter={StaticResource BoolVis}}">
                    <ItemsControl ItemTemplate="{StaticResource ReleaseCard}" ItemsPanel="{StaticResource CardRowTemplate}"/>
                </views:Shelf>

                <!-- the saved radios -->
                <views:Shelf Tag="radios" Title="{local:T 'Your radios'}" Items="{Binding Stations.Saved}"
                             Visibility="{Binding Stations.HasSaved, Converter={StaticResource BoolVis}}">
                    <ItemsControl ItemTemplate="{StaticResource StationCard}" ItemsPanel="{StaticResource CardRowTemplate}"/>
                </views:Shelf>

                <views:Shelf Tag="playlists" Title="{local:T 'Your playlists'}" Items="{Binding PlaylistCards}">
                    <ListBox x:Name="PlaylistList" Style="{StaticResource BareList}" ItemsPanel="{StaticResource CardRowTemplate}">
                        <ListBox.Resources>
                            <DataTemplate DataType="{x:Type vm:PlaylistViewModel}">
                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource PlaylistCard}"/>
                            </DataTemplate>
                        </ListBox.Resources>
                    </ListBox>
                </views:Shelf>

                <!-- ("Show all": the library, they may be thousands) -->
                <views:Shelf Tag="added" Title="{local:T 'Recently added'}" MoreLabel="{local:T 'Show all'}" Items="{Binding RecentlyAdded}"
                             MoreCommand="{Binding DataContext.GoLibraryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                             Visibility="{Binding HasRecentlyAdded, Converter={StaticResource BoolVis}}">
                    <ListBox x:Name="AddedList" Style="{StaticResource BareList}" ItemTemplate="{StaticResource TrackCard}" ItemsPanel="{StaticResource CardRowTemplate}"/>
                </views:Shelf>
            </StackPanel>
        </ScrollViewer>
        <!-- what's selected in one of the lists (Ctrl or Shift + click): songs or playlists -->
        <views:SelectionBar List="{Binding ElementName=RecentList}" Panel.ZIndex="1"/>
        <views:SelectionBar List="{Binding ElementName=PlaylistList}" Panel.ZIndex="1"/>
        <views:SelectionBar List="{Binding ElementName=AddedList}" Panel.ZIndex="1"/>
    </Grid>
</UserControl>
