<UserControl x:Class="UltimateMP3Player.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UltimateMP3Player"
             xmlns:vm="clr-namespace:UltimateMP3Player.ViewModels"
             xmlns:views="clr-namespace:UltimateMP3Player.Views">
    <Grid>
        <Border Height="260" VerticalAlignment="Top" Background="{DynamicResource HeaderGradient}" Opacity="0.55" IsHitTestVisible="False"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="28,12,20,28">
                <TextBlock Text="{Binding Greeting}" FontSize="30" FontWeight="Bold" Margin="0,4,0,22"/>

                <!-- December to mid January: the year's recap -->
                <Border CornerRadius="16" Padding="24,20" Margin="0,0,8,26" Cursor="Hand" Background="{DynamicResource AccentGradient}"
                        TextElement.Foreground="{DynamicResource OnAccentBrush}" Visibility="{Binding HasRecap, Converter={StaticResource BoolVis}}">
                    <Border.InputBindings>
                        <MouseBinding Gesture="LeftClick" Command="{Binding OpenRecapCommand}"/>
                    </Border.InputBindings>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" CornerRadius="20" Padding="20,10" Background="{DynamicResource OnAccentBrush}" VerticalAlignment="Center">
                            <TextBlock Text="{local:T Open}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock DockPanel.Dock="Left" Text="&#xE787;" Style="{StaticResource Glyph}" FontSize="34" Margin="0,0,20,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{local:T RECAP}" FontSize="12" FontWeight="Bold" Opacity="0.85"/>
                            <TextBlock Text="{Binding RecapTitle}" FontSize="24" FontWeight="Bold" Margin="0,2,0,2" TextWrapping="Wrap"/>
                            <TextBlock Text="{local:T 'Your songs, your artists, your minutes: page after page, like stories.'}" Opacity="0.9" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- first run -->
                <Border Style="{StaticResource Card}" Padding="28" Margin="0,0,8,24" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="{StaticResource LogoImage}" Width="96" Height="96" VerticalAlignment="Top"/>
                        <StackPanel Grid.Column="1" Margin="24,0,0,0">
                            <TextBlock Text="{local:T 'Your music, offline and ad-free'}" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Style="{StaticResource Hint}" FontSize="14" LineHeight="21" Margin="0,8,0,16"
                                       Text="{local:T 'Paste the link to a song or playlist in the bar at the top (YouTube Music, Spotify, SoundCloud, YouTube, TikTok, Instagram and almost any other site): it gets downloaded and saved here. You can also add music you already have on your computer, or drag files into the window.'}"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryButton}" Padding="18,10"
                                        Command="{Binding DataContext.PasteLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE77F;" Style="{StaticResource Glyph}"/>
                                        <TextBlock Text="{local:T 'Paste a link'}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Padding="18,10" Margin="10,0,0,0"
                                        Command="{Binding DataContext.ImportCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8E5;" Style="{StaticResource Glyph}"/>
                                        <TextBlock Text="{local:T 'Add files from your computer'}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- card grids end 8 px before the right margin, level with the welcome card: same space left and right -->
                <StackPanel Visibility="{Binding HasRecent, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{local:T 'Recently played'}" Style="{StaticResource SectionTitle}"/>
                    <ListBox x:Name="RecentList" Style="{StaticResource BareList}" ItemsSource="{Binding Recent}" ItemTemplate="{StaticResource TrackCard}"
                             ItemsPanel="{StaticResource CardGridTemplate}" Margin="0,0,8,30"/>
                </StackPanel>

                <!-- for you: mixes made from what you listen to -->
                <StackPanel Visibility="{Binding HasForYou, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{local:T 'For you'}" Style="{StaticResource SectionTitle}"/>
                    <ItemsControl ItemsSource="{Binding ForYou}" ItemTemplate="{StaticResource MixCard}" ItemsPanel="{StaticResource CardGridTemplate}" Margin="0,0,8,30"/>
                </StackPanel>

                <!-- the followed artists' new releases: one row, the rest on the Artists page -->
                <StackPanel Visibility="{Binding Artists.HasReleases, Converter={StaticResource BoolVis}}">
                    <DockPanel LastChildFill="False" Margin="0,0,8,0">
                        <TextBlock Text="{local:T 'New releases'}" Style="{StaticResource SectionTitle}"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="{local:T 'Show all|f'}" VerticalAlignment="Center"
                                Command="{Binding DataContext.GoArtistsCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Artists.Releases}" ItemTemplate="{StaticResource ReleaseCard}" Margin="0,0,8,30">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <views:CardGrid MaxRows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <!-- the saved radios: one row, the rest on the Radio page -->
                <StackPanel Visibility="{Binding Stations.HasSaved, Converter={StaticResource BoolVis}}">
                    <DockPanel LastChildFill="False" Margin="0,0,8,0">
                        <TextBlock Text="{local:T 'Your radios'}" Style="{StaticResource SectionTitle}"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="{local:T 'Show all|f'}" VerticalAlignment="Center"
                                Command="{Binding DataContext.GoStationsCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Stations.Saved}" ItemTemplate="{StaticResource StationCard}" Margin="0,0,8,30">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <views:CardGrid MaxRows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <TextBlock Text="{local:T 'Your playlists'}" Style="{StaticResource SectionTitle}"/>
                <ListBox x:Name="PlaylistList" Style="{StaticResource BareList}" ItemsSource="{Binding PlaylistCards}" ItemsPanel="{StaticResource CardGridTemplate}"
                         Margin="0,0,8,30">
                    <ListBox.Resources>
                        <DataTemplate DataType="{x:Type vm:PlaylistViewModel}">
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource PlaylistCard}"/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:NewPlaylistCard}">
                            <Border CornerRadius="12" Cursor="Hand" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1.5">
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.NewPlaylistCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </Border.InputBindings>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="26" HorizontalAlignment="Center" Foreground="{DynamicResource SubTextBrush}"/>
                                    <TextBlock Text="{local:T 'New playlist'}" Margin="0,10,0,0" Foreground="{DynamicResource SubTextBrush}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </DataTemplate>
                    </ListBox.Resources>
                </ListBox>

                <StackPanel Visibility="{Binding HasRecentlyAdded, Converter={StaticResource BoolVis}}">
                    <DockPanel LastChildFill="False" Margin="0,0,8,0">
                        <TextBlock Text="{local:T 'Recently added'}" Style="{StaticResource SectionTitle}"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="{local:T 'Show all'}" VerticalAlignment="Center"
                                Command="{Binding DataContext.GoLibraryCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </DockPanel>
                    <ListBox x:Name="AddedList" Style="{StaticResource BareList}" ItemsSource="{Binding RecentlyAdded}" ItemTemplate="{StaticResource TrackRowTemplate}"
                             Margin="0,0,8,0"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <!-- what's selected in one of the lists (Ctrl or Shift + click): songs or playlists -->
        <views:SelectionBar List="{Binding ElementName=RecentList}" Panel.ZIndex="1"/>
        <views:SelectionBar List="{Binding ElementName=PlaylistList}" Panel.ZIndex="1"/>
        <views:SelectionBar List="{Binding ElementName=AddedList}" Panel.ZIndex="1"/>
    </Grid>
</UserControl>
