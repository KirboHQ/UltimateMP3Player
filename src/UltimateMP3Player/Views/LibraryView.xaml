<UserControl x:Class="UltimateMP3Player.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UltimateMP3Player"
             xmlns:views="clr-namespace:UltimateMP3Player.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.RowSpan="2" Background="{DynamicResource HeaderGradient}" Opacity="0.55" IsHitTestVisible="False"/>

        <Grid Margin="28,8,28,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="148" Height="148" CornerRadius="10" Background="{DynamicResource AccentGradient}">
                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="56" Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Bottom">
                <TextBlock Text="{Binding Kicker}" Style="{StaticResource SmallCaps}" Foreground="{StaticResource SubTextBrush}"/>
                <TextBlock Text="{Binding Title}" FontSize="40" FontWeight="Bold" Margin="0,2,0,6"/>
                <TextBlock Text="{Binding CountText}" Foreground="{StaticResource SubTextBrush}"/>
                <TextBlock Text="{Binding Hint}" Style="{StaticResource Hint}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <DockPanel Grid.Row="1" Margin="28,0,28,14" LastChildFill="False">
            <Button Style="{StaticResource BigPlayButton}" Content="&#xE768;" Command="{Binding PlayCommand}" ToolTip="{local:T Riproduci}"
                    AutomationProperties.Name="{local:T 'Riproduci tutto'}"/>
            <Button Style="{StaticResource BigPlayButton}" Width="46" Height="46" FontSize="17" Content="&#xE8B1;" Margin="12,0,0,0"
                    Command="{Binding ShuffleCommand}" ToolTip="{local:T 'Riproduci in ordine casuale'}" AutomationProperties.Name="{local:T 'Riproduci in ordine casuale'}"/>
            <Button Style="{StaticResource GhostButton}" Margin="14,0,0,0" Padding="16,9"
                    Command="{Binding DataContext.ImportCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    ToolTip="{local:T 'Aggiungi alla libreria brani che hai già sul computer'}"
                    Visibility="{Binding Unsorted, Converter={StaticResource InvBoolVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8E5;" Style="{StaticResource Glyph}"/>
                    <TextBlock Text="{local:T 'Aggiungi file'}" Margin="8,0,0,0"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource GhostButton}" Margin="10,0,0,0" Padding="16,9" Click="SelectAll_Click"
                    Visibility="{Binding IsEmpty, Converter={StaticResource InvBoolVis}}" ToolTip="Ctrl+A">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8B3;" Style="{StaticResource Glyph}"/>
                    <TextBlock Text="{local:T 'Seleziona tutti'}" Margin="8,0,0,0"/>
                </StackPanel>
            </Button>
            <ComboBox DockPanel.Dock="Right" Width="180" ItemsSource="{Binding Sorts}" SelectedItem="{Binding Sort}" VerticalAlignment="Center"
                      ToolTip="{local:T 'Ordina per'}"/>
            <TextBox DockPanel.Dock="Right" Style="{StaticResource FilterBox}" Width="210" Margin="0,0,10,0" VerticalAlignment="Center"
                     Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Tag="{local:T 'Cerca nei brani'}" KeyDown="Filter_KeyDown"
                     AutomationProperties.Name="{local:T 'Cerca nei brani'}"/>
        </DockPanel>

        <Grid Grid.Row="2" Margin="20,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ContentPresenter ContentTemplate="{StaticResource TrackHeader}" Margin="0,0,10,0"/>
            <ListBox x:Name="List" Grid.Row="1" Style="{StaticResource PlainList}" ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource TrackRowTemplate}"/>
            <views:SelectionBar Grid.Row="1" List="{Binding ElementName=List}" Panel.ZIndex="1"/>
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,50,0,0" MaxWidth="480"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding EmptyTitle}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Hint}" Margin="0,8,0,0" TextAlignment="Center"/>
            </StackPanel>
            <TextBlock Grid.Row="1" Text="{local:T 'Nessun brano corrisponde alla ricerca.'}" Style="{StaticResource Hint}" FontSize="14"
                       HorizontalAlignment="Center" Margin="0,40,0,0" Visibility="{Binding NoMatches, Converter={StaticResource BoolVis}}"/>
        </Grid>
    </Grid>
</UserControl>
