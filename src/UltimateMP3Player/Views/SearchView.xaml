<UserControl x:Class="UltimateMP3Player.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UltimateMP3Player"
             xmlns:vm="clr-namespace:UltimateMP3Player.ViewModels"
             xmlns:views="clr-namespace:UltimateMP3Player.Views">
    <UserControl.Resources>
        <!-- a site filter over the online results: coloured dot, name, how many -->
        <Style x:Key="ServiceChip" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="0,0,8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="15" Height="30" Padding="12,0" Background="{DynamicResource Surface2Brush}"
                                BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface3Brush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- a song found online: the whole row is the button (it opens the download, as a pasted link) -->
        <Style x:Key="HitRow" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Padding="8,6" Margin="0,0,10,1" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,6,12,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="8,0,10,14">
            <!-- your songs / the music sites -->
            <Border DockPanel.Dock="Right" Margin="16,0,0,0" CornerRadius="20" Padding="4" Background="{DynamicResource SurfaceBrush}" VerticalAlignment="Center"
                    BorderBrush="Transparent" BorderThickness="1" Visibility="{Binding OnlineEnabled, Converter={StaticResource BoolVis}}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segment}" GroupName="SearchTabs" local:Ui.Glyph="&#xE8F1;" Content="{Binding LocalTabText}"
                                 IsChecked="{Binding LocalMode, Mode=OneWay}" Command="{Binding ShowLocalCommand}"/>
                    <RadioButton Style="{StaticResource Segment}" GroupName="SearchTabs" local:Ui.Glyph="&#xE774;" Content="{Binding OnlineTabText}" Margin="4,0,0,0"
                                 IsChecked="{Binding OnlineMode, Mode=OneWay}" Command="{Binding ShowOnlineCommand}"
                                 ToolTip="{local:T 'Songs found on YouTube Music, SoundCloud, YouTube and Deezer: click one to download it'}"/>
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <!-- ============================================================ your songs -->
        <Grid Grid.Row="1" Visibility="{Binding LocalMode, Converter={StaticResource BoolVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="8,0,0,6" Visibility="{Binding HasPlaylists, Converter={StaticResource BoolVis}}">
                <TextBlock Text="PLAYLIST" Style="{StaticResource SmallCaps}" Margin="0,0,0,10"/>
                <ItemsControl ItemsSource="{Binding PlaylistResults}" ItemTemplate="{StaticResource PlaylistCard}" Margin="0,0,10,12">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <views:CardGrid MaxRows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>

            <ContentPresenter Grid.Row="1" ContentTemplate="{StaticResource TrackHeader}" Margin="0,0,10,0"/>
            <ListBox x:Name="List" Grid.Row="2" Style="{StaticResource PlainList}" ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource TrackRowTemplate}"/>
            <views:SelectionBar Grid.Row="2" List="{Binding ElementName=List}" Panel.ZIndex="1"/>
            <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                        Visibility="{Binding NoResults, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{local:T 'No results'}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding LocalEmptyHint}" Style="{StaticResource Hint}" Margin="0,8,0,0" TextAlignment="Center" MaxWidth="460"/>
            </StackPanel>
        </Grid>

        <!-- ============================================================ online -->
        <Grid Grid.Row="1" Visibility="{Binding OnlineMode, Converter={StaticResource BoolVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="8,0,10,8" MinHeight="36">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                    <Ellipse Style="{StaticResource Spinner}" Width="14" Height="14" StrokeThickness="2.5" Margin="0,0,8,0" VerticalAlignment="Center"
                             Visibility="{Binding OnlineBusy, Converter={StaticResource BoolVis}}"/>
                    <TextBlock Text="{Binding OnlineStatus}" Style="{StaticResource Hint}" FontSize="12" VerticalAlignment="Center" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                    <Button Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="13" Content="&#xE713;" Margin="6,0,0,0"
                            Command="{Binding OnlineSettingsCommand}" ToolTip="{local:T 'Which sites to search and in what order (Settings)'}"
                            AutomationProperties.Name="{local:T 'Online search settings'}"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding ServiceTabs}" Focusable="False" Visibility="{Binding HasServiceTabs, Converter={StaticResource BoolVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ServiceTab}">
                            <Button Style="{StaticResource ServiceChip}" CommandParameter="{Binding}"
                                    Command="{Binding DataContext.SelectServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{Binding Brush}" Margin="0,0,7,0" VerticalAlignment="Center"
                                             Visibility="{Binding HasDot, Converter={StaticResource BoolVis}}"/>
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Count}" Foreground="{DynamicResource MutedBrush}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>

            <ListBox Grid.Row="1" Style="{StaticResource PlainList}" ItemsSource="{Binding OnlineHits}" AutomationProperties.Name="{local:T 'Online results'}">
                <ListBox.Resources>
                    <!-- the playlist named as the words: a big card first, so it's clear it's a whole playlist -->
                    <DataTemplate DataType="{x:Type vm:FeaturedHitViewModel}">
                        <Button x:Name="RowButton" Style="{StaticResource HitRow}" Command="{Binding DownloadCommand}" Margin="0,0,0,8"
                                AutomationProperties.Name="{Binding Title}"
                                ToolTip="{local:T 'Open it to choose its songs and the playlist to save them in'}" ToolTipService.InitialShowDelay="1200">
                            <Border x:Name="Card" CornerRadius="12" Padding="12" Background="{DynamicResource SurfaceBrush}">
                                <Grid local:Marquee.Host="True">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="112" Height="112">
                                        <Border CornerRadius="8" Background="{DynamicResource PlaceholderGradient}">
                                            <TextBlock Text="&#xE8FD;" Style="{StaticResource Glyph}" FontSize="30" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                                        </Border>
                                        <Border CornerRadius="8">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="20,0,12,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8FD;" Style="{StaticResource Glyph}" FontSize="12" Foreground="{DynamicResource AccentTextBrush}"/>
                                            <TextBlock Text="{Binding Kind}" FontSize="12.5" FontWeight="Bold" Margin="7,0,0,0" Foreground="{DynamicResource AccentTextBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold" Margin="0,4,0,6" TextTrimming="CharacterEllipsis" local:Marquee.IsEnabled="True"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Fill="{Binding ServiceBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Service}" FontSize="12.5" Margin="6,0,10,0" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Details}" FontSize="12.5" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border x:Name="Get" Grid.Column="2" CornerRadius="17" Height="34" Padding="16,0" Margin="14,0,4,0" VerticalAlignment="Center"
                                            Background="{DynamicResource Surface3Brush}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="GetIcon" Text="&#xE896;" Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource SubTextBrush}"/>
                                            <TextBlock x:Name="GetText" Text="{local:T 'Download|verb'}" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0"
                                                       Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </Button>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="RowButton" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                <Setter TargetName="Get" Property="Background" Value="{DynamicResource AccentGradient}"/>
                                <Setter TargetName="GetIcon" Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
                                <Setter TargetName="GetText" Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:OnlineHitViewModel}">
                        <Button x:Name="RowButton" Style="{StaticResource HitRow}" Command="{Binding DownloadCommand}"
                                PreviewMouseLeftButtonDown="Hit_MouseDown" PreviewMouseMove="Hit_MouseMove" MouseRightButtonUp="Hit_RightClick"
                                ToolTip="{local:T 'Open it to download it: choose the playlist and press Download'}" ToolTipService.InitialShowDelay="1200">
                            <Grid x:Name="Row" local:Marquee.Host="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="48" Height="48">
                                    <Border CornerRadius="6" Background="{DynamicResource PlaceholderGradient}">
                                        <TextBlock Text="&#xEC4F;" Style="{StaticResource Glyph}" FontSize="17" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                                    </Border>
                                    <Border CornerRadius="6">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" local:Marquee.IsEnabled="True"/>
                                    <DockPanel Margin="0,2,0,0">
                                        <Border DockPanel.Dock="Left" CornerRadius="7" Padding="6,0" Margin="0,0,8,0" Background="{DynamicResource SuccessSoftBrush}" VerticalAlignment="Center"
                                                Visibility="{Binding InLibrary, Converter={StaticResource BoolVis}}" ToolTip="{local:T 'You already have it in your library'}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="9" Foreground="{DynamicResource SuccessBrush}"/>
                                                <TextBlock Text="{local:T 'in library'}" FontSize="11" FontWeight="SemiBold" Margin="4,0,0,1" Foreground="{DynamicResource SuccessBrush}"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis"
                                                   local:Marquee.IsEnabled="True"/>
                                    </DockPanel>
                                </StackPanel>
                                <Border Grid.Column="2" CornerRadius="10" Padding="8,2,9,2" Background="{DynamicResource Surface3Brush}" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="{Binding ServiceBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Service}" FontSize="11.5" Margin="6,0,0,0" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Grid.Column="3" Text="{Binding DurationText}" FontSize="12.5" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                                <Border x:Name="Get" Grid.Column="4" CornerRadius="15" Height="30" Padding="13,0" Margin="14,0,4,0" VerticalAlignment="Center"
                                        Background="{DynamicResource Surface3Brush}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="GetIcon" Text="&#xE896;" Style="{StaticResource Glyph}" FontSize="12" Foreground="{DynamicResource SubTextBrush}"/>
                                        <TextBlock x:Name="GetText" Text="{local:T 'Download|verb'}" FontSize="12.5" FontWeight="SemiBold" Margin="7,0,0,0"
                                                   Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Button>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="RowButton" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Get" Property="Background" Value="{DynamicResource AccentGradient}"/>
                                <Setter TargetName="GetIcon" Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
                                <Setter TargetName="GetText" Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.Resources>
            </ListBox>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0" MaxWidth="460"
                        Visibility="{Binding NoOnlineResults, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding NoOnlineText}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock Text="{local:T 'Try the title and the artist, or paste the song\'s link directly.'}" Style="{StaticResource Hint}"
                           Margin="0,8,0,0" TextAlignment="Center"/>
            </StackPanel>
            <!-- the Spotify tab without a key (or with one Spotify refuses): what it takes, and the way to Settings -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0" MaxWidth="480"
                        Visibility="{Binding ShowSpotifySetup, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{local:T 'Search Spotify too'}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding SpotifySetupText}" Style="{StaticResource Hint}" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
                <Button Style="{StaticResource PrimaryButton}" Content="{local:T 'Set it up in Settings'}" Command="{Binding SpotifySettingsCommand}"
                        HorizontalAlignment="Center" Margin="0,18,0,0"/>
            </StackPanel>
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,48,0,0" Orientation="Horizontal"
                        Visibility="{Binding ShowSearching, Converter={StaticResource BoolVis}}">
                <Ellipse Style="{StaticResource Spinner}" Width="20" Height="20" StrokeThickness="3"/>
                <TextBlock Text="{local:T 'Searching online…'}" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
