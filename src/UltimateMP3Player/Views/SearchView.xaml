<UserControl x:Class="UltimateMP3Player.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UltimateMP3Player"
             xmlns:vm="clr-namespace:UltimateMP3Player.ViewModels"
             xmlns:views="clr-namespace:UltimateMP3Player.Views">
    <UserControl.Resources>
        <!-- a site filter over the online results: coloured dot, name, how many -->
        <Style x:Key="ServiceChip" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="0,0,8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="15" Height="30" Padding="12,0" Background="{StaticResource Surface2Brush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface3Brush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- a song found online: the whole row is the button (it opens the download, as a pasted link) -->
        <Style x:Key="HitRow" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Padding="8,6" Margin="0,0,10,1" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,6,12,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="8,0,10,14">
            <!-- your songs / the music sites -->
            <Border DockPanel.Dock="Right" Margin="16,0,0,0" CornerRadius="20" Padding="4" Background="{StaticResource SurfaceBrush}" VerticalAlignment="Center"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Visibility="{Binding OnlineEnabled, Converter={StaticResource BoolVis}}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segment}" GroupName="SearchTabs" local:Ui.Glyph="&#xE8F1;" Content="{Binding LocalTabText}"
                                 IsChecked="{Binding LocalMode, Mode=OneWay}" Command="{Binding ShowLocalCommand}"/>
                    <RadioButton Style="{StaticResource Segment}" GroupName="SearchTabs" local:Ui.Glyph="&#xE774;" Content="{Binding OnlineTabText}" Margin="4,0,0,0"
                                 IsChecked="{Binding OnlineMode, Mode=OneWay}" Command="{Binding ShowOnlineCommand}"
                                 ToolTip="{local:T 'Brani trovati su YouTube Music, SoundCloud, YouTube e Deezer: cliccane uno per scaricarlo'}"/>
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <!-- ============================================================ your songs -->
        <Grid Grid.Row="1" Visibility="{Binding LocalMode, Converter={StaticResource BoolVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="8,0,0,6" Visibility="{Binding HasPlaylists, Converter={StaticResource BoolVis}}">
                <TextBlock Text="PLAYLIST" Style="{StaticResource SmallCaps}" Margin="0,0,0,10"/>
                <ItemsControl ItemsSource="{Binding PlaylistResults}" ItemTemplate="{StaticResource PlaylistCard}" Margin="0,0,10,12">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <views:CardGrid MaxRows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>

            <ContentPresenter Grid.Row="1" ContentTemplate="{StaticResource TrackHeader}" Margin="0,0,10,0"/>
            <ListBox x:Name="List" Grid.Row="2" Style="{StaticResource PlainList}" ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource TrackRowTemplate}"/>
            <views:SelectionBar Grid.Row="2" List="{Binding ElementName=List}" Panel.ZIndex="1"/>
            <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                        Visibility="{Binding NoResults, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{local:T 'Nessun risultato'}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding LocalEmptyHint}" Style="{StaticResource Hint}" Margin="0,8,0,0" TextAlignment="Center" MaxWidth="460"/>
            </StackPanel>
        </Grid>

        <!-- ============================================================ online -->
        <Grid Grid.Row="1" Visibility="{Binding OnlineMode, Converter={StaticResource BoolVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="8,0,10,8" MinHeight="36">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                    <Ellipse Style="{StaticResource Spinner}" Width="14" Height="14" StrokeThickness="2.5" Margin="0,0,8,0" VerticalAlignment="Center"
                             Visibility="{Binding OnlineBusy, Converter={StaticResource BoolVis}}"/>
                    <TextBlock Text="{Binding OnlineStatus}" Style="{StaticResource Hint}" FontSize="12" VerticalAlignment="Center" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                    <Button Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="13" Content="&#xE713;" Margin="6,0,0,0"
                            Command="{Binding OnlineSettingsCommand}" ToolTip="{local:T 'Siti in cui cercare e in che ordine (Impostazioni)'}"
                            AutomationProperties.Name="{local:T 'Impostazioni della ricerca online'}"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding ServiceTabs}" Focusable="False" Visibility="{Binding HasServiceTabs, Converter={StaticResource BoolVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ServiceTab}">
                            <Button Style="{StaticResource ServiceChip}" CommandParameter="{Binding}"
                                    Command="{Binding DataContext.SelectServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{Binding Brush}" Margin="0,0,7,0" VerticalAlignment="Center"
                                             Visibility="{Binding HasDot, Converter={StaticResource BoolVis}}"/>
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Count}" Foreground="{StaticResource MutedBrush}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>

            <ListBox Grid.Row="1" Style="{StaticResource PlainList}" ItemsSource="{Binding OnlineHits}" AutomationProperties.Name="{local:T 'Risultati online'}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:OnlineHitViewModel}">
                        <Button x:Name="RowButton" Style="{StaticResource HitRow}" Command="{Binding DownloadCommand}"
                                ToolTip="{local:T 'Aprilo per scaricarlo: scegli la playlist e premi Scarica'}" ToolTipService.InitialShowDelay="1200">
                            <Grid local:Marquee.Host="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="48" Height="48">
                                    <Border CornerRadius="6" Background="{StaticResource PlaceholderGradient}">
                                        <TextBlock Text="&#xEC4F;" Style="{StaticResource Glyph}" FontSize="17" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                                    </Border>
                                    <Border CornerRadius="6">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" local:Marquee.IsEnabled="True"/>
                                    <DockPanel Margin="0,2,0,0">
                                        <Border DockPanel.Dock="Left" CornerRadius="7" Padding="6,0" Margin="0,0,8,0" Background="#1E3A2F" VerticalAlignment="Center"
                                                Visibility="{Binding InLibrary, Converter={StaticResource BoolVis}}" ToolTip="{local:T 'Ce l\'hai già nella libreria'}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="9" Foreground="{StaticResource SuccessBrush}"/>
                                                <TextBlock Text="{local:T 'nella libreria'}" FontSize="11" FontWeight="SemiBold" Margin="4,0,0,1" Foreground="{StaticResource SuccessBrush}"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Foreground="{StaticResource SubTextBrush}" TextTrimming="CharacterEllipsis"
                                                   local:Marquee.IsEnabled="True"/>
                                    </DockPanel>
                                </StackPanel>
                                <Border Grid.Column="2" CornerRadius="10" Padding="8,2,9,2" Background="{StaticResource Surface3Brush}" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="{Binding ServiceBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Service}" FontSize="11.5" Margin="6,0,0,0" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Grid.Column="3" Text="{Binding DurationText}" FontSize="12.5" Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                                <Border x:Name="Get" Grid.Column="4" CornerRadius="15" Height="30" Padding="13,0" Margin="14,0,4,0" VerticalAlignment="Center"
                                        Background="{StaticResource Surface3Brush}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="GetIcon" Text="&#xE896;" Style="{StaticResource Glyph}" FontSize="12" Foreground="{StaticResource SubTextBrush}"/>
                                        <TextBlock x:Name="GetText" Text="{local:T Scarica}" FontSize="12.5" FontWeight="SemiBold" Margin="7,0,0,0"
                                                   Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Button>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="RowButton" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Get" Property="Background" Value="{DynamicResource AccentGradient}"/>
                                <Setter TargetName="GetIcon" Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
                                <Setter TargetName="GetText" Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0" MaxWidth="460"
                        Visibility="{Binding NoOnlineResults, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding NoOnlineText}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock Text="{local:T 'Prova con il titolo e l\'artista, oppure incolla direttamente il link del brano.'}" Style="{StaticResource Hint}"
                           Margin="0,8,0,0" TextAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,48,0,0" Orientation="Horizontal">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding OnlineBusy}" Value="True"/>
                                    <Condition Binding="{Binding OnlineHits.Count}" Value="0"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Ellipse Style="{StaticResource Spinner}" Width="20" Height="20" StrokeThickness="3"/>
                <TextBlock Text="{local:T 'Cerco online…'}" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
