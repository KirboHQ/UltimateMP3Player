<UserControl x:Class="UltimateMP3Player.Views.PlaylistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UltimateMP3Player"
             xmlns:views="clr-namespace:UltimateMP3Player.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.RowSpan="2" Background="{DynamicResource HeaderGradient}" Opacity="0.55" IsHitTestVisible="False"/>

        <Grid Margin="28,8,28,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Width="172" Height="172">
                <Grid.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.5" Color="Black"/>
                </Grid.Effect>
                <ContentPresenter Content="{Binding Vm}" ContentTemplate="{StaticResource PlaylistCover}"/>
                <Button x:Name="CoverButton" Style="{StaticResource SubtleButton}" Padding="0" Command="{Binding CoverCommand}" Opacity="0"
                        ToolTip="{local:T 'Cambia immagine'}" Background="#99000000" Foreground="White">
                    <StackPanel>
                        <TextBlock Text="&#xEB9F;" Style="{StaticResource Glyph}" FontSize="30" HorizontalAlignment="Center"/>
                        <TextBlock Text="{local:T 'Cambia immagine'}" Margin="0,8,0,0" FontSize="12.5"/>
                    </StackPanel>
                </Button>
            </Grid>
            <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Bottom">
                <TextBlock Text="PLAYLIST" Style="{StaticResource SmallCaps}" Foreground="{StaticResource SubTextBrush}"/>
                <TextBlock Text="{Binding Vm.Name}" FontSize="40" FontWeight="Bold" Margin="0,2,0,6" TextTrimming="CharacterEllipsis" Cursor="Hand"
                           MouseLeftButtonUp="Name_Click" ToolTip="{local:T 'Clicca per rinominare'}"/>
                <TextBlock Text="{Binding Vm.TotalText}" Foreground="{StaticResource SubTextBrush}"/>
                <!-- the playlist's own tags -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <ItemsControl ItemsSource="{Binding Vm.Tags}" ItemTemplate="{StaticResource TagChip}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <Button Style="{StaticResource SubtleButton}" Padding="9,3" FontSize="12.5" Click="PlaylistTags_Click" VerticalAlignment="Center"
                            ToolTip="{local:T 'Tag della playlist, e come metterli sui suoi brani'}" AutomationProperties.Name="{local:T 'Tag della playlist'}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8EC;" Style="{StaticResource Glyph}" FontSize="12"/>
                            <TextBlock Text="{local:T 'Tag…'}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <DockPanel Grid.Row="1" Margin="28,0,28,14" LastChildFill="False">
            <Button DockPanel.Dock="Right" Style="{StaticResource TagFilterButton}" Margin="10,0,0,0" Click="TagFilter_Click"/>
            <TextBox DockPanel.Dock="Right" Style="{StaticResource FilterBox}" Width="260" VerticalAlignment="Center"
                     Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Tag="{local:T 'Cerca nella playlist'}" KeyDown="Filter_KeyDown"
                     AutomationProperties.Name="{local:T 'Cerca nella playlist'}"/>
            <Button Style="{StaticResource BigPlayButton}" Content="&#xE768;" Command="{Binding PlayCommand}" ToolTip="{local:T Riproduci}"
                    AutomationProperties.Name="{local:T 'Riproduci tutto'}"/>
            <Button Style="{StaticResource BigPlayButton}" Width="46" Height="46" FontSize="17" Content="&#xE8B1;" Margin="12,0,0,0"
                    Command="{Binding ShuffleCommand}" ToolTip="{local:T 'Riproduci in ordine casuale'}" AutomationProperties.Name="{local:T 'Riproduci in ordine casuale'}"/>
            <Button Style="{StaticResource ControlButton}" Content="&#xE712;" Margin="10,0,0,0" Click="More_Click" ToolTip="{local:T 'Altre opzioni'}"
                    Visibility="{Binding Vm.IsFavorites, Converter={StaticResource InvBoolVis}}"/>
        </DockPanel>

        <Grid Grid.Row="2" Margin="20,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ContentPresenter ContentTemplate="{StaticResource TrackHeader}" Margin="0,0,10,0"/>
            <ListBox x:Name="List" Grid.Row="1" Style="{StaticResource PlainList}" ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource TrackRowTemplate}"
                     AllowDrop="True" DragOver="List_DragOver" DragLeave="List_DragLeave" Drop="List_Drop"/>
            <views:SelectionBar Grid.Row="1" List="{Binding ElementName=List}" Panel.ZIndex="1"/>
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,50,0,0" MaxWidth="460"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{local:T 'La playlist è vuota'}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Hint}" Margin="0,8,0,0" TextAlignment="Center"/>
            </StackPanel>
            <TextBlock Grid.Row="1" Text="{local:T 'Nessun brano della playlist corrisponde alla ricerca.'}" Style="{StaticResource Hint}" FontSize="14"
                       HorizontalAlignment="Center" Margin="0,40,0,0" Visibility="{Binding NoMatches, Converter={StaticResource BoolVis}}"/>
        </Grid>
    </Grid>
</UserControl>
