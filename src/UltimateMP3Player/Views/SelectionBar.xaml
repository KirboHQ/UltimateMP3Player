<UserControl x:Class="UltimateMP3Player.Views.SelectionBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UltimateMP3Player"
             Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16">
    <UserControl.RenderTransform>
        <TranslateTransform x:Name="Shift"/>
    </UserControl.RenderTransform>
    <Border CornerRadius="14" Padding="16,8,8,8" Background="{StaticResource Surface3Brush}" BorderBrush="{StaticResource BorderStrongBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.55" Color="Black"/>
        </Border.Effect>
        <!-- the actions depend on what's selected (songs, songs of "next up", downloads, playlists): built in code -->
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="CountText" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
            <StackPanel x:Name="Buttons" Orientation="Horizontal"/>
            <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11" Margin="6,0,0,0" Click="Clear_Click"
                    ToolTip="{local:T 'Deseleziona (Esc)'}" AutomationProperties.Name="{local:T Deseleziona}"/>
        </StackPanel>
    </Border>
</UserControl>
