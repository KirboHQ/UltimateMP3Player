<Window x:Class="UltimateMP3Player.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UltimateMP3Player"
        xmlns:vm="clr-namespace:UltimateMP3Player.ViewModels"
        xmlns:views="clr-namespace:UltimateMP3Player.Views"
        Title="Ultimate MP3 Player" Width="1280" Height="820" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{StaticResource TitleBarBrush}"
        Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}" FontSize="14"
        AllowDrop="True" UseLayoutRounding="True" Icon="/app.ico">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}"><views:HomeView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LibraryViewModel}"><views:LibraryView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaylistPageViewModel}"><views:PlaylistView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SearchViewModel}"><views:SearchView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DownloadsPageViewModel}"><views:DownloadsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:NowPlayingViewModel}"><views:NowPlayingView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DjViewModel}"><views:DjView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:TogetherViewModel}"><views:TogetherView/></DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============================================================ title bar -->
        <Grid Background="{StaticResource TitleBarBrush}">
            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                <Image Source="{StaticResource LogoImage}" Width="16" Height="16"/>
                <TextBlock Text="Ultimate MP3 Player" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SubTextBrush}" Margin="9,0,0,1"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="MinButton" Style="{StaticResource TitleBarButton}" Content="&#xE921;" ToolTip="{local:T 'Riduci a icona'}"
                        AutomationProperties.Name="{local:T 'Riduci a icona'}"/>
                <Button x:Name="MaxButton" Style="{StaticResource TitleBarButton}" Content="&#xE922;" AutomationProperties.Name="{local:T 'Ingrandisci'}"/>
                <Button x:Name="CloseButton" Style="{StaticResource TitleBarCloseButton}" Content="&#xE8BB;" ToolTip="{local:T Chiudi}"
                        AutomationProperties.Name="{local:T Chiudi}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Background="{StaticResource BgBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ======================================================== sidebar -->
            <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <!-- the menu keeps its size; below it the playlists get 2/3 of what is left and the tags 1/3, so both shrink with the window -->
                <Grid Margin="14,14,14,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*" MinHeight="60"/>
                        <RowDefinition Height="*" MinHeight="44"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <RadioButton Style="{StaticResource NavButton}" local:Ui.Glyph="&#xE80F;" Content="{local:T Home}" IsChecked="{Binding IsHome}"/>
                        <RadioButton Style="{StaticResource NavButton}" local:Ui.Glyph="&#xE8F1;" Content="{local:T 'Tutti i brani'}" IsChecked="{Binding IsLibrary}"/>
                        <RadioButton Style="{StaticResource NavButton}" local:Ui.Glyph="&#xE8B7;" Content="{local:T 'Senza playlist'}" IsChecked="{Binding IsUnsorted}"
                                     ToolTip="{local:T 'Brani che non sono in nessuna playlist'}"/>
                        <RadioButton Style="{StaticResource NavButton}" local:Ui.Glyph="&#xE896;" IsChecked="{Binding IsDownloads}"
                                     AutomationProperties.Name="{local:T Download}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{local:T Download}"/>
                                <Border Margin="8,0,0,0" CornerRadius="9" MinWidth="18" Height="18" Padding="5,0" Background="{DynamicResource AccentGradient}"
                                        Visibility="{Binding Queue.HasActive, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="{Binding Queue.ActiveCount}" FontSize="11" Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavButton}" local:Ui.Glyph="&#xE8D6;" Content="DJ" IsChecked="{Binding IsDj}"
                                     ToolTip="{local:T 'Mixa due brani: tempo, pitch, taglio e volume'}"/>
                        <RadioButton Style="{StaticResource NavButton}" local:Ui.Glyph="&#xE716;" IsChecked="{Binding IsTogether}"
                                     AutomationProperties.Name="{local:T 'Ascolta insieme'}" ToolTip="{local:T 'Ascolta la stessa musica con gli amici, sulla stessa rete'}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{local:T 'Ascolta insieme'}"/>
                                <!-- in a room: how many are listening -->
                                <Border Margin="8,0,0,0" CornerRadius="9" MinWidth="18" Height="18" Padding="5,0" Background="{StaticResource SuccessBrush}"
                                        Visibility="{Binding Together.InRoom, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="{Binding Together.MemberCount}" FontSize="11" FontWeight="Bold" Foreground="#0E1014" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavButton}" local:Ui.Glyph="&#xE713;" Content="{local:T Impostazioni}" IsChecked="{Binding IsSettings}"/>
                    </StackPanel>

                    <!-- profile -->
                    <Button Grid.Row="3" Style="{StaticResource SubtleButton}" Padding="8,8" HorizontalContentAlignment="Stretch"
                            Command="{Binding SwitchProfileCommand}" ToolTip="{local:T 'Cambia o gestisci i profili'}" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="32" Height="32">
                                <Ellipse Fill="{Binding ProfileBrush}"/>
                                <TextBlock Text="{Binding ProfileInitial}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Ellipse Margin="2.5" Visibility="{Binding ProfileAvatar, Converter={StaticResource NotNullVis}}">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding ProfileAvatar}" Stretch="UniformToFill"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ProfileName}" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{local:T 'Cambia profilo'}" FontSize="11.5" FontWeight="Normal" Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="&#xE748;" Style="{StaticResource Glyph}" Foreground="{StaticResource MutedBrush}"/>
                        </Grid>
                    </Button>

                    <!-- tags: each one opens the page of its songs; songs can be dropped on them -->
                    <DockPanel Grid.Row="2" Margin="0,6,0,0">
                        <DockPanel DockPanel.Dock="Top" Margin="8,6,0,4">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="13" Content="&#xE710;"
                                    Command="{Binding NewTagCommand}" ToolTip="{local:T 'Nuovo tag'}" AutomationProperties.Name="{local:T 'Nuovo tag'}"/>
                            <TextBlock Text="{local:T TAG}" Style="{StaticResource SmallCaps}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{local:T 'Etichette colorate per raggruppare brani e playlist a modo tuo.'}" Style="{StaticResource Hint}"
                                   FontSize="12" Margin="8,0,8,4" TextWrapping="Wrap" Visibility="{Binding HasTags, Converter={StaticResource InvBoolVis}}"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                            <ItemsControl ItemsSource="{Binding Tags}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:TagViewModel}">
                                        <Border x:Name="Item" CornerRadius="8" Padding="10,7" Background="Transparent" Cursor="Hand" AllowDrop="True"
                                                Drop="Tag_Drop" DragOver="Playlist_DragOver" DragLeave="Playlist_DragLeave" MouseRightButtonUp="Tag_RightClick"
                                                ToolTip="{Binding CountText}" local:Marquee.Host="True">
                                            <Border.InputBindings>
                                                <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.OpenTagCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              CommandParameter="{Binding}"/>
                                            </Border.InputBindings>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                                <Ellipse Width="10" Height="10" Fill="{Binding Brush}" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="Name" Text="{Binding Name}" Margin="11,0,8,0" FontSize="13.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" local:Marquee.IsEnabled="True"/>
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="Item" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Item" Property="Background" Value="{StaticResource RowHoverBrush}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="Item" Property="Background" Value="{StaticResource Surface2Brush}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>

                    <DockPanel Grid.Row="1">
                    <DockPanel DockPanel.Dock="Top" Margin="8,22,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="13" Content="&#xE710;"
                                Command="{Binding NewPlaylistCommand}" ToolTip="{local:T 'Nuova playlist'}"/>
                        <TextBlock Text="{local:T 'LE TUE PLAYLIST'}" Style="{StaticResource SmallCaps}" VerticalAlignment="Center"/>
                    </DockPanel>

                    <ListBox x:Name="PlaylistList" Style="{StaticResource PlainList}" ItemsSource="{Binding Playlists}"
                             SelectionChanged="PlaylistList_SelectionChanged" AutomationProperties.Name="Playlist">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PlaylistViewModel}">
                                <Border x:Name="Item" CornerRadius="8" Padding="6" Background="Transparent" Cursor="Hand" AllowDrop="True"
                                        Drop="Playlist_Drop" DragOver="Playlist_DragOver" DragLeave="Playlist_DragLeave"
                                        MouseRightButtonUp="Playlist_RightClick" local:Marquee.Host="True">
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.OpenPlaylistCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter Width="42" Height="42" Content="{Binding}" ContentTemplate="{StaticResource PlaylistCover}"/>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="Name" Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="13.5" local:Marquee.IsEnabled="True"/>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="&#xE995;" Style="{StaticResource Glyph}" Foreground="{DynamicResource AccentTextBrush}"
                                                   FontSize="12" Margin="6,0,2,0" Visibility="{Binding IsPlayingFrom, Converter={StaticResource BoolVis}}"/>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Item" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Item" Property="Background" Value="{StaticResource RowHoverBrush}"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="Item" Property="Background" Value="{StaticResource Surface2Brush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsPlayingFrom}" Value="True">
                                        <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- ======================================================== content -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="20,12,20,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource ControlButton}" Content="&#xE72B;" Command="{Binding BackCommand}" AutomationProperties.Name="{local:T Indietro}"
                            ToolTip="{local:T Indietro}" Margin="0,0,10,0"/>

                    <Border x:Name="SearchPill" Grid.Column="1" Height="44" CornerRadius="22" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="16,0,4,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SearchIcon" Text="&#xE721;" Style="{StaticResource Glyph}" Foreground="{StaticResource SubTextBrush}" FontSize="15"/>
                            <TextBox x:Name="SearchBox" AutomationProperties.Name="{local:T Cerca}" Grid.Column="1" Style="{StaticResource BareTextBox}" Margin="12,0,6,0"
                                     Tag="{local:T 'Cerca nei tuoi brani, oppure incolla un link da scaricare (YouTube, Spotify, SoundCloud, TikTok…)'}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     GotKeyboardFocus="Search_Focus" LostKeyboardFocus="Search_Focus" KeyDown="Search_KeyDown"/>
                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="11" Content="&#xE711;"
                                    Command="{Binding ClearSearchCommand}" ToolTip="{local:T Cancella}"
                                    Visibility="{Binding HasSearchText, Converter={StaticResource BoolVis}}"/>
                            <Button Grid.Column="3" Style="{StaticResource PillPrimaryButton}" Margin="4,0,0,0"
                                    Command="{Binding SubmitSearchCommand}" AutomationProperties.Name="{local:T 'Scarica link'}"
                                    Visibility="{Binding IsLink, Converter={StaticResource BoolVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" FontSize="13"/>
                                    <TextBlock Text="{local:T Scarica}" Margin="7,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Height="44" Padding="18,0"
                            Command="{Binding PasteLinkCommand}" ToolTip="{local:T 'Incolla un link dagli appunti e scaricalo'}"
                            AutomationProperties.Name="{local:T 'Incolla link'}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77F;" Style="{StaticResource Glyph}" FontSize="14"/>
                            <TextBlock Text="{local:T 'Incolla link'}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <StackPanel Grid.Row="1" Margin="20,0,20,0">
                    <Border Margin="0,0,0,8" CornerRadius="10" Padding="14,8" Background="{StaticResource WarningSoftBrush}"
                            Visibility="{Binding Host.EngineStatus, Converter={StaticResource NotNullVis}, FallbackValue=Collapsed}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" Foreground="{StaticResource WarningBrush}"/>
                            <TextBlock Text="{Binding Host.EngineStatus}" Margin="10,0,0,0" Foreground="{StaticResource WarningBrush}" FontSize="13"/>
                        </StackPanel>
                    </Border>
                    <Border Margin="0,0,0,8" CornerRadius="10" Padding="14,6,6,6" Background="{DynamicResource AccentSoftBrush}"
                            Visibility="{Binding Host.Updates.IsReady, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Padding="12,5" Content="{local:T 'Riavvia ora'}"
                                    Command="{Binding Host.RestartToUpdateCommand}"/>
                            <TextBlock Text="&#xE777;" Style="{StaticResource Glyph}" Foreground="{DynamicResource AccentTextBrush}"/>
                            <TextBlock Text="{Binding Host.Updates.ReadyText}" Margin="10,0,10,0" VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <views:AnimatedContent Grid.Row="2" Content="{Binding Page}"/>

                <!-- toast -->
                <Border x:Name="ToastBox" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18" CornerRadius="10"
                        Padding="16,10" Background="{StaticResource Surface3Brush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                        Visibility="{Binding ToastText, Converter={StaticResource NotNullVis}}" IsHitTestVisible="False" MaxWidth="640">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.45" Color="Black"/>
                    </Border.Effect>
                    <TextBlock Text="{Binding ToastText}" TextWrapping="Wrap"/>
                </Border>
            </Grid>
        </Grid>

        <!-- ============================================================ player bar -->
        <Border Grid.Row="2" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="14,10" DataContext="{Binding Player}"
                Visibility="{Binding DataContext.ShowPlayerBar, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="220" MaxWidth="360"/>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="3*" MinWidth="220" MaxWidth="340"/>
                </Grid.ColumnDefinitions>

                <!-- now playing -->
                <Grid VerticalAlignment="Center" Visibility="{Binding ShowNowPlaying, Converter={StaticResource BoolVis}}"
                      MouseRightButtonUp="Current_RightClick" Background="Transparent" local:Marquee.Host="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource SubtleButton}" Padding="0" Width="58" Height="58"
                            Command="{Binding DataContext.GoNowPlayingCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="{local:T 'Apri la schermata del brano'}"
                            AutomationProperties.Name="{local:T 'Apri la schermata del brano'}">
                        <ContentPresenter Width="58" Height="58" Content="{Binding Current}" ContentTemplate="{StaticResource TrackCoverSmall}"/>
                    </Button>
                    <StackPanel Grid.Column="1" Margin="12,0,6,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Current.Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" local:Marquee.IsEnabled="True"/>
                        <TextBlock Text="{Binding Current.Artist}" FontSize="12.5" Foreground="{StaticResource SubTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" local:Marquee.IsEnabled="True"/>
                        <!-- in a room: which one (green dot), a click opens it -->
                        <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,3,0,0" FontSize="11.5" Command="{Binding OpenRoomCommand}"
                                Visibility="{Binding InRoom, Converter={StaticResource BoolVis}}" ToolTip="{local:T 'Sei in una stanza di Ascolta insieme: aprila'}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding RoomName}" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="HeartButton" AutomationProperties.Name="{local:T Preferiti}" Style="{StaticResource ControlButton}" Command="{Binding FavoriteCommand}"
                                ToolTip="{local:T Preferiti}">
                            <TextBlock x:Name="HeartGlyph" FontFamily="{StaticResource IconFont}" FontSize="15">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xEB51;"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Current.IsFavorite}" Value="True">
                                                <Setter Property="Text" Value="&#xEB52;"/>
                                                <Setter Property="Foreground" Value="{DynamicResource PinkBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <Button Style="{StaticResource ControlButton}" Content="&#xE710;" Click="AddCurrentToPlaylist_Click" AutomationProperties.Name="{local:T 'Aggiungi a playlist'}"
                                ToolTip="{local:T 'Aggiungi a una playlist'}"/>
                        <!-- automatic queue: lit = "next up" refills itself at every song (in a room the room's queue rules) -->
                        <ToggleButton Style="{StaticResource ToggleIcon}" Content="&#xE90B;" IsChecked="{Binding AutoQueue}"
                                      ToolTip="{Binding AutoQueueTip}" AutomationProperties.Name="{local:T 'Coda automatica'}"
                                      Visibility="{Binding InRoom, Converter={StaticResource InvBoolVis}}"/>
                    </StackPanel>
                </Grid>

                <!-- transport + waveform -->
                <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <!-- in a room shuffle and repeat don't apply (dimmed); prev/play/next need the host's permission (greyed out, the tooltip says why) -->
                        <ToggleButton Style="{StaticResource ToggleIcon}" Content="&#xE8B1;" IsChecked="{Binding Shuffle}" AutomationProperties.Name="{local:T Casuale}"
                                      ToolTip="{local:T 'Riproduzione casuale'}" IsEnabled="{Binding NotInRoom}"/>
                        <Button Style="{StaticResource ControlButton}" Content="&#xE892;" Command="{Binding PreviousCommand}" AutomationProperties.Name="{local:T Precedente}"
                                Margin="8,0,0,0" ToolTip="{Binding PreviousTip}" ToolTipService.ShowOnDisabled="True"/>
                        <Button Style="{StaticResource PlayButton}" Content="{Binding PlayGlyph}" Command="{Binding PlayPauseCommand}"
                                AutomationProperties.Name="{local:T 'Riproduci/Pausa'}" Margin="12,0" ToolTip="{Binding PlayTip}" ToolTipService.ShowOnDisabled="True"/>
                        <Button Style="{StaticResource ControlButton}" Content="&#xE893;" Command="{Binding NextCommand}" AutomationProperties.Name="{local:T Successivo}"
                                Margin="0,0,8,0" ToolTip="{Binding NextTip}" ToolTipService.ShowOnDisabled="True"/>
                        <ToggleButton Style="{StaticResource ToggleIcon}" Content="{Binding RepeatGlyph}" AutomationProperties.Name="{local:T Ripeti}"
                                      IsChecked="{Binding RepeatOn, Mode=OneWay}" Command="{Binding CycleRepeatCommand}" ToolTip="{Binding RepeatTip}"/>
                    </StackPanel>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="44"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding PositionText}" FontSize="11.5" Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <views:WaveformBar Grid.Column="1" Height="30" Peaks="{Binding Current.Wave}" Progress="{Binding Progress}"
                                           IsPlaying="{Binding IsPlaying}" Duration="{Binding Duration}"
                                           PlayedBrush="{DynamicResource ProgressGradient}" RestBrush="{StaticResource WaveBrush}"
                                           SeekCommand="{Binding SeekCommand}" ToolTip="{Binding SeekTip}"/>
                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="11.5" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                </StackPanel>

                <!-- right side -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ToggleButton Style="{StaticResource PillToggle}" IsChecked="{Binding DataContext.IsNowPlaying, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Command="{Binding DataContext.GoNowPlayingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  ToolTip="{local:T 'Video e successivi'}" AutomationProperties.Name="{local:T 'Video e successivi'}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE714;" VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE8FD;" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                    </ToggleButton>
                    <Button Style="{StaticResource ControlButton}" Content="&#xE9E9;" ToolTip="{local:T Equalizzatore}" AutomationProperties.Name="{local:T Equalizzatore}"
                            Command="{Binding DataContext.GoSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="4,0,0,0"/>
                    <Button Style="{StaticResource ControlButton}" Content="{Binding VolumeGlyph}" AutomationProperties.Name="{local:T Muto}" Command="{Binding ToggleMuteCommand}"
                            Margin="4,0,0,0" ToolTip="{local:T Muto}"/>
                    <Slider Width="110" Minimum="0" Maximum="1" Value="{Binding Volume}" Margin="4,0,0,0" VerticalAlignment="Center"
                            SmallChange="0.02" LargeChange="0.1" PreviewMouseWheel="Volume_Wheel" ToolTip="{local:T Volume}" AutomationProperties.Name="{local:T Volume}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
