<Window x:Class="UltimateMP3Player.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UltimateMP3Player"
        xmlns:vm="clr-namespace:UltimateMP3Player.ViewModels"
        xmlns:views="clr-namespace:UltimateMP3Player.Views"
        Title="Ultimate MP3 Player" Width="1280" Height="820" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource TitleBarBrush}"
        Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource UiFont}" FontSize="14"
        AllowDrop="True" UseLayoutRounding="True" Icon="/app.ico">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}"><views:HomeView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LibraryHubViewModel}"><views:LibraryHubView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LibraryViewModel}"><views:LibraryView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaylistsPageViewModel}"><views:PlaylistsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaylistPageViewModel}"><views:PlaylistView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SearchViewModel}"><views:SearchView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:NowPlayingViewModel}"><views:NowPlayingView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DjViewModel}"><views:DjView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:TogetherViewModel}"><views:TogetherView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:StatsViewModel}"><views:StatsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ArtistsViewModel}"><views:ArtistsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:StationsViewModel}"><views:StationsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ArtistPageViewModel}"><views:ArtistView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RecapViewModel}"><views:RecapView/></DataTemplate>

        <!-- back and forward in the title bar: dimmed when there's nowhere to go -->
        <Style x:Key="TitleNavButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- a preset of the speed: lit when it's the speed playing -->
        <Style x:Key="SpeedPresetButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="0,6"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- a small heading inside the player bar's panels -->
        <Style x:Key="PanelHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
        </Style>

        <!-- the playback panel's button: its icon, and the speed when it isn't the normal one -->
        <Style x:Key="PlaybackToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="18" Background="Transparent" Padding="9,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface3Brush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface3Brush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============================================================ title bar -->
        <Grid x:Name="TitleBar" Background="{DynamicResource TitleBarBrush}">
            <!-- back and forward (the pages' history), like a browser's; the mouse's side buttons and Alt+arrows do the same -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Style="{StaticResource TitleNavButton}" Content="&#xE72B;" Command="{Binding BackCommand}" ToolTip="{local:T 'Back (Alt+←)'}"
                        AutomationProperties.Name="{local:T Back}"/>
                <Button Style="{StaticResource TitleNavButton}" Command="{Binding ForwardCommand}" ToolTip="{local:T 'Forward (Alt+→)'}"
                        AutomationProperties.Name="{local:T Forward}">
                    <TextBlock Text="&#xE72B;" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <ScaleTransform ScaleX="-1"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="94,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                <Image Source="{StaticResource LogoImage}" Width="16" Height="16"/>
                <TextBlock Text="Ultimate MP3 Player" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" Margin="9,0,0,1"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="MinButton" Style="{StaticResource TitleBarButton}" Content="&#xE921;" ToolTip="{local:T Minimize}"
                        AutomationProperties.Name="{local:T Minimize}"/>
                <Button x:Name="MaxButton" Style="{StaticResource TitleBarButton}" Content="&#xE922;" AutomationProperties.Name="{local:T Maximize}"/>
                <Button x:Name="CloseButton" Style="{StaticResource TitleBarCloseButton}" Content="&#xE8BB;" ToolTip="{local:T Close}"
                        AutomationProperties.Name="{local:T Close}"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="Body" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ======================================================== sidebar -->
            <!-- no line against the page: its own tone is enough -->
            <Border x:Name="Sidebar" Background="{DynamicResource SidebarBrush}">
                <!-- the pages (Ctrl+1…5, Ctrl+↑/↓); the playlists take what is left; the tags (folded under their heading if you like);
                     the profile and the settings -->
                <Grid Margin="14,12,14,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="60"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <!-- the open page's pill, gliding with the page -->
                        <views:SlidingPill Target="{Binding ElementName=NavPanel}" Fill="{DynamicResource Surface2Brush}"/>
                        <StackPanel x:Name="NavPanel">
                            <RadioButton Style="{StaticResource NavButton}" local:Ui.Glyph="&#xE80F;" Content="{local:T Home}" IsChecked="{Binding IsHome}"
                                         ToolTip="{local:T 'Home (Ctrl+1)'}"/>
                            <RadioButton Style="{StaticResource NavButton}" local:Ui.Glyph="&#xE721;" IsChecked="{Binding IsSearch}"
                                         AutomationProperties.Name="{local:T Search}"
                                         ToolTip="{local:T 'Search your songs and online, or paste a link to download (Ctrl+2)'}">
                                <DockPanel>
                                    <!-- downloads going on -->
                                    <Border DockPanel.Dock="Right" CornerRadius="9" MinWidth="18" Height="18" Padding="5,0" Background="{DynamicResource AccentGradient}"
                                            Visibility="{Binding Queue.HasActive, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="{Binding Queue.ActiveCount}" FontSize="11" Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{local:T Search}"/>
                                </DockPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavButton}" local:Ui.Glyph="&#xE8F1;" IsChecked="{Binding IsLibraryNav}"
                                         AutomationProperties.Name="{local:T Library}" ToolTip="{local:T 'Your songs, playlists, artists and radios (Ctrl+3)'}">
                                <DockPanel>
                                    <!-- the followed artists' new releases not seen yet -->
                                    <Border DockPanel.Dock="Right" CornerRadius="9" MinWidth="18" Height="18" Padding="5,0" Background="{DynamicResource AccentGradient}"
                                            Visibility="{Binding HasNewReleases, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="{Binding NewReleases}" FontSize="11" Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{local:T Library}"/>
                                </DockPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavButton}" local:Ui.Glyph="&#xE716;" IsChecked="{Binding IsTogether}"
                                         AutomationProperties.Name="{local:T 'Listen together'}" ToolTip="{local:T 'Listen together (Ctrl+4)'}">
                                <DockPanel>
                                    <!-- in a room -->
                                    <Ellipse DockPanel.Dock="Right" Width="8" Height="8" Margin="0,0,4,0" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center"
                                             Visibility="{Binding Together.InRoom, Converter={StaticResource BoolVis}}"/>
                                    <TextBlock Text="{local:T 'Listen together'}" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavButton}" local:Ui.Glyph="&#xE8D6;" Content="DJ" IsChecked="{Binding IsDj}"
                                         ToolTip="{local:T 'DJ: mix two songs (tempo, pitch, trim and volume) (Ctrl+5)'}"/>
                        </StackPanel>
                    </Grid>

                    <DockPanel Grid.Row="1">
                        <DockPanel DockPanel.Dock="Top" Margin="8,18,0,6">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="13" Content="&#xE710;"
                                    Command="{Binding NewPlaylistCommand}" ToolTip="{local:T 'New playlist'}"/>
                            <TextBlock Text="{local:T 'YOUR PLAYLISTS'}" Style="{StaticResource SmallCaps}" VerticalAlignment="Center"/>
                        </DockPanel>

                    <ListBox x:Name="PlaylistList" Style="{StaticResource PlainList}" ItemsSource="{Binding Playlists}"
                             SelectionChanged="PlaylistList_SelectionChanged" AutomationProperties.Name="Playlist">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PlaylistViewModel}">
                                <Border x:Name="Item" CornerRadius="12" Padding="6" Background="Transparent" Cursor="Hand" AllowDrop="True"
                                        Drop="Playlist_Drop" DragOver="Playlist_DragOver" DragLeave="Playlist_DragLeave"
                                        MouseRightButtonUp="Playlist_RightClick" local:Marquee.Host="True">
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.OpenPlaylistCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter Width="42" Height="42" Content="{Binding}" ContentTemplate="{StaticResource PlaylistCover}"/>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="Name" Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="13.5" local:Marquee.IsEnabled="True"/>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding DeviceGlyph}" Style="{StaticResource Glyph}" FontSize="10.5" Foreground="{DynamicResource MutedBrush}"
                                                           Margin="0,0,5,0" VerticalAlignment="Center" Visibility="{Binding HasDevice, Converter={StaticResource BoolVis}}"/>
                                                <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="&#xE995;" Style="{StaticResource Glyph}" Foreground="{DynamicResource AccentTextBrush}"
                                                   FontSize="12" Margin="6,0,2,0" Visibility="{Binding IsPlayingFrom, Converter={StaticResource BoolVis}}"/>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Item" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Item" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="Item" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsPlayingFrom}" Value="True">
                                        <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    </DockPanel>

                    <!-- tags: each one opens the page of its songs; songs can be dropped on them. A click on the heading folds them. -->
                    <DockPanel Grid.Row="2" Margin="0,4,0,0">
                        <DockPanel DockPanel.Dock="Top" Margin="0,6,0,4">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="13" Content="&#xE710;"
                                    Command="{Binding NewTagCommand}" ToolTip="{local:T 'New tag'}" AutomationProperties.Name="{local:T 'New tag'}"/>
                            <Button Style="{StaticResource SubtleButton}" Padding="8,4" HorizontalAlignment="Left" Command="{Binding ToggleTagsCommand}"
                                    ToolTip="{local:T 'Show or hide the tags'}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{local:T TAGS}" Style="{StaticResource SmallCaps}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding TagsChevron}" Style="{StaticResource Glyph}" FontSize="9" Margin="7,0,0,0" Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </Button>
                        </DockPanel>
                        <Border DockPanel.Dock="Top" Visibility="{Binding TagsOpen, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{local:T 'Colored labels to group songs and playlists your way.'}" Style="{StaticResource Hint}"
                                       FontSize="12" Margin="8,0,8,4" TextWrapping="Wrap" Visibility="{Binding HasTags, Converter={StaticResource InvBoolVis}}"/>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" MaxHeight="190"
                                      Visibility="{Binding TagsOpen, Converter={StaticResource BoolVis}}">
                            <ItemsControl ItemsSource="{Binding Tags}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:TagViewModel}">
                                        <Border x:Name="Item" CornerRadius="17" Padding="12,7" Background="Transparent" Cursor="Hand" AllowDrop="True"
                                                Drop="Tag_Drop" DragOver="Playlist_DragOver" DragLeave="Playlist_DragLeave" MouseRightButtonUp="Tag_RightClick"
                                                ToolTip="{Binding CountText}" local:Marquee.Host="True">
                                            <Border.InputBindings>
                                                <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.OpenTagCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              CommandParameter="{Binding}"/>
                                            </Border.InputBindings>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding DeviceGlyph}" Style="{StaticResource Glyph}" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                                           Margin="0,0,6,0" VerticalAlignment="Center" Visibility="{Binding HasDevice, Converter={StaticResource BoolVis}}"/>
                                                <Ellipse Width="10" Height="10" Fill="{Binding Brush}" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="Name" Text="{Binding Name}" Margin="11,0,8,0" FontSize="13.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" local:Marquee.IsEnabled="True"/>
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="Item" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Item" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="Item" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- the profile; the settings -->
                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource SubtleButton}" Padding="6,6" HorizontalContentAlignment="Stretch"
                                Command="{Binding SwitchProfileCommand}" ToolTip="{local:T 'Switch or manage profiles'}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                            <Grid>
                                <!-- both devices' music (Connect phone): the other device's profile behind this one's -->
                                <Grid Width="26" Height="26" Margin="20,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                      Visibility="{Binding HasSecondProfile, Converter={StaticResource BoolVis}}">
                                    <Ellipse Fill="{Binding SecondBrush}"/>
                                    <TextBlock Text="{Binding SecondInitial}" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Ellipse Margin="2" Visibility="{Binding SecondAvatar, Converter={StaticResource NotNullVis}}">
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{Binding SecondAvatar}" Stretch="UniformToFill"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </Grid>
                                <Grid Width="32" Height="32" HorizontalAlignment="Left">
                                    <Ellipse Margin="-2" Fill="{DynamicResource SidebarBrush}" Visibility="{Binding HasSecondProfile, Converter={StaticResource BoolVis}}"/>
                                    <Ellipse Fill="{Binding ProfileBrush}"/>
                                    <TextBlock Text="{Binding ProfileInitial}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Ellipse Margin="2.5" Visibility="{Binding ProfileAvatar, Converter={StaticResource NotNullVis}}">
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{Binding ProfileAvatar}" Stretch="UniformToFill"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </Grid>
                            </Grid>
                                <TextBlock Grid.Column="1" Margin="9,0,0,0" Text="{Binding ProfileName}" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <RadioButton Grid.Column="1" Style="{StaticResource NavIconButton}" local:Ui.Glyph="&#xE713;" IsChecked="{Binding IsSettings}"
                                     VerticalAlignment="Center" AutomationProperties.Name="{local:T Settings}" ToolTip="{local:T 'Settings (Ctrl+,)'}"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ======================================================== content -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="1" Margin="20,0,20,0">
                    <Border Margin="0,10,0,0" CornerRadius="10" Padding="14,8" Background="{DynamicResource WarningSoftBrush}"
                            Visibility="{Binding Host.EngineStatus, Converter={StaticResource NotNullVis}, FallbackValue=Collapsed}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" Foreground="{DynamicResource WarningBrush}"/>
                            <TextBlock Text="{Binding Host.EngineStatus}" Margin="10,0,0,0" Foreground="{DynamicResource WarningBrush}" FontSize="13"/>
                        </StackPanel>
                    </Border>
                    <Border Margin="0,10,0,0" CornerRadius="10" Padding="14,6,6,6" Background="{DynamicResource AccentSoftBrush}"
                            Visibility="{Binding Host.Updates.IsReady, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Padding="12,5" Content="{local:T 'Restart now'}"
                                    Command="{Binding Host.RestartToUpdateCommand}"/>
                            <TextBlock Text="&#xE777;" Style="{StaticResource Glyph}" Foreground="{DynamicResource AccentTextBrush}"/>
                            <TextBlock Text="{Binding Host.Updates.ReadyText}" Margin="10,0,10,0" VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- the page: it slides in from where its entry is in the sidebar (AnimatedContent, MainViewModel.OrderOf) -->
                <views:AnimatedContent Grid.Row="2" Content="{Binding Shown}" KeepViews="True"/>

                <!-- up next popped out of the player bar (a click elsewhere or Esc folds it) -->
                <views:QueuePopup x:Name="QueuePanel" Grid.Row="1" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,20,16,12"
                                  Visibility="{Binding QueueOpen, Converter={StaticResource BoolVis}}"/>

                <!-- toast -->
                <Border x:Name="ToastBox" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18" CornerRadius="10"
                        Padding="16,10" Background="{DynamicResource PopupBrush}"
                        Visibility="{Binding ToastText, Converter={StaticResource NotNullVis}}" IsHitTestVisible="False" MaxWidth="640">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.45" Color="{DynamicResource PopupShadowColor}"/>
                    </Border.Effect>
                    <TextBlock Text="{Binding ToastText}" TextWrapping="Wrap"/>
                </Border>

                <!-- downloads going on, seen from any page: each group (a song, or the songs of a link) with how far it is and a
                     button that cancels it; a click opens the downloads (the search's page without words) -->
                <Border x:Name="DownloadPanel" Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,16" Width="320" CornerRadius="14" Padding="4"
                        Background="{DynamicResource PopupBrush}" Visibility="{Binding ShowDownloadPanel, Converter={StaticResource BoolVis}}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.45" Color="{DynamicResource PopupShadowColor}"/>
                    </Border.Effect>
                    <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Queue.Groups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DownloadGroupViewModel}">
                                    <Button Style="{StaticResource SubtleButton}" Padding="10,7,4,7" HorizontalContentAlignment="Stretch" Command="{Binding OpenCommand}"
                                            ToolTip="{local:T 'Open the downloads'}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" FontSize="15" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,5"/>
                                                <ProgressBar Value="{Binding Percent, Mode=OneWay}" IsIndeterminate="{Binding Indeterminate, Mode=OneWay}"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" Command="{Binding CancelCommand}" VerticalAlignment="Center"
                                                    ToolTip="{local:T 'Cancel the download'}" AutomationProperties.Name="{local:T 'Cancel the download'}"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- ============================================================ player bar -->
        <!-- (away while the DJ is the page, sliding down out of the window: MainWindow.SlideBar) -->
        <Border x:Name="PlayerBar" Grid.Row="2" Background="{DynamicResource SidebarBrush}"
                Padding="14,10" DataContext="{Binding Player}">
            <Grid x:Name="PlayerGrid" SizeChanged="PlayerBar_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="300" MaxWidth="400"/>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="3*" MinWidth="300" MaxWidth="400"/>
                </Grid.ColumnDefinitions>

                <!-- nothing playing: said, not an empty corner -->
                <Grid VerticalAlignment="Center" Visibility="{Binding ShowNothingPlaying, Converter={StaticResource BoolVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="58" Height="58" CornerRadius="8" Background="{DynamicResource Surface2Brush}">
                        <TextBlock Text="&#xEC4F;" Style="{StaticResource Glyph}" FontSize="22" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,6,0" VerticalAlignment="Center">
                        <TextBlock Text="{local:T 'Nothing playing'}" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{local:T 'Pick a song to start'}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>

                <!-- now playing -->
                <Grid VerticalAlignment="Center" Visibility="{Binding ShowNowPlaying, Converter={StaticResource BoolVis}}"
                      MouseRightButtonUp="Current_RightClick" Background="Transparent" local:Marquee.Host="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource SubtleButton}" Padding="0" Width="58" Height="58"
                            Command="{Binding DataContext.GoNowPlayingCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="{local:T 'Open song view'}"
                            AutomationProperties.Name="{local:T 'Open song view'}">
                        <ContentPresenter Width="58" Height="58" Content="{Binding Current}" ContentTemplate="{StaticResource TrackCoverSmall}"/>
                    </Button>
                    <StackPanel Grid.Column="1" Margin="12,0,6,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Current.Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" local:Marquee.IsEnabled="True"/>
                        <!-- the artist; before it the song's sign (the exception to Settings › Download: TrackViewModel.ShowSign) -->
                        <DockPanel Margin="0,2,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Current.SignGlyph}" FontFamily="{StaticResource IconFont}" FontSize="12"
                                       Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="{Binding Current.SignTip}"
                                       Visibility="{Binding Current.ShowSign, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Current.SignIsGone}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Current.Artist}" FontSize="12.5" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis" local:Marquee.IsEnabled="True"
                                       Cursor="Hand" MouseLeftButtonUp="Artist_Click" ToolTip="{local:T 'Go to the artist'}" ToolTipService.InitialShowDelay="900"/>
                        </DockPanel>
                        <!-- a suggested song still downloading (it starts by itself), or more of them on their way -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding IsWaiting, Converter={StaticResource BoolVis}}">
                            <Ellipse Style="{StaticResource Spinner}" Width="12" Height="12" StrokeThickness="1.5"/>
                            <TextBlock Text="{Binding WaitText}" FontSize="11.5" Foreground="{DynamicResource SubTextBrush}" Margin="7,0,0,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <!-- in a room: which one (green dot), a click opens it -->
                        <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,3,0,0" FontSize="11.5" Command="{Binding OpenRoomCommand}"
                                Visibility="{Binding InRoom, Converter={StaticResource BoolVis}}" ToolTip="{local:T 'You\'re in a Listen together room: open it'}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding RoomName}" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- a phone connected (Connect phone): which one, a spinner while it comes back; a click opens its window -->
                        <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,3,0,0" FontSize="11.5" Command="{Binding OpenPhoneCommand}"
                                Visibility="{Binding PhoneLinked, Converter={StaticResource BoolVis}}" ToolTip="{Binding PhoneTip}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center"
                                         Visibility="{Binding PhoneAway, Converter={StaticResource InvBoolVis}}"/>
                                <Ellipse Style="{StaticResource Spinner}" Width="9" Height="9" StrokeThickness="1.5" VerticalAlignment="Center"
                                         Visibility="{Binding PhoneAway, Converter={StaticResource BoolVis}}"/>
                                <TextBlock Text="&#xE8EA;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding PhoneName}" Margin="5,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <!-- the library icon for a song not in the library (in the cloud, a ring while it's saved); + = a playlist; the heart.
                         Saving a song of the library on the device is in its menu (right click). -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource ControlButton}" Command="{Binding SaveCurrentCommand}" ToolTip="{Binding Current.SaveTip}"
                                AutomationProperties.Name="{Binding Current.SaveTip}" Visibility="{Binding CanAddToLibrary, Converter={StaticResource BoolVis}}">
                            <Grid>
                                <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                           Visibility="{Binding Current.IsSaving, Converter={StaticResource InvBoolVis}, FallbackValue=Visible}"/>
                                <views:ProgressRing Width="18" Height="18" Value="{Binding Current.SavePct}" IsIndeterminate="{Binding Current.SaveIndeterminate}"
                                                    Stroke="{DynamicResource AccentBrush}" Track="{DynamicResource Surface3Brush}"
                                                    Visibility="{Binding Current.IsSaving, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource ControlButton}" Content="&#xE710;" Click="AddCurrentToPlaylist_Click" AutomationProperties.Name="{local:T 'Add to playlist'}"
                                ToolTip="{local:T 'Add to a playlist'}"/>
                        <Button x:Name="HeartButton" AutomationProperties.Name="{local:T Favorites}" Style="{StaticResource ControlButton}" Command="{Binding FavoriteCommand}"
                                ToolTip="{local:T Favorites}">
                            <TextBlock x:Name="HeartGlyph" FontFamily="{StaticResource IconFont}" FontSize="15">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xEB51;"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Current.IsFavorite}" Value="True">
                                                <Setter Property="Text" Value="&#xEB52;"/>
                                                <Setter Property="Foreground" Value="{DynamicResource PinkBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- transport + waveform -->
                <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <!-- in a room shuffle and repeat don't apply (dimmed); prev/play/next need the host's permission (greyed out, the tooltip says why) -->
                        <ToggleButton Style="{StaticResource ToggleIcon}" Content="&#xE8B1;" IsChecked="{Binding Shuffle}" AutomationProperties.Name="{local:T Shuffle}"
                                      ToolTip="{local:T Shuffle}" IsEnabled="{Binding NotInRoom}"/>
                        <Button Style="{StaticResource ControlButton}" Content="&#xE892;" Command="{Binding PreviousCommand}" AutomationProperties.Name="{local:T Previous}"
                                Margin="8,0,0,0" ToolTip="{Binding PreviousTip}" ToolTipService.ShowOnDisabled="True"/>
                        <Button Style="{StaticResource PlayButton}" Content="{Binding PlayGlyph}" Command="{Binding PlayPauseCommand}"
                                AutomationProperties.Name="{local:T 'Play/Pause'}" Margin="12,0" ToolTip="{Binding PlayTip}" ToolTipService.ShowOnDisabled="True"/>
                        <Button Style="{StaticResource ControlButton}" Content="&#xE893;" Command="{Binding NextCommand}" AutomationProperties.Name="{local:T Next}"
                                Margin="0,0,8,0" ToolTip="{Binding NextTip}" ToolTipService.ShowOnDisabled="True"/>
                        <ToggleButton Style="{StaticResource ToggleIcon}" Content="{Binding RepeatGlyph}" AutomationProperties.Name="{local:T Repeat}"
                                      IsChecked="{Binding RepeatOn, Mode=OneWay}" Command="{Binding CycleRepeatCommand}" ToolTip="{Binding RepeatTip}"/>
                    </StackPanel>
                    <Grid Margin="0,6,0,0" MinHeight="30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="44"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding PositionText}" FontSize="11.5" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Visibility="{Binding IsLive, Converter={StaticResource InvBoolVis}}"/>
                        <views:WaveformBar Grid.Column="1" Height="30" Peaks="{Binding Current.Wave}" Progress="{Binding Progress}"
                                           IsPlaying="{Binding Animate}" Duration="{Binding Duration}" Rate="{Binding Speed}"
                                           PlayedBrush="{DynamicResource ProgressGradient}" RestBrush="{DynamicResource WaveBrush}"
                                           SeekCommand="{Binding SeekCommand}" ToolTip="{Binding SeekTip}"
                                           Visibility="{Binding IsLive, Converter={StaticResource InvBoolVis}}"/>
                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="11.5" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Margin="8,0,0,0"
                                   Visibility="{Binding IsLive, Converter={StaticResource InvBoolVis}}"/>
                        <!-- a radio: nothing to seek, only that it's live -->
                        <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding IsLive, Converter={StaticResource BoolVis}}">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentGradient}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DurationText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" Margin="7,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- right side: how the queue goes on, the song view, the queue, the playback panel, the volume (the slider narrows on
                     small windows: MainWindow.PlayerBar_SizeChanged) -->
                <StackPanel x:Name="RightBlock" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- automatic queue: lit = "next up" refills itself at every song (in a room the room's queue rules) -->
                    <ToggleButton Style="{StaticResource ToggleIcon}" Content="&#xE90B;" IsChecked="{Binding AutoQueue}"
                                  ToolTip="{Binding AutoQueueTip}" AutomationProperties.Name="{local:T 'Automatic queue'}"
                                  Visibility="{Binding InRoom, Converter={StaticResource InvBoolVis}}"/>
                    <Border Width="1" Height="18" Margin="6,0" Background="{DynamicResource BorderBrush}" VerticalAlignment="Center"
                            Visibility="{Binding InRoom, Converter={StaticResource InvBoolVis}}"/>
                    <!-- the song view (video, lyrics, the big queue) -->
                    <ToggleButton Style="{StaticResource ToggleIcon}" Content="&#xE70E;"
                                  IsChecked="{Binding DataContext.IsNowPlaying, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Command="{Binding DataContext.GoNowPlayingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  ToolTip="{local:T 'Song view: video and lyrics'}" AutomationProperties.Name="{local:T 'Song view'}"/>
                    <!-- up next: popping out over the page (Views/QueuePopup), or the song view's big one when that's the page -->
                    <ToggleButton x:Name="QueueButton" Style="{StaticResource ToggleIcon}" Content="&#xE8FD;"
                                  IsChecked="{Binding DataContext.QueueShown, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Command="{Binding DataContext.ToggleQueueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  ToolTip="{local:T 'Up next'}" AutomationProperties.Name="{local:T 'Up next'}"/>
                    <!-- playback: speed, steady volume, crossfade, equalizer (in a room: the room's speed, with the permission) -->
                    <Grid Margin="2,0,0,0">
                        <ToggleButton x:Name="PlaybackButton" Style="{StaticResource PlaybackToggle}" ToolTip="{local:T 'Playback: speed, volume, crossfade, equalizer'}"
                                      IsChecked="{Binding IsOpen, ElementName=PlaybackPopup, Mode=TwoWay}"
                                      IsHitTestVisible="{Binding IsOpen, ElementName=PlaybackPopup, Converter={StaticResource Not}}"
                                      PreviewMouseWheel="Speed_Wheel" SizeChanged="PlayerBar_SizeChanged" AutomationProperties.Name="{local:T Playback}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9E9;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SpeedText}" FontSize="12.5" FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentTextBrush}" Visibility="{Binding IsSpeedChanged, Converter={StaticResource BoolVis}}"/>
                            </StackPanel>
                        </ToggleButton>
                        <Popup x:Name="PlaybackPopup" PlacementTarget="{Binding ElementName=PlaybackButton}" Placement="Top" StaysOpen="False"
                               AllowsTransparency="True" PopupAnimation="Fade" HorizontalOffset="-600" VerticalOffset="-6">
                            <!-- two columns: speed and volume on the left, the equalizer on the right -->
                            <Border Margin="10" Width="720" Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="18" Padding="22,18,22,18">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" Color="{DynamicResource PopupShadowColor}"/>
                                </Border.Effect>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="600" Focusable="False">
                                    <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="41"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{local:T Playback}" FontSize="17" FontWeight="Bold"/>

                                        <!-- speed, like YouTube's -->
                                        <DockPanel Margin="0,16,0,8">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding SpeedValueText}" FontWeight="Bold"/>
                                            <TextBlock Text="{local:T 'Playback speed'}" Style="{StaticResource PanelHeading}"/>
                                        </DockPanel>
                                        <StackPanel IsEnabled="{Binding CanSetSpeed}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Style="{StaticResource ControlButton}" Width="32" Height="32" FontSize="12" Content="&#xE738;"
                                                        Command="{Binding SpeedStepCommand}" CommandParameter="-0.05" ToolTip="{local:T Slower}"
                                                        AutomationProperties.Name="{local:T Slower}"/>
                                                <Slider Grid.Column="1" Style="{StaticResource KnobSlider}" Margin="6,0" Minimum="0.5" Maximum="2" Value="{Binding Speed}"
                                                        SmallChange="0.05" LargeChange="0.25" IsSnapToTickEnabled="True" TickFrequency="0.05" VerticalAlignment="Center"
                                                        PreviewMouseWheel="Speed_Wheel" AutomationProperties.Name="{local:T 'Playback speed'}"/>
                                                <Button Grid.Column="2" Style="{StaticResource ControlButton}" Width="32" Height="32" FontSize="12" Content="&#xE710;"
                                                        Command="{Binding SpeedStepCommand}" CommandParameter="0.05" ToolTip="{local:T Faster}"
                                                        AutomationProperties.Name="{local:T Faster}"/>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding SpeedPresets}" Margin="-3,10,-3,0" Focusable="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Rows="1"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:SpeedPreset}">
                                                        <Button Style="{StaticResource SpeedPresetButton}" Content="{Binding Label}" Command="{Binding Command}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <CheckBox Margin="0,12,0,0" IsChecked="{Binding SpeedPitch}" VerticalContentAlignment="Top">
                                                <StackPanel>
                                                    <TextBlock Text="{local:T 'Change the pitch too'}"/>
                                                    <TextBlock Text="{local:T 'Faster = higher, like a record spun faster.'}" Style="{StaticResource Hint}" FontSize="12"/>
                                                </StackPanel>
                                            </CheckBox>
                                        </StackPanel>
                                        <TextBlock Text="{Binding SpeedHint}" Style="{StaticResource Hint}" FontSize="12" Margin="0,8,0,0" Foreground="{DynamicResource MutedBrush}"
                                                   TextWrapping="Wrap"/>

                                        <Border Height="1" Margin="0,16" Background="{DynamicResource BorderBrush}"/>

                                        <!-- steady volume and crossfade (the same switches as in Settings › Playback) -->
                                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Normalize}" Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock Text="{local:T 'Normalize volume'}"/>
                                                <TextBlock Text="{local:T 'All songs at the same volume, even if they come from different sites.'}" Style="{StaticResource Hint}"
                                                           FontSize="12" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Main.Settings.Crossfade}">
                                            <StackPanel>
                                                <TextBlock Text="{local:T Crossfade}"/>
                                                <TextBlock Text="{local:T 'The next song fades in as the current one fades out, with no silence.'}" Style="{StaticResource Hint}"
                                                           FontSize="12" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <Grid Margin="0,10,0,0" Visibility="{Binding Main.Settings.Crossfade, Converter={StaticResource BoolVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{local:T Duration}" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="13"/>
                                            <Slider Grid.Column="1" Minimum="1" Maximum="12" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="1"
                                                    Value="{Binding Main.Settings.CrossfadeSeconds}" VerticalAlignment="Center"
                                                    AutomationProperties.Name="{local:T 'Crossfade duration'}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Main.Settings.CrossfadeText}" Margin="12,0,0,0" VerticalAlignment="Center" MinWidth="34" FontSize="13"/>
                                        </Grid>
                                    </StackPanel>

                                    <Border Grid.Column="1" Width="1" HorizontalAlignment="Center" Background="{DynamicResource BorderBrush}"/>

                                    <!-- the equalizer: the same one as in Settings, smaller -->
                                    <StackPanel Grid.Column="2">
                                        <StackPanel DataContext="{Binding Main.Settings.Equalizer}">
                                            <DockPanel>
                                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" VerticalAlignment="Center"
                                                          AutomationProperties.Name="{local:T Equalizer}"/>
                                                <TextBlock Text="{local:T Equalizer}" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <StackPanel IsEnabled="{Binding Enabled}" Margin="0,16,0,0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Opacity" Value="0.45"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <DockPanel Margin="0,0,0,10">
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Content="{local:T Reset}" Command="{Binding ResetCommand}"
                                                            Margin="8,0,0,0"/>
                                                    <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding Preset}" AutomationProperties.Name="Preset"/>
                                                </DockPanel>
                                                <Border CornerRadius="12" Background="{DynamicResource BgBrush}" Padding="6,10">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="120"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Border Height="1" Background="{DynamicResource BorderStrongBrush}" VerticalAlignment="Center" Margin="4,0"/>
                                                        <views:EqCurve Gains="{Binding Gains}" Version="{Binding CurveVersion}" Stroke="{DynamicResource AccentTextBrush}"
                                                                       IsHitTestVisible="False"/>
                                                        <ItemsControl ItemsSource="{Binding Bands}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <UniformGrid Rows="1"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type vm:EqBandViewModel}">
                                                                    <Slider Style="{StaticResource EqSlider}" Height="120" Value="{Binding Gain}" HorizontalAlignment="Center"
                                                                            PreviewMouseWheel="Eq_Wheel" MouseDoubleClick="Eq_DoubleClick" ToolTip="{Binding GainText}"
                                                                            AutomationProperties.Name="{Binding Label, StringFormat=Eq {0}}"/>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Bands}" Margin="0,6,0,0">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <UniformGrid Rows="1"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type vm:EqBandViewModel}">
                                                                    <TextBlock Text="{Binding Label}" FontSize="10.5" HorizontalAlignment="Center" Foreground="{DynamicResource SubTextBrush}"/>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Right" Margin="0,14,0,0" Click="PlaybackSettings_Click"
                                                Content="{local:T 'More in Settings'}"/>
                                    </StackPanel>
                                    </Grid>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <Button Style="{StaticResource ControlButton}" Content="{Binding VolumeGlyph}" AutomationProperties.Name="{local:T Mute}" Command="{Binding ToggleMuteCommand}"
                            Margin="2,0,0,0" ToolTip="{local:T Mute}"/>
                    <Slider x:Name="VolumeSlider" Width="110" Minimum="0" Maximum="1" Value="{Binding Volume}" Margin="4,0,0,0" VerticalAlignment="Center"
                            SmallChange="0.02" LargeChange="0.1" PreviewMouseWheel="Volume_Wheel" ToolTip="{local:T Volume}" AutomationProperties.Name="{local:T Volume}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ a .ump pack dragged over the window -->
        <Border x:Name="PackDrop" Grid.Row="1" Grid.RowSpan="2" Background="{DynamicResource VeilBrush}" IsHitTestVisible="False" Visibility="Collapsed">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border CornerRadius="24" Background="{DynamicResource SurfaceBrush}" Padding="48,32,48,30" MinWidth="360">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="34" ShadowDepth="8" Opacity="0.6" Color="{DynamicResource PopupShadowColor}"/>
                    </Border.Effect>
                    <StackPanel>
                        <Image Source="{StaticResource PackImage}" Width="104" Height="104" HorizontalAlignment="Center"/>
                        <TextBlock Text="{local:T 'Drop to import'}" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,18,0,4"/>
                        <TextBlock x:Name="PackDropName" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center" MaxWidth="420"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
                <Rectangle RadiusX="24" RadiusY="24" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeDashArray="5 3" Margin="8"/>
            </Grid>
        </Border>
    </Grid>
</Window>
