<Window x:Class="UltimateMP3Player.Views.ProfilePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UltimateMP3Player"
        xmlns:views="clr-namespace:UltimateMP3Player.Views"
        Title="Ultimate MP3 Player" Width="820" Height="600" MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource TitleBarBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14" UseLayoutRounding="True" Icon="/app.ico" ResizeMode="CanResize">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Background="{DynamicResource TitleBarBrush}">
            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                <Image Source="{StaticResource LogoImage}" Width="16" Height="16"/>
                <TextBlock Text="Ultimate MP3 Player" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" Margin="9,0,0,1"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <Button x:Name="CloseButton" Style="{StaticResource TitleBarCloseButton}" Content="&#xE8BB;" HorizontalAlignment="Right"
                    ToolTip="{local:T Close}" AutomationProperties.Name="{local:T Close}"/>
        </Grid>

        <Grid Grid.Row="1" Background="{DynamicResource BgBrush}">
            <Border Height="300" VerticalAlignment="Top" Background="{DynamicResource HeaderGradient}" Opacity="0.6"/>

            <!-- ======================================================== picker -->
            <Grid x:Name="PickerPanel" Margin="40,28,40,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel HorizontalAlignment="Center">
                    <Image Source="{StaticResource LogoImage}" Width="48" Height="48"/>
                    <TextBlock Text="{local:T 'Who\'s listening?'}" FontSize="30" FontWeight="Bold" Margin="0,14,0,4" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="SubTitle" Text="{local:T 'Each profile has its own playlists, favorites and equalizer.'}"
                               Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,28,0,0">
                    <ItemsControl x:Name="Tiles" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type views:ProfileTile}">
                                <Button x:Name="Tile" Width="150" Margin="8" Click="Tile_Click" AutomationProperties.Name="{Binding Name}" Cursor="Hand"
                                        FocusVisualStyle="{x:Null}" Foreground="{DynamicResource TextBrush}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Padding="12,14" CornerRadius="14" Background="Transparent">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel>
                                        <Grid Width="104" Height="104">
                                            <Ellipse Fill="{Binding Brush}"/>
                                            <TextBlock Text="{Binding Initial}" FontSize="42" FontWeight="Bold" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsAdd, Converter={StaticResource InvBoolVis}}"/>
                                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="34" Foreground="{DynamicResource SubTextBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsAdd, Converter={StaticResource BoolVis}}"/>
                                            <!-- the photo sits inside a ring of the profile colour -->
                                            <Ellipse Margin="5" Visibility="{Binding Avatar, Converter={StaticResource NotNullVis}}">
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <Ellipse x:Name="Ring" Stroke="White" StrokeThickness="3" Margin="-5" Opacity="0"/>
                                            <Button x:Name="Edit" Style="{StaticResource PlayButton}" Width="34" Height="34" FontSize="13" Content="&#xE70F;"
                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="Edit_Click" Opacity="0.85"
                                                    ToolTip="{local:T 'Edit or delete profile'}"
                                                    AutomationProperties.Name="{Binding Name, StringFormat={}{0} ✎}"
                                                    Visibility="{Binding IsAdd, Converter={StaticResource InvBoolVis}}"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" Margin="0,12,0,0" FontSize="15" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{local:T 'in use'}" HorizontalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource AccentTextBrush}"
                                                   Visibility="{Binding IsCurrent, Converter={StaticResource BoolVis}}"/>
                                    </StackPanel>
                                </Button>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Ring" Property="Opacity" Value="0.9"/>
                                        <Setter TargetName="Edit" Property="Opacity" Value="1"/>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <TextBlock Text="{local:T 'The pencil edits or deletes a profile.'}" Style="{StaticResource Hint}"
                               HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <CheckBox x:Name="Remember" HorizontalAlignment="Center" Content="{local:T 'Always start with the chosen profile'}"/>
                </StackPanel>
            </Grid>

            <!-- ======================================================== editor -->
            <Grid x:Name="EditPanel" Background="{DynamicResource VeilBrush}" Visibility="Collapsed">
                <Border Width="460" VerticalAlignment="Center" Style="{StaticResource Card}" Padding="26">
                    <StackPanel>
                        <TextBlock x:Name="EditTitle" FontSize="20" FontWeight="Bold" Margin="0,0,0,18"/>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="88" Height="88">
                                <Ellipse x:Name="EditColorDisc"/>
                                <TextBlock x:Name="EditInitial" FontSize="36" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Ellipse x:Name="EditAvatar" Margin="5"/>
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="PickAvatar_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xEB9F;" Style="{StaticResource Glyph}"/>
                                        <TextBlock Text="{local:T 'Choose a photo…'}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="RemoveAvatarButton" Style="{StaticResource LinkButton}" Content="{local:T 'Remove photo'}" Margin="4,10,0,0"
                                        HorizontalAlignment="Left" Click="RemoveAvatar_Click"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{local:T Name}" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="NameBox" Style="{StaticResource BoxTextBox}" TextChanged="NameBox_Changed" MaxLength="30" AutomationProperties.Name="{local:T Name}"/>

                        <TextBlock Text="{local:T Color}" Style="{StaticResource FieldLabel}" Margin="2,16,0,8"/>
                        <ItemsControl x:Name="Swatches">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type views:ColorSwatch}">
                                    <Grid x:Name="Swatch" Width="38" Height="38" Margin="0,0,6,6" Cursor="Hand" Background="Transparent"
                                          MouseLeftButtonUp="Swatch_Click">
                                        <Ellipse x:Name="Ring" Stroke="{DynamicResource TextBrush}" StrokeThickness="2" Opacity="0"/>
                                        <Ellipse Margin="5" Fill="{Binding Brush}"/>
                                        <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Swatch" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Ring" Property="Opacity" Value="0.45"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Ring" Property="Opacity" Value="1"/>
                                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <DockPanel Margin="0,18,0,0" LastChildFill="False">
                            <Button x:Name="DeleteButton" Style="{StaticResource DangerButton}" Content="{local:T 'Delete profile'}" Click="Delete_Click"
                                    AutomationProperties.Name="{local:T 'Delete profile'}"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="{local:T Save}" MinWidth="96" Margin="10,0,0,0" Click="Save_Click" IsDefault="True"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{local:T Cancel}" MinWidth="96" Click="Cancel_Click"/>
                        </DockPanel>
                        <TextBlock x:Name="DeleteHint" Style="{StaticResource Hint}" Margin="2,10,0,0" Visibility="Collapsed"
                                   Text="{local:T 'It\'s the only profile: create another one before deleting it.'}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
