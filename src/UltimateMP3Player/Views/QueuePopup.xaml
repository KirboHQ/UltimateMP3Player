<UserControl x:Class="UltimateMP3Player.Views.QueuePopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UltimateMP3Player"
             xmlns:vm="clr-namespace:UltimateMP3Player.ViewModels"
             xmlns:views="clr-namespace:UltimateMP3Player.Views">
    <!-- Up next popping out over any page from the player bar (MainViewModel.QueueOpen): the song view's queue, smaller.
         A click elsewhere or Esc folds it (MainWindow). -->
    <UserControl.Resources>
        <Style x:Key="QueueIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Template" Value="{StaticResource PillButtonTemplate}"/>
        </Style>
    </UserControl.Resources>
    <Border Width="380" MinHeight="300" MaxHeight="580" Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            CornerRadius="18" Padding="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="{DynamicResource PopupShadowColor}"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Margin="6,2,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{local:T 'Up next'}" FontSize="17" FontWeight="Bold"/>
                    <TextBlock FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap" Text="{Binding Player.QueueHint}"
                               Visibility="{Binding Player.HasUpNext, Converter={StaticResource BoolVis}}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,-3,-4,0">
                    <!-- your own queue only: in a room the queue is the room's -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding Player.InRoom, Converter={StaticResource InvBoolVis}}">
                        <Button Style="{StaticResource QueueIconButton}" Content="&#xE895;" Command="{Binding Player.GenerateQueueCommand}"
                                Visibility="{Binding Player.HasTrack, Converter={StaticResource BoolVis}}"
                                ToolTip="{local:T 'Complete the queue (if it\'s already full, generate it again from scratch)'}"
                                AutomationProperties.Name="{local:T 'Complete the queue (if it\'s already full, generate it again from scratch)'}"/>
                        <Button Style="{StaticResource QueueIconButton}" Content="&#xE74D;" Command="{Binding Player.ClearQueueCommand}"
                                Visibility="{Binding Player.HasUpNext, Converter={StaticResource BoolVis}}"
                                ToolTip="{local:T 'Clear the queue: the music stops after this song'}" AutomationProperties.Name="{local:T 'Clear queue'}"/>
                    </StackPanel>
                    <!-- the big one, next to the video and the lyrics -->
                    <Button Style="{StaticResource QueueIconButton}" Content="&#xE70E;" Command="{Binding GoNowPlayingCommand}"
                            ToolTip="{local:T 'Open in the song view'}" AutomationProperties.Name="{local:T 'Open in the song view'}"/>
                    <Button Style="{StaticResource QueueIconButton}" Content="&#xE711;" Command="{Binding ToggleQueueCommand}"
                            ToolTip="{local:T 'Close (Esc)'}" AutomationProperties.Name="{local:T Close}"/>
                </StackPanel>
            </Grid>
            <!-- at most 150 rows: no virtualization, so scrolling and dragging stay exact -->
            <ListBox x:Name="QueueList" Grid.Row="1" Style="{StaticResource PlainList}" ItemsSource="{Binding Player.UpNext}"
                     VirtualizingPanel.IsVirtualizing="False" ScrollViewer.CanContentScroll="False"
                     AllowDrop="True" DragOver="Queue_DragOver" Drop="Queue_Drop" AutomationProperties.Name="{local:T 'Up next'}">
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer Focusable="False" CanContentScroll="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <ItemsPresenter/>
                                <TextBlock Text="{Binding Player.MoreText}" Style="{StaticResource SmallCaps}" HorizontalAlignment="Center" Margin="0,14,0,8"
                                           Visibility="{Binding Player.MoreText, Converter={StaticResource NotNullVis}}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:QueueRow}">
                        <StackPanel>
                            <TextBlock Text="{Binding Header}" Style="{StaticResource SmallCaps}" Margin="8,10,0,6" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding Header, Converter={StaticResource NotNullVis}}"/>
                            <Border x:Name="Row" CornerRadius="10" Padding="6" Background="Transparent" local:Marquee.Host="True"
                                    MouseRightButtonUp="Row_RightClick" PreviewMouseLeftButtonDown="Row_MouseDown" MouseMove="Row_MouseMove">
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding PlayCommand}"/>
                                </Border.InputBindings>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Width="40" Height="40" Content="{Binding Track}" ContentTemplate="{StaticResource TrackCoverSmall}"/>
                                    <Button x:Name="PlayBtn" Width="26" Height="26" Style="{StaticResource IconButton}" Template="{StaticResource PillButtonTemplate}"
                                            Content="&#xE768;" FontSize="10.5" Foreground="White" Background="#B8000000" local:Ui.HoverBrush="#E6000000"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Command="{Binding PlayCommand}" Visibility="Hidden" ToolTip="{local:T 'Play now'}"
                                            AutomationProperties.Name="{Binding Track.Title}"/>
                                    <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Track.Title}" TextTrimming="CharacterEllipsis" FontSize="13.5" local:Marquee.IsEnabled="True"/>
                                        <TextBlock Text="{Binding Track.Artist}" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{DynamicResource SubTextBrush}"
                                                   local:Marquee.IsEnabled="True"/>
                                    </StackPanel>
                                    <!-- a suggested song: online, downloading, ready or not to be found (the remove button on hover) -->
                                    <Grid x:Name="RadioState" Grid.Column="2" Width="30" Height="30" Background="Transparent" ToolTip="{Binding Radio.StateTip}"
                                          Visibility="{Binding IsRadio, Converter={StaticResource BoolVis}}">
                                        <TextBlock x:Name="Online" Text="&#xE753;" Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource MutedBrush}"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="Ready" Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource SuccessBrush}"
                                                   HorizontalAlignment="Center" Visibility="Collapsed"/>
                                        <TextBlock x:Name="Failed" Text="&#xE7BA;" Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource WarningBrush}"
                                                   HorizontalAlignment="Center" Visibility="Collapsed"/>
                                        <Grid x:Name="Busy" Visibility="Collapsed">
                                            <Ellipse Style="{StaticResource Spinner}" Width="26" Height="26" StrokeThickness="2"/>
                                            <TextBlock Text="{Binding Radio.PctText}" FontSize="8.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Grid>
                                    <!-- (the row's ShowCloud read on a Grid: a ContentPresenter's own DataContext is its Content) -->
                                    <Grid x:Name="CloudState" Grid.Column="2" Visibility="{Binding ShowCloud, Converter={StaticResource BoolVis}}">
                                        <ContentPresenter Content="{Binding Track}" ContentTemplate="{StaticResource TrackCloudCell}"/>
                                    </Grid>
                                    <Button x:Name="RemoveBtn" Grid.Column="2" Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="11"
                                            Content="&#xE711;" Command="{Binding RemoveCommand}" Visibility="Hidden" ToolTip="{local:T 'Remove from Up next'}"
                                            AutomationProperties.Name="{local:T 'Remove from Up next'}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, FallbackValue=False}" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Radio.IsReady}" Value="True">
                                <Setter TargetName="Ready" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Online" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Radio.IsBusy}" Value="True">
                                <Setter TargetName="Busy" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Online" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Radio.IsFailed}" Value="True">
                                <Setter TargetName="Failed" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Online" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                <Setter TargetName="PlayBtn" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="RemoveBtn" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="RadioState" Property="Visibility" Value="Hidden"/>
                                <Setter TargetName="CloudState" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <views:SelectionBar Grid.Row="1" List="{Binding ElementName=QueueList}" Compact="True" Panel.ZIndex="1" Margin="0,0,0,10"/>
            <!-- empty queue: what happens next, and the way to fill it -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="14,0,14,20" MaxWidth="270"
                        Visibility="{Binding Player.UpNextCount, Converter={StaticResource ZeroVis}}">
                <Grid Width="64" Height="64" HorizontalAlignment="Center">
                    <Ellipse Fill="{DynamicResource AccentSoftBrush}"/>
                    <TextBlock Text="&#xE90B;" FontFamily="{StaticResource IconFont}" FontSize="26" Foreground="{DynamicResource AccentTextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="{local:T 'The queue is empty'}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                <TextBlock Text="{Binding Player.QueueEndHint}" Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,6,0,0"/>
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding Player.GenerateQueueCommand}" HorizontalAlignment="Center" Margin="0,16,0,0"
                        Visibility="{Binding Player.CanGenerate, Converter={StaticResource BoolVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE895;" Style="{StaticResource Glyph}" FontSize="13"/>
                        <TextBlock Text="{local:T 'Generate queue'}" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
