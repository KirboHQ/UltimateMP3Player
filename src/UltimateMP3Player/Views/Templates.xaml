<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:UltimateMP3Player"
                    xmlns:vm="clr-namespace:UltimateMP3Player.ViewModels"
                    x:Class="UltimateMP3Player.Views.Templates">

    <!-- ============================================================ covers -->

    <!-- Song cover, or a note on a gradient. -->
    <DataTemplate x:Key="TrackCoverSmall" DataType="{x:Type vm:TrackViewModel}">
        <Grid>
            <Border CornerRadius="5" Background="{StaticResource PlaceholderGradient}">
                <TextBlock Text="&#xEC4F;" Style="{StaticResource Glyph}" HorizontalAlignment="Center" FontSize="15" Foreground="{StaticResource MutedBrush}"/>
            </Border>
            <Border CornerRadius="5" Visibility="{Binding Cover48, Converter={StaticResource NotNullVis}}">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding Cover48}" Stretch="UniformToFill"/>
                </Border.Background>
            </Border>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="TrackCoverMedium" DataType="{x:Type vm:TrackViewModel}">
        <Grid>
            <Border CornerRadius="10" Background="{StaticResource PlaceholderGradient}">
                <TextBlock Text="&#xEC4F;" Style="{StaticResource Glyph}" HorizontalAlignment="Center" FontSize="42" Foreground="{StaticResource MutedBrush}"/>
            </Border>
            <Border CornerRadius="10" Visibility="{Binding Cover160, Converter={StaticResource NotNullVis}}">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding Cover160}" Stretch="UniformToFill"/>
                </Border.Background>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- Playlist cover: custom, favorites, mosaic or first cover. -->
    <DataTemplate x:Key="PlaylistCover" DataType="{x:Type vm:PlaylistViewModel}">
        <Grid>
            <Border x:Name="Placeholder" CornerRadius="8" Background="{StaticResource PlaceholderGradient}" Visibility="Collapsed">
                <Viewbox>
                    <Border Width="100" Height="100" Padding="30">
                        <Viewbox>
                            <TextBlock Text="&#xEC4F;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource MutedBrush}"/>
                        </Viewbox>
                    </Border>
                </Viewbox>
            </Border>
            <Border x:Name="Fav" CornerRadius="8" Background="{DynamicResource FavoritesGradient}" Visibility="Collapsed">
                <Viewbox>
                    <Border Width="100" Height="100" Padding="30">
                        <Viewbox>
                            <TextBlock Text="&#xEB52;" FontFamily="{StaticResource IconFont}" Foreground="White"/>
                        </Viewbox>
                    </Border>
                </Viewbox>
            </Border>
            <Border x:Name="Single" CornerRadius="8" Visibility="Collapsed" ClipToBounds="True">
                <ContentPresenter Content="{Binding FirstCover}" ContentTemplate="{StaticResource TrackCoverMedium}"/>
            </Border>
            <Border x:Name="Mosaic" CornerRadius="8" Visibility="Collapsed" ClipToBounds="True">
                <Border.OpacityMask>
                    <VisualBrush>
                        <VisualBrush.Visual>
                            <Border Width="100" Height="100" CornerRadius="8" Background="Black"/>
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Border.OpacityMask>
                <ItemsControl ItemsSource="{Binding CoverTracks}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="2" Columns="2"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TrackViewModel}">
                            <Rectangle>
                                <Rectangle.Fill>
                                    <ImageBrush ImageSource="{Binding Cover160}" Stretch="UniformToFill"/>
                                </Rectangle.Fill>
                            </Rectangle>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <Border x:Name="Custom" CornerRadius="8" Visibility="Collapsed">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding CustomCover}" Stretch="UniformToFill"/>
                </Border.Background>
            </Border>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding ShowPlaceholder}" Value="True">
                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsFavorites}" Value="True">
                <Setter TargetName="Fav" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding ShowMosaic}" Value="False"/>
                    <Condition Binding="{Binding FirstCover, Converter={StaticResource NotNullVis}}" Value="Visible"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Single" Property="Visibility" Value="Visible"/>
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding ShowMosaic}" Value="True">
                <Setter TargetName="Mosaic" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding HasCustomCover}" Value="True">
                <Setter TargetName="Custom" Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ============================================================ track rows -->

    <Style x:Key="RowIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <DataTemplate x:Key="TrackRowTemplate" DataType="{x:Type vm:TrackRow}">
        <Border x:Name="Row" CornerRadius="8" Padding="8,5" Background="Transparent" Margin="0,0,0,1"
                MouseRightButtonUp="Row_RightClick" PreviewMouseLeftButtonDown="Row_MouseDown" MouseMove="Row_MouseMove"
                ToolTipService.InitialShowDelay="900">
            <Border.InputBindings>
                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding PlayCommand}"/>
            </Border.InputBindings>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="36"/>
                </Grid.ColumnDefinitions>

                <Grid>
                    <TextBlock x:Name="Num" Text="{Binding Number}" Foreground="{StaticResource SubTextBrush}" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock x:Name="Eq" Text="&#xE995;" Style="{StaticResource Glyph}" Foreground="{DynamicResource AccentTextBrush}"
                               HorizontalAlignment="Center" Visibility="Collapsed"/>
                    <Button x:Name="PlayBtn" Style="{StaticResource RowIconButton}" Content="&#xE768;" Command="{Binding PlayCommand}"
                            Foreground="{StaticResource TextBrush}" Visibility="Collapsed" ToolTip="{local:T Riproduci}" AutomationProperties.Name="{local:T 'Riproduci brano'}"/>
                </Grid>

                <Grid Grid.Column="1" Margin="4,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Width="40" Height="40" Content="{Binding Track}" ContentTemplate="{StaticResource TrackCoverSmall}"/>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="Title" Text="{Binding Track.Title}" FontSize="14" TextTrimming="CharacterEllipsis" MaxWidth="600"/>
                            <Border Margin="8,0,0,0" CornerRadius="4" Padding="5,0" Background="{StaticResource Surface3Brush}" VerticalAlignment="Center"
                                    Visibility="{Binding Track.HasVideo, Converter={StaticResource BoolVis}}" ToolTip="{local:T 'Ha anche il video'}">
                                <TextBlock Text="&#xE714;" Style="{StaticResource Glyph}" FontSize="10" Foreground="{StaticResource SubTextBrush}" Margin="0,2"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Track.Artist}" FontSize="12.5" Foreground="{StaticResource SubTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Column="2" Text="{Binding Track.AlbumText}" FontSize="13" Foreground="{StaticResource SubTextBrush}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0"/>

                <Button x:Name="Heart" Grid.Column="3" Style="{StaticResource RowIconButton}" Content="&#xEB51;" Command="{Binding FavoriteCommand}"
                        Visibility="Hidden" ToolTip="{local:T 'Aggiungi ai Preferiti'}"/>

                <TextBlock Grid.Column="4" Text="{Binding Track.DurationText}" FontSize="13" Foreground="{StaticResource SubTextBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>

                <Button x:Name="More" Grid.Column="5" Style="{StaticResource RowIconButton}" Content="&#xE712;" Click="More_Click"
                        Visibility="Hidden" ToolTip="{local:T 'Altre opzioni'}" AutomationProperties.Name="{local:T 'Altre opzioni'}"/>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{StaticResource RowHoverBrush}"/>
                <Setter TargetName="PlayBtn" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Num" Property="Visibility" Value="Hidden"/>
                <Setter TargetName="Heart" Property="Visibility" Value="Visible"/>
                <Setter TargetName="More" Property="Visibility" Value="Visible"/>
            </Trigger>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, FallbackValue=False}" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Track.IsCurrent}" Value="True">
                <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Track.IsPlaying}" Value="True">
                <Setter TargetName="Eq" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Num" Property="Visibility" Value="Hidden"/>
                <Setter TargetName="PlayBtn" Property="Content" Value="&#xE769;"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Track.IsFavorite}" Value="True">
                <Setter TargetName="Heart" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Heart" Property="Content" Value="&#xEB52;"/>
                <Setter TargetName="Heart" Property="Foreground" Value="{DynamicResource PinkBrush}"/>
                <Setter TargetName="Heart" Property="ToolTip" Value="{local:T 'Togli dai Preferiti'}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Column titles above a track list. -->
    <DataTemplate x:Key="TrackHeader">
        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,0,18,8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="36"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="#" Style="{StaticResource SmallCaps}" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{local:T TITOLO}" Style="{StaticResource SmallCaps}" Margin="4,0,0,0"/>
                <TextBlock Grid.Column="2" Text="ALBUM" Style="{StaticResource SmallCaps}"/>
                <TextBlock Grid.Column="4" Text="&#xE823;" Style="{StaticResource Glyph}" FontSize="13" Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Right" Margin="0,0,12,0"/>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- ============================================================ cards -->

    <DataTemplate x:Key="TrackCard" DataType="{x:Type vm:TrackViewModel}">
        <Border x:Name="Card" Width="176" CornerRadius="12" Padding="12" Margin="0,0,12,12" Background="{StaticResource SurfaceBrush}"
                Cursor="Hand" MouseRightButtonUp="Card_RightClick">
            <Border.InputBindings>
                <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.PlayTrackCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}"/>
            </Border.InputBindings>
            <StackPanel>
                <Grid Width="152" Height="152">
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource TrackCoverMedium}"/>
                    <Border x:Name="PlayDisc" Width="44" Height="44" CornerRadius="22" Background="{DynamicResource AccentGradient}"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8" Opacity="0">
                        <TextBlock x:Name="PlayIco" Text="&#xE768;" Style="{StaticResource Glyph}" Foreground="{DynamicResource OnAccentBrush}" FontSize="16" HorizontalAlignment="Center"/>
                    </Border>
                </Grid>
                <TextBlock x:Name="Title" Text="{Binding Title}" FontWeight="SemiBold" Margin="0,10,0,2" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Artist}" FontSize="12.5" Foreground="{StaticResource SubTextBrush}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>
        <DataTemplate.Triggers>
            <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                <Setter TargetName="Card" Property="Background" Value="{StaticResource Surface2Brush}"/>
                <Setter TargetName="PlayDisc" Property="Opacity" Value="1"/>
            </Trigger>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                <Setter TargetName="PlayDisc" Property="Opacity" Value="1"/>
                <Setter TargetName="PlayIco" Property="Text" Value="&#xE995;"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="PlaylistCard" DataType="{x:Type vm:PlaylistViewModel}">
        <Border x:Name="Card" Width="176" CornerRadius="12" Padding="12" Margin="0,0,12,12" Background="{StaticResource SurfaceBrush}"
                Cursor="Hand" MouseRightButtonUp="Playlist_RightClick">
            <Border.InputBindings>
                <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.OpenPlaylistCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}"/>
            </Border.InputBindings>
            <StackPanel>
                <Grid Width="152" Height="152">
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource PlaylistCover}"/>
                    <Button x:Name="PlayDisc" Style="{StaticResource BigPlayButton}" Width="44" Height="44" FontSize="16" Content="&#xE768;"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8" Opacity="0"
                            Command="{Binding DataContext.PlayPlaylistCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" ToolTip="{local:T Riproduci}"/>
                </Grid>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,10,0,2" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Foreground="{StaticResource SubTextBrush}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>
        <DataTemplate.Triggers>
            <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                <Setter TargetName="Card" Property="Background" Value="{StaticResource Surface2Brush}"/>
                <Setter TargetName="PlayDisc" Property="Opacity" Value="1"/>
            </Trigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="WrapPanelTemplate">
        <WrapPanel/>
    </ItemsPanelTemplate>
</ResourceDictionary>
