<UserControl x:Class="UltimateMP3Player.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UltimateMP3Player"
             xmlns:vm="clr-namespace:UltimateMP3Player.ViewModels"
             xmlns:views="clr-namespace:UltimateMP3Player.Views">
    <UserControl.Resources>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="SettingSwitch" TargetType="CheckBox" BasedOn="{StaticResource Switch}">
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <!-- A word that's a link among grey words: underlined, and lit under the mouse (LinkButton's). -->
        <Style x:Key="GreyLink" TargetType="Button" BasedOn="{StaticResource LinkButton}">
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <!-- Big button with an icon and two lines (help card). -->
        <Style x:Key="SupportTile" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="12" Background="{DynamicResource BgBrush}" BorderBrush="Transparent"
                                BorderThickness="1" Padding="14">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- The title, the search and the groups on the left, one group open on the right, like an iPad's settings; the search looks in all of them (SettingsView.Apply). -->
        <Grid Margin="14,6,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{local:T Settings}" FontSize="30" FontWeight="Bold" Margin="6,0,12,16"/>
            <TextBox x:Name="SearchBox" Grid.Row="1" Style="{StaticResource FilterBox}" Margin="0,0,12,14"
                     Tag="{local:T 'Search settings'}" AutomationProperties.Name="{local:T 'Search settings'}"
                     TextChanged="Search_TextChanged" KeyDown="Search_KeyDown"/>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False">
                <Grid Margin="0,0,12,20">
                    <views:SlidingPill Target="{Binding ElementName=Groups}" Fill="{DynamicResource Surface2Brush}"/>
                    <StackPanel x:Name="Groups">
                        <RadioButton Style="{StaticResource NavButton}" GroupName="SettingsGroups" local:Ui.Glyph="&#xE890;" Content="{local:T Appearance}" Tag="appearance" IsChecked="True" Checked="Group_Checked"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="SettingsGroups" local:Ui.Glyph="&#xE768;" Content="{local:T Playback}" Tag="playback" Checked="Group_Checked"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="SettingsGroups" local:Ui.Glyph="&#xE896;" Content="{local:T Download}" Tag="download" Checked="Group_Checked"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="SettingsGroups" local:Ui.Glyph="&#xE721;" Content="{local:T 'Search and suggestions'}" Tag="search" Checked="Group_Checked"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="SettingsGroups" local:Ui.Glyph="&#xE8F1;" Content="{local:T Library}" Tag="library" Margin="0,14,0,1" Checked="Group_Checked"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="SettingsGroups" local:Ui.Glyph="&#xE74E;" Content="{local:T 'Backup and export'}" Tag="backup" Checked="Group_Checked"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="SettingsGroups" local:Ui.Glyph="&#xE716;" Content="{local:T 'Phone and rooms'}" Tag="connect" Margin="0,14,0,1" Checked="Group_Checked"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="SettingsGroups" local:Ui.Glyph="&#xE714;" Content="{local:T 'Stream overlay'}" Tag="overlay" Checked="Group_Checked"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="SettingsGroups" local:Ui.Glyph="&#xE71B;" Content="{local:T Integrations}" Tag="integrations" Checked="Group_Checked"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="SettingsGroups" local:Ui.Glyph="&#xE77B;" Content="{local:T 'Profiles and startup'}" Tag="profiles" Margin="0,14,0,1" Checked="Group_Checked"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="SettingsGroups" local:Ui.Glyph="&#xE946;" Content="{local:T About}" Tag="about" Checked="Group_Checked"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
        <!-- One page per group (SettingsView.MakePages), sliding like the sidebar's pages; this one is the search's: it takes all the cards while there are words in the box. -->
        <views:AnimatedContent x:Name="Pages" Grid.Column="1">
            <views:AnimatedContent.Content>
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Focusable="False" Background="Transparent">
        <StackPanel Margin="8,6,28,28">
            <TextBlock x:Name="NoResults" Text="{local:T 'No setting matches the search.'}" Style="{StaticResource Hint}" FontSize="14"
                       HorizontalAlignment="Left" Margin="0,30,0,0" Visibility="Collapsed"/>

            <!-- SettingsView.Keywords: extra words (in the app language) the search box finds; Tag="whole": the card is shown or hidden as a whole -->
            <views:MasonryPanel x:Name="Cards" ColumnWidth="380" MaxColumns="3" MaxColumnWidth="880" Gap="16">

                <!-- ==================================================== appearance -->
                <Border Style="{StaticResource Card}" views:SettingsView.Group="appearance" Padding="22" views:SettingsView.Keywords="{local:T 'theme colors light dark night mode'}">
                    <StackPanel>
                        <TextBlock Text="{local:T 'Theme (for this profile)'}" Style="{StaticResource CardTitle}"/>
                        <StackPanel>
                            <TextBlock Text="{local:T Dynamic}" Style="{StaticResource Hint}" Margin="2,2,0,6"/>
                            <ItemsControl ItemsSource="{Binding MovingThemes}" Margin="0,0,0,6">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ThemeOption}">
                                        <Button Height="38" Margin="0,0,8,8" Cursor="Hand" AutomationProperties.Name="{Binding Label}" FocusVisualStyle="{x:Null}"
                                                Command="{Binding DataContext.SelectThemeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Id}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Pill" CornerRadius="19" Padding="6,0,16,0" Background="{DynamicResource Surface2Brush}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="26" Height="26" Fill="{Binding Swatch}"/>
                                                            <TextBlock Text="{Binding Label}" Margin="9,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Surface3Brush}"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid Margin="2,0,0,14" views:Fold.Open="{Binding IsRgbTheme}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{local:T Speed}" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <Slider Grid.Column="1" Minimum="1" Maximum="10" SmallChange="0.5" LargeChange="0.5" IsSnapToTickEnabled="True" TickFrequency="0.5"
                                        Value="{Binding RgbSpeed}" VerticalAlignment="Center" AutomationProperties.Name="{local:T 'RGB speed'}"/>
                                <TextBlock Grid.Column="2" Text="{Binding RgbSpeedText}" Margin="14,0,0,0" VerticalAlignment="Center" MinWidth="36"/>
                            </Grid>
                            <TextBlock Text="{local:T Colors}" Style="{StaticResource Hint}" Margin="2,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding ColorThemes}" Margin="0,0,0,14">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ThemeOption}">
                                    <Button x:Name="Swatch" Width="38" Height="38" Margin="0,0,0,8" Cursor="Hand" ToolTip="{Binding Label}"
                                            AutomationProperties.Name="{Binding Label}" FocusVisualStyle="{x:Null}"
                                            Command="{Binding DataContext.SelectThemeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Id}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Grid Background="Transparent">
                                                    <Ellipse x:Name="Ring" Stroke="{DynamicResource TextBrush}" StrokeThickness="2" Opacity="0"/>
                                                    <Ellipse Margin="5" Fill="{Binding Swatch}"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Ring" Property="Opacity" Value="0.45"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="Ring" Property="Opacity" Value="1"/>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                        <views:ColorPicker Margin="0,-6,0,14" Hex="{Binding CustomColor}" views:Fold.Open="{Binding IsCustomTheme}"/>
                        <TextBlock Text="{Binding ThemeHint}" Style="{StaticResource Hint}" Margin="0,-8,0,14" views:Fold.Open="{Binding HasThemeHint}"/>

                        <TextBlock Text="{local:T 'Light or dark'}" Style="{StaticResource FieldLabel}"/>
                        <views:ChoiceTiles Picture="look" Items="{Binding Appearances}" Selected="{Binding Appearance}"/>
                    </StackPanel>
                </Border>

                <!-- the glass look: on or off in its title, like the bars of the music; its choices under it (Core Glass) -->
                <Border Style="{StaticResource Card}" views:SettingsView.Group="appearance" Padding="22" views:SettingsView.Keywords="{local:T 'glass blur transparent translucent background cover frosted smoked acrylic grain panes edges borders rim'}">
                    <StackPanel>
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding GlassOn}" VerticalAlignment="Center"
                                      AutomationProperties.Name="{local:T Glass}"/>
                            <StackPanel>
                                <TextBlock Text="{local:T Glass}" FontSize="17" FontWeight="Bold"/>
                                <TextBlock Text="{local:T 'The window lies on the cover of the song playing, blurred, under panes of glass.'}" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <!-- the picture behind (made again: GlassBackdrop), then the panes over it (the palette: Themes.Apply); one column of names for both -->
                        <StackPanel Margin="0,14,0,0" Grid.IsSharedSizeScope="True" views:Fold.Open="{Binding GlassOn}">
                            <TextBlock Text="{local:T Background}" Style="{StaticResource FieldLabel}"/>
                            <views:ChoiceTiles Picture="glasspicture" Items="{Binding GlassPictures}" Selected="{Binding GlassPicture}"/>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="GlassLabel"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{local:T Blur}" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <Slider Grid.Column="1" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" Value="{Binding GlassBlur}" VerticalAlignment="Center" AutomationProperties.Name="{local:T Blur}"/>
                                <TextBlock Grid.Column="2" Text="{Binding GlassBlurText}" Margin="14,0,0,0" VerticalAlignment="Center" MinWidth="36"/>
                                <TextBlock Grid.Row="1" Text="{local:T Brightness}" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Margin="0,12,14,0"/>
                                <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" Value="{Binding GlassBrightness}" VerticalAlignment="Center" Margin="0,12,0,0" AutomationProperties.Name="{local:T Brightness}"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding GlassBrightnessText}" Margin="14,12,0,0" VerticalAlignment="Center" MinWidth="36"/>
                                <TextBlock Grid.Row="2" Text="{local:T Color}" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Margin="0,12,14,0"/>
                                <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" Value="{Binding GlassVivid}" VerticalAlignment="Center" Margin="0,12,0,0" AutomationProperties.Name="{local:T Color}"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding GlassVividText}" Margin="14,12,0,0" VerticalAlignment="Center" MinWidth="36"/>
                            </Grid>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding GlassGrain}" Margin="0,12,0,0">
                                <TextBlock Text="{local:T Grain}"/>
                            </CheckBox>
                            <TextBlock Text="{local:T Panes}" Style="{StaticResource FieldLabel}" Margin="2,20,0,6"/>
                            <views:ChoiceTiles Picture="glasstint" Items="{Binding GlassTints}" Selected="{Binding GlassTintChoice}"/>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="GlassLabel"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{local:T Opacity}" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <Slider Grid.Column="1" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" Value="{Binding GlassPanes}" VerticalAlignment="Center" AutomationProperties.Name="{local:T 'Opacity of the panes'}"/>
                                <TextBlock Grid.Column="2" Text="{Binding GlassPanesText}" Margin="14,0,0,0" VerticalAlignment="Center" MinWidth="36"/>
                                <TextBlock Grid.Row="1" Text="{local:T Edges}" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Margin="0,12,14,0"/>
                                <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" Value="{Binding GlassRim}" VerticalAlignment="Center" Margin="0,12,0,0" AutomationProperties.Name="{local:T 'Edges of the panes'}"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding GlassRimText}" Margin="14,12,0,0" VerticalAlignment="Center" MinWidth="36"/>
                            </Grid>
                            <Button Style="{StaticResource SubtleButton}" Padding="12,5" Margin="0,14,0,0" HorizontalAlignment="Right" Content="{local:T Reset}" Command="{Binding GlassResetCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- the layout: the bars floating or attached, the side bar's width, its pages and sections, Home's rows (Core Layout) -->
                <Border Style="{StaticResource Card}" views:SettingsView.Group="appearance" Padding="22" views:SettingsView.Keywords="{local:T 'layout menu side bar width order position hide floating attached home rows sections customize'}">
                    <StackPanel>
                        <StackPanel.Resources>
                            <!-- a page or a row: shown or not, dragged by its handle like the search's sites (SettingsView.LayoutRow_MouseMove) -->
                            <DataTemplate DataType="{x:Type vm:LayoutRow}">
                                <Border x:Name="Row" CornerRadius="8" Background="Transparent" Padding="0,2" PreviewMouseLeftButtonDown="Reorder_MouseDown" MouseMove="LayoutRow_MouseMove">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="&#xE700;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{DynamicResource MutedBrush}"
                                                   Background="Transparent" Cursor="SizeAll" VerticalAlignment="Center" Padding="12,8,8,8" ToolTip="{local:T 'Drag to change the order'}"/>
                                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Shown}" IsEnabled="{Binding CanHide}" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Icon}" Style="{StaticResource Glyph}" FontSize="15" Width="22" Margin="0,0,8,0" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                            <Style x:Key="LayoutRows" TargetType="ListBox" BasedOn="{StaticResource PlainList}">
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="AllowDrop" Value="True"/>
                                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="False"/>
                                <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBox">
                                            <ItemsPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </StackPanel.Resources>
                        <TextBlock Text="{local:T Layout}" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{local:T 'Side bar and player bar'}" Style="{StaticResource FieldLabel}"/>
                        <views:ChoiceTiles Picture="bars" Items="{Binding BarChoices}" Selected="{Binding BarChoice}"/>
                        <TextBlock Text="{Binding BarHint}" Style="{StaticResource Hint}" FontSize="12" Margin="2,8,0,0"/>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{local:T 'Side bar width'}" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <Slider Grid.Column="1" Minimum="220" Maximum="360" SmallChange="10" LargeChange="20" IsSnapToTickEnabled="True" TickFrequency="10" Value="{Binding SideWidth}"
                                    VerticalAlignment="Center" AutomationProperties.Name="{local:T 'Side bar width'}"/>
                            <TextBlock Grid.Column="2" Text="{Binding SideWidthText}" Margin="14,0,0,0" VerticalAlignment="Center" MinWidth="36"/>
                        </Grid>
                        <TextBlock Text="{local:T 'Pages of the side bar'}" Style="{StaticResource FieldLabel}" Margin="2,16,0,4"/>
                        <ListBox ItemsSource="{Binding MenuRows}" Style="{StaticResource LayoutRows}" DragOver="LayoutRows_DragOver"/>
                        <TextBlock Text="{local:T 'Sections of the side bar'}" Style="{StaticResource FieldLabel}" Margin="2,14,0,4"/>
                        <ListBox ItemsSource="{Binding SectionRows}" Style="{StaticResource LayoutRows}" DragOver="LayoutRows_DragOver"/>
                        <TextBlock Text="{local:T 'Rows of Home'}" Style="{StaticResource FieldLabel}" Margin="2,14,0,4"/>
                        <ListBox ItemsSource="{Binding HomeRows}" Style="{StaticResource LayoutRows}" DragOver="LayoutRows_DragOver"/>
                    </StackPanel>
                </Border>

                <!-- the song's bar: how it will look, its shapes -->
                <Border Style="{StaticResource Card}" views:SettingsView.Group="appearance" Padding="22" Tag="whole" views:SettingsView.Keywords="{local:T 'song bar seek progress shape blocks dots line wave mirrored'}">
                    <StackPanel>
                        <TextBlock Text="{local:T 'Shape of the song bar'}" Style="{StaticResource CardTitle}"/>
                        <Border CornerRadius="12" Background="{DynamicResource BgBrush}" Padding="14,12" Margin="0,0,0,10">
                            <views:WaveformBar Height="30" Margin="0,10,0,0" Peaks="{Binding SeekSample}" Progress="0.4" Shape="{Binding SeekStyle}" Mirrored="{Binding SeekMirrored}" IsHitTestVisible="False"
                                               PlayedBrush="{DynamicResource ProgressGradient}" RestBrush="{DynamicResource WaveBrush}"/>
                        </Border>
                        <views:ChoiceTiles Picture="shape" Items="{Binding VisualizerStyles}" Selected="{Binding SeekStyleChoice}"/>
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SeekMirrored}" Margin="0,12,0,0">
                            <TextBlock Text="{local:T Mirrored}"/>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- the bars of the music: on or off in its title, like the equalizer -->
                <Border Style="{StaticResource Card}" views:SettingsView.Group="appearance" Padding="22" Tag="whole" views:SettingsView.Keywords="{local:T 'visualizer bars waves music spectrum song view'}">
                    <StackPanel>
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Visualizer}" VerticalAlignment="Center"
                                      AutomationProperties.Name="{local:T 'Bars of the music'}"/>
                            <StackPanel>
                                <TextBlock Text="{local:T 'Bars of the music'}" FontSize="17" FontWeight="Bold"/>
                                <TextBlock Text="{local:T 'In the song view, bars that follow the music, behind the title.'}" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <StackPanel Margin="0,14,0,0" views:Fold.Open="{Binding Visualizer}">
                            <!-- what the song's page will show: the music playing, otherwise a made-up sound -->
                            <Border CornerRadius="12" Background="{DynamicResource BgBrush}" Height="76" Padding="14,10,14,0">
                                <views:WaveVisualizer IsPreview="True" HeightShare="1" Flow="{Binding NowPlaying.VisualizerFlow}" Place="{Binding NowPlaying.VisualizerPlace}" BarStyle="{Binding NowPlaying.VisualizerStyle}" Tint="{Binding NowPlaying.VisualizerTint}" Thickness="{Binding NowPlaying.VisualizerThickness}" Strength="{Binding NowPlaying.VisualizerStrength}"/>
                            </Border>
                            <TextBlock Text="{local:T 'Shape of the bars'}" Style="{StaticResource FieldLabel}" Margin="2,14,0,6"/>
                            <views:ChoiceTiles Picture="shape" Items="{Binding VisualizerStyles}" Selected="{Binding VisualizerStyleChoice}"/>
                            <TextBlock Text="{local:T 'Direction of the bars'}" Style="{StaticResource FieldLabel}" Margin="2,14,0,6"/>
                            <views:ChoiceTiles Picture="flow" TileWidth="150" Items="{Binding VisualizerFlows}" Selected="{Binding VisualizerFlowChoice}"/>
                            <TextBlock Text="{local:T 'Position of the bars'}" Style="{StaticResource FieldLabel}" Margin="2,14,0,6"/>
                            <views:ChoiceTiles Picture="place" TileWidth="150" Items="{Binding VisualizerPlaces}" Selected="{Binding VisualizerPlaceChoice}"/>
                            <TextBlock Text="{local:T 'Color of the bars'}" Style="{StaticResource FieldLabel}" Margin="2,14,0,6"/>
                            <views:ChoiceTiles Picture="tint" Items="{Binding VisualizerTints}" Selected="{Binding VisualizerTintChoice}"/>
                            <StackPanel views:Fold.Open="{Binding VisualizerHasThickness}">
                                <TextBlock Text="{Binding VisualizerThicknessLabel}" Style="{StaticResource FieldLabel}" Margin="2,14,0,6"/>
                                <views:ChoiceTiles Picture="thickness" Items="{Binding VisualizerThicknesses}" Selected="{Binding VisualizerThicknessChoice}"/>
                            </StackPanel>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{local:T 'Height'}" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <Slider Grid.Column="1" Minimum="0.15" Maximum="1" SmallChange="0.05" LargeChange="0.05" Value="{Binding VisualizerHeight}" VerticalAlignment="Center" AutomationProperties.Name="{local:T 'Height'}"/>
                                <TextBlock Grid.Column="2" Text="{Binding VisualizerHeightText}" Margin="14,0,0,0" VerticalAlignment="Center" MinWidth="36"/>
                                <TextBlock Grid.Row="1" Text="{local:T 'Strength'}" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Margin="0,12,14,0"/>
                                <Slider Grid.Row="1" Grid.Column="1" Minimum="0.2" Maximum="1" SmallChange="0.05" LargeChange="0.05" Value="{Binding VisualizerStrength}" VerticalAlignment="Center" Margin="0,12,0,0" AutomationProperties.Name="{local:T 'Strength'}"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding VisualizerStrengthText}" Margin="14,12,0,0" VerticalAlignment="Center" MinWidth="36"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- the rest of how the app looks and moves -->
                <Border Style="{StaticResource Card}" views:SettingsView.Group="appearance" Padding="22" views:SettingsView.Keywords="{local:T 'interface language english italian animations scrolling mouse wheel cover 3d parallax speed zoom size bigger smaller'}">
                    <StackPanel>
                        <TextBlock Text="{local:T Interface}" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{local:T Language}" Style="{StaticResource FieldLabel}"/>
                        <views:ChoiceTiles Margin="-4,0,-4,16" Items="{Binding Languages}" Selected="{Binding Language}"/>
                        <!-- the same as Ctrl+wheel, Ctrl + and - -->
                        <DockPanel Margin="0,0,0,18">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource ControlButton}" Width="32" Height="32" FontSize="12" Content="&#xE738;" Command="{Binding ZoomOutCommand}"
                                        ToolTip="{local:T Smaller}" AutomationProperties.Name="{local:T Smaller}"/>
                                <Button Style="{StaticResource SubtleButton}" Padding="8,4" MinWidth="58" Content="{Binding ZoomText}" Command="{Binding ZoomResetCommand}"
                                        ToolTip="{local:T 'Back to 100% (Ctrl+0)'}"/>
                                <Button Style="{StaticResource ControlButton}" Width="32" Height="32" FontSize="12" Content="&#xE710;" Command="{Binding ZoomInCommand}"
                                        ToolTip="{local:T Bigger}" AutomationProperties.Name="{local:T Bigger}"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{local:T 'Interface size'}"/>
                                <TextBlock Text="{local:T 'Ctrl + mouse wheel, or Ctrl + and Ctrl -, from any page.'}" Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </DockPanel>
                        <CheckBox Style="{StaticResource SettingSwitch}" IsChecked="{Binding Animations}">
                            <StackPanel>
                                <TextBlock Text="{local:T Animations}"/>
                                <TextBlock Text="{local:T 'Smooth transitions between tabs. Turn them off if you prefer everything instant.'}" Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </CheckBox>
                        <Grid Margin="0,-6,0,18" views:Fold.Open="{Binding Animations}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{local:T Speed}" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <Slider Grid.Column="1" Minimum="0.25" Maximum="3" SmallChange="0.25" LargeChange="0.25" IsSnapToTickEnabled="True" TickFrequency="0.25"
                                    Value="{Binding AnimationSpeed}" VerticalAlignment="Center" AutomationProperties.Name="{local:T 'Animation speed'}"/>
                            <TextBlock Grid.Column="2" Text="{Binding AnimationSpeedText}" Margin="14,0,0,0" VerticalAlignment="Center" MinWidth="36"/>
                        </Grid>
                        <CheckBox Style="{StaticResource SettingSwitch}" IsChecked="{Binding SmoothScrolling}">
                            <StackPanel>
                                <TextBlock Text="{local:T 'Smooth scrolling'}"/>
                                <TextBlock Text="{local:T 'The mouse wheel scrolls lists smoothly.'}" Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CoverTilt}">
                            <StackPanel>
                                <TextBlock Text="{local:T '3D cover'}"/>
                                <TextBlock Text="{local:T 'In the song view, the cover tilts to follow your mouse.'}" Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- ==================================================== playback -->
                <Border Style="{StaticResource Card}" views:SettingsView.Group="playback" Padding="22" views:SettingsView.Keywords="{local:T 'playback volume normalize output device speakers headphones'}">
                    <StackPanel>
                        <TextBlock Text="{local:T Playback}" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{local:T 'Audio output'}" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding OutputDevice}" Margin="0,0,0,18"
                                  AutomationProperties.Name="{local:T 'Audio output'}"/>
                        <CheckBox Style="{StaticResource SettingSwitch}" IsChecked="{Binding Normalize}">
                            <StackPanel>
                                <TextBlock Text="{local:T 'Normalize volume'}"/>
                                <TextBlock Text="{local:T 'All songs at the same volume, even if they come from different sites.'}" Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding PlayWhileDownloading}">
                            <StackPanel>
                                <TextBlock Text="{local:T 'Start songs while they download'}"/>
                                <TextBlock Text="{local:T 'Songs in the cloud and suggested ones play right away, while they download, when nothing else is playing. Off: they wait for the whole file (less mobile data).'}" Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- from one song to the next -->
                <Border Style="{StaticResource Card}" views:SettingsView.Group="playback" Padding="22" views:SettingsView.Keywords="{local:T 'crossfade fade transition bpm beat next song'}">
                    <StackPanel>
                        <TextBlock Text="{local:T 'Between songs'}" Style="{StaticResource CardTitle}"/>
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Crossfade}" AutomationProperties.Name="{local:T Crossfade}">
                            <StackPanel>
                                <TextBlock Text="{local:T Crossfade}"/>
                                <TextBlock Text="{local:T 'The next song fades in as the current one fades out, with no silence.'}" Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </CheckBox>
                        <Grid Margin="0,12,0,0" views:Fold.Open="{Binding Crossfade}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{local:T Duration}" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <Slider Grid.Column="1" Minimum="1" Maximum="12" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="1"
                                    Value="{Binding CrossfadeSeconds}" VerticalAlignment="Center" AutomationProperties.Name="{local:T 'Crossfade duration'}"/>
                            <TextBlock Grid.Column="2" Text="{Binding CrossfadeText}" Margin="14,0,0,0" VerticalAlignment="Center" MinWidth="36"/>
                        </Grid>
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding BpmMatch}" Margin="0,14,0,0" AutomationProperties.Name="{local:T 'BPM-matched transition'}">
                            <StackPanel>
                                <TextBlock Text="{local:T 'BPM-matched transition'}"/>
                                <TextBlock Text="{local:T 'In its last seconds the song slows down or speeds up to the next one\'s BPM (without changing key), so they meet on the beat. Only when both BPMs are known and close.'}"
                                           Style="{StaticResource Hint}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </CheckBox>
                        <Grid Margin="0,12,0,0" views:Fold.Open="{Binding BpmMatch}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{local:T Duration}" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <Slider Grid.Column="1" Minimum="2" Maximum="30" SmallChange="1" LargeChange="2" IsSnapToTickEnabled="True" TickFrequency="1"
                                    Value="{Binding BpmMatchSeconds}" VerticalAlignment="Center" AutomationProperties.Name="{local:T 'Length of the BPM-matched transition'}"/>
                            <TextBlock Grid.Column="2" Text="{Binding BpmMatchText}" Margin="14,0,0,0" VerticalAlignment="Center" MinWidth="36"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ==================================================== equalizer -->
                <Border Style="{StaticResource Card}" views:SettingsView.Group="playback" Padding="22" DataContext="{Binding Equalizer}" Tag="whole"
                        views:SettingsView.Keywords="{local:T 'equalizer eq bass mids treble frequencies preset sound audio'}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" VerticalAlignment="Center"
                                      AutomationProperties.Name="{local:T Equalizer}"/>
                            <StackPanel>
                                <TextBlock Text="{local:T Equalizer}" FontSize="17" FontWeight="Bold"/>
                                <TextBlock Text="{local:T 'Adjust bass, mids and treble. Double-click a band to reset it.'}"
                                           Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </DockPanel>

                        <StackPanel IsEnabled="{Binding Enabled}">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.45"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <WrapPanel Margin="0,14,0,10">
                                <ComboBox Width="200" ItemsSource="{Binding Presets}" SelectedItem="{Binding Preset}" Margin="0,0,8,8"
                                          AutomationProperties.Name="Preset"/>
                                <Button Style="{StaticResource GhostButton}" Command="{Binding SaveCommand}" Margin="0,0,8,8" ToolTip="{local:T 'Save as preset'}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74E;" Style="{StaticResource Glyph}"/>
                                        <TextBlock Text="{local:T Save}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Command="{Binding DeleteCommand}" Margin="0,0,8,8"
                                        Visibility="{Binding IsCustomPreset, Converter={StaticResource BoolVis}}" ToolTip="{local:T 'Delete preset'}">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Glyph}"/>
                                </Button>
                                <Button Style="{StaticResource SubtleButton}" Content="{local:T Reset}" Command="{Binding ResetCommand}" Margin="0,0,8,8"/>
                            </WrapPanel>

                            <Border CornerRadius="12" Background="{DynamicResource BgBrush}" Padding="10,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="180"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="1" Margin="0,0,6,0">
                                        <TextBlock Text="+12" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Top"/>
                                        <TextBlock Text="0" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        <TextBlock Text="-12" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Bottom"/>
                                    </Grid>
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Bands}" Margin="0,0,0,6">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:EqBandViewModel}">
                                                <TextBlock Text="{Binding GainText}" FontSize="11.5" HorizontalAlignment="Center" Foreground="{DynamicResource SubTextBrush}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Grid.Row="1" Grid.Column="1" Height="1" Background="{DynamicResource BorderStrongBrush}" VerticalAlignment="Center" Margin="4,0"/>
                                    <views:EqCurve Grid.Row="1" Grid.Column="1" Gains="{Binding Gains}" Version="{Binding CurveVersion}"
                                                   Stroke="{DynamicResource AccentTextBrush}" IsHitTestVisible="False"/>
                                    <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Bands}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:EqBandViewModel}">
                                                <Slider Style="{StaticResource EqSlider}" Height="180" Value="{Binding Gain}" HorizontalAlignment="Center"
                                                        PreviewMouseWheel="Eq_Wheel" MouseDoubleClick="Eq_DoubleClick"
                                                        AutomationProperties.Name="{Binding Label, StringFormat=Eq {0}}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Bands}" Margin="0,8,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:EqBandViewModel}">
                                                <TextBlock Text="{Binding Label}" FontSize="12" HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Grid.Row="2" Text="Hz" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,8,6,0"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ==================================================== downloads and temporary storage -->
                <Border Style="{StaticResource Card}" views:SettingsView.Group="download" Padding="22" views:SettingsView.Keywords="{local:T 'downloads folder music save audio only simultaneous at once'}">
                    <StackPanel>
                        <TextBlock Text="{local:T Download}" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{local:T 'Music folder (shared by all profiles)'}" Style="{StaticResource FieldLabel}"/>
                        <StackPanel Margin="0,0,0,16">
                            <TextBox Style="{StaticResource BoxTextBox}" Text="{Binding MusicDir, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="{local:T 'Music folder (shared by all profiles)'}"/>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Style="{StaticResource GhostButton}" Content="{local:T 'Browse…'}" Margin="0,0,8,0" Command="{Binding BrowseCommand}"/>
                                <Button Style="{StaticResource GhostButton}" Content="{local:T Open}" Command="{Binding OpenMusicDirCommand}"/>
                            </WrapPanel>
                        </StackPanel>
                        <CheckBox Style="{StaticResource SettingSwitch}" IsChecked="{Binding SaveAudio}">
                            <StackPanel>
                                <TextBlock Text="{local:T 'Save the audio on your device'}"/>
                                <TextBlock Text="{local:T 'Songs you add from a link or a pack are downloaded. Off: they go into your library in the cloud, you listen from their link and save them whenever you like.'}" Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource SettingSwitch}" IsChecked="{Binding PreferAudioOnly}">
                            <StackPanel>
                                <TextBlock Text="{local:T 'Prefer audio only'}"/>
                                <TextBlock Text="{local:T 'You can always choose the video when downloading.'}" Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </CheckBox>
                        <TextBlock Text="{local:T 'Simultaneous downloads'}" Style="{StaticResource FieldLabel}"/>
                        <views:ChoiceTiles Numbers="True" Items="{Binding ParallelChoices}" Selected="{Binding Parallel}"/>
                    </StackPanel>
                </Border>

                <!-- quality -->
                <Border Style="{StaticResource Card}" views:SettingsView.Group="download" Padding="22" views:SettingsView.Keywords="{local:T 'format mp3 m4a opus flac quality video resolution'}">
                    <StackPanel>
                        <TextBlock Text="{local:T Quality}" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{local:T 'Audio format'}" Style="{StaticResource FieldLabel}"/>
                        <views:ChoiceTiles Margin="-4,0,-4,12" Items="{Binding AudioFormats}" Selected="{Binding AudioFormat}"/>
                        <TextBlock Text="{local:T 'Maximum video quality'}" Style="{StaticResource FieldLabel}"/>
                        <views:ChoiceTiles TileWidth="86" Items="{Binding VideoQualities}" Selected="{Binding VideoQuality}"/>
                    </StackPanel>
                </Border>

                <!-- storage -->
                <Border Style="{StaticResource Card}" views:SettingsView.Group="download" Padding="22" Tag="whole" views:SettingsView.Keywords="{local:T 'storage space cache suggested cloud unsaved clear empty'}">
                    <StackPanel>
                        <TextBlock Text="{local:T 'Temporary storage (unsaved songs)'}" Style="{StaticResource CardTitle}"/>
                        <StackPanel>
                            <views:ChoiceTiles Numbers="True" Items="{Binding CacheChoices}" Selected="{Binding CacheSize}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                       Text="{local:T 'Songs you play without having saved them on your device (in the cloud, suggested, in rooms) stay ready for next time; beyond this number the oldest are deleted (never those in the queue). Saving one moves it out of here.'}"/>
                            <TextBlock Text="{Binding CacheText}" Style="{StaticResource Hint}" Margin="0,4,0,10"/>
                            <WrapPanel>
                                <Button Margin="0,0,8,8" Style="{StaticResource GhostButton}" Command="{Binding ClearCacheCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" Style="{StaticResource Glyph}"/>
                                        <TextBlock Text="{local:T Empty}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Margin="0,0,8,8" Style="{StaticResource GhostButton}" Command="{Binding OpenCacheCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE838;" Style="{StaticResource Glyph}"/>
                                        <TextBlock Text="{local:T 'Open the folder'}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- sign-ins -->
                <Border Style="{StaticResource Card}" views:SettingsView.Group="download" Padding="22" views:SettingsView.Keywords="{local:T 'cookies browser chrome firefox edge sign in login account private'}">
                    <StackPanel>
                        <TextBlock Text="{local:T Sign-ins}" Style="{StaticResource CardTitle}"/>
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding UseCookies}">
                            <StackPanel>
                                <TextBlock Text="{local:T 'Use my sign-ins for downloads'}"/>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="{local:T 'For content that requires signing in (Instagram, TikTok, age-restricted, private playlists). Off by default.'}"/>
                            </StackPanel>
                        </CheckBox>
                        <StackPanel Margin="0,12,0,0" views:Fold.Open="{Binding UseCookies}">
                            <TextBlock Text="{local:T 'Where the sign-ins come from'}" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Width="280" HorizontalAlignment="Left" ItemsSource="{Binding BrowserChoices}" SelectedItem="{Binding Browser}"
                                      AutomationProperties.Name="{local:T 'Where the sign-ins come from'}"/>
                            <DockPanel Margin="0,12,0,0" views:Fold.Open="{Binding UsesEachSite}">
                                <Button Style="{StaticResource GhostButton}" Content="{local:T 'Sign in to sites'}" Click="Logins_Click"/>
                                <TextBlock Text="{Binding LoginsSummary}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ==================================================== search and suggestions -->
                <!-- online search -->
                <Border Style="{StaticResource Card}" views:SettingsView.Group="search" Padding="22" views:SettingsView.Keywords="{local:T 'online search find sites youtube music soundcloud deezer spotify order'}">
                    <StackPanel>
                        <TextBlock Text="{local:T 'Online search'}" Style="{StaticResource CardTitle}"/>
                        <CheckBox Style="{StaticResource SettingSwitch}" IsChecked="{Binding OnlineSearch}">
                            <StackPanel>
                                <TextBlock Text="{local:T 'Also search music sites'}"/>
                                <TextBlock Text="{local:T 'The search also finds songs you don\'t have: click one to download it, like a pasted link.'}"
                                           Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </CheckBox>
                        <StackPanel IsEnabled="{Binding OnlineSearch}">
                            <TextBlock Text="{local:T 'Sites, in order of preference'}" Style="{StaticResource FieldLabel}"/>
                            <!-- dragged to another place like the songs of a playlist (SettingsView.Service_MouseMove) -->
                            <ListBox x:Name="ServiceList" ItemsSource="{Binding SearchServices}" Style="{StaticResource PlainList}" Focusable="False" Margin="0,0,0,10"
                                     AllowDrop="True" DragOver="Services_DragOver" VirtualizingPanel.IsVirtualizing="False" ScrollViewer.CanContentScroll="False">
                                <ListBox.Template>
                                    <ControlTemplate TargetType="ListBox">
                                        <ItemsPresenter/>
                                    </ControlTemplate>
                                </ListBox.Template>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SearchServiceOption}">
                                        <Border x:Name="Row" CornerRadius="10" Background="{DynamicResource BgBrush}" BorderBrush="Transparent" BorderThickness="1"
                                                Padding="12,8,6,8" Margin="0,0,0,6" PreviewMouseLeftButtonDown="Service_MouseDown" MouseMove="Service_MouseMove">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="&#xE700;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{DynamicResource MutedBrush}"
                                                           Background="Transparent" Cursor="SizeAll" VerticalAlignment="Center" Padding="10,6,8,6"
                                                           ToolTip="{local:T 'Drag to change the order: the sites higher up are searched first'}"/>
                                                <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}">
                                                    <StackPanel Margin="2,0,0,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Number}" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                                            <Ellipse Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Hint}" FontSize="12"/>
                                                    </StackPanel>
                                                </CheckBox>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{local:T 'How to search'}" Style="{StaticResource FieldLabel}"/>
                            <views:ChoiceTiles Picture="searchmode" TileWidth="150" Items="{Binding SearchModes}" Selected="{Binding SearchMode}"/>
                            <TextBlock Text="{Binding SearchModeHint}" Style="{StaticResource Hint}" FontSize="12" Margin="2,8,0,0"/>
                            <DockPanel Margin="0,16,0,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding SpotifyKeyCommand}" Content="{local:T 'Enter key…'}"
                                        VerticalAlignment="Center" Margin="12,0,0,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{local:T 'Spotify key'}"/>
                                    <TextBlock Text="{Binding SpotifyKeyText}" Style="{StaticResource Hint}" FontSize="12"/>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}" FontSize="12" Margin="2,8,0,0" Foreground="{DynamicResource MutedBrush}"
                                       Text="{local:T 'Spotify only answers apps with a key: with yours (free; your Spotify account needs Premium) the search finds Spotify\'s songs and artists too. Without one, Deezer has the same catalogue. The audio comes from YouTube Music, as for Spotify links.'}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- suggested songs -->
                <Border Style="{StaticResource Card}" views:SettingsView.Group="search" Padding="22" views:SettingsView.Keywords="{local:T 'suggested suggestions similar radio automatic queue online discover new songs ahead'}">
                    <StackPanel>
                        <TextBlock Text="{local:T 'Suggested songs'}" Style="{StaticResource CardTitle}"/>
                        <CheckBox Style="{StaticResource SettingSwitch}" IsChecked="{Binding RadioAfterSingle}">
                            <StackPanel>
                                <TextBlock Text="{local:T 'Outside a playlist, go on with similar songs'}"/>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="{local:T 'A song started from the downloads, the search or on its own is followed by similar songs found online (with the automatic queue on). Off: all your songs follow it.'}"/>
                            </StackPanel>
                        </CheckBox>
                        <TextBlock Text="{local:T 'Where they come from'}" Style="{StaticResource FieldLabel}"/>
                        <views:ChoiceTiles Items="{Binding RadioSourceChoices}" Selected="{Binding RadioSource}"/>
                        <TextBlock Text="{Binding RadioSourceHint}" Style="{StaticResource Hint}" FontSize="12" Margin="2,8,0,14"/>
                        <TextBlock Text="{local:T 'Ready ahead'}" Style="{StaticResource FieldLabel}"/>
                        <views:ChoiceTiles Numbers="True" Items="{Binding TogetherAheadChoices}" Selected="{Binding RadioAhead}"/>
                        <TextBlock Style="{StaticResource Hint}" FontSize="12" Margin="2,12,0,0" Foreground="{DynamicResource MutedBrush}"
                                   Text="{local:T 'From any song: right-click → Play similar songs. They\'re downloaded shortly before their turn, as in Listen together and into the same storage, and don\'t go into your library: to keep one, right-click → Save to library.'}"/>
                    </StackPanel>
                </Border>

                <!-- lyrics -->
                <Border Style="{StaticResource Card}" views:SettingsView.Group="search" Padding="22" views:SettingsView.Keywords="{local:T 'lyrics text words karaoke lrclib synced timing'}">
                    <StackPanel>
                        <TextBlock Text="{local:T 'Song lyrics'}" Style="{StaticResource CardTitle}"/>
                        <CheckBox Style="{StaticResource SettingSwitch}" IsChecked="{Binding AutoLyrics}">
                            <StackPanel>
                                <TextBlock Text="{local:T 'Find lyrics automatically'}"/>
                                <TextBlock Text="{local:T 'For newly downloaded songs and for the ones you play, if they were never searched. When a song has lyrics, the Lyrics button appears on its page.'}"
                                           Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </CheckBox>
                        <TextBlock Text="{local:T 'In your library'}" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding LyricsStats}" Margin="0,0,0,12" TextWrapping="Wrap"/>
                        <!-- the missing ones of the whole library, one at a time -->
                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Command="{Binding ScanLyricsCommand}"
                                Visibility="{Binding Lyrics.IsScanning, Converter={StaticResource InvBoolVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE720;" Style="{StaticResource Glyph}"/>
                                <TextBlock Text="{local:T 'Find missing lyrics'}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Grid Visibility="{Binding Lyrics.IsScanning, Converter={StaticResource BoolVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock Text="{Binding Lyrics.ScanText}" FontSize="12.5" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis"/>
                                <ProgressBar Maximum="1" Value="{Binding Lyrics.ScanProgress, Mode=OneWay}" Margin="0,7,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="{local:T Stop}" Command="{Binding Lyrics.StopScanCommand}"/>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" FontSize="12" Margin="2,14,0,0" Foreground="{DynamicResource MutedBrush}"
                                   Text="{local:T 'Lyrics come from LRCLIB, a free and open archive. Synced lyrics light up line by line as you listen; for one song right-click → Lyrics, for several songs select them and right-click.'}"/>
                    </StackPanel>
                </Border>

                <!-- ==================================================== library: music on the computer, tags, bulk edit, followed artists -->
                <!-- library -->
                <Border Style="{StaticResource Card}" views:SettingsView.Group="library" Padding="22" Tag="whole" views:SettingsView.Keywords="{local:T 'import add files folder computer'}">
                    <StackPanel>
                        <TextBlock Text="{local:T 'Music already on your computer'}" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{local:T 'Add audio or video files you already have: they stay where they are. You can also drag them into the window.'}"
                                   Style="{StaticResource Hint}" Margin="0,-8,0,14"/>
                        <UniformGrid Columns="2">
                            <Button Style="{StaticResource SupportTile}" Command="{Binding ImportFilesCommand}" Margin="0,0,6,0"
                                    AutomationProperties.Name="{local:T 'Add files…'}">
                                <StackPanel>
                                    <Grid Width="38" Height="38" HorizontalAlignment="Left">
                                        <Ellipse Fill="{DynamicResource AccentSoftBrush}"/>
                                        <TextBlock Text="&#xE8E5;" Style="{StaticResource Glyph}" FontSize="17" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="{local:T 'Add files…'}" FontWeight="SemiBold" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SupportTile}" Command="{Binding ImportFolderCommand}" Margin="6,0,0,0"
                                    AutomationProperties.Name="{local:T 'Add a folder…'}">
                                <StackPanel>
                                    <Grid Width="38" Height="38" HorizontalAlignment="Left">
                                        <Ellipse Fill="{DynamicResource AccentSoftBrush}"/>
                                        <TextBlock Text="&#xE8B7;" Style="{StaticResource Glyph}" FontSize="17" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="{local:T 'Add a folder…'}" FontWeight="SemiBold" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- tags -->
                <Border Style="{StaticResource Card}" views:SettingsView.Group="library" Padding="22" Tag="whole" views:SettingsView.Keywords="{local:T 'tags labels color colors'}">
                    <StackPanel>
                        <TextBlock Text="{local:T Tags}" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{local:T 'Colored labels for this profile only: put them on songs and playlists with a right-click, or by selecting several songs.'}"
                                   Style="{StaticResource Hint}" Margin="0,-8,0,12"/>
                        <ItemsControl ItemsSource="{Binding DataContext.Tags, RelativeSource={RelativeSource AncestorType=Window}}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TagViewModel}">
                                    <Border x:Name="Row" CornerRadius="8" Padding="10,4,4,4" Background="Transparent">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="13" Content="&#xE74D;"
                                                    Command="{Binding DataContext.DeleteTagCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                    ToolTip="{local:T 'Delete tag'}" AutomationProperties.Name="{local:T 'Delete tag'}"/>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="13" Content="&#xE70F;"
                                                    Command="{Binding DataContext.EditTagCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                    ToolTip="{local:T 'Edit name and color'}" AutomationProperties.Name="{local:T 'Edit tag'}"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}"
                                                       VerticalAlignment="Center" Margin="10,0,8,0"/>
                                            <Ellipse Width="12" Height="12" Fill="{Binding Brush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{local:T 'No tags yet.'}" Style="{StaticResource Hint}" Margin="2,0,0,4"
                                   Visibility="{Binding DataContext.HasTags, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InvBoolVis}}"/>
                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                Command="{Binding DataContext.NewTagCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}"/>
                                <TextBlock Text="{local:T 'New tag'}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- bulk edit -->
                <Border Style="{StaticResource Card}" views:SettingsView.Group="library" Padding="22" Tag="whole" views:SettingsView.Keywords="{local:T 'artist artists rename names edit'}">
                    <StackPanel>
                        <TextBlock Text="{local:T 'Bulk edit'}" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{local:T 'Downloaded an artist with the wrong name? Pick it and rename it across all its songs.'}"
                                   Style="{StaticResource Hint}" Margin="0,-8,0,12"/>
                        <TextBox Style="{StaticResource FilterBox}" Text="{Binding ArtistFilter, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="{local:T 'Search for an artist'}" AutomationProperties.Name="{local:T 'Search for an artist'}"/>
                        <Border Margin="0,8,0,10" CornerRadius="10" Background="{DynamicResource BgBrush}" BorderBrush="Transparent"
                                BorderThickness="1" Padding="4" Height="190">
                            <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Artists}" SelectedItem="{Binding SelectedArtist}"
                                     AutomationProperties.Name="{local:T Artists}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:Choice}">
                                        <Border x:Name="Row" CornerRadius="7" Padding="10,6" Background="Transparent">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Hint}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="10,0,0,0"/>
                                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource BoxTextBox}" Text="{Binding NewArtistName, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="{local:T 'New artist name'}" AutomationProperties.Name="{local:T 'New artist name'}"/>
                            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="{local:T Rename}" Margin="8,0,0,0"
                                    Command="{Binding RenameArtistCommand}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- tidying up: the covers and lengths missing (an import's), the same song twice (another site, an import) joined into one -->
                <Border Style="{StaticResource Card}" views:SettingsView.Group="library" Padding="22"
                        views:SettingsView.Keywords="{local:T 'duplicates doubles same song twice copies join covers pictures images missing length album'}">
                    <StackPanel>
                        <TextBlock Text="{local:T 'Tidy up the library'}" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{local:T 'Songs without a cover or a length (an import from Spotify brings none): looked up by title and artist'}" Style="{StaticResource Hint}"
                                   TextWrapping="Wrap" Margin="0,4,0,10"/>
                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="16,9" Content="{local:T 'Find missing covers'}"
                                Command="{Binding FindMissingCommand}"/>
                        <TextBlock Text="{local:T 'The same song twice in the library: one copy stays, with the playlists, plays and tags of both'}" Style="{StaticResource Hint}"
                                   TextWrapping="Wrap" Margin="0,18,0,10"/>
                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="16,9" Content="{local:T 'Remove duplicates'}"
                                Command="{Binding RemoveDuplicatesCommand}"/>
                    </StackPanel>
                </Border>

                <!-- followed artists -->
                <Border Style="{StaticResource Card}" views:SettingsView.Group="library" Padding="22" Tag="whole" views:SettingsView.Keywords="{local:T 'artists follow new releases albums notifications'}">
                    <StackPanel>
                        <TextBlock Text="{local:T 'Artists you follow'}" Style="{StaticResource CardTitle}"/>
                        <CheckBox Style="{StaticResource SettingSwitch}" IsChecked="{Binding ReleaseNotifications}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="{local:T 'Notify new releases'}"/>
                                <TextBlock Text="{local:T 'A notification when an artist you follow releases an album, an EP or a single (looked for every 12 hours).'}" Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- ==================================================== backup, export and import -->
                <!-- .ump packs -->
                <Border Style="{StaticResource Card}" views:SettingsView.Group="backup" Padding="22" Tag="whole" views:SettingsView.Keywords="{local:T 'export import pack packs ump share backup copy move transfer friends playlist tag library'}">
                    <StackPanel>
                        <TextBlock Text="{local:T 'Export and import'}" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{local:T 'Put playlists, tags or the whole library into a .ump file: to keep a backup, move it to another computer or send it to a friend.'}"
                                   Style="{StaticResource Hint}" Margin="0,-8,0,14"/>
                        <UniformGrid Columns="2">
                            <Button Style="{StaticResource SupportTile}" Command="{Binding ExportPackCommand}" Margin="0,0,6,0"
                                    AutomationProperties.Name="{local:T 'Export…'}">
                                <StackPanel>
                                    <Grid Width="38" Height="38" HorizontalAlignment="Left">
                                        <Ellipse Fill="{DynamicResource AccentSoftBrush}"/>
                                        <TextBlock Text="&#xEDE1;" Style="{StaticResource Glyph}" FontSize="17" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="{local:T 'Export…'}" FontWeight="SemiBold" Margin="0,12,0,2"/>
                                    <TextBlock Text="{local:T 'Choose what goes into the pack'}" Style="{StaticResource Hint}" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SupportTile}" Command="{Binding ImportPackCommand}" Margin="6,0,0,0"
                                    AutomationProperties.Name="{local:T 'Import a pack…'}">
                                <StackPanel>
                                    <Image Source="{StaticResource PackImage}" Width="38" Height="38" HorizontalAlignment="Left"/>
                                    <TextBlock Text="{local:T 'Import a pack…'}" FontWeight="SemiBold" Margin="0,12,0,2"/>
                                    <TextBlock Text="{local:T 'Songs you already have aren\'t duplicated'}" Style="{StaticResource Hint}" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                        <TextBlock Style="{StaticResource Hint}" FontSize="12" Margin="2,14,0,0" Foreground="{DynamicResource MutedBrush}"
                                   Text="{local:T 'A .ump file also opens with a double click or by dragging it into the window. A playlist or a tag can also be exported with a right-click.'}"/>
                    </StackPanel>
                </Border>

                <!-- backups -->
                <Border Style="{StaticResource Card}" views:SettingsView.Group="backup" Padding="22" views:SettingsView.Keywords="{local:T 'backup backups restore automatic copy safety data library playlists statistics zip reinstall'}">
                    <StackPanel DataContext="{Binding Backups}">
                        <TextBlock Text="{local:T Backup}" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{local:T 'Your library, playlists, tags, statistics, settings, covers and lyrics in one small file (not the music), made by itself now and then. Restore it after a reinstall or on a new computer.'}"
                                   Style="{StaticResource Hint}" Margin="0,-8,0,14"/>
                        <TextBlock Text="{local:T 'Automatic backup'}" Style="{StaticResource FieldLabel}"/>
                        <views:ChoiceTiles Margin="-4,0,-4,12" Items="{Binding EveryChoices}" Selected="{Binding Every}"/>
                        <TextBlock Text="{local:T 'Backups kept'}" Style="{StaticResource FieldLabel}"/>
                        <views:ChoiceTiles Margin="-4,0,-4,12" Numbers="True" Items="{Binding KeepChoices}" Selected="{Binding Keep}"/>
                        <TextBlock Text="{local:T 'Backup folder'}" Style="{StaticResource FieldLabel}"/>
                        <StackPanel Margin="0,0,0,12">
                            <TextBox Style="{StaticResource BoxTextBox}" Text="{Binding FolderText, Mode=OneWay}" IsReadOnly="True"
                                     AutomationProperties.Name="{local:T 'Backup folder'}"/>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Style="{StaticResource GhostButton}" Content="{local:T 'Browse…'}" Margin="0,0,8,0" Command="{Binding ChooseFolderCommand}"/>
                                <Button Style="{StaticResource GhostButton}" Content="{local:T Open}" Margin="0,0,8,0" Command="{Binding OpenFolderCommand}"/>
                                <Button Style="{StaticResource GhostButton}" Content="{local:T Default}" Command="{Binding DefaultFolderCommand}"
                                    ToolTip="{local:T 'Back to the default folder'}" Visibility="{Binding IsDefaultFolder, Converter={StaticResource InvBoolVis}}"/>
                            </WrapPanel>
                        </StackPanel>
                        <TextBlock Text="{Binding LastText}" Style="{StaticResource Hint}" Margin="0,0,0,12"/>
                        <WrapPanel>
                            <Button Margin="0,0,8,8" Style="{StaticResource PrimaryButton}" Padding="16,9" Command="{Binding BackupNowCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" Style="{StaticResource Glyph}"/>
                                    <TextBlock Text="{local:T 'Back up now'}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Margin="0,0,8,8" Style="{StaticResource GhostButton}" Command="{Binding RestoreCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE777;" Style="{StaticResource Glyph}"/>
                                    <TextBlock Text="{local:T 'Restore a backup…'}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Hint}" Margin="2,10,0,0" Visibility="{Binding Status, Converter={StaticResource NotNullVis}}"/>
                    </StackPanel>
                </Border>

                <!-- ==================================================== listening statistics -->
                <Border Style="{StaticResource Card}" views:SettingsView.Group="library" Padding="22" Tag="whole"
                        views:SettingsView.Keywords="{local:T 'statistics plays played most least time chart top clean up delete'}">
                    <StackPanel>
                        <TextBlock Text="{local:T 'Listening statistics'}" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{local:T 'How many times and how long you\'ve listened to each song, for this profile only.'}"
                                   Style="{StaticResource Hint}" Margin="0,-8,0,12"/>
                        <TextBlock Text="{Binding StatsSummary}" Margin="0,0,0,12" TextWrapping="Wrap"/>
                        <ItemsControl ItemsSource="{Binding TopTracks}" Focusable="False" Margin="0,0,0,10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TrackViewModel}">
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding PlaysText}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}"
                                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        <ContentPresenter Width="38" Height="38" Content="{Binding}" ContentTemplate="{StaticResource TrackCoverSmall}"/>
                                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Artist}" FontSize="12" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <WrapPanel>
                            <Button Margin="0,0,8,8" Style="{StaticResource GhostButton}" Command="{Binding OpenStatsCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D2;" Style="{StaticResource Glyph}"/>
                                    <TextBlock Text="{local:T 'All statistics'}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Margin="0,0,8,8" Style="{StaticResource GhostButton}" Command="{Binding ImportSpotifyCommand}"
                                    ToolTip="{local:T 'Your liked songs, playlists and plays on Spotify'}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8E5;" Style="{StaticResource Glyph}"/>
                                    <TextBlock Text="{local:T 'Import from Spotify…'}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Margin="0,0,8,8" Style="{StaticResource GhostButton}" Command="{Binding ImportLastFmCommand}" ToolTip="{local:T 'Your loved songs as a playlist, your scrobbles into the statistics'}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8E5;" Style="{StaticResource Glyph}"/>
                                    <TextBlock Text="{local:T 'Import from Last.fm…'}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Hint}" FontSize="12" Margin="2,12,0,0" Foreground="{DynamicResource MutedBrush}"
                                   Text="{local:T 'To clean up, sort them by least played: select them and press Delete to delete them.'}"/>
                    </StackPanel>
                </Border>

                <!-- ==================================================== profiles & app -->
                <Border Style="{StaticResource Card}" views:SettingsView.Group="profiles" Padding="22" views:SettingsView.Keywords="{local:T 'profile profiles startup'}">
                    <StackPanel>
                        <TextBlock Text="{local:T 'Profiles and startup'}" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{local:T 'At startup'}" Style="{StaticResource FieldLabel}"/>
                        <StackPanel>
                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding StartupChoices}" SelectedItem="{Binding StartupProfile}" AutomationProperties.Name="{local:T 'At startup'}"/>
                            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Command="{Binding ManageProfilesCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE716;" Style="{StaticResource Glyph}"/>
                                    <TextBlock Text="{local:T 'Manage profiles'}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- what closing the app does -->
                <Border Style="{StaticResource Card}" views:SettingsView.Group="profiles" Padding="22" Tag="whole" views:SettingsView.Keywords="{local:T 'close quit exit pause background tray icon clock'}">
                    <StackPanel>
                        <TextBlock Text="{local:T 'When you close the app'}" Style="{StaticResource CardTitle}"/>
                        <views:ChoiceTiles Picture="close" Items="{Binding CloseChoices}" Selected="{Binding CloseChoice}"/>
                        <TextBlock Text="{local:T 'It stays next to the clock and uses very few resources; media keys work there too.'}"
                                   Style="{StaticResource Hint}" Margin="2,8,0,0" views:Fold.Open="{Binding StaysWhenClosed}"/>
                    </StackPanel>
                </Border>

                <!-- ==================================================== connect phone -->
                <Border Style="{StaticResource Card}" views:SettingsView.Group="connect" Padding="22" Tag="whole"
                        views:SettingsView.Keywords="{local:T 'connect phone remote control android iphone mobile cable usb wifi send music p2p'}">
                    <StackPanel>
                        <TextBlock Text="{local:T 'Connect phone'}" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{local:T 'Control the music of this computer from your phone: the phone\'s songs play here and its sound stays off. You can also send music from here to the phone.'}"
                                   Style="{StaticResource Hint}" Margin="0,-8,0,14"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding ConnectPhoneCommand}" VerticalAlignment="Center"
                                    AutomationProperties.Name="{local:T 'Connect phone…'}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8EA;" Style="{StaticResource Glyph}"/>
                                    <TextBlock Text="{local:T 'Connect phone…'}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding PhoneLink.PhoneName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding PhoneLink.HasPhone, Converter={StaticResource BoolVis}}"/>
                                <TextBlock Text="{Binding PhoneLink.StatusText}" Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- ==================================================== the app on an iPhone -->
                <Border Style="{StaticResource Card}" views:SettingsView.Group="connect" Padding="22" Tag="whole"
                        views:SettingsView.Keywords="{local:T 'install iphone ipad ios apple id sideload sidestore xtool'}">
                    <StackPanel>
                        <TextBlock Text="{local:T 'Put the app on an iPhone'}" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{local:T 'A small separate program does it from this computer: the cable, your Apple ID and a few taps. It also renews the app every 7 days.'}"
                                   Style="{StaticResource Hint}" Margin="0,-8,0,14"/>
                        <Button HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" Command="{Binding InstallOnIPhoneCommand}"
                                AutomationProperties.Name="{local:T 'Get the installer…'}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8EA;" Style="{StaticResource Glyph}"/>
                                <TextBlock Text="{local:T 'Get the installer…'}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- ==================================================== listen together -->
                <Border Style="{StaticResource Card}" views:SettingsView.Group="connect" Padding="22" Tag="whole" views:SettingsView.Keywords="{local:T 'listen together room rooms friends host ahead'}">
                    <StackPanel>
                        <TextBlock Text="{local:T 'Listen together'}" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{local:T 'How many songs of the queue to download before their turn, besides the one playing.'}"
                                   Style="{StaticResource Hint}" Margin="0,-8,0,14"/>
                        <TextBlock Text="{local:T 'When you listen'}" Style="{StaticResource FieldLabel}"/>
                        <views:ChoiceTiles Margin="-4,0,-4,12" Numbers="True" Items="{Binding TogetherAheadChoices}" Selected="{Binding TogetherAhead}"/>
                        <TextBlock Text="{local:T 'When you\'re the host'}" Style="{StaticResource FieldLabel}"/>
                        <views:ChoiceTiles Numbers="True" Items="{Binding TogetherAheadChoices}" Selected="{Binding TogetherHostAhead}"/>
                    </StackPanel>
                </Border>

                <!-- P2P -->
                <Border Style="{StaticResource Card}" views:SettingsView.Group="connect" Padding="22" views:SettingsView.Keywords="{local:T 'p2p share send exchange passed host'}">
                    <StackPanel>
                        <TextBlock Text="{local:T 'Songs passed between computers (P2P)'}" Style="{StaticResource CardTitle}"/>
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding TogetherP2P}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{local:T 'Exchange songs with the others'}"/>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="{local:T 'Off: this computer doesn\'t receive songs from anyone and doesn\'t send any, not even as the host (and as the host nobody passes them through you). Everyone gets them from their library, the storage or the link: whoever can\'t find a song doesn\'t hear it.'}"/>
                            </StackPanel>
                        </CheckBox>
                        <StackPanel IsEnabled="{Binding TogetherP2P}">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.45"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding TogetherSendAsHost}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{local:T 'When you\'re the host, send the songs yourself'}"/>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="{local:T 'Whoever turned on “Take the songs from the host” gets them from you instead of downloading them from the internet: worth it if your connection is fast. The others download them as usual.'}"/>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding TogetherTakeFromHost}">
                                <StackPanel>
                                    <TextBlock Text="{local:T 'Take the songs from the host'}"/>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="{local:T 'If the host sends them, the ones it gets ready come from it; you download the others and, if they can\'t be found, wait for the host. Off (or if the host doesn\'t send them): from the link first, then from whoever in the room has it.'}"/>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- network -->
                <Border Style="{StaticResource Card}" views:SettingsView.Group="connect" Padding="22" Tag="whole" views:SettingsView.Keywords="{local:T 'network lan radmin vpn firewall'}">
                    <StackPanel>
                        <TextBlock Text="{local:T Network}" Style="{StaticResource CardTitle}"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                                   Text="{local:T 'If others can\'t join your room (or you theirs), it\'s usually Windows Firewall: allow the app on every network (needs administrator confirmation).'}"/>
                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Command="{Binding FirewallCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEA18;" Style="{StaticResource Glyph}"/>
                                <TextBlock Text="{local:T 'Allow through the firewall'}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- ==================================================== stream overlays (OBS) -->
                <Border Style="{StaticResource Card}" views:SettingsView.Group="overlay" Padding="22" Tag="whole" views:SettingsView.Keywords="{local:T 'obs stream streaming streamer overlay browser source twitch youtube now playing vinyl'}">
                    <StackPanel DataContext="{x:Static local:OverlaySourcesViewModel.Shared}">
                        <DockPanel Margin="0,0,0,16">
                            <TextBlock DockPanel.Dock="Left" Text="{local:T 'Stream overlay'}" Style="{StaticResource CardTitle}" Margin="0"/>
                            <!-- (the same words in every language, like a stamp) -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12,0,0,2">
                                <Button Style="{StaticResource GreyLink}" FontSize="12.5" Click="Zanno_Click" ToolTip="twitch.tv/zanno_tw">
                                    <TextBlock Text="Zanno" TextDecorations="Underline"/>
                                </Button>
                                <TextBlock Text="approved" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="4,0,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="{local:T 'What you are listening to, on your stream: copy the link and add it in OBS as a Browser source. Transparent background, it fits any size, and it only works from this computer.'}"/>
                        <ItemsControl ItemsSource="{Binding Sources}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- how it looks: what its editor last showed, or the picture of its look -->
                                        <Border Width="96" Height="60" CornerRadius="8" Margin="0,0,12,0">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Picture}" Stretch="UniformToFill" AlignmentY="{Binding PictureY}"/>
                                            </Border.Background>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource GhostButton}" Padding="14,7" Margin="0,0,6,0" Content="{local:T 'Copy link'}" Command="{Binding CopyCommand}"/>
                                            <Button Style="{StaticResource IconButton}" Width="32" Height="32" FontSize="14" Content="&#xE8A7;" ToolTip="{local:T Preview}" Command="{Binding PreviewCommand}"/>
                                            <Button Style="{StaticResource IconButton}" Width="32" Height="32" FontSize="14" Content="&#xE70F;" ToolTip="{local:T Edit}" Command="{Binding EditCommand}"/>
                                            <Button Style="{StaticResource IconButton}" Width="32" Height="32" FontSize="14" Content="&#xE74D;" ToolTip="{local:T Delete}" Command="{Binding DeleteCommand}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource GhostButton}" Padding="16,8" Margin="0,14,0,0" HorizontalAlignment="Left" Content="{local:T 'Add an overlay'}" Command="{Binding AddCommand}"/>
                    </StackPanel>
                </Border>

                <!-- ==================================================== integrations -->
                <Border Style="{StaticResource Card}" views:SettingsView.Group="integrations" Padding="22" Tag="whole" views:SettingsView.Keywords="{local:T 'discord status activity rich presence'}">
                    <StackPanel>
                        <TextBlock Text="Discord" Style="{StaticResource CardTitle}"/>
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding DiscordPresence}" IsEnabled="{Binding DiscordAvailable}">
                            <StackPanel>
                                <TextBlock Text="{local:T 'Show what you\'re listening to on Discord'}"/>
                                <TextBlock Text="{local:T 'Song title, artist, cover and progress on your Discord profile (while Discord is open).'}"
                                           Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- what this profile listens to, to Last.fm and ListenBrainz -->
                <Border Style="{StaticResource Card}" views:SettingsView.Group="integrations" Padding="22" views:SettingsView.Keywords="{local:T 'lastfm last.fm listenbrainz scrobble scrobbling'}">
                    <StackPanel>
                        <TextBlock Text="Scrobbling" Style="{StaticResource CardTitle}"/>
                        <Grid DataContext="{Binding Scrobbling}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Last.fm"/>
                                <TextBlock Text="{Binding LastFmText}" Style="{StaticResource Hint}"/>
                                <Button Style="{StaticResource LinkButton}" Content="{local:T 'Import your loved songs and scrobbles…'}" Command="{Binding ImportLastFmCommand}"
                                        HorizontalAlignment="Left" Margin="0,4,0,0" Visibility="{Binding LastFmOn, Converter={StaticResource BoolVis}}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Padding="16,8" Content="{Binding LastFmButton}" Command="{Binding LastFmCommand}"
                                    VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="1" Margin="0,12,0,0" VerticalAlignment="Center">
                                <TextBlock Text="ListenBrainz"/>
                                <TextBlock Text="{Binding ListenBrainzText}" Style="{StaticResource Hint}"/>
                            </StackPanel>
                            <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource GhostButton}" Padding="16,8" Margin="0,12,0,0" Content="{Binding ListenBrainzButton}"
                                    Command="{Binding ListenBrainzCommand}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource Hint}" Margin="0,12,0,0"
                                       Text="{local:T 'Scrobbling: what this profile listens to goes to your accounts (half of a song is enough, at most 4 minutes). Without a connection the plays wait and go later.'}"/>
                            <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding WaitingText}" Style="{StaticResource Hint}" Foreground="{DynamicResource MutedBrush}"
                                       Margin="0,4,0,0" Visibility="{Binding HasWaiting, Converter={StaticResource BoolVis}}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ==================================================== about: updates, help, support the project -->
                <!-- updates -->
                <Border Style="{StaticResource Card}" views:SettingsView.Group="about" Padding="22" views:SettingsView.Keywords="{local:T 'updates update version github engines yt-dlp gallery-dl data'}">
                    <StackPanel>
                        <TextBlock Text="{local:T Updates}" Style="{StaticResource CardTitle}"/>
                        <CheckBox Style="{StaticResource SettingSwitch}" IsChecked="{Binding AutoUpdateApp}">
                            <StackPanel>
                                <TextBlock Text="{local:T 'Update the app automatically'}"/>
                                <TextBlock Text="{local:T 'Downloads the latest version by itself and installs it when you close the app.'}" Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </CheckBox>
                        <DockPanel Margin="0,0,0,16">
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding CheckAppUpdateCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE777;" Style="{StaticResource Glyph}"/>
                                    <TextBlock Text="{local:T 'Update now'}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding WhatsNewCommand}"
                                    Content="{local:T 'Release notes'}" Margin="0,0,10,0"/>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="{Binding Version}"/>
                                <TextBlock Text="{Binding Host.Updates.Status}" Style="{StaticResource Hint}"
                                           Visibility="{Binding Host.Updates.Status, Converter={StaticResource NotNullVis}}"/>
                            </StackPanel>
                        </DockPanel>
                        <CheckBox Style="{StaticResource SettingSwitch}" IsChecked="{Binding ShowWhatsNew}">
                            <StackPanel>
                                <TextBlock Text="{local:T 'Show the release notes after an update'}"/>
                                <TextBlock Text="{local:T 'The changes of every version since the last one you opened.'}" Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource SettingSwitch}" IsChecked="{Binding AutoUpdateEngines}">
                            <StackPanel>
                                <TextBlock Text="{local:T 'Update download engines'}"/>
                                <TextBlock Text="{local:T 'Sites change often: yt-dlp and gallery-dl update once a day.'}" Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </CheckBox>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding UpdateEnginesCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE895;" Style="{StaticResource Glyph}"/>
                                    <TextBlock Text="{local:T 'Update engines'}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding EngineInfo}" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </DockPanel>
                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,18"/>
                        <Button Style="{StaticResource LinkButton}" Content="{local:T 'Open data folder'}" Command="{Binding OpenDataDirCommand}"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- help -->
                <Border Style="{StaticResource Card}" views:SettingsView.Group="about" Padding="22" Tag="whole" views:SettingsView.Keywords="{local:T 'help support report problem bug error github issue idea suggestion feature contact terms use conditions copyright'}">
                    <StackPanel>
                        <TextBlock Text="{local:T 'Help &amp; support'}" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{local:T 'Something wrong, or a feature you miss? Tell us on GitHub: first check whether someone has already reported it.'}"
                                   Style="{StaticResource Hint}" Margin="0,-8,0,14"/>
                        <UniformGrid Columns="2">
                            <Button Style="{StaticResource SupportTile}" Command="{Binding ReportProblemCommand}" Margin="0,0,6,0"
                                    AutomationProperties.Name="{local:T 'Report a problem'}">
                                <StackPanel>
                                    <Grid Width="38" Height="38" HorizontalAlignment="Left">
                                        <Ellipse Fill="{DynamicResource ErrorSoftBrush}"/>
                                        <TextBlock Text="&#xEBE8;" Style="{StaticResource Glyph}" FontSize="17" Foreground="{DynamicResource ErrorBrush}" HorizontalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="{local:T 'Report a problem'}" FontWeight="SemiBold" Margin="0,12,0,2"/>
                                    <TextBlock Text="{local:T 'Something doesn\'t work as it should'}" Style="{StaticResource Hint}" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SupportTile}" Command="{Binding SuggestIdeaCommand}" Margin="6,0,0,0"
                                    AutomationProperties.Name="{local:T 'Suggest an idea'}">
                                <StackPanel>
                                    <Grid Width="38" Height="38" HorizontalAlignment="Left">
                                        <Ellipse Fill="{DynamicResource WarningSoftBrush}"/>
                                        <TextBlock Text="&#xEA80;" Style="{StaticResource Glyph}" FontSize="17" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="{local:T 'Suggest an idea'}" FontWeight="SemiBold" Margin="0,12,0,2"/>
                                    <TextBlock Text="{local:T 'A feature you\'d like'}" Style="{StaticResource Hint}" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                        <WrapPanel Margin="0,12,0,0">
                            <Button Style="{StaticResource GhostButton}" Command="{Binding OpenIssuesCommand}" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}"/>
                                    <TextBlock Text="{local:T 'Existing reports'}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Command="{Binding OpenRepoCommand}" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A7;" Style="{StaticResource Glyph}"/>
                                    <TextBlock Text="{local:T 'Project page'}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                        <TextBlock Text="{local:T 'GitHub opens in your browser (a free account is needed). The app and Windows versions are already filled in.'}"
                                   Style="{StaticResource Hint}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16"/>
                        <Button Style="{StaticResource LinkButton}" Content="{local:T 'Terms of use'}" Command="{Binding ShowTermsCommand}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- support the project: donations, the people who support it -->
                <Border Style="{StaticResource Card}" views:SettingsView.Group="about" Padding="22" Tag="whole" views:SettingsView.Keywords="{local:T 'support donate donation sponsor sponsors ko-fi coffee money thanks supporters'}">
                    <StackPanel>
                        <TextBlock Text="{local:T 'Support the project'}" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{local:T 'Ultimate MP3 Player is free, with no ads, and made in spare time. If it\'s useful to you, a donation helps keep it going.'}"
                                   Style="{StaticResource Hint}" Margin="0,-8,0,14"/>
                        <UniformGrid Columns="2">
                            <Button Style="{StaticResource SupportTile}" Command="{Binding SponsorCommand}" Margin="0,0,6,0"
                                    AutomationProperties.Name="GitHub Sponsors">
                                <StackPanel>
                                    <Grid Width="38" Height="38" HorizontalAlignment="Left">
                                        <Ellipse Fill="{DynamicResource ErrorSoftBrush}"/>
                                        <TextBlock Text="&#xEB51;" Style="{StaticResource Glyph}" FontSize="17" Foreground="{DynamicResource ErrorBrush}" HorizontalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="GitHub Sponsors" FontWeight="SemiBold" Margin="0,12,0,2"/>
                                    <TextBlock Text="{local:T 'Monthly or once, with a GitHub account'}" Style="{StaticResource Hint}" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SupportTile}" Command="{Binding KofiCommand}" Margin="6,0,0,0"
                                    AutomationProperties.Name="Ko-fi">
                                <StackPanel>
                                    <Grid Width="38" Height="38" HorizontalAlignment="Left">
                                        <Ellipse Fill="{DynamicResource AccentSoftBrush}"/>
                                        <TextBlock Text="&#xE734;" Style="{StaticResource Glyph}" FontSize="17" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="Ko-fi" FontWeight="SemiBold" Margin="0,12,0,2"/>
                                    <TextBlock Text="{local:T 'Once, by card or PayPal, no account needed'}" Style="{StaticResource Hint}" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                        <StackPanel Visibility="{Binding Supporters, Converter={StaticResource NotNullVis}}">
                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16"/>
                            <TextBlock Text="{local:T 'Thanks to'}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding Supporters}" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </views:MasonryPanel>
        </StackPanel>
    </ScrollViewer>
            </views:AnimatedContent.Content>
        </views:AnimatedContent>
    </Grid>
</UserControl>
