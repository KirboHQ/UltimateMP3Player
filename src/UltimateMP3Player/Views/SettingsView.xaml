<UserControl x:Class="UltimateMP3Player.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UltimateMP3Player"
             xmlns:vm="clr-namespace:UltimateMP3Player.ViewModels"
             xmlns:views="clr-namespace:UltimateMP3Player.Views">
    <UserControl.Resources>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="SettingSwitch" TargetType="CheckBox" BasedOn="{StaticResource Switch}">
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="28,6,28,28" MaxWidth="1640">
            <DockPanel Margin="0,0,0,20">
                <TextBox x:Name="SearchBox" DockPanel.Dock="Right" Style="{StaticResource FilterBox}" Width="300" VerticalAlignment="Center"
                         Tag="{local:T 'Cerca nelle impostazioni'}" AutomationProperties.Name="{local:T 'Cerca nelle impostazioni'}"
                         TextChanged="Search_TextChanged" KeyDown="Search_KeyDown"/>
                <TextBlock Text="{local:T Impostazioni}" FontSize="30" FontWeight="Bold" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock x:Name="NoResults" Text="{local:T 'Nessuna impostazione corrisponde alla ricerca.'}" Style="{StaticResource Hint}" FontSize="14"
                       HorizontalAlignment="Center" Margin="0,30,0,0" Visibility="Collapsed"/>

            <!-- SettingsView.Keywords: extra words (in the app language) the search box finds; Tag="whole": the card is shown or hidden as a whole -->
            <views:MasonryPanel x:Name="Cards" ColumnWidth="500" MaxColumns="3" Gap="16">

                <!-- ==================================================== appearance -->
                <Border Style="{StaticResource Card}" Padding="22" views:SettingsView.Keywords="{local:T 'tema colori lingua inglese italiano animazioni scorrimento rotella mouse copertina 3d'}">
                    <StackPanel>
                        <TextBlock Text="{local:T Aspetto}" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{local:T 'Tema (per questo profilo)'}" Style="{StaticResource FieldLabel}"/>
                        <ItemsControl ItemsSource="{Binding Themes}" Margin="0,2,0,14">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ThemeOption}">
                                    <Button x:Name="Swatch" Width="38" Height="38" Margin="0,0,8,8" Cursor="Hand" ToolTip="{Binding Label}"
                                            AutomationProperties.Name="{Binding Label}" FocusVisualStyle="{x:Null}"
                                            Command="{Binding DataContext.SelectThemeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Id}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Grid Background="Transparent">
                                                    <Ellipse x:Name="Ring" Stroke="{StaticResource TextBrush}" StrokeThickness="2" Opacity="0"/>
                                                    <Ellipse Margin="5" Fill="{Binding Swatch}"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Ring" Property="Opacity" Value="0.45"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="Ring" Property="Opacity" Value="1"/>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{local:T 'Lingua'}" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Width="240" HorizontalAlignment="Left" ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}"
                                  Margin="0,0,0,18" AutomationProperties.Name="Language"/>

                        <CheckBox Style="{StaticResource SettingSwitch}" IsChecked="{Binding Animations}">
                            <StackPanel>
                                <TextBlock Text="{local:T Animazioni}"/>
                                <TextBlock Text="{local:T 'Passaggi morbidi tra le schede. Spegnile se preferisci tutto istantaneo.'}" Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource SettingSwitch}" IsChecked="{Binding SmoothScrolling}">
                            <StackPanel>
                                <TextBlock Text="{local:T 'Scorrimento fluido'}"/>
                                <TextBlock Text="{local:T 'La rotella del mouse scorre le liste in modo morbido.'}" Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CoverTilt}">
                            <StackPanel>
                                <TextBlock Text="{local:T 'Copertina in 3D'}"/>
                                <TextBlock Text="{local:T 'Nella schermata del brano la copertina si inclina seguendo il mouse.'}" Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- ==================================================== equalizer -->
                <Border Style="{StaticResource Card}" Padding="22" DataContext="{Binding Equalizer}" Tag="whole"
                        views:SettingsView.Keywords="{local:T 'equalizzatore eq bassi medi alti frequenze preset suono audio'}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" VerticalAlignment="Center"
                                      AutomationProperties.Name="{local:T Equalizzatore}"/>
                            <StackPanel>
                                <TextBlock Text="{local:T Equalizzatore}" FontSize="17" FontWeight="Bold"/>
                                <TextBlock Text="{local:T 'Regola bassi, medi e alti. Doppio clic su una banda per azzerarla.'}"
                                           Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </DockPanel>

                        <StackPanel IsEnabled="{Binding Enabled}">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.45"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <WrapPanel Margin="0,14,0,10">
                                <ComboBox Width="200" ItemsSource="{Binding Presets}" SelectedItem="{Binding Preset}" Margin="0,0,8,8"
                                          AutomationProperties.Name="Preset"/>
                                <Button Style="{StaticResource GhostButton}" Command="{Binding SaveCommand}" Margin="0,0,8,8" ToolTip="{local:T 'Salva come preset'}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74E;" Style="{StaticResource Glyph}"/>
                                        <TextBlock Text="{local:T Salva}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Command="{Binding DeleteCommand}" Margin="0,0,8,8"
                                        Visibility="{Binding IsCustomPreset, Converter={StaticResource BoolVis}}" ToolTip="{local:T 'Elimina preset'}">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Glyph}"/>
                                </Button>
                                <Button Style="{StaticResource SubtleButton}" Content="{local:T Azzera}" Command="{Binding ResetCommand}" Margin="0,0,8,8"/>
                            </WrapPanel>

                            <Border CornerRadius="12" Background="{StaticResource BgBrush}" Padding="10,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="180"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="1" Margin="0,0,6,0">
                                        <TextBlock Text="+12" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Top"/>
                                        <TextBlock Text="0" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        <TextBlock Text="-12" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom"/>
                                    </Grid>
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Bands}" Margin="0,0,0,6">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:EqBandViewModel}">
                                                <TextBlock Text="{Binding GainText}" FontSize="11.5" HorizontalAlignment="Center" Foreground="{StaticResource SubTextBrush}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Grid.Row="1" Grid.Column="1" Height="1" Background="{StaticResource BorderStrongBrush}" VerticalAlignment="Center" Margin="4,0"/>
                                    <views:EqCurve Grid.Row="1" Grid.Column="1" Gains="{Binding Gains}" Version="{Binding CurveVersion}"
                                                   Stroke="{DynamicResource AccentTextBrush}" IsHitTestVisible="False"/>
                                    <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Bands}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:EqBandViewModel}">
                                                <Slider Style="{StaticResource EqSlider}" Height="180" Value="{Binding Gain}" HorizontalAlignment="Center"
                                                        PreviewMouseWheel="Eq_Wheel" MouseDoubleClick="Eq_DoubleClick"
                                                        AutomationProperties.Name="{Binding Label, StringFormat=Eq {0}}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Bands}" Margin="0,8,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:EqBandViewModel}">
                                                <TextBlock Text="{Binding Label}" FontSize="12" HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Grid.Row="2" Text="Hz" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,8,6,0"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ==================================================== playback -->
                <Border Style="{StaticResource Card}" Padding="22" views:SettingsView.Keywords="{local:T 'riproduzione volume dissolvenza sfumatura normalizza'}">
                    <StackPanel>
                        <TextBlock Text="{local:T Riproduzione}" Style="{StaticResource CardTitle}"/>
                        <CheckBox Style="{StaticResource SettingSwitch}" IsChecked="{Binding Normalize}">
                            <StackPanel>
                                <TextBlock Text="{local:T 'Normalizza il volume'}"/>
                                <TextBlock Text="{local:T 'Tutti i brani allo stesso volume, anche se presi da siti diversi.'}" Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Crossfade}" AutomationProperties.Name="{local:T 'Dissolvenza tra i brani'}">
                            <StackPanel>
                                <TextBlock Text="{local:T 'Dissolvenza tra i brani'}"/>
                                <TextBlock Text="{local:T 'Il brano successivo entra mentre il primo sfuma, senza silenzi.'}" Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </CheckBox>
                        <Grid Margin="0,12,0,0" Visibility="{Binding Crossfade, Converter={StaticResource BoolVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{local:T Durata}" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <Slider Grid.Column="1" Minimum="1" Maximum="12" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="1"
                                    Value="{Binding CrossfadeSeconds}" VerticalAlignment="Center" AutomationProperties.Name="{local:T 'Durata dissolvenza'}"/>
                            <TextBlock Grid.Column="2" Text="{Binding CrossfadeText}" Margin="14,0,0,0" VerticalAlignment="Center" MinWidth="36"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ==================================================== downloads -->
                <Border Style="{StaticResource Card}" Padding="22" views:SettingsView.Keywords="{local:T 'download formato mp3 m4a opus flac qualità video cookie browser chrome firefox edge cartella musica'}">
                    <StackPanel>
                        <TextBlock Text="{local:T Download}" Style="{StaticResource CardTitle}"/>

                        <TextBlock Text="{local:T 'Cartella della musica (condivisa da tutti i profili)'}" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource BoxTextBox}" Text="{Binding MusicDir, Mode=OneWay}" IsReadOnly="True"/>
                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="{local:T 'Sfoglia…'}" Margin="8,0,0,0" Command="{Binding BrowseCommand}"/>
                            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="{local:T Apri}" Margin="8,0,0,0" Command="{Binding OpenMusicDirCommand}"/>
                        </Grid>

                        <UniformGrid Columns="2" Margin="0,0,0,4">
                            <StackPanel Margin="0,0,8,12">
                                <TextBlock Text="{local:T 'Formato audio'}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding AudioFormats}" SelectedItem="{Binding AudioFormat}"/>
                            </StackPanel>
                            <StackPanel Margin="8,0,0,12">
                                <TextBlock Text="{local:T 'Qualità massima dei video'}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding VideoQualities}" SelectedItem="{Binding VideoQuality}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,12">
                                <TextBlock Text="{local:T 'Download contemporanei'}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding ParallelChoices}" SelectedItem="{Binding Parallel}"/>
                            </StackPanel>
                        </UniformGrid>

                        <CheckBox Style="{StaticResource SettingSwitch}" IsChecked="{Binding PreferAudioOnly}">
                            <StackPanel>
                                <TextBlock Text="{local:T 'Preferisci solo l\'audio'}"/>
                                <TextBlock Text="{local:T 'Il video si può sempre scegliere al momento del download.'}" Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </CheckBox>

                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding UseCookies}">
                            <StackPanel>
                                <TextBlock Text="{local:T 'Usa i cookie del browser'}"/>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="{local:T 'Per contenuti che richiedono l\'accesso (Instagram, TikTok, limite d\'età, playlist private). Disattivato di norma.'}"/>
                            </StackPanel>
                        </CheckBox>
                        <StackPanel Width="280" HorizontalAlignment="Left" Margin="0,12,0,0" Visibility="{Binding UseCookies, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{local:T 'Browser (quelli installati)'}" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding BrowserChoices}" SelectedItem="{Binding Browser}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ==================================================== tags -->
                <Border Style="{StaticResource Card}" Padding="22" Tag="whole" views:SettingsView.Keywords="{local:T 'tag etichette colore colori'}">
                    <StackPanel>
                        <TextBlock Text="{local:T Tag}" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{local:T 'Etichette colorate solo per questo profilo: mettile ai brani e alle playlist col tasto destro, o selezionando più brani.'}"
                                   Style="{StaticResource Hint}" Margin="0,-8,0,12"/>
                        <ItemsControl ItemsSource="{Binding DataContext.Tags, RelativeSource={RelativeSource AncestorType=Window}}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TagViewModel}">
                                    <Border x:Name="Row" CornerRadius="8" Padding="10,4,4,4" Background="Transparent">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="13" Content="&#xE74D;"
                                                    Command="{Binding DataContext.DeleteTagCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                    ToolTip="{local:T 'Elimina tag'}" AutomationProperties.Name="{local:T 'Elimina tag'}"/>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="13" Content="&#xE70F;"
                                                    Command="{Binding DataContext.EditTagCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                    ToolTip="{local:T 'Modifica nome e colore'}" AutomationProperties.Name="{local:T 'Modifica tag'}"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" FontSize="12.5" Foreground="{StaticResource MutedBrush}"
                                                       VerticalAlignment="Center" Margin="10,0,8,0"/>
                                            <Ellipse Width="12" Height="12" Fill="{Binding Brush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource RowHoverBrush}"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{local:T 'Nessun tag, per ora.'}" Style="{StaticResource Hint}" Margin="2,0,0,4"
                                   Visibility="{Binding DataContext.HasTags, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InvBoolVis}}"/>
                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                Command="{Binding DataContext.NewTagCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}"/>
                                <TextBlock Text="{local:T 'Nuovo tag'}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- ==================================================== bulk edit -->
                <Border Style="{StaticResource Card}" Padding="22" Tag="whole" views:SettingsView.Keywords="{local:T 'artista artisti rinomina nomi modifica'}">
                    <StackPanel>
                        <TextBlock Text="{local:T 'Modifica di massa'}" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{local:T 'Un artista scaricato con il nome sbagliato? Sceglilo e rinominalo su tutti i suoi brani.'}"
                                   Style="{StaticResource Hint}" Margin="0,-8,0,12"/>
                        <TextBox Style="{StaticResource FilterBox}" Text="{Binding ArtistFilter, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="{local:T 'Cerca un artista'}" AutomationProperties.Name="{local:T 'Cerca un artista'}"/>
                        <Border Margin="0,8,0,10" CornerRadius="10" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" Padding="4" Height="190">
                            <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Artists}" SelectedItem="{Binding SelectedArtist}"
                                     AutomationProperties.Name="{local:T Artisti}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:Choice}">
                                        <Border x:Name="Row" CornerRadius="7" Padding="10,6" Background="Transparent">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Hint}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0"/>
                                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{StaticResource RowHoverBrush}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource BoxTextBox}" Text="{Binding NewArtistName, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="{local:T 'Nuovo nome dell\'artista'}" AutomationProperties.Name="{local:T 'Nuovo nome dell\'artista'}"/>
                            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="{local:T Rinomina}" Margin="8,0,0,0"
                                    Command="{Binding RenameArtistCommand}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ==================================================== library -->
                <Border Style="{StaticResource Card}" Padding="22" Tag="whole" views:SettingsView.Keywords="{local:T 'importa aggiungi file cartella computer'}">
                    <StackPanel>
                        <TextBlock Text="{local:T 'Musica già sul computer'}" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{local:T 'Aggiungi file audio o video che hai già: restano dove sono. Puoi anche trascinarli nella finestra.'}"
                                   Style="{StaticResource Hint}" Margin="0,-8,0,14"/>
                        <WrapPanel>
                            <Button Style="{StaticResource GhostButton}" Command="{Binding ImportFilesCommand}" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8E5;" Style="{StaticResource Glyph}"/>
                                    <TextBlock Text="{local:T 'Aggiungi file…'}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Command="{Binding ImportFolderCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;" Style="{StaticResource Glyph}"/>
                                    <TextBlock Text="{local:T 'Aggiungi una cartella…'}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- ==================================================== profiles & app -->
                <Border Style="{StaticResource Card}" Padding="22" views:SettingsView.Keywords="{local:T 'profilo profili avvio icona orologio chiudi sottofondo'}">
                    <StackPanel>
                        <TextBlock Text="{local:T 'Profili e avvio'}" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{local:T 'All\'avvio'}" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding StartupChoices}" SelectedItem="{Binding StartupProfile}" AutomationProperties.Name="{local:T 'All\'avvio'}"/>
                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Command="{Binding ManageProfilesCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE716;" Style="{StaticResource Glyph}"/>
                                    <TextBlock Text="{local:T 'Gestisci profili'}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CloseToTray}">
                            <StackPanel>
                                <TextBlock Text="{local:T 'Chiudendo la finestra, continua a suonare'}"/>
                                <TextBlock Text="{local:T 'Resta vicino all\'orologio e usa pochissime risorse; i tasti multimediali funzionano anche lì.'}"
                                           Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- ==================================================== integrations -->
                <Border Style="{StaticResource Card}" Padding="22" views:SettingsView.Keywords="{local:T 'discord stato attività'}">
                    <StackPanel>
                        <TextBlock Text="{local:T Integrazioni}" Style="{StaticResource CardTitle}"/>
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding DiscordPresence}" IsEnabled="{Binding DiscordAvailable}">
                            <StackPanel>
                                <TextBlock Text="{local:T 'Mostra su Discord cosa ascolti'}"/>
                                <TextBlock Text="{local:T 'Titolo, artista, copertina e avanzamento del brano nel tuo profilo Discord (con Discord aperto).'}"
                                           Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- ==================================================== updates -->
                <Border Style="{StaticResource Card}" Padding="22" views:SettingsView.Keywords="{local:T 'aggiornamenti aggiorna versione github motori yt-dlp gallery-dl dati'}">
                    <StackPanel>
                        <TextBlock Text="{local:T Aggiornamenti}" Style="{StaticResource CardTitle}"/>
                        <CheckBox Style="{StaticResource SettingSwitch}" IsChecked="{Binding AutoUpdateApp}">
                            <StackPanel>
                                <TextBlock Text="{local:T 'Aggiorna automaticamente l\'app'}"/>
                                <TextBlock Text="{local:T 'Scarica da sola l\'ultima versione e la installa alla chiusura.'}" Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </CheckBox>
                        <DockPanel Margin="0,0,0,16">
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding CheckAppUpdateCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE777;" Style="{StaticResource Glyph}"/>
                                    <TextBlock Text="{local:T 'Aggiorna ora'}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="{Binding Version}"/>
                                <TextBlock Text="{Binding Host.Updates.Status}" Style="{StaticResource Hint}"
                                           Visibility="{Binding Host.Updates.Status, Converter={StaticResource NotNullVis}}"/>
                            </StackPanel>
                        </DockPanel>
                        <CheckBox Style="{StaticResource SettingSwitch}" IsChecked="{Binding AutoUpdateEngines}">
                            <StackPanel>
                                <TextBlock Text="{local:T 'Aggiorna i motori di download'}"/>
                                <TextBlock Text="{local:T 'I siti cambiano spesso: yt-dlp e gallery-dl si aggiornano una volta al giorno.'}" Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </CheckBox>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding UpdateEnginesCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE895;" Style="{StaticResource Glyph}"/>
                                    <TextBlock Text="{local:T 'Aggiorna motori'}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding EngineInfo}" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </DockPanel>
                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,18"/>
                        <Button Style="{StaticResource LinkButton}" Content="{local:T 'Apri la cartella dei dati'}" Command="{Binding OpenDataDirCommand}"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </views:MasonryPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
