<UserControl x:Class="UltimateMP3Player.Views.DjSongPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UltimateMP3Player"
             xmlns:vm="clr-namespace:UltimateMP3Player.ViewModels">
    <UserControl.Resources>
        <!-- one song: the chosen one is unmistakable (accent bar, tinted row, tick, bold title) -->
        <DataTemplate x:Key="PickRow" DataType="{x:Type vm:TrackViewModel}">
            <Border x:Name="Row" CornerRadius="9" Padding="4,5,12,5" Margin="0,0,6,2" Background="Transparent" local:Marquee.Host="True"
                    BorderThickness="1" BorderBrush="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="28"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="Bar" CornerRadius="2" Margin="0,3" Background="{DynamicResource AccentGradient}" Visibility="Hidden"/>
                    <ContentPresenter Grid.Column="1" Width="42" Height="42" Margin="8,0,0,0" Content="{Binding}" ContentTemplate="{StaticResource TrackCoverSmall}"/>
                    <StackPanel Grid.Column="2" Margin="14,0,10,0" VerticalAlignment="Center">
                        <TextBlock x:Name="Title" Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" local:Marquee.IsEnabled="True"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <!-- in the cloud: downloaded for the deck when it's loaded -->
                            <TextBlock Text="&#xE753;" Style="{StaticResource Glyph}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,6,0"
                                       VerticalAlignment="Center" Visibility="{Binding IsCloud, Converter={StaticResource BoolVis}}"
                                       ToolTip="{local:T 'Non è salvato sul dispositivo: si scarica quando lo carichi sul deck'}"/>
                            <TextBlock Text="{Binding Artist}" FontSize="12.5" Foreground="{StaticResource SubTextBrush}" TextTrimming="CharacterEllipsis"
                                       local:Marquee.IsEnabled="True"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="{Binding BpmText}" FontSize="13" Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <TextBlock Grid.Column="4" Text="{Binding DurationText}" FontSize="13" Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                    <Grid x:Name="Check" Grid.Column="5" Width="20" Height="20" HorizontalAlignment="Right" Visibility="Hidden">
                        <Ellipse Fill="{DynamicResource AccentGradient}"/>
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="11" Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource RowHoverBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, FallbackValue=False}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                    <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Title" Property="FontWeight" Value="SemiBold"/>
                    <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel Width="780">
        <DockPanel Margin="0,0,0,10">
            <ComboBox x:Name="Source" DockPanel.Dock="Right" Width="230" Margin="10,0,0,0" SelectionChanged="Source_Changed"
                      AutomationProperties.Name="{local:T 'Da dove'}"/>
            <TextBox x:Name="Filter" Style="{StaticResource FilterBox}" Tag="{local:T 'Cerca per titolo, artista o #tag'}" TextChanged="Filter_Changed"
                     PreviewKeyDown="Filter_KeyDown" AutomationProperties.Name="{local:T 'Cerca nei brani'}"/>
        </DockPanel>
        <!-- shortcuts: the song playing, the other deck's song, a file -->
        <WrapPanel x:Name="Quick" Margin="0,0,0,6"/>

        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,4,24,8" Margin="0,4,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="28"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{local:T TITOLO}" Style="{StaticResource SmallCaps}" Margin="12,0,0,0"/>
                <TextBlock Grid.Column="1" Text="BPM" Style="{StaticResource SmallCaps}" HorizontalAlignment="Right" Margin="0,0,14,0"/>
                <TextBlock Grid.Column="2" Text="&#xE823;" Style="{StaticResource Glyph}" FontSize="12" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
        <Grid Height="420">
            <ListBox x:Name="List" Style="{StaticResource PlainList}" ItemTemplate="{StaticResource PickRow}" SelectionMode="Single"
                     MouseDoubleClick="List_DoubleClick" SelectionChanged="List_SelectionChanged" AutomationProperties.Name="{local:T Brani}"/>
            <StackPanel x:Name="Empty" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="30" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock Text="{local:T 'Nessun brano trovato'}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>
        <TextBlock x:Name="Hint" Style="{StaticResource Hint}" Margin="4,10,0,0"/>
    </StackPanel>
</UserControl>
