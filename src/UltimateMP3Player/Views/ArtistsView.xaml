<UserControl x:Class="UltimateMP3Player.Views.ArtistsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UltimateMP3Player"
             xmlns:views="clr-namespace:UltimateMP3Player.Views">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="28,8,20,28">
                <Grid Margin="0,0,8,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="148" Height="148" CornerRadius="74" Background="{DynamicResource AccentGradient}">
                        <TextBlock Text="&#xE77B;" Style="{StaticResource Glyph}" FontSize="56" Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Bottom">
                        <TextBlock Text="{local:T LIBRARY}" Style="{StaticResource SmallCaps}" Foreground="{DynamicResource SubTextBrush}"/>
                        <TextBlock Text="{local:T Artists}" FontSize="40" FontWeight="Bold" Margin="0,2,0,8"/>
                        <TextBlock Text="{Binding FollowedText}" Foreground="{DynamicResource SubTextBrush}"/>
                    </StackPanel>
                </Grid>

                <!-- find one by name (Deezer's artists) -->
                <StackPanel Orientation="Horizontal" Margin="0,0,8,20">
                    <TextBox Style="{StaticResource FilterBox}" Width="320" VerticalAlignment="Center" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                             Tag="{local:T 'Find an artist'}" KeyDown="Find_KeyDown" AutomationProperties.Name="{local:T 'Find an artist'}"/>
                    <Button Style="{StaticResource GhostButton}" Padding="16,8" Margin="10,0,0,0" Command="{Binding FindCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}"/>
                            <TextBlock Text="{local:T Search}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{local:T 'Searching…'}" Style="{StaticResource Hint}" Margin="14,0,0,0" VerticalAlignment="Center"
                               Visibility="{Binding Finding, Converter={StaticResource BoolVis}}"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Found}" ItemTemplate="{StaticResource ArtistCard}" ItemsPanel="{StaticResource CardGridTemplate}" Margin="0,0,8,30"
                              Visibility="{Binding HasFound, Converter={StaticResource BoolVis}}"/>

                <StackPanel Visibility="{Binding HasReleases, Converter={StaticResource BoolVis}}">
                    <DockPanel LastChildFill="False" Margin="0,0,8,0">
                        <TextBlock Text="{local:T 'New releases'}" Style="{StaticResource SectionTitle}"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="{local:T 'Mark all as seen'}" VerticalAlignment="Center"
                                Command="{Binding SeeAllCommand}" Visibility="{Binding HasNew, Converter={StaticResource BoolVis}}"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Releases}" ItemTemplate="{StaticResource ReleaseCard}" ItemsPanel="{StaticResource CardGridTemplate}" Margin="0,0,8,30"/>
                </StackPanel>

                <TextBlock Text="{local:T 'Artists you follow'}" Style="{StaticResource SectionTitle}"/>
                <ItemsControl ItemsSource="{Binding Followed}" ItemTemplate="{StaticResource ArtistCard}" ItemsPanel="{StaticResource CardGridTemplate}" Margin="0,0,8,30"
                              Visibility="{Binding HasFollowed, Converter={StaticResource BoolVis}}"/>
                <Border Style="{StaticResource Card}" Padding="22" Margin="0,0,8,30" Visibility="{Binding HasFollowed, Converter={StaticResource InvBoolVis}}">
                    <TextBlock Style="{StaticResource Hint}" FontSize="14" LineHeight="21"
                               Text="{local:T 'Follow the artists you like: their new albums and songs show up here and in Home, with a notification.'}"/>
                </Border>

                <StackPanel Visibility="{Binding HasSuggested, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{local:T 'You listen to them often'}" Style="{StaticResource SectionTitle}"/>
                    <ItemsControl ItemsSource="{Binding Suggested}" ItemTemplate="{StaticResource ArtistCard}" ItemsPanel="{StaticResource CardGridTemplate}" Margin="0,0,8,0"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
