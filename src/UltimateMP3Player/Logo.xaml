<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- App logo, 256x256, symmetric. tools\make-images.ps1 renders the icon and installer images from it. -->
    <DrawingGroup x:Key="LogoDrawing">
        <GeometryDrawing>
            <GeometryDrawing.Brush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#6D4DFF" Offset="0"/>
                    <GradientStop Color="#A54CF5" Offset="0.5"/>
                    <GradientStop Color="#FF4FA3" Offset="1"/>
                </LinearGradientBrush>
            </GeometryDrawing.Brush>
            <GeometryDrawing.Geometry>
                <RectangleGeometry Rect="0,0,256,256" RadiusX="62" RadiusY="62"/>
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing>
            <GeometryDrawing.Brush>
                <RadialGradientBrush Center="0.3,0.12" GradientOrigin="0.3,0.12" RadiusX="0.75" RadiusY="0.6">
                    <GradientStop Color="#40FFFFFF" Offset="0"/>
                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                </RadialGradientBrush>
            </GeometryDrawing.Brush>
            <GeometryDrawing.Geometry>
                <RectangleGeometry Rect="0,0,256,256" RadiusX="62" RadiusY="62"/>
            </GeometryDrawing.Geometry>
        </GeometryDrawing>

        <DrawingGroup>
        <DrawingGroup.Transform>
            <TranslateTransform Y="-11"/>
        </DrawingGroup.Transform>
        <!-- soft shadow under the white shapes -->
        <DrawingGroup Opacity="0.22">
            <DrawingGroup.Transform>
                <TranslateTransform Y="5"/>
            </DrawingGroup.Transform>
            <GeometryDrawing Geometry="M 58,150 A 70,70 0 0 1 198,150">
                <GeometryDrawing.Pen>
                    <Pen Brush="#2A0B4A" Thickness="17" StartLineCap="Round" EndLineCap="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Brush="#2A0B4A">
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <RectangleGeometry Rect="40,134,42,72" RadiusX="19" RadiusY="19"/>
                        <RectangleGeometry Rect="174,134,42,72" RadiusX="19" RadiusY="19"/>
                        <RectangleGeometry Rect="98,154,15,32" RadiusX="7.5" RadiusY="7.5"/>
                        <RectangleGeometry Rect="120.5,138,15,64" RadiusX="7.5" RadiusY="7.5"/>
                        <RectangleGeometry Rect="143,154,15,32" RadiusX="7.5" RadiusY="7.5"/>
                    </GeometryGroup>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingGroup>

        <!-- headphones and equalizer -->
        <GeometryDrawing Geometry="M 58,150 A 70,70 0 0 1 198,150">
            <GeometryDrawing.Pen>
                <Pen Brush="White" Thickness="17" StartLineCap="Round" EndLineCap="Round"/>
            </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Brush="White">
            <GeometryDrawing.Geometry>
                <GeometryGroup>
                    <RectangleGeometry Rect="40,134,42,72" RadiusX="19" RadiusY="19"/>
                    <RectangleGeometry Rect="174,134,42,72" RadiusX="19" RadiusY="19"/>
                    <RectangleGeometry Rect="98,154,15,32" RadiusX="7.5" RadiusY="7.5"/>
                    <RectangleGeometry Rect="120.5,138,15,64" RadiusX="7.5" RadiusY="7.5"/>
                    <RectangleGeometry Rect="143,154,15,32" RadiusX="7.5" RadiusY="7.5"/>
                </GeometryGroup>
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
        </DrawingGroup>
    </DrawingGroup>

    <DrawingImage x:Key="LogoImage" Drawing="{StaticResource LogoDrawing}"/>

    <!-- Icon of the .ump packs, 256x256: a page with a folded corner and the logo, a coloured card behind it (a "pack").
         tools\make-images.ps1 renders pack.ico from it. -->
    <DrawingGroup x:Key="PackDrawing">
        <!-- the card behind -->
        <DrawingGroup>
            <DrawingGroup.Transform>
                <TransformGroup>
                    <RotateTransform Angle="-11" CenterX="128" CenterY="136"/>
                    <TranslateTransform X="-22" Y="4"/>
                </TransformGroup>
            </DrawingGroup.Transform>
            <GeometryDrawing Geometry="M 82,24 L 192,24 A 22,22 0 0 1 214,46 L 214,218 A 22,22 0 0 1 192,240 L 82,240 A 22,22 0 0 1 60,218 L 60,46 A 22,22 0 0 1 82,24 Z">
                <GeometryDrawing.Brush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#6D4DFF" Offset="0"/>
                        <GradientStop Color="#A54CF5" Offset="0.55"/>
                        <GradientStop Color="#FF4FA3" Offset="1"/>
                    </LinearGradientBrush>
                </GeometryDrawing.Brush>
            </GeometryDrawing>
        </DrawingGroup>
        <!-- soft shadow of the page on the card -->
        <GeometryDrawing Brush="#33140A30" Geometry="M 70,22 L 166,22 L 220,76 L 220,222 A 22,22 0 0 1 198,244 L 70,244 A 22,22 0 0 1 48,222 L 48,44 A 22,22 0 0 1 70,22 Z"/>
        <!-- the page -->
        <GeometryDrawing Geometry="M 76,16 L 166,16 L 220,70 L 220,218 A 22,22 0 0 1 198,240 L 76,240 A 22,22 0 0 1 54,218 L 54,38 A 22,22 0 0 1 76,16 Z">
            <GeometryDrawing.Brush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFFFFF" Offset="0"/>
                    <GradientStop Color="#EEEAFB" Offset="1"/>
                </LinearGradientBrush>
            </GeometryDrawing.Brush>
            <GeometryDrawing.Pen>
                <Pen Brush="#40241A4F" Thickness="3" LineJoin="Round"/>
            </GeometryDrawing.Pen>
        </GeometryDrawing>
        <!-- the folded corner -->
        <GeometryDrawing Geometry="M 166,16 L 166,54 A 16,16 0 0 0 182,70 L 220,70 Z">
            <GeometryDrawing.Brush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#D4CCF4" Offset="0"/>
                    <GradientStop Color="#BDB1EC" Offset="1"/>
                </LinearGradientBrush>
            </GeometryDrawing.Brush>
            <GeometryDrawing.Pen>
                <Pen Brush="#40241A4F" Thickness="3" LineJoin="Round"/>
            </GeometryDrawing.Pen>
        </GeometryDrawing>
        <!-- the logo on the page, with a little shadow -->
        <GeometryDrawing Brush="#26241A4F">
            <GeometryDrawing.Geometry>
                <RectangleGeometry Rect="81,105,112,112" RadiusX="27" RadiusY="27"/>
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <ImageDrawing ImageSource="{StaticResource LogoImage}" Rect="81,99,112,112"/>
    </DrawingGroup>

    <DrawingImage x:Key="PackImage" Drawing="{StaticResource PackDrawing}"/>
</ResourceDictionary>
