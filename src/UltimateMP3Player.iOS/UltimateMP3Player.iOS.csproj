<Project Sdk="Microsoft.NET.Sdk">

  <!-- Ultimate MP3 Player for iPhone (and iPad): the Android app's pages, sheets and touch (linked from there: the few
       Android-only lines are marked ANDROID_APP), with what talks to iOS in Platform\: the sound through an AudioQueue, the
       decoders and the tags of AudioToolbox and AVFoundation, the lock screen, the Files app, the life of the app.
       Built with .NET 10 on macOS by GitHub Actions (.github\workflows\ios.yml) into an unsigned .ipa that SideStore signs
       on the phone with the user's Apple ID; on Windows `dotnet build` checks the C# (the .app needs Xcode).
       No downloads yet: iOS can't start programs (yt-dlp, ffmpeg); they'll come with Python inside the app. -->
  <PropertyGroup>
    <!-- The iOS 26 bindings, not the newest (27): GitHub's macOS runners have Xcode 26, and the newest pack needs its Xcode. -->
    <TargetFramework>net10.0-ios26.0</TargetFramework>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>UltimateMP3Player</AssemblyName>
    <RootNamespace>UltimateMP3Player</RootNamespace>
    <!-- SideStore may add a suffix to it (a free Apple ID): the code never relies on it. -->
    <ApplicationId>com.kirbohq.ultimatemp3player</ApplicationId>
    <ApplicationTitle>Ultimate MP3 Player</ApplicationTitle>
    <!-- Keep equal to the other projects; the build number as on Android (3.7.2 → 30702). -->
    <Version>4.4.1</Version>
    <ApplicationDisplayVersion>4.4.1</ApplicationDisplayVersion>
    <ApplicationVersion>40401</ApplicationVersion>
    <Product>Ultimate MP3 Player</Product>
    <AssemblyTitle>Ultimate MP3 Player</AssemblyTitle>
    <Description>Offline music player that downloads songs and playlists from almost any site</Description>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- CA1416/CA1422: iOS APIs newer or older than the minimum (AVAsset's synchronous properties still work). CS0618:
         Avalonia's obsolete APIs still in use, as in the other apps. The DJ and Listen together view models come along but
         aren't used. -->
    <NoWarn>$(NoWarn);CA1416;CA1422;AVLN3001;CS0618</NoWarn>
    <DefineConstants>$(DefineConstants);AVALONIA;IOS_APP</DefineConstants>
    <!-- Only the system's libraries trimmed: the view models are bound by name (reflection), like on Android (so the
         trimming warnings about the app's own code don't apply). -->
    <MtouchLink Condition="'$(Configuration)' == 'Release'">SdkOnly</MtouchLink>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>

    <!-- Same as the Windows project. -->
    <GitHubRepo>KirboHQ/UltimateMP3Player</GitHubRepo>
    <DiscordAppId>1553571296665804911</DiscordAppId>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="GitHubRepo" Value="$(GitHubRepo)" />
    <AssemblyMetadata Include="DiscordAppId" Value="$(DiscordAppId)" />
  </ItemGroup>

  <!-- UIKit's UIButton, Foundation's NSObject... next to Avalonia's: iOS types are written in full or imported by file. -->
  <ItemGroup>
    <Using Remove="Foundation" />
    <Using Remove="UIKit" />
    <Using Remove="CoreGraphics" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.iOS" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="NLayer.NAudioSupport" Version="2.0.1" />
    <PackageReference Include="SoundTouch.Net" Version="2.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UltimateMP3Player.Core\UltimateMP3Player.Core.csproj" />
  </ItemGroup>

  <!-- Shared with the Windows app. -->
  <ItemGroup>
    <Compile Include="..\UltimateMP3Player\ViewModels\*.cs" Link="Shared\ViewModels\%(Filename)%(Extension)" />
    <Compile Include="..\UltimateMP3Player\Audio\Mixer.cs" Link="Shared\Audio\Mixer.cs" />
    <Compile Include="..\UltimateMP3Player\Audio\Sources.cs" Link="Shared\Audio\Sources.cs" />
    <Compile Include="..\UltimateMP3Player\Audio\AudioEngine.cs" Link="Shared\Audio\AudioEngine.cs" />
    <Compile Include="..\UltimateMP3Player\Audio\DjEngine.cs" Link="Shared\Audio\DjEngine.cs" />
    <Compile Include="..\UltimateMP3Player\Services\AppInfo.cs" Link="Shared\Services\AppInfo.cs" />
    <Compile Include="..\UltimateMP3Player\Services\LyricsService.cs" Link="Shared\Services\LyricsService.cs" />
  </ItemGroup>

  <!-- Shared with the Linux/macOS app. -->
  <ItemGroup>
    <Compile Include="..\UltimateMP3Player.Avalonia\Shims\WpfShims.cs" Link="Shared\Avalonia\WpfShims.cs" />
    <Compile Include="..\UltimateMP3Player.Avalonia\Infrastructure.cs" Link="Shared\Avalonia\Infrastructure.cs" />
    <Compile Include="..\UltimateMP3Player.Avalonia\Themes.cs" Link="Shared\Avalonia\Themes.cs" />
    <Compile Include="..\UltimateMP3Player.Avalonia\Audio\Decoders.cs" Link="Shared\Avalonia\Decoders.cs" />
    <Compile Include="..\UltimateMP3Player.Avalonia\Views\Controls.cs" Link="Shared\Avalonia\Controls.cs" />
    <Compile Include="..\UltimateMP3Player.Avalonia\Views\Marquee.cs" Link="Shared\Avalonia\Marquee.cs" />
    <Compile Include="..\UltimateMP3Player.Avalonia\Views\Tweener.cs" Link="Shared\Avalonia\Tweener.cs" />
    <Compile Include="..\UltimateMP3Player.Avalonia\Views\WaveformBar.cs" Link="Shared\Avalonia\WaveformBar.cs" />
    <Compile Include="..\UltimateMP3Player.Avalonia\Views\LyricsView.cs" Link="Shared\Avalonia\LyricsView.cs" />
    <Compile Include="..\UltimateMP3Player.Avalonia\Views\LyricsCaptions.cs" Link="Shared\Avalonia\LyricsCaptions.cs" />
    <Compile Include="..\UltimateMP3Player.Avalonia\Views\VideoView.cs" Link="Shared\Avalonia\VideoView.cs" />
    <Compile Include="..\UltimateMP3Player.Avalonia\Views\CoverSheen.cs" Link="Shared\Avalonia\CoverSheen.cs" />
    <Compile Include="..\UltimateMP3Player.Avalonia\Views\CoverGlow.cs" Link="Shared\Avalonia\CoverGlow.cs" />
    <Compile Include="..\UltimateMP3Player.Avalonia\Views\EqCurve.cs" Link="Shared\Avalonia\EqCurve.cs" />
    <Compile Include="..\UltimateMP3Player.Avalonia\Views\RowSwipe.cs" Link="Shared\Avalonia\RowSwipe.cs" />
    <Compile Include="..\UltimateMP3Player.Avalonia\Views\WhatsNew.cs" Link="Shared\Avalonia\WhatsNew.cs" />
    <!-- the recap (stories): the same view as Linux/macOS -->
    <AvaloniaXaml Include="..\UltimateMP3Player.Avalonia\Views\RecapView.axaml" Link="Shared\Avalonia\RecapView.axaml" />
    <Compile Include="..\UltimateMP3Player.Avalonia\Views\RecapView.axaml.cs" Link="Shared\Avalonia\RecapView.axaml.cs" />
    <AvaloniaXaml Include="..\UltimateMP3Player.Avalonia\Theme.axaml" Link="Theme.axaml" />
  </ItemGroup>

  <!-- Shared with the Android app: the phone's screen (App, AppHost, the pages, the sheets, menus and touch). -->
  <ItemGroup>
    <AvaloniaXaml Include="..\UltimateMP3Player.Android\App.axaml" Link="App.axaml" />
    <Compile Include="..\UltimateMP3Player.Android\App.axaml.cs" Link="App.axaml.cs" />
    <Compile Include="..\UltimateMP3Player.Android\AppHost.cs" Link="AppHost.cs" />
    <Compile Include="..\UltimateMP3Player.Android\Platform\Stubs.cs" Link="Shared\Phone\Stubs.cs" />
    <Compile Include="..\UltimateMP3Player.Android\Platform\SiteLogins.Shared.cs" Link="Shared\Phone\SiteLogins.Shared.cs" />
    <Compile Include="..\UltimateMP3Player.Android\Platform\WebJs.Shared.cs" Link="Shared\Phone\WebJs.Shared.cs" />
    <AvaloniaXaml Include="..\UltimateMP3Player.Android\Views\*.axaml" Link="Views\%(Filename)%(Extension)" />
    <Compile Include="..\UltimateMP3Player.Android\Views\*.cs" Link="Views\%(Filename)%(Extension)" />
    <AvaloniaXaml Include="..\UltimateMP3Player.Android\Mobile\*.axaml" Link="Mobile\%(Filename)%(Extension)" />
    <Compile Include="..\UltimateMP3Player.Android\Mobile\*.cs" Link="Mobile\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\UltimateMP3Player.Avalonia\Assets\Fonts\**" Link="Assets\Fonts\%(RecursiveDir)%(Filename)%(Extension)" />
    <AvaloniaResource Include="..\UltimateMP3Player.Avalonia\Assets\app-256.png" Link="Assets\app-256.png" />
    <AvaloniaResource Include="..\UltimateMP3Player.Avalonia\Assets\pack-256.png" Link="Assets\pack-256.png" />
  </ItemGroup>

  <!-- The licenses (the app's own GPL-3.0 and the third-party ones), in the app's licenses folder. -->
  <ItemGroup>
    <BundleResource Include="..\..\LICENSE" Link="licenses\LICENSE.txt" />
    <BundleResource Include="..\..\licenses\*" Link="licenses\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The app's part of Python (Platform\Python.cs). Python itself, yt-dlp, certifi and LAME are put into the .app by
       tools/ios-deps.sh when the .ipa is made (.github/workflows/ios.yml): not in git. -->
  <ItemGroup>
    <BundleResource Include="Python\ump_ios.py" Link="python\app\ump_ios.py" />
  </ItemGroup>

</Project>
