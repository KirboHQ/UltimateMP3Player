<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UltimateMP3Player"
             x:Class="UltimateMP3Player.App"
             RequestedThemeVariant="Dark"
             Name="Ultimate MP3 Player">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://UltimateMP3Player/Theme.axaml"/>
                <ResourceInclude Source="avares://UltimateMP3Player/Views/Templates.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme/>
        <StyleInclude Source="avares://UltimateMP3Player/Views/TemplateStyles.axaml"/>

        <!-- The text styles of the Windows app's Theme.xaml (there: Style="{StaticResource Glyph}", here: Classes="glyph"). -->
        <Style Selector="TextBlock.glyph">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="local:Ui.GrayText" Value="True"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.glyph.filled">
            <Setter Property="FontFamily" Value="{StaticResource IconFontFilled}"/>
        </Style>
        <Style Selector="TextBlock.field-label">
            <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,0,0,6"/>
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style Selector="TextBlock.small-caps">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="18"/>
        </Style>

        <!-- Rotating arc used while analyzing. -->
        <Style Selector="Ellipse.spinner">
            <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="StrokeThickness" Value="4"/>
            <Setter Property="StrokeDashArray" Value="9,24"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <!-- it turns by itself (Views.Spinners) -->
        </Style>

        <!-- Every text field of the app selects with the accent. -->
        <Style Selector="TextBox">
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
    </Application.Styles>
</Application>
