<UserControl x:Class="UltimateMP3Player.Views.HomeView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UltimateMP3Player"
             xmlns:vm="clr-namespace:UltimateMP3Player.ViewModels"
             xmlns:views="clr-namespace:UltimateMP3Player.Views">
    <UserControl.Styles>
        <Style Selector="Border.newcard">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.newcard:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        </Style>
    </UserControl.Styles>
    <Panel>
        <Border Height="260" VerticalAlignment="Top" Background="{DynamicResource HeaderGlow}" IsHitTestVisible="False"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel x:Name="HomeRows" Margin="28,12,20,28">
                <TextBlock Text="{Binding Greeting}" FontSize="30" FontWeight="Bold" Margin="0,4,0,22"/>

                <!-- December to mid January: the year's recap -->
                <Border CornerRadius="16" Padding="24,20" Margin="0,0,8,26" Cursor="Hand" Background="{DynamicResource AccentGradient}"
                        TextElement.Foreground="{DynamicResource OnAccentBrush}" IsVisible="{Binding HasRecap}" views:Click.Command="{Binding OpenRecapCommand}">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" CornerRadius="20" Padding="20,10" Background="{DynamicResource OnAccentBrush}" VerticalAlignment="Center">
                            <TextBlock Text="{local:T Open}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock DockPanel.Dock="Left" Text="{local:Icon E787}" Classes="glyph" FontSize="34" Margin="0,0,20,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{local:T RECAP}" FontSize="12" FontWeight="Bold" Opacity="0.85"/>
                            <TextBlock Text="{Binding RecapTitle}" FontSize="24" FontWeight="Bold" Margin="0,2,0,2" TextWrapping="Wrap"/>
                            <TextBlock Text="{local:T 'Your songs, your artists, your minutes: page after page, like stories.'}" Opacity="0.9" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- first run -->
                <Border Theme="{StaticResource Card}" Padding="28" Margin="0,0,8,24" IsVisible="{Binding IsEmpty}">
                    <Grid ColumnDefinitions="Auto,*">
                        <Image Source="/Assets/app-256.png" Width="96" Height="96" VerticalAlignment="Top" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                        <StackPanel Grid.Column="1" Margin="24,0,0,0">
                            <TextBlock Text="{local:T 'Your music, offline and ad-free'}" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Classes="hint" FontSize="14" LineHeight="21" Margin="0,8,0,16"
                                       Text="{local:T 'Paste the link to a song or playlist in Search (YouTube Music, Spotify, SoundCloud, YouTube, TikTok, Instagram and almost any other site): it gets downloaded and saved here. You can also add music you already have on your computer, or drag files into the window.'}"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Theme="{StaticResource PrimaryButton}" Padding="18,10"
                                        Command="{Binding $parent[Window].DataContext.PasteLinkCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{local:Icon E77F}" Classes="glyph"/>
                                        <TextBlock Text="{local:T 'Paste a link'}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Theme="{StaticResource GhostButton}" Padding="18,10" Margin="10,0,0,0"
                                        Command="{Binding $parent[Window].DataContext.ImportCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{local:Icon E8E5}" Classes="glyph"/>
                                        <TextBlock Text="{local:T 'Add files from your computer'}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <!-- coming from Spotify or Last.fm: the library, the playlists and the plays -->
                            <TextBlock Classes="hint" FontSize="13" Margin="0,20,0,10" TextWrapping="Wrap"
                                       Text="{local:T 'Coming from Spotify or Last.fm? Bring your liked songs, your playlists and your plays.'}"/>
                            <WrapPanel>
                                <Button Theme="{StaticResource GhostButton}" Padding="16,9" Margin="0,0,10,0" Command="{Binding ImportSpotifyCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{local:Icon E8E5}" Classes="glyph"/>
                                        <TextBlock Text="{local:T 'Import from Spotify'}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Theme="{StaticResource GhostButton}" Padding="16,9" Command="{Binding ImportLastFmCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{local:Icon E8E5}" Classes="glyph"/>
                                        <TextBlock Text="{local:T 'Import from Last.fm'}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- one row each, scrolling sideways: its arrows, its bar (Shelf, in Controls.cs) -->
                <views:Shelf Tag="recent" Title="{local:T 'Recently played'}" Items="{Binding Recent}" IsVisible="{Binding HasRecent}">
                    <ListBox x:Name="RecentList" Theme="{StaticResource BareList}" ItemTemplate="{StaticResource TrackCard}" ItemsPanel="{StaticResource CardRowTemplate}"/>
                </views:Shelf>

                <!-- for you: mixes made from what you listen to -->
                <views:Shelf Tag="foryou" Title="{local:T 'For you'}" Items="{Binding ForYou}" IsVisible="{Binding HasForYou}">
                    <ItemsControl ItemTemplate="{StaticResource MixCard}" ItemsPanel="{StaticResource CardRowTemplate}"/>
                </views:Shelf>

                <!-- the followed artists' new releases -->
                <views:Shelf Tag="releases" Title="{local:T 'New releases'}" Items="{Binding Artists.Releases}" IsVisible="{Binding Artists.HasReleases}">
                    <ItemsControl ItemTemplate="{StaticResource ReleaseCard}" ItemsPanel="{StaticResource CardRowTemplate}"/>
                </views:Shelf>

                <!-- the saved radios -->
                <views:Shelf Tag="radios" Title="{local:T 'Your radios'}" Items="{Binding Stations.Saved}" IsVisible="{Binding Stations.HasSaved}">
                    <ItemsControl ItemTemplate="{StaticResource StationCard}" ItemsPanel="{StaticResource CardRowTemplate}"/>
                </views:Shelf>

                <views:Shelf Tag="playlists" Title="{local:T 'Your playlists'}" Items="{Binding PlaylistCards}">
                    <ListBox x:Name="PlaylistList" Theme="{StaticResource BareList}" ItemsPanel="{StaticResource CardRowTemplate}">
                        <ListBox.DataTemplates>
                            <DataTemplate DataType="vm:PlaylistViewModel">
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PlaylistCard}"/>
                            </DataTemplate>
                            <DataTemplate DataType="vm:NewPlaylistCard">
                                <Border Classes="newcard" CornerRadius="12" Cursor="Hand" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1.5"
                                        views:Click.Command="{Binding $parent[Window].DataContext.NewPlaylistCommand}">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="{local:Icon E710}" Classes="glyph" FontSize="26" HorizontalAlignment="Center" Foreground="{DynamicResource SubTextBrush}"/>
                                        <TextBlock Text="{local:T 'New playlist'}" Margin="0,10,0,0" Foreground="{DynamicResource SubTextBrush}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.DataTemplates>
                    </ListBox>
                </views:Shelf>

                <!-- ("Show all": the library, they may be thousands) -->
                <views:Shelf Tag="added" Title="{local:T 'Recently added'}" MoreLabel="{local:T 'Show all'}" Items="{Binding RecentlyAdded}" IsVisible="{Binding HasRecentlyAdded}"
                             MoreCommand="{Binding $parent[Window].DataContext.GoLibraryCommand}">
                    <ListBox x:Name="AddedList" Theme="{StaticResource BareList}" ItemTemplate="{StaticResource TrackCard}" ItemsPanel="{StaticResource CardRowTemplate}"/>
                </views:Shelf>
            </StackPanel>
        </ScrollViewer>
        <!-- what's selected in one of the lists (Ctrl or Shift + click): songs or playlists -->
        <views:SelectionBar List="{Binding #RecentList}" ZIndex="1"/>
        <views:SelectionBar List="{Binding #PlaylistList}" ZIndex="1"/>
        <views:SelectionBar List="{Binding #AddedList}" ZIndex="1"/>
    </Panel>
</UserControl>
