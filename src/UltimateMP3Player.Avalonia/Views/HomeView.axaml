<UserControl x:Class="UltimateMP3Player.Views.HomeView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UltimateMP3Player"
             xmlns:vm="clr-namespace:UltimateMP3Player.ViewModels"
             xmlns:views="clr-namespace:UltimateMP3Player.Views">
    <UserControl.Styles>
        <Style Selector="Border.newcard">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.newcard:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        </Style>
    </UserControl.Styles>
    <Panel>
        <Border Height="260" VerticalAlignment="Top" Background="{DynamicResource HeaderGlow}" IsHitTestVisible="False"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="28,12,20,28">
                <TextBlock Text="{Binding Greeting}" FontSize="30" FontWeight="Bold" Margin="0,4,0,22"/>

                <!-- December to mid January: the year's recap -->
                <Border CornerRadius="16" Padding="24,20" Margin="0,0,8,26" Cursor="Hand" Background="{DynamicResource AccentGradient}"
                        TextElement.Foreground="{DynamicResource OnAccentBrush}" IsVisible="{Binding HasRecap}" views:Click.Command="{Binding OpenRecapCommand}">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" CornerRadius="20" Padding="20,10" Background="{DynamicResource OnAccentBrush}" VerticalAlignment="Center">
                            <TextBlock Text="{local:T Open}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock DockPanel.Dock="Left" Text="{local:Icon E787}" Classes="glyph" FontSize="34" Margin="0,0,20,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{local:T RECAP}" FontSize="12" FontWeight="Bold" Opacity="0.85"/>
                            <TextBlock Text="{Binding RecapTitle}" FontSize="24" FontWeight="Bold" Margin="0,2,0,2" TextWrapping="Wrap"/>
                            <TextBlock Text="{local:T 'Your songs, your artists, your minutes: page after page, like stories.'}" Opacity="0.9" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- first run -->
                <Border Theme="{StaticResource Card}" Padding="28" Margin="0,0,8,24" IsVisible="{Binding IsEmpty}">
                    <Grid ColumnDefinitions="Auto,*">
                        <Image Source="/Assets/app-256.png" Width="96" Height="96" VerticalAlignment="Top" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                        <StackPanel Grid.Column="1" Margin="24,0,0,0">
                            <TextBlock Text="{local:T 'Your music, offline and ad-free'}" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Classes="hint" FontSize="14" LineHeight="21" Margin="0,8,0,16"
                                       Text="{local:T 'Paste the link to a song or playlist in the bar at the top (YouTube Music, Spotify, SoundCloud, YouTube, TikTok, Instagram and almost any other site): it gets downloaded and saved here. You can also add music you already have on your computer, or drag files into the window.'}"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Theme="{StaticResource PrimaryButton}" Padding="18,10"
                                        Command="{Binding $parent[Window].DataContext.PasteLinkCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{local:Icon E77F}" Classes="glyph"/>
                                        <TextBlock Text="{local:T 'Paste a link'}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Theme="{StaticResource GhostButton}" Padding="18,10" Margin="10,0,0,0"
                                        Command="{Binding $parent[Window].DataContext.ImportCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{local:Icon E8E5}" Classes="glyph"/>
                                        <TextBlock Text="{local:T 'Add files from your computer'}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- card grids end 8 px before the right margin, level with the welcome card: same space left and right -->
                <StackPanel IsVisible="{Binding HasRecent}">
                    <TextBlock Text="{local:T 'Recently played'}" Classes="section-title"/>
                    <ListBox x:Name="RecentList" Theme="{StaticResource BareList}" ItemsSource="{Binding Recent}" ItemTemplate="{StaticResource TrackCard}"
                             ItemsPanel="{StaticResource CardGridTemplate}" Margin="0,0,8,30"/>
                </StackPanel>

                <!-- for you: mixes made from what you listen to -->
                <StackPanel IsVisible="{Binding HasForYou}">
                    <TextBlock Text="{local:T 'For you'}" Classes="section-title"/>
                    <ItemsControl ItemsSource="{Binding ForYou}" ItemTemplate="{StaticResource MixCard}" ItemsPanel="{StaticResource CardGridTemplate}" Margin="0,0,8,30"/>
                </StackPanel>

                <!-- the followed artists' new releases: one row, the rest on the Artists page -->
                <StackPanel IsVisible="{Binding Artists.HasReleases}">
                    <DockPanel LastChildFill="False" Margin="0,0,8,0">
                        <TextBlock Text="{local:T 'New releases'}" Classes="section-title"/>
                        <Button DockPanel.Dock="Right" Theme="{StaticResource LinkButton}" Content="{local:T 'Show all|f'}" VerticalAlignment="Center"
                                Command="{Binding $parent[Window].DataContext.GoArtistsCommand}"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Artists.Releases}" ItemTemplate="{StaticResource ReleaseCard}" Margin="0,0,8,30">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <views:CardGrid MaxRows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <!-- the saved radios: one row, the rest on the Radio page -->
                <StackPanel IsVisible="{Binding Stations.HasSaved}">
                    <DockPanel LastChildFill="False" Margin="0,0,8,0">
                        <TextBlock Text="{local:T 'Your radios'}" Classes="section-title"/>
                        <Button DockPanel.Dock="Right" Theme="{StaticResource LinkButton}" Content="{local:T 'Show all|f'}" VerticalAlignment="Center"
                                Command="{Binding $parent[Window].DataContext.GoStationsCommand}"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Stations.Saved}" ItemTemplate="{StaticResource StationCard}" Margin="0,0,8,30">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <views:CardGrid MaxRows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <TextBlock Text="{local:T 'Your playlists'}" Classes="section-title"/>
                <ListBox x:Name="PlaylistList" Theme="{StaticResource BareList}" ItemsSource="{Binding PlaylistCards}" ItemsPanel="{StaticResource CardGridTemplate}"
                         Margin="0,0,8,30">
                    <ListBox.DataTemplates>
                        <DataTemplate DataType="vm:PlaylistViewModel">
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PlaylistCard}"/>
                        </DataTemplate>
                        <DataTemplate DataType="vm:NewPlaylistCard">
                            <Border Classes="newcard" CornerRadius="12" Cursor="Hand" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1.5"
                                    views:Click.Command="{Binding $parent[Window].DataContext.NewPlaylistCommand}">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{local:Icon E710}" Classes="glyph" FontSize="26" HorizontalAlignment="Center" Foreground="{DynamicResource SubTextBrush}"/>
                                    <TextBlock Text="{local:T 'New playlist'}" Margin="0,10,0,0" Foreground="{DynamicResource SubTextBrush}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.DataTemplates>
                </ListBox>

                <StackPanel IsVisible="{Binding HasRecentlyAdded}">
                    <DockPanel LastChildFill="False" Margin="0,0,8,0">
                        <TextBlock Text="{local:T 'Recently added'}" Classes="section-title"/>
                        <Button DockPanel.Dock="Right" Theme="{StaticResource LinkButton}" Content="{local:T 'Show all'}" VerticalAlignment="Center"
                                Command="{Binding $parent[Window].DataContext.GoLibraryCommand}"/>
                    </DockPanel>
                    <ListBox x:Name="AddedList" Theme="{StaticResource BareList}" ItemsSource="{Binding RecentlyAdded}" ItemTemplate="{StaticResource TrackRowTemplate}"
                             Margin="0,0,8,0"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <!-- what's selected in one of the lists (Ctrl or Shift + click): songs or playlists -->
        <views:SelectionBar List="{Binding #RecentList}" ZIndex="1"/>
        <views:SelectionBar List="{Binding #PlaylistList}" ZIndex="1"/>
        <views:SelectionBar List="{Binding #AddedList}" ZIndex="1"/>
    </Panel>
</UserControl>
