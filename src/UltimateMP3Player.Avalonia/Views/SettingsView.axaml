<UserControl x:Class="UltimateMP3Player.Views.SettingsView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UltimateMP3Player"
             xmlns:vm="clr-namespace:UltimateMP3Player.ViewModels"
             xmlns:views="clr-namespace:UltimateMP3Player.Views">
    <UserControl.Resources>
        <ControlTheme x:Key="SettingSwitch" TargetType="CheckBox" BasedOn="{StaticResource Switch}">
            <Setter Property="Margin" Value="0,0,0,16"/>
        </ControlTheme>
        <!-- Big button with an icon and two lines (help card). -->
        <ControlTheme x:Key="SupportTile" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" CornerRadius="12" Background="{DynamicResource BgBrush}" BorderBrush="Transparent"
                            BorderThickness="1" Padding="14">
                        <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#Bd">
                <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            </Style>
            <Style Selector="^:focus-visible /template/ Border#Bd">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            </Style>
            <Style Selector="^:pressed /template/ Border#Bd">
                <Setter Property="Opacity" Value="0.85"/>
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Opacity" Value="0.45"/>
            </Style>
        </ControlTheme>
        <!-- A theme of the palette: a dot, ringed when chosen. -->
        <ControlTheme x:Key="ThemePill" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Pill" CornerRadius="19" Padding="6,0,16,0" Background="{DynamicResource Surface2Brush}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="26" Height="26" Fill="{Binding Swatch}"/>
                            <TextBlock Text="{Binding Label}" Margin="9,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#Pill">
                <Setter Property="Background" Value="{DynamicResource Surface3Brush}"/>
            </Style>
            <Style Selector="^.selected /template/ Border#Pill">
                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
            </Style>
        </ControlTheme>
        <ControlTheme x:Key="ThemeSwatch" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel Background="Transparent">
                        <Ellipse Name="Ring" Stroke="{DynamicResource TextBrush}" StrokeThickness="2" Opacity="0"/>
                        <Ellipse Margin="5" Fill="{Binding Swatch}"/>
                    </Panel>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Ellipse#Ring">
                <Setter Property="Opacity" Value="0.45"/>
            </Style>
            <Style Selector="^.selected /template/ Ellipse#Ring">
                <Setter Property="Opacity" Value="1"/>
            </Style>
        </ControlTheme>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBlock.card-title">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <!-- A word that's a link among grey words: underlined, and lit under the mouse (LinkButton's). -->
        <Style Selector="Button.greylink">
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style Selector="Button.greylink:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextHoverBrush}"/>
        </Style>
        <Style Selector="StackPanel.dims:disabled">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
        <Style Selector="Border.hoverrow">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.hoverrow:pointerover">
            <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
        </Style>
        <Style Selector="ListBoxItem:selected Border.hoverrow">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
        </Style>
    </UserControl.Styles>


    <Grid ColumnDefinitions="280,*">
        <!-- The title, the search and the groups on the left, one group open on the right, like an iPad's settings; the search looks in all of them (SettingsView.Apply). -->
        <Grid Margin="14,6,0,0" RowDefinitions="Auto,Auto,*">
            <TextBlock Text="{local:T Settings}" FontSize="30" FontWeight="Bold" Margin="6,0,12,16"/>
            <TextBox x:Name="SearchBox" Grid.Row="1" Theme="{StaticResource FilterBox}" Margin="0,0,12,14"
                     Watermark="{local:T 'Search settings'}" AutomationProperties.Name="{local:T 'Search settings'}"/>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False">
                <Panel Margin="0,0,12,20">
                    <views:SlidingPill Target="{Binding #Groups}" Fill="{DynamicResource Surface2Brush}"/>
                    <StackPanel x:Name="Groups">
                        <RadioButton Theme="{StaticResource NavButton}" GroupName="SettingsGroups" local:Ui.Glyph="&#xE890;" Content="{local:T Appearance}" Tag="appearance" IsChecked="True"/>
                        <RadioButton Theme="{StaticResource NavButton}" GroupName="SettingsGroups" local:Ui.Glyph="&#xE768;" Content="{local:T Playback}" Tag="playback"/>
                        <RadioButton Theme="{StaticResource NavButton}" GroupName="SettingsGroups" local:Ui.Glyph="&#xE896;" Content="{local:T Download}" Tag="download"/>
                        <RadioButton Theme="{StaticResource NavButton}" GroupName="SettingsGroups" local:Ui.Glyph="&#xE721;" Content="{local:T 'Search and suggestions'}" Tag="search"/>
                        <RadioButton Theme="{StaticResource NavButton}" GroupName="SettingsGroups" local:Ui.Glyph="&#xE8F1;" Content="{local:T Library}" Tag="library" Margin="0,14,0,1"/>
                        <RadioButton Theme="{StaticResource NavButton}" GroupName="SettingsGroups" local:Ui.Glyph="&#xE74E;" Content="{local:T 'Backup and export'}" Tag="backup"/>
                        <RadioButton Theme="{StaticResource NavButton}" GroupName="SettingsGroups" local:Ui.Glyph="&#xE716;" Content="{local:T 'Phone and rooms'}" Tag="connect" Margin="0,14,0,1"/>
                        <RadioButton Theme="{StaticResource NavButton}" GroupName="SettingsGroups" local:Ui.Glyph="&#xE714;" Content="{local:T 'Stream overlay'}" Tag="overlay"/>
                        <RadioButton Theme="{StaticResource NavButton}" GroupName="SettingsGroups" local:Ui.Glyph="&#xE71B;" Content="{local:T Integrations}" Tag="integrations"/>
                        <RadioButton Theme="{StaticResource NavButton}" GroupName="SettingsGroups" local:Ui.Glyph="&#xE77B;" Content="{local:T 'Profiles and startup'}" Tag="profiles" Margin="0,14,0,1"/>
                        <RadioButton Theme="{StaticResource NavButton}" GroupName="SettingsGroups" local:Ui.Glyph="&#xE946;" Content="{local:T About}" Tag="about"/>
                    </StackPanel>
                </Panel>
            </ScrollViewer>
        </Grid>
        <!-- One page per group (SettingsView.MakePages), sliding like the sidebar's pages; this one is the search's: it takes all the cards while there are words in the box. -->
        <views:AnimatedContent x:Name="Pages" Grid.Column="1">
            <views:AnimatedContent.Content>
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="8,6,28,28">
            <TextBlock x:Name="NoResults" Text="{local:T 'No setting matches the search.'}" Classes="hint" FontSize="14"
                       HorizontalAlignment="Left" Margin="0,30,0,0" IsVisible="False"/>

            <!-- SettingsView.Keywords: extra words (in the app language) the search box finds; Tag="whole": the card is shown or hidden as a whole -->
            <views:MasonryPanel x:Name="Cards" ColumnWidth="380" MaxColumns="3" MaxColumnWidth="880" Gap="16">

                <!-- ==================================================== appearance -->
                <Border Theme="{StaticResource Card}" views:SettingsView.Group="appearance" Padding="22" views:SettingsView.Keywords="{local:T 'theme colors light dark night mode'}">
                    <StackPanel>
                        <TextBlock Text="{local:T 'Theme (for this profile)'}" Classes="card-title"/>
                        <StackPanel>
                            <TextBlock Text="{local:T Dynamic}" Classes="hint" Margin="2,2,0,6"/>
                            <ItemsControl ItemsSource="{Binding MovingThemes}" Margin="0,0,0,6">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ThemeOption}">
                                        <Button Theme="{StaticResource ThemePill}" Classes.selected="{Binding IsSelected}" Height="38" Margin="0,0,8,8" AutomationProperties.Name="{Binding Label}" Command="{Binding $parent[UserControl].DataContext.SelectThemeCommand}" CommandParameter="{Binding Id}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid Margin="2,0,0,14" ColumnDefinitions="Auto,*,Auto" views:Fold.Open="{Binding IsRgbTheme}">
                                <TextBlock Text="{local:T Speed}" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <Slider Grid.Column="1" Minimum="1" Maximum="10" SmallChange="0.5" LargeChange="0.5" IsSnapToTickEnabled="True" TickFrequency="0.5"
                                        Value="{Binding RgbSpeed}" VerticalAlignment="Center" AutomationProperties.Name="{local:T 'RGB speed'}"/>
                                <TextBlock Grid.Column="2" Text="{Binding RgbSpeedText}" Margin="14,0,0,0" VerticalAlignment="Center" MinWidth="36"/>
                            </Grid>
                            <TextBlock Text="{local:T Colors}" Classes="hint" Margin="2,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding ColorThemes}" Margin="0,0,0,14">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ThemeOption}">
                                    <Button Theme="{StaticResource ThemeSwatch}" Classes.selected="{Binding IsSelected}" Width="38" Height="38" Margin="0,0,0,8" ToolTip.Tip="{Binding Label}" AutomationProperties.Name="{Binding Label}" Command="{Binding $parent[UserControl].DataContext.SelectThemeCommand}" CommandParameter="{Binding Id}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                        <views:ColorPicker Margin="0,-6,0,14" Hex="{Binding CustomColor}" views:Fold.Open="{Binding IsCustomTheme}"/>
                        <TextBlock Text="{Binding ThemeHint}" Classes="hint" Margin="0,-8,0,14" views:Fold.Open="{Binding HasThemeHint}"/>

                        <TextBlock Text="{local:T 'Light or dark'}" Classes="field-label"/>
                        <views:ChoiceTiles Picture="look" Items="{Binding Appearances}" Selected="{Binding Appearance}"/>
                    </StackPanel>
                </Border>

                <!-- the glass look: on or off in its title, like the bars of the music; its choices under it (Core Glass) -->
                <Border Theme="{StaticResource Card}" views:SettingsView.Group="appearance" Padding="22" views:SettingsView.Keywords="{local:T 'glass blur transparent translucent background cover frosted smoked acrylic grain panes edges borders rim'}">
                    <StackPanel>
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Theme="{StaticResource Switch}" IsChecked="{Binding GlassOn}" VerticalAlignment="Center"
                                      AutomationProperties.Name="{local:T Glass}"/>
                            <StackPanel>
                                <TextBlock Text="{local:T Glass}" FontSize="17" FontWeight="Bold"/>
                                <TextBlock Text="{local:T 'The window lies on the cover of the song playing, blurred, under panes of glass.'}" Classes="hint" Margin="0,4,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <!-- the picture behind (made again: GlassBackdrop), then the panes over it (the palette: Themes.Apply); one column of names for both -->
                        <StackPanel Margin="0,14,0,0" Grid.IsSharedSizeScope="True" views:Fold.Open="{Binding GlassOn}">
                            <TextBlock Text="{local:T Background}" Classes="field-label"/>
                            <views:ChoiceTiles Picture="glasspicture" Items="{Binding GlassPictures}" Selected="{Binding GlassPicture}"/>
                            <Grid Margin="0,14,0,0" RowDefinitions="Auto,Auto,Auto">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="GlassLabel"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{local:T Blur}" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <Slider Grid.Column="1" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" Value="{Binding GlassBlur}" VerticalAlignment="Center" AutomationProperties.Name="{local:T Blur}"/>
                                <TextBlock Grid.Column="2" Text="{Binding GlassBlurText}" Margin="14,0,0,0" VerticalAlignment="Center" MinWidth="36"/>
                                <TextBlock Grid.Row="1" Text="{local:T Brightness}" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Margin="0,12,14,0"/>
                                <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" Value="{Binding GlassBrightness}" VerticalAlignment="Center" Margin="0,12,0,0" AutomationProperties.Name="{local:T Brightness}"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding GlassBrightnessText}" Margin="14,12,0,0" VerticalAlignment="Center" MinWidth="36"/>
                                <TextBlock Grid.Row="2" Text="{local:T Color}" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Margin="0,12,14,0"/>
                                <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" Value="{Binding GlassVivid}" VerticalAlignment="Center" Margin="0,12,0,0" AutomationProperties.Name="{local:T Color}"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding GlassVividText}" Margin="14,12,0,0" VerticalAlignment="Center" MinWidth="36"/>
                            </Grid>
                            <CheckBox Theme="{StaticResource Switch}" IsChecked="{Binding GlassGrain}" Margin="0,12,0,0">
                                <TextBlock Text="{local:T Grain}"/>
                            </CheckBox>
                            <TextBlock Text="{local:T Panes}" Classes="field-label" Margin="2,20,0,6"/>
                            <views:ChoiceTiles Picture="glasstint" Items="{Binding GlassTints}" Selected="{Binding GlassTintChoice}"/>
                            <Grid Margin="0,14,0,0" RowDefinitions="Auto,Auto">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="GlassLabel"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{local:T Opacity}" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <Slider Grid.Column="1" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" Value="{Binding GlassPanes}" VerticalAlignment="Center" AutomationProperties.Name="{local:T 'Opacity of the panes'}"/>
                                <TextBlock Grid.Column="2" Text="{Binding GlassPanesText}" Margin="14,0,0,0" VerticalAlignment="Center" MinWidth="36"/>
                                <TextBlock Grid.Row="1" Text="{local:T Edges}" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Margin="0,12,14,0"/>
                                <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" Value="{Binding GlassRim}" VerticalAlignment="Center" Margin="0,12,0,0" AutomationProperties.Name="{local:T 'Edges of the panes'}"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding GlassRimText}" Margin="14,12,0,0" VerticalAlignment="Center" MinWidth="36"/>
                            </Grid>
                            <Button Theme="{StaticResource SubtleButton}" Padding="12,5" Margin="0,14,0,0" HorizontalAlignment="Right" Content="{local:T Reset}" Command="{Binding GlassResetCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- the layout: the bars floating or attached, the side bar's width, its pages and sections, Home's rows (Core Layout) -->
                <Border Theme="{StaticResource Card}" views:SettingsView.Group="appearance" Padding="22" views:SettingsView.Keywords="{local:T 'layout menu side bar width order position hide floating attached home rows sections customize'}">
                    <StackPanel>
                        <StackPanel.DataTemplates>
                            <!-- a page or a row: shown or not, dragged by its handle like the search's sites (SettingsView: LayoutRow_Moved) -->
                            <DataTemplate DataType="vm:LayoutRow">
                                <Border Name="Row" CornerRadius="8" Background="Transparent" Padding="0,2">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Background="Transparent" Cursor="SizeAll" VerticalAlignment="Center" Padding="12,10,8,10"
                                                ToolTip.Tip="{local:T 'Drag to change the order'}">
                                            <StackPanel Width="14" Spacing="3">
                                                <Border Height="2" CornerRadius="1" Background="{DynamicResource MutedBrush}"/>
                                                <Border Height="2" CornerRadius="1" Background="{DynamicResource MutedBrush}"/>
                                                <Border Height="2" CornerRadius="1" Background="{DynamicResource MutedBrush}"/>
                                            </StackPanel>
                                        </Border>
                                        <CheckBox Theme="{StaticResource Switch}" IsChecked="{Binding Shown}" IsEnabled="{Binding CanHide}" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Icon, Converter={StaticResource Icon}}" Classes="glyph" FontSize="15" Width="22" Margin="0,0,8,0" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </StackPanel.DataTemplates>
                        <StackPanel.Styles>
                            <Style Selector="ListBox.layout">
                                <Setter Property="Template">
                                    <ControlTemplate>
                                        <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"/>
                                    </ControlTemplate>
                                </Setter>
                            </Style>
                        </StackPanel.Styles>
                        <TextBlock Text="{local:T Layout}" Classes="card-title"/>
                        <TextBlock Text="{local:T 'Side bar and player bar'}" Classes="field-label"/>
                        <views:ChoiceTiles Picture="bars" Items="{Binding BarChoices}" Selected="{Binding BarChoice}"/>
                        <TextBlock Text="{Binding BarHint}" Classes="hint" FontSize="12" Margin="2,8,0,0"/>
                        <Grid Margin="0,14,0,0" ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Text="{local:T 'Side bar width'}" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <Slider Grid.Column="1" Minimum="220" Maximum="360" SmallChange="10" LargeChange="20" IsSnapToTickEnabled="True" TickFrequency="10" Value="{Binding SideWidth}"
                                    VerticalAlignment="Center" AutomationProperties.Name="{local:T 'Side bar width'}"/>
                            <TextBlock Grid.Column="2" Text="{Binding SideWidthText}" Margin="14,0,0,0" VerticalAlignment="Center" MinWidth="36"/>
                        </Grid>
                        <TextBlock Text="{local:T 'Pages of the side bar'}" Classes="field-label" Margin="2,16,0,4"/>
                        <ListBox x:Name="MenuRowList" ItemsSource="{Binding MenuRows}" Theme="{StaticResource PlainList}" Classes="layout" Focusable="False" DragDrop.AllowDrop="True"/>
                        <TextBlock Text="{local:T 'Sections of the side bar'}" Classes="field-label" Margin="2,14,0,4"/>
                        <ListBox x:Name="SectionRowList" ItemsSource="{Binding SectionRows}" Theme="{StaticResource PlainList}" Classes="layout" Focusable="False" DragDrop.AllowDrop="True"/>
                        <TextBlock Text="{local:T 'Rows of Home'}" Classes="field-label" Margin="2,14,0,4"/>
                        <ListBox x:Name="HomeRowList" ItemsSource="{Binding HomeRows}" Theme="{StaticResource PlainList}" Classes="layout" Focusable="False" DragDrop.AllowDrop="True"/>
                    </StackPanel>
                </Border>

                <!-- the song's bar: how it will look, its shapes -->
                <Border Theme="{StaticResource Card}" views:SettingsView.Group="appearance" Padding="22" Tag="whole" views:SettingsView.Keywords="{local:T 'song bar seek progress shape blocks dots line wave mirrored'}">
                    <StackPanel>
                        <TextBlock Text="{local:T 'Shape of the song bar'}" Classes="card-title"/>
                        <Border CornerRadius="12" Background="{DynamicResource BgBrush}" Padding="14,12" Margin="0,0,0,10">
                            <views:WaveformBar Height="30" Margin="0,10,0,0" Peaks="{Binding SeekSample}" Progress="0.4" Shape="{Binding SeekStyle}" Mirrored="{Binding SeekMirrored}" IsHitTestVisible="False"
                                               PlayedBrush="{DynamicResource ProgressGradient}" RestBrush="{DynamicResource WaveBrush}"/>
                        </Border>
                        <views:ChoiceTiles Picture="shape" Items="{Binding VisualizerStyles}" Selected="{Binding SeekStyleChoice}"/>
                        <CheckBox Theme="{StaticResource Switch}" IsChecked="{Binding SeekMirrored}" Margin="0,12,0,0">
                            <TextBlock Text="{local:T Mirrored}"/>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- the bars of the music: on or off in its title, like the equalizer -->
                <Border Theme="{StaticResource Card}" views:SettingsView.Group="appearance" Padding="22" Tag="whole" views:SettingsView.Keywords="{local:T 'visualizer bars waves music spectrum song view'}">
                    <StackPanel>
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Theme="{StaticResource Switch}" IsChecked="{Binding Visualizer}" VerticalAlignment="Center"
                                      AutomationProperties.Name="{local:T 'Bars of the music'}"/>
                            <StackPanel>
                                <TextBlock Text="{local:T 'Bars of the music'}" FontSize="17" FontWeight="Bold"/>
                                <TextBlock Text="{local:T 'In the song view, bars that follow the music, behind the title.'}" Classes="hint" Margin="0,4,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <StackPanel Margin="0,14,0,0" views:Fold.Open="{Binding Visualizer}">
                            <!-- what the song's page will show: the music playing, otherwise a made-up sound -->
                            <Border CornerRadius="12" Background="{DynamicResource BgBrush}" Height="76" Padding="14,10,14,0" ClipToBounds="True">
                                <views:WaveVisualizer IsPreview="True" HeightShare="1" Flow="{Binding NowPlaying.VisualizerFlow}" Place="{Binding NowPlaying.VisualizerPlace}" BarStyle="{Binding NowPlaying.VisualizerStyle}" Tint="{Binding NowPlaying.VisualizerTint}" Thickness="{Binding NowPlaying.VisualizerThickness}" Strength="{Binding NowPlaying.VisualizerStrength}"/>
                            </Border>
                            <TextBlock Text="{local:T 'Shape of the bars'}" Classes="field-label" Margin="2,14,0,6"/>
                            <views:ChoiceTiles Picture="shape" Items="{Binding VisualizerStyles}" Selected="{Binding VisualizerStyleChoice}"/>
                            <TextBlock Text="{local:T 'Direction of the bars'}" Classes="field-label" Margin="2,14,0,6"/>
                            <views:ChoiceTiles Picture="flow" TileWidth="150" Items="{Binding VisualizerFlows}" Selected="{Binding VisualizerFlowChoice}"/>
                            <TextBlock Text="{local:T 'Position of the bars'}" Classes="field-label" Margin="2,14,0,6"/>
                            <views:ChoiceTiles Picture="place" TileWidth="150" Items="{Binding VisualizerPlaces}" Selected="{Binding VisualizerPlaceChoice}"/>
                            <TextBlock Text="{local:T 'Color of the bars'}" Classes="field-label" Margin="2,14,0,6"/>
                            <views:ChoiceTiles Picture="tint" Items="{Binding VisualizerTints}" Selected="{Binding VisualizerTintChoice}"/>
                            <StackPanel views:Fold.Open="{Binding VisualizerHasThickness}">
                                <TextBlock Text="{Binding VisualizerThicknessLabel}" Classes="field-label" Margin="2,14,0,6"/>
                                <views:ChoiceTiles Picture="thickness" Items="{Binding VisualizerThicknesses}" Selected="{Binding VisualizerThicknessChoice}"/>
                            </StackPanel>
                            <Grid Margin="0,14,0,0" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                                <TextBlock Text="{local:T Height}" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <Slider Grid.Column="1" Minimum="0.15" Maximum="1" SmallChange="0.05" LargeChange="0.05" Value="{Binding VisualizerHeight}" VerticalAlignment="Center" AutomationProperties.Name="{local:T Height}"/>
                                <TextBlock Grid.Column="2" Text="{Binding VisualizerHeightText}" Margin="14,0,0,0" VerticalAlignment="Center" MinWidth="36"/>
                                <TextBlock Grid.Row="1" Text="{local:T Strength}" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Margin="0,12,14,0"/>
                                <Slider Grid.Row="1" Grid.Column="1" Minimum="0.2" Maximum="1" SmallChange="0.05" LargeChange="0.05" Value="{Binding VisualizerStrength}" VerticalAlignment="Center" Margin="0,12,0,0" AutomationProperties.Name="{local:T Strength}"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding VisualizerStrengthText}" Margin="14,12,0,0" VerticalAlignment="Center" MinWidth="36"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- the rest of how the app looks and moves -->
                <Border Theme="{StaticResource Card}" views:SettingsView.Group="appearance" Padding="22" views:SettingsView.Keywords="{local:T 'interface language english italian animations scrolling mouse wheel cover 3d parallax speed zoom size bigger smaller'}">
                    <StackPanel>
                        <TextBlock Text="{local:T Interface}" Classes="card-title"/>
                        <TextBlock Text="{local:T Language}" Classes="field-label"/>
                        <views:ChoiceTiles Margin="-4,0,-4,16" Items="{Binding Languages}" Selected="{Binding Language}"/>
                        <!-- the same as Ctrl+wheel, Ctrl + and - -->
                        <DockPanel Margin="0,0,0,18">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Theme="{StaticResource ControlButton}" Width="32" Height="32" FontSize="12" Content="{local:Icon E738}" Command="{Binding ZoomOutCommand}"
                                        ToolTip.Tip="{local:T Smaller}"/>
                                <Button Theme="{StaticResource SubtleButton}" Padding="8,4" MinWidth="58" HorizontalContentAlignment="Center" Content="{Binding ZoomText}" Command="{Binding ZoomResetCommand}"
                                        ToolTip.Tip="{local:T 'Back to 100% (Ctrl+0)'}"/>
                                <Button Theme="{StaticResource ControlButton}" Width="32" Height="32" FontSize="12" Content="{local:Icon E710}" Command="{Binding ZoomInCommand}"
                                        ToolTip.Tip="{local:T Bigger}"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{local:T 'Interface size'}"/>
                                <TextBlock Text="{local:T 'Ctrl + mouse wheel, or Ctrl + and Ctrl -, from any page.'}" Classes="hint"/>
                            </StackPanel>
                        </DockPanel>
                        <CheckBox Theme="{StaticResource SettingSwitch}" IsChecked="{Binding Animations}">
                            <StackPanel>
                                <TextBlock Text="{local:T Animations}"/>
                                <TextBlock Text="{local:T 'Smooth transitions between tabs. Turn them off if you prefer everything instant.'}" Classes="hint"/>
                            </StackPanel>
                        </CheckBox>
                        <Grid Margin="0,-6,0,18" ColumnDefinitions="Auto,*,Auto" views:Fold.Open="{Binding Animations}">
                            <TextBlock Text="{local:T Speed}" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <Slider Grid.Column="1" Minimum="0.25" Maximum="3" SmallChange="0.25" LargeChange="0.25" IsSnapToTickEnabled="True" TickFrequency="0.25"
                                    Value="{Binding AnimationSpeed}" VerticalAlignment="Center" AutomationProperties.Name="{local:T 'Animation speed'}"/>
                            <TextBlock Grid.Column="2" Text="{Binding AnimationSpeedText}" Margin="14,0,0,0" VerticalAlignment="Center" MinWidth="36"/>
                        </Grid>
                        <CheckBox Theme="{StaticResource SettingSwitch}" IsChecked="{Binding SmoothScrolling}">
                            <StackPanel>
                                <TextBlock Text="{local:T 'Smooth scrolling'}"/>
                                <TextBlock Text="{local:T 'The mouse wheel scrolls lists smoothly.'}" Classes="hint"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Theme="{StaticResource Switch}" IsChecked="{Binding CoverTilt}">
                            <StackPanel>
                                <TextBlock Text="{local:T '3D cover'}"/>
                                <TextBlock Text="{local:T 'In the song view, the cover tilts to follow your mouse.'}" Classes="hint"/>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- ==================================================== playback -->
                <Border Theme="{StaticResource Card}" views:SettingsView.Group="playback" Padding="22" views:SettingsView.Keywords="{local:T 'playback volume normalize output device speakers headphones'}">
                    <StackPanel>
                        <TextBlock Text="{local:T Playback}" Classes="card-title"/>
                        <TextBlock Text="{local:T 'Audio output'}" Classes="field-label"/>
                        <ComboBox ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding OutputDevice}" Margin="0,0,0,18"
                                  HorizontalAlignment="Stretch" AutomationProperties.Name="{local:T 'Audio output'}"/>
                        <CheckBox Theme="{StaticResource SettingSwitch}" IsChecked="{Binding Normalize}">
                            <StackPanel>
                                <TextBlock Text="{local:T 'Normalize volume'}"/>
                                <TextBlock Text="{local:T 'All songs at the same volume, even if they come from different sites.'}" Classes="hint"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Theme="{StaticResource Switch}" IsChecked="{Binding PlayWhileDownloading}">
                            <StackPanel>
                                <TextBlock Text="{local:T 'Start songs while they download'}"/>
                                <TextBlock Text="{local:T 'Songs in the cloud and suggested ones play right away, while they download, when nothing else is playing. Off: they wait for the whole file (less mobile data).'}" Classes="hint"/>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- from one song to the next -->
                <Border Theme="{StaticResource Card}" views:SettingsView.Group="playback" Padding="22" views:SettingsView.Keywords="{local:T 'crossfade fade transition bpm beat next song'}">
                    <StackPanel>
                        <TextBlock Text="{local:T 'Between songs'}" Classes="card-title"/>
                        <CheckBox Theme="{StaticResource Switch}" IsChecked="{Binding Crossfade}" AutomationProperties.Name="{local:T Crossfade}">
                            <StackPanel>
                                <TextBlock Text="{local:T Crossfade}"/>
                                <TextBlock Text="{local:T 'The next song fades in as the current one fades out, with no silence.'}" Classes="hint"/>
                            </StackPanel>
                        </CheckBox>
                        <Grid Margin="0,12,0,0" views:Fold.Open="{Binding Crossfade}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{local:T Duration}" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <Slider Grid.Column="1" Minimum="1" Maximum="12" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="1"
                                    Value="{Binding CrossfadeSeconds}" VerticalAlignment="Center" AutomationProperties.Name="{local:T 'Crossfade duration'}"/>
                            <TextBlock Grid.Column="2" Text="{Binding CrossfadeText}" Margin="14,0,0,0" VerticalAlignment="Center" MinWidth="36"/>
                        </Grid>
                        <CheckBox Theme="{StaticResource Switch}" IsChecked="{Binding BpmMatch}" Margin="0,14,0,0" AutomationProperties.Name="{local:T 'BPM-matched transition'}">
                            <StackPanel>
                                <TextBlock Text="{local:T 'BPM-matched transition'}"/>
                                <TextBlock Text="{local:T 'In its last seconds the song slows down or speeds up to the next one\'s BPM (without changing key), so they meet on the beat. Only when both BPMs are known and close.'}"
                                           Classes="hint" TextWrapping="Wrap"/>
                            </StackPanel>
                        </CheckBox>
                        <Grid Margin="0,12,0,0" views:Fold.Open="{Binding BpmMatch}" ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Text="{local:T Duration}" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <Slider Grid.Column="1" Minimum="2" Maximum="30" SmallChange="1" LargeChange="2" IsSnapToTickEnabled="True" TickFrequency="1"
                                    Value="{Binding BpmMatchSeconds}" VerticalAlignment="Center" AutomationProperties.Name="{local:T 'Length of the BPM-matched transition'}"/>
                            <TextBlock Grid.Column="2" Text="{Binding BpmMatchText}" Margin="14,0,0,0" VerticalAlignment="Center" MinWidth="36"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ==================================================== equalizer -->
                <Border Theme="{StaticResource Card}" views:SettingsView.Group="playback" Padding="22" DataContext="{Binding Equalizer}" Tag="whole"
                        views:SettingsView.Keywords="{local:T 'equalizer eq bass mids treble frequencies preset sound audio'}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <CheckBox DockPanel.Dock="Right" Theme="{StaticResource Switch}" IsChecked="{Binding Enabled}" VerticalAlignment="Center"
                                      AutomationProperties.Name="{local:T Equalizer}"/>
                            <StackPanel>
                                <TextBlock Text="{local:T Equalizer}" FontSize="17" FontWeight="Bold"/>
                                <TextBlock Text="{local:T 'Adjust bass, mids and treble. Double-click a band to reset it.'}"
                                           Classes="hint" Margin="0,4,0,0"/>
                            </StackPanel>
                        </DockPanel>

                        <StackPanel Classes="dims" IsEnabled="{Binding Enabled}">
                            <WrapPanel Margin="0,14,0,10">
                                <ComboBox Width="200" ItemsSource="{Binding Presets}" SelectedItem="{Binding Preset}" Margin="0,0,8,8"
                                          AutomationProperties.Name="Preset"/>
                                <Button Theme="{StaticResource GhostButton}" Command="{Binding SaveCommand}" Margin="0,0,8,8" ToolTip.Tip="{local:T 'Save as preset'}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{local:Icon E74E}" Classes="glyph"/>
                                        <TextBlock Text="{local:T Save}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Theme="{StaticResource GhostButton}" Command="{Binding DeleteCommand}" Margin="0,0,8,8"
                                        IsVisible="{Binding IsCustomPreset}" ToolTip.Tip="{local:T 'Delete preset'}">
                                    <TextBlock Text="{local:Icon E74D}" Classes="glyph"/>
                                </Button>
                                <Button Theme="{StaticResource SubtleButton}" Content="{local:T Reset}" Command="{Binding ResetCommand}" Margin="0,0,8,8"/>
                            </WrapPanel>

                            <Border CornerRadius="12" Background="{DynamicResource BgBrush}" Padding="10,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="180"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="1" Margin="0,0,6,0">
                                        <TextBlock Text="+12" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Top"/>
                                        <TextBlock Text="0" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        <TextBlock Text="-12" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Bottom"/>
                                    </Grid>
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Bands}" Margin="0,0,0,6">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:EqBandViewModel}">
                                                <TextBlock Text="{Binding GainText}" FontSize="11.5" HorizontalAlignment="Center" Foreground="{DynamicResource SubTextBrush}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Grid.Row="1" Grid.Column="1" Height="1" Background="{DynamicResource BorderStrongBrush}" VerticalAlignment="Center" Margin="4,0"/>
                                    <views:EqCurve Grid.Row="1" Grid.Column="1" Gains="{Binding Gains}" Version="{Binding CurveVersion}"
                                                   Stroke="{DynamicResource AccentTextBrush}" IsHitTestVisible="False"/>
                                    <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Bands}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:EqBandViewModel}">
                                                <Slider Theme="{StaticResource EqSlider}" Height="180" Value="{Binding Gain}" HorizontalAlignment="Center"
                                                        Classes="eqband"
                                                        AutomationProperties.Name="{Binding Label, StringFormat=Eq {0}}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Bands}" Margin="0,8,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:EqBandViewModel}">
                                                <TextBlock Text="{Binding Label}" FontSize="12" HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Grid.Row="2" Text="Hz" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,8,6,0"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ==================================================== downloads and temporary storage -->
                <Border Theme="{StaticResource Card}" views:SettingsView.Group="download" Padding="22" views:SettingsView.Keywords="{local:T 'downloads folder music save audio only simultaneous at once'}">
                    <StackPanel>
                        <TextBlock Text="{local:T Download}" Classes="card-title"/>
                        <TextBlock Text="{local:T 'Music folder (shared by all profiles)'}" Classes="field-label"/>
                        <StackPanel Margin="0,0,0,16">
                            <TextBox Theme="{StaticResource BoxTextBox}" Text="{Binding MusicDir, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="{local:T 'Music folder (shared by all profiles)'}"/>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Theme="{StaticResource GhostButton}" Content="{local:T 'Browse…'}" Margin="0,0,8,0" Command="{Binding BrowseCommand}"/>
                                <Button Theme="{StaticResource GhostButton}" Content="{local:T Open}" Command="{Binding OpenMusicDirCommand}"/>
                            </WrapPanel>
                        </StackPanel>
                        <CheckBox Theme="{StaticResource SettingSwitch}" IsChecked="{Binding SaveAudio}">
                            <StackPanel>
                                <TextBlock Text="{local:T 'Save the audio on your device'}"/>
                                <TextBlock Text="{local:T 'Songs you add from a link or a pack are downloaded. Off: they go into your library in the cloud, you listen from their link and save them whenever you like.'}" Classes="hint"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Theme="{StaticResource SettingSwitch}" IsChecked="{Binding PreferAudioOnly}">
                            <StackPanel>
                                <TextBlock Text="{local:T 'Prefer audio only'}"/>
                                <TextBlock Text="{local:T 'You can always choose the video when downloading.'}" Classes="hint"/>
                            </StackPanel>
                        </CheckBox>
                        <TextBlock Text="{local:T 'Simultaneous downloads'}" Classes="field-label"/>
                        <views:ChoiceTiles Numbers="True" Items="{Binding ParallelChoices}" Selected="{Binding Parallel}"/>
                    </StackPanel>
                </Border>

                <!-- quality -->
                <Border Theme="{StaticResource Card}" views:SettingsView.Group="download" Padding="22" views:SettingsView.Keywords="{local:T 'format mp3 m4a opus flac quality video resolution'}">
                    <StackPanel>
                        <TextBlock Text="{local:T Quality}" Classes="card-title"/>
                        <TextBlock Text="{local:T 'Audio format'}" Classes="field-label"/>
                        <views:ChoiceTiles Margin="-4,0,-4,12" Items="{Binding AudioFormats}" Selected="{Binding AudioFormat}"/>
                        <TextBlock Text="{local:T 'Maximum video quality'}" Classes="field-label"/>
                        <views:ChoiceTiles TileWidth="86" Items="{Binding VideoQualities}" Selected="{Binding VideoQuality}"/>
                    </StackPanel>
                </Border>

                <!-- storage -->
                <Border Theme="{StaticResource Card}" views:SettingsView.Group="download" Padding="22" Tag="whole" views:SettingsView.Keywords="{local:T 'storage space cache suggested cloud unsaved clear empty'}">
                    <StackPanel>
                        <TextBlock Text="{local:T 'Temporary storage (unsaved songs)'}" Classes="card-title"/>
                        <StackPanel>
                            <views:ChoiceTiles Numbers="True" Items="{Binding CacheChoices}" Selected="{Binding CacheSize}"/>
                            <TextBlock Classes="hint" Margin="0,8,0,0"
                                       Text="{local:T 'Songs you play without having saved them on your device (in the cloud, suggested, in rooms) stay ready for next time; beyond this number the oldest are deleted (never those in the queue). Saving one moves it out of here.'}"/>
                            <TextBlock Text="{Binding CacheText}" Classes="hint" Margin="0,4,0,10"/>
                            <WrapPanel>
                                <Button Margin="0,0,8,8" Theme="{StaticResource GhostButton}" Command="{Binding ClearCacheCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{local:Icon E74D}" Classes="glyph"/>
                                        <TextBlock Text="{local:T Empty}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Margin="0,0,8,8" Theme="{StaticResource GhostButton}" Command="{Binding OpenCacheCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{local:Icon E838}" Classes="glyph"/>
                                        <TextBlock Text="{local:T 'Open the folder'}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- sign-ins -->
                <Border Theme="{StaticResource Card}" views:SettingsView.Group="download" Padding="22" views:SettingsView.Keywords="{local:T 'cookies browser chrome firefox edge sign in login account private'}">
                    <StackPanel>
                        <TextBlock Text="{local:T Sign-ins}" Classes="card-title"/>
                        <CheckBox Theme="{StaticResource Switch}" IsChecked="{Binding UseCookies}">
                            <StackPanel>
                                <TextBlock Text="{local:T 'Use my sign-ins for downloads'}"/>
                                <TextBlock Classes="hint"
                                           Text="{local:T 'For content that requires signing in (Instagram, TikTok, age-restricted, private playlists). Off by default.'}"/>
                            </StackPanel>
                        </CheckBox>
                        <StackPanel Margin="0,12,0,0" views:Fold.Open="{Binding UseCookies}">
                            <TextBlock Text="{local:T 'Where the sign-ins come from'}" Classes="field-label"/>
                            <ComboBox Width="280" HorizontalAlignment="Left" ItemsSource="{Binding BrowserChoices}" SelectedItem="{Binding Browser}"
                                      AutomationProperties.Name="{local:T 'Where the sign-ins come from'}"/>
                            <DockPanel Margin="0,12,0,0" views:Fold.Open="{Binding UsesEachSite}">
                                <Button Theme="{StaticResource GhostButton}" Content="{local:T 'Sign in to sites'}" Click="Logins_Click"/>
                                <TextBlock Text="{Binding LoginsSummary}" Classes="hint" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ==================================================== search and suggestions -->
                <!-- online search -->
                <Border Theme="{StaticResource Card}" views:SettingsView.Group="search" Padding="22" views:SettingsView.Keywords="{local:T 'online search find sites youtube music soundcloud deezer spotify order'}">
                    <StackPanel>
                        <TextBlock Text="{local:T 'Online search'}" Classes="card-title"/>
                        <CheckBox Theme="{StaticResource SettingSwitch}" IsChecked="{Binding OnlineSearch}">
                            <StackPanel>
                                <TextBlock Text="{local:T 'Also search music sites'}"/>
                                <TextBlock Text="{local:T 'The search also finds songs you don\'t have: click one to download it, like a pasted link.'}"
                                           Classes="hint"/>
                            </StackPanel>
                        </CheckBox>
                        <StackPanel IsEnabled="{Binding OnlineSearch}">
                            <TextBlock Text="{local:T 'Sites, in order of preference'}" Classes="field-label"/>
                            <!-- dragged to another place like the songs of a playlist (SettingsView: ServiceList) -->
                            <ListBox x:Name="ServiceList" ItemsSource="{Binding SearchServices}" Theme="{StaticResource PlainList}" Focusable="False" Margin="0,0,0,10"
                                     DragDrop.AllowDrop="True">
                                <ListBox.Template>
                                    <ControlTemplate>
                                        <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"/>
                                    </ControlTemplate>
                                </ListBox.Template>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SearchServiceOption}">
                                        <Border Name="Row" CornerRadius="10" Background="{DynamicResource BgBrush}" BorderBrush="Transparent" BorderThickness="1"
                                                Padding="12,8,6,8" Margin="0,0,0,6">
                                            <DockPanel>
                                                <!-- the handle: three lines, like the phone's -->
                                                <Border DockPanel.Dock="Right" Background="Transparent" Cursor="SizeAll" VerticalAlignment="Center" Padding="10,8,8,8"
                                                        ToolTip.Tip="{local:T 'Drag to change the order: the sites higher up are searched first'}">
                                                    <StackPanel Width="14" Spacing="3">
                                                        <Border Height="2" CornerRadius="1" Background="{DynamicResource MutedBrush}"/>
                                                        <Border Height="2" CornerRadius="1" Background="{DynamicResource MutedBrush}"/>
                                                        <Border Height="2" CornerRadius="1" Background="{DynamicResource MutedBrush}"/>
                                                    </StackPanel>
                                                </Border>
                                                <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}">
                                                    <StackPanel Margin="2,0,0,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Number}" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                                            <Ellipse Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}" Classes="hint" FontSize="12"/>
                                                    </StackPanel>
                                                </CheckBox>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{local:T 'How to search'}" Classes="field-label"/>
                            <views:ChoiceTiles Picture="searchmode" TileWidth="150" Items="{Binding SearchModes}" Selected="{Binding SearchMode}"/>
                            <TextBlock Text="{Binding SearchModeHint}" Classes="hint" FontSize="12" Margin="2,8,0,0"/>
                            <DockPanel Margin="0,16,0,0">
                                <Button DockPanel.Dock="Right" Theme="{StaticResource GhostButton}" Command="{Binding SpotifyKeyCommand}" Content="{local:T 'Enter key…'}"
                                        VerticalAlignment="Center" Margin="12,0,0,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{local:T 'Spotify key'}"/>
                                    <TextBlock Text="{Binding SpotifyKeyText}" Classes="hint" FontSize="12"/>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Classes="hint" FontSize="12" Margin="2,8,0,0" Foreground="{DynamicResource MutedBrush}"
                                       Text="{local:T 'Spotify only answers apps with a key: with yours (free; your Spotify account needs Premium) the search finds Spotify\'s songs and artists too. Without one, Deezer has the same catalogue. The audio comes from YouTube Music, as for Spotify links.'}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- suggested songs -->
                <Border Theme="{StaticResource Card}" views:SettingsView.Group="search" Padding="22" views:SettingsView.Keywords="{local:T 'suggested suggestions similar radio automatic queue online discover new songs ahead'}">
                    <StackPanel>
                        <TextBlock Text="{local:T 'Suggested songs'}" Classes="card-title"/>
                        <CheckBox Theme="{StaticResource SettingSwitch}" IsChecked="{Binding RadioAfterSingle}">
                            <StackPanel>
                                <TextBlock Text="{local:T 'Outside a playlist, go on with similar songs'}"/>
                                <TextBlock Classes="hint"
                                           Text="{local:T 'A song started from the downloads, the search or on its own is followed by similar songs found online (with the automatic queue on). Off: all your songs follow it.'}"/>
                            </StackPanel>
                        </CheckBox>
                        <TextBlock Text="{local:T 'Where they come from'}" Classes="field-label"/>
                        <views:ChoiceTiles Items="{Binding RadioSourceChoices}" Selected="{Binding RadioSource}"/>
                        <TextBlock Text="{Binding RadioSourceHint}" Classes="hint" FontSize="12" Margin="2,8,0,14"/>
                        <TextBlock Text="{local:T 'Ready ahead'}" Classes="field-label"/>
                        <views:ChoiceTiles Numbers="True" Items="{Binding TogetherAheadChoices}" Selected="{Binding RadioAhead}"/>
                        <TextBlock Classes="hint" FontSize="12" Margin="2,12,0,0" Foreground="{DynamicResource MutedBrush}"
                                   Text="{local:T 'From any song: right-click → Play similar songs. They\'re downloaded shortly before their turn, as in Listen together and into the same storage, and don\'t go into your library: to keep one, right-click → Save to library.'}"/>
                        <!-- the artists left out (song or artist menu › Don't suggest), each with its X -->
                        <TextBlock Text="{local:T 'Artists never suggested'}" Classes="field-label" Margin="0,18,0,6"/>
                        <ItemsControl ItemsSource="{Binding UnsuggestedArtists}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="hoverrow" CornerRadius="8" Padding="10,4,4,4">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Theme="{StaticResource IconButton}" Width="30" Height="30" FontSize="13" Content="{local:Icon E711}"
                                                    Command="{Binding $parent[UserControl].DataContext.SuggestAgainCommand}" CommandParameter="{Binding}"
                                                    ToolTip.Tip="{local:T 'Suggest again'}" AutomationProperties.Name="{local:T 'Suggest again'}"/>
                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{local:T 'None yet: from a song\'s menu (More) or an artist\'s, “Don\'t suggest”. Their songs stay out of the suggested ones; searched or played by hand, they play as always.'}"
                                   Classes="hint" FontSize="12" Margin="2,0,0,0" IsVisible="{Binding !HasUnsuggested}"/>
                    </StackPanel>
                </Border>

                <!-- lyrics -->
                <Border Theme="{StaticResource Card}" views:SettingsView.Group="search" Padding="22" views:SettingsView.Keywords="{local:T 'lyrics text words karaoke lrclib synced timing'}">
                    <StackPanel>
                        <TextBlock Text="{local:T 'Song lyrics'}" Classes="card-title"/>
                        <CheckBox Theme="{StaticResource SettingSwitch}" IsChecked="{Binding AutoLyrics}">
                            <StackPanel>
                                <TextBlock Text="{local:T 'Find lyrics automatically'}"/>
                                <TextBlock Text="{local:T 'For newly downloaded songs and for the ones you play, if they were never searched. When a song has lyrics, the Lyrics button appears on its page.'}"
                                           Classes="hint"/>
                            </StackPanel>
                        </CheckBox>
                        <TextBlock Text="{local:T 'In your library'}" Classes="field-label"/>
                        <TextBlock Text="{Binding LyricsStats}" Margin="0,0,0,12" TextWrapping="Wrap"/>
                        <!-- the missing ones of the whole library, one at a time -->
                        <Button Theme="{StaticResource GhostButton}" HorizontalAlignment="Left" Command="{Binding ScanLyricsCommand}"
                                IsVisible="{Binding !Lyrics.IsScanning}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{local:Icon E720}" Classes="glyph"/>
                                <TextBlock Text="{local:T 'Find missing lyrics'}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Grid IsVisible="{Binding Lyrics.IsScanning}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock Text="{Binding Lyrics.ScanText}" FontSize="12.5" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis"/>
                                <ProgressBar Maximum="1" Value="{Binding Lyrics.ScanProgress, Mode=OneWay}" Margin="0,7,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Theme="{StaticResource GhostButton}" Content="{local:T Stop}" Command="{Binding Lyrics.StopScanCommand}"/>
                        </Grid>
                        <TextBlock Classes="hint" FontSize="12" Margin="2,14,0,0" Foreground="{DynamicResource MutedBrush}"
                                   Text="{local:T 'Lyrics come from LRCLIB, a free and open archive. Synced lyrics light up line by line as you listen; for one song right-click → Lyrics, for several songs select them and right-click.'}"/>
                    </StackPanel>
                </Border>

                <!-- ==================================================== library: music on the computer, tags, bulk edit, followed artists -->
                <!-- library -->
                <Border Theme="{StaticResource Card}" views:SettingsView.Group="library" Padding="22" Tag="whole" views:SettingsView.Keywords="{local:T 'import add files folder computer'}">
                    <StackPanel>
                        <TextBlock Text="{local:T 'Music already on your computer'}" Classes="card-title"/>
                        <TextBlock Text="{local:T 'Add audio or video files you already have: they stay where they are. You can also drag them into the window.'}"
                                   Classes="hint" Margin="0,-8,0,14"/>
                        <UniformGrid Columns="2">
                            <Button Theme="{StaticResource SupportTile}" Command="{Binding ImportFilesCommand}" Margin="0,0,6,0"
                                    AutomationProperties.Name="{local:T 'Add files…'}">
                                <StackPanel>
                                    <Grid Width="38" Height="38" HorizontalAlignment="Left">
                                        <Ellipse Fill="{DynamicResource AccentSoftBrush}"/>
                                        <TextBlock Text="{local:Icon E8E5}" Classes="glyph" FontSize="17" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="{local:T 'Add files…'}" FontWeight="SemiBold" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Theme="{StaticResource SupportTile}" Command="{Binding ImportFolderCommand}" Margin="6,0,0,0"
                                    AutomationProperties.Name="{local:T 'Add a folder…'}">
                                <StackPanel>
                                    <Grid Width="38" Height="38" HorizontalAlignment="Left">
                                        <Ellipse Fill="{DynamicResource AccentSoftBrush}"/>
                                        <TextBlock Text="{local:Icon E8B7}" Classes="glyph" FontSize="17" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="{local:T 'Add a folder…'}" FontWeight="SemiBold" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- tags -->
                <Border Theme="{StaticResource Card}" views:SettingsView.Group="library" Padding="22" Tag="whole" views:SettingsView.Keywords="{local:T 'tags labels color colors'}">
                    <StackPanel>
                        <TextBlock Text="{local:T Tags}" Classes="card-title"/>
                        <TextBlock Text="{local:T 'Colored labels for this profile only: put them on songs and playlists with a right-click, or by selecting several songs.'}"
                                   Classes="hint" Margin="0,-8,0,12"/>
                        <ItemsControl ItemsSource="{Binding $parent[Window].DataContext.Tags}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TagViewModel}">
                                    <Border Classes="hoverrow" CornerRadius="8" Padding="10,4,4,4">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Theme="{StaticResource IconButton}" Width="30" Height="30" FontSize="13" Content="{local:Icon E74D}"
                                                    Command="{Binding $parent[Window].DataContext.DeleteTagCommand}" CommandParameter="{Binding}"
                                                    ToolTip.Tip="{local:T 'Delete tag'}" AutomationProperties.Name="{local:T 'Delete tag'}"/>
                                            <Button DockPanel.Dock="Right" Theme="{StaticResource IconButton}" Width="30" Height="30" FontSize="13" Content="{local:Icon E70F}"
                                                    Command="{Binding $parent[Window].DataContext.EditTagCommand}" CommandParameter="{Binding}"
                                                    ToolTip.Tip="{local:T 'Edit name and color'}" AutomationProperties.Name="{local:T 'Edit tag'}"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}"
                                                       VerticalAlignment="Center" Margin="10,0,8,0"/>
                                            <Ellipse Width="12" Height="12" Fill="{Binding Brush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{local:T 'No tags yet.'}" Classes="hint" Margin="2,0,0,4"
                                   IsVisible="{Binding !$parent[Window].DataContext.HasTags}"/>
                        <Button Theme="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                Command="{Binding $parent[Window].DataContext.NewTagCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{local:Icon E710}" Classes="glyph"/>
                                <TextBlock Text="{local:T 'New tag'}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- bulk edit -->
                <Border Theme="{StaticResource Card}" views:SettingsView.Group="library" Padding="22" Tag="whole" views:SettingsView.Keywords="{local:T 'artist artists rename names edit'}">
                    <StackPanel>
                        <TextBlock Text="{local:T 'Bulk edit'}" Classes="card-title"/>
                        <TextBlock Text="{local:T 'Downloaded an artist with the wrong name? Pick it and rename it across all its songs.'}"
                                   Classes="hint" Margin="0,-8,0,12"/>
                        <TextBox Theme="{StaticResource FilterBox}" Text="{Binding ArtistFilter}"
                                 Watermark="{local:T 'Search for an artist'}" AutomationProperties.Name="{local:T 'Search for an artist'}"/>
                        <Border Margin="0,8,0,10" CornerRadius="10" Background="{DynamicResource BgBrush}" BorderBrush="Transparent"
                                BorderThickness="1" Padding="4" Height="190">
                            <ListBox Theme="{StaticResource PlainList}" ItemsSource="{Binding Artists}" SelectedItem="{Binding SelectedArtist}"
                                     AutomationProperties.Name="{local:T Artists}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:Choice}">
                                        <Border Classes="hoverrow" CornerRadius="7" Padding="10,6">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Hint}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="10,0,0,0"/>
                                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Theme="{StaticResource BoxTextBox}" Text="{Binding NewArtistName}"
                                     Watermark="{local:T 'New artist name'}" AutomationProperties.Name="{local:T 'New artist name'}"/>
                            <Button Grid.Column="1" Theme="{StaticResource PrimaryButton}" Content="{local:T Rename}" Margin="8,0,0,0"
                                    Command="{Binding RenameArtistCommand}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- tidying up: the covers and lengths missing (an import's), the same song twice (another site, an import) joined into one -->
                <Border Theme="{StaticResource Card}" views:SettingsView.Group="library" Padding="22"
                        views:SettingsView.Keywords="{local:T 'duplicates doubles same song twice copies join covers pictures images missing length album'}">
                    <StackPanel>
                        <TextBlock Text="{local:T 'Tidy up the library'}" Classes="card-title"/>
                        <TextBlock Text="{local:T 'Songs without a cover or a length (an import from Spotify brings none): looked up by title and artist'}" Classes="hint"
                                   TextWrapping="Wrap" Margin="0,4,0,10"/>
                        <Button Theme="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="16,9" Content="{local:T 'Find missing covers'}"
                                Command="{Binding FindMissingCommand}"/>
                        <TextBlock Text="{local:T 'The same song twice in the library: one copy stays, with the playlists, plays and tags of both'}" Classes="hint"
                                   TextWrapping="Wrap" Margin="0,18,0,10"/>
                        <Button Theme="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="16,9" Content="{local:T 'Remove duplicates'}"
                                Command="{Binding RemoveDuplicatesCommand}"/>
                    </StackPanel>
                </Border>

                <!-- followed artists -->
                <Border Theme="{StaticResource Card}" views:SettingsView.Group="library" Padding="22" Tag="whole" views:SettingsView.Keywords="{local:T 'artists follow new releases albums notifications'}">
                    <StackPanel>
                        <TextBlock Text="{local:T 'Artists you follow'}" Classes="card-title"/>
                        <CheckBox Theme="{StaticResource SettingSwitch}" IsChecked="{Binding ReleaseNotifications}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="{local:T 'Notify new releases'}"/>
                                <TextBlock Text="{local:T 'A notification when an artist you follow releases an album, an EP or a single (looked for every 12 hours).'}" Classes="hint"/>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- ==================================================== backup, export and import -->
                <!-- .ump packs -->
                <Border Theme="{StaticResource Card}" views:SettingsView.Group="backup" Padding="22" Tag="whole" views:SettingsView.Keywords="{local:T 'export import pack packs ump share backup copy move transfer friends playlist tag library'}">
                    <StackPanel>
                        <TextBlock Text="{local:T 'Export and import'}" Classes="card-title"/>
                        <TextBlock Text="{local:T 'Put playlists, tags or the whole library into a .ump file: to keep a backup, move it to another computer or send it to a friend.'}"
                                   Classes="hint" Margin="0,-8,0,14"/>
                        <UniformGrid Columns="2">
                            <Button Theme="{StaticResource SupportTile}" Command="{Binding ExportPackCommand}" Margin="0,0,6,0"
                                    AutomationProperties.Name="{local:T 'Export…'}">
                                <StackPanel>
                                    <Grid Width="38" Height="38" HorizontalAlignment="Left">
                                        <Ellipse Fill="{DynamicResource AccentSoftBrush}"/>
                                        <TextBlock Text="{local:Icon EDE1}" Classes="glyph" FontSize="17" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="{local:T 'Export…'}" FontWeight="SemiBold" Margin="0,12,0,2"/>
                                    <TextBlock Text="{local:T 'Choose what goes into the pack'}" Classes="hint" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button Theme="{StaticResource SupportTile}" Command="{Binding ImportPackCommand}" Margin="6,0,0,0"
                                    AutomationProperties.Name="{local:T 'Import a pack…'}">
                                <StackPanel>
                                    <Image Source="/Assets/pack-256.png" Width="38" Height="38" HorizontalAlignment="Left" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                    <TextBlock Text="{local:T 'Import a pack…'}" FontWeight="SemiBold" Margin="0,12,0,2"/>
                                    <TextBlock Text="{local:T 'Songs you already have aren\'t duplicated'}" Classes="hint" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                        <TextBlock Classes="hint" FontSize="12" Margin="2,14,0,0" Foreground="{DynamicResource MutedBrush}"
                                   Text="{local:T 'A .ump file also opens with a double click or by dragging it into the window. A playlist or a tag can also be exported with a right-click.'}"/>
                    </StackPanel>
                </Border>

                <!-- backups -->
                <Border Theme="{StaticResource Card}" views:SettingsView.Group="backup" Padding="22" views:SettingsView.Keywords="{local:T 'backup backups restore automatic copy safety data library playlists statistics zip reinstall'}">
                    <StackPanel DataContext="{Binding Backups}">
                        <TextBlock Text="{local:T Backup}" Classes="card-title"/>
                        <TextBlock Text="{local:T 'Your library, playlists, tags, statistics, settings, covers and lyrics in one small file (not the music), made by itself now and then. Restore it after a reinstall or on a new computer.'}"
                                   Classes="hint" Margin="0,-8,0,14"/>
                        <TextBlock Text="{local:T 'Automatic backup'}" Classes="field-label"/>
                        <views:ChoiceTiles Margin="-4,0,-4,12" Items="{Binding EveryChoices}" Selected="{Binding Every}"/>
                        <TextBlock Text="{local:T 'Backups kept'}" Classes="field-label"/>
                        <views:ChoiceTiles Margin="-4,0,-4,12" Numbers="True" Items="{Binding KeepChoices}" Selected="{Binding Keep}"/>
                        <TextBlock Text="{local:T 'Backup folder'}" Classes="field-label"/>
                        <StackPanel Margin="0,0,0,12">
                            <TextBox Theme="{StaticResource BoxTextBox}" Text="{Binding FolderText, Mode=OneWay}" IsReadOnly="True"
                                     AutomationProperties.Name="{local:T 'Backup folder'}"/>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Theme="{StaticResource GhostButton}" Content="{local:T 'Browse…'}" Margin="0,0,8,0" Command="{Binding ChooseFolderCommand}"/>
                                <Button Theme="{StaticResource GhostButton}" Content="{local:T Open}" Margin="0,0,8,0" Command="{Binding OpenFolderCommand}"/>
                                <Button Theme="{StaticResource GhostButton}" Content="{local:T Default}" Command="{Binding DefaultFolderCommand}"
                                    ToolTip.Tip="{local:T 'Back to the default folder'}" IsVisible="{Binding !IsDefaultFolder}"/>
                            </WrapPanel>
                        </StackPanel>
                        <TextBlock Text="{Binding LastText}" Classes="hint" Margin="0,0,0,12"/>
                        <WrapPanel>
                            <Button Margin="0,0,8,8" Theme="{StaticResource PrimaryButton}" Padding="16,9" Command="{Binding BackupNowCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{local:Icon E74E}" Classes="glyph"/>
                                    <TextBlock Text="{local:T 'Back up now'}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Margin="0,0,8,8" Theme="{StaticResource GhostButton}" Command="{Binding RestoreCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{local:Icon E777}" Classes="glyph"/>
                                    <TextBlock Text="{local:T 'Restore a backup…'}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                        <TextBlock Text="{Binding Status}" Classes="hint" Margin="2,10,0,0" IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    </StackPanel>
                </Border>

                <!-- ==================================================== listening statistics -->
                <Border Theme="{StaticResource Card}" views:SettingsView.Group="library" Padding="22" Tag="whole"
                        views:SettingsView.Keywords="{local:T 'statistics plays played most least time chart top clean up delete'}">
                    <StackPanel>
                        <TextBlock Text="{local:T 'Listening statistics'}" Classes="card-title"/>
                        <TextBlock Text="{local:T 'How many times and how long you\'ve listened to each song, for this profile only.'}"
                                   Classes="hint" Margin="0,-8,0,12"/>
                        <TextBlock Text="{Binding StatsSummary}" Margin="0,0,0,12" TextWrapping="Wrap"/>
                        <ItemsControl ItemsSource="{Binding TopTracks}" Focusable="False" Margin="0,0,0,10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TrackViewModel}">
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding PlaysText}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}"
                                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        <ContentControl Width="38" Height="38" Content="{Binding}" ContentTemplate="{StaticResource TrackCoverSmall}"/>
                                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Artist}" FontSize="12" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <WrapPanel>
                            <Button Margin="0,0,8,8" Theme="{StaticResource GhostButton}" Command="{Binding OpenStatsCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{local:Icon E9D2}" Classes="glyph"/>
                                    <TextBlock Text="{local:T 'All statistics'}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Margin="0,0,8,8" Theme="{StaticResource GhostButton}" Command="{Binding ImportSpotifyCommand}"
                                    ToolTip.Tip="{local:T 'Your liked songs, playlists and plays on Spotify'}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{local:Icon E8E5}" Classes="glyph"/>
                                    <TextBlock Text="{local:T 'Import from Spotify…'}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Margin="0,0,8,8" Theme="{StaticResource GhostButton}" Command="{Binding ImportLastFmCommand}" ToolTip.Tip="{local:T 'Your loved songs as a playlist, your scrobbles into the statistics'}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{local:Icon E8E5}" Classes="glyph"/>
                                    <TextBlock Text="{local:T 'Import from Last.fm…'}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                        <TextBlock Classes="hint" FontSize="12" Margin="2,12,0,0" Foreground="{DynamicResource MutedBrush}"
                                   Text="{local:T 'To clean up, sort them by least played: select them and press Delete to delete them.'}"/>
                    </StackPanel>
                </Border>

                <!-- ==================================================== profiles & app -->
                <Border Theme="{StaticResource Card}" views:SettingsView.Group="profiles" Padding="22" views:SettingsView.Keywords="{local:T 'profile profiles startup'}">
                    <StackPanel>
                        <TextBlock Text="{local:T 'Profiles and startup'}" Classes="card-title"/>
                        <TextBlock Text="{local:T 'At startup'}" Classes="field-label"/>
                        <StackPanel>
                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding StartupChoices}" SelectedItem="{Binding StartupProfile}" AutomationProperties.Name="{local:T 'At startup'}"/>
                            <Button Theme="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Command="{Binding ManageProfilesCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{local:Icon E716}" Classes="glyph"/>
                                    <TextBlock Text="{local:T 'Manage profiles'}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- what closing the app does -->
                <Border Theme="{StaticResource Card}" views:SettingsView.Group="profiles" Padding="22" Tag="whole" views:SettingsView.Keywords="{local:T 'close quit exit pause background tray icon clock'}">
                    <StackPanel>
                        <TextBlock Text="{local:T 'When you close the app'}" Classes="card-title"/>
                        <views:ChoiceTiles Picture="close" Items="{Binding CloseChoices}" Selected="{Binding CloseChoice}"/>
                        <TextBlock Text="{local:T 'It stays next to the clock and uses very few resources; media keys work there too.'}"
                                   Classes="hint" Margin="2,8,0,0" views:Fold.Open="{Binding StaysWhenClosed}"/>
                    </StackPanel>
                </Border>

                <!-- ==================================================== connect phone -->
                <Border Theme="{StaticResource Card}" views:SettingsView.Group="connect" Padding="22" Tag="whole"
                        views:SettingsView.Keywords="{local:T 'connect phone remote control android iphone mobile cable usb wifi send music p2p'}">
                    <StackPanel>
                        <TextBlock Text="{local:T 'Connect phone'}" Classes="card-title"/>
                        <TextBlock Text="{local:T 'Control the music of this computer from your phone: the phone\'s songs play here and its sound stays off. You can also send music from here to the phone.'}"
                                   Classes="hint" Margin="0,-8,0,14"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Theme="{StaticResource PrimaryButton}" Command="{Binding ConnectPhoneCommand}" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{local:Icon E8EA}" Classes="glyph"/>
                                    <TextBlock Text="{local:T 'Connect phone…'}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding PhoneLink.PhoneName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" IsVisible="{Binding PhoneLink.HasPhone}"/>
                                <TextBlock Text="{Binding PhoneLink.StatusText}" Classes="hint"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- ==================================================== the app on an iPhone -->
                <Border Theme="{StaticResource Card}" views:SettingsView.Group="connect" Padding="22" Tag="whole"
                        views:SettingsView.Keywords="{local:T 'install iphone ipad ios apple id sideload sidestore xtool'}">
                    <StackPanel>
                        <TextBlock Text="{local:T 'Put the app on an iPhone'}" Classes="card-title"/>
                        <TextBlock Text="{local:T 'A small separate program does it from this computer: the cable, your Apple ID and a few taps. It also renews the app every 7 days.'}"
                                   Classes="hint" Margin="0,-8,0,14"/>
                        <Button HorizontalAlignment="Left" Theme="{StaticResource PrimaryButton}" Command="{Binding InstallOnIPhoneCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{local:Icon E8EA}" Classes="glyph"/>
                                <TextBlock Text="{local:T 'Get the installer…'}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- ==================================================== listen together -->
                <Border Theme="{StaticResource Card}" views:SettingsView.Group="connect" Padding="22" Tag="whole" views:SettingsView.Keywords="{local:T 'listen together room rooms friends host ahead'}">
                    <StackPanel>
                        <TextBlock Text="{local:T 'Listen together'}" Classes="card-title"/>
                        <TextBlock Text="{local:T 'How many songs of the queue to download before their turn, besides the one playing.'}"
                                   Classes="hint" Margin="0,-8,0,14"/>
                        <TextBlock Text="{local:T 'When you listen'}" Classes="field-label"/>
                        <views:ChoiceTiles Margin="-4,0,-4,12" Numbers="True" Items="{Binding TogetherAheadChoices}" Selected="{Binding TogetherAhead}"/>
                        <TextBlock Text="{local:T 'When you\'re the host'}" Classes="field-label"/>
                        <views:ChoiceTiles Numbers="True" Items="{Binding TogetherAheadChoices}" Selected="{Binding TogetherHostAhead}"/>
                    </StackPanel>
                </Border>

                <!-- P2P -->
                <Border Theme="{StaticResource Card}" views:SettingsView.Group="connect" Padding="22" views:SettingsView.Keywords="{local:T 'p2p share send exchange passed host'}">
                    <StackPanel>
                        <TextBlock Text="{local:T 'Songs passed between computers (P2P)'}" Classes="card-title"/>
                        <CheckBox Theme="{StaticResource Switch}" IsChecked="{Binding TogetherP2P}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{local:T 'Exchange songs with the others'}"/>
                                <TextBlock Classes="hint"
                                           Text="{local:T 'Off: this computer doesn\'t receive songs from anyone and doesn\'t send any, not even as the host (and as the host nobody passes them through you). Everyone gets them from their library, the storage or the link: whoever can\'t find a song doesn\'t hear it.'}"/>
                            </StackPanel>
                        </CheckBox>
                        <StackPanel Classes="dims" IsEnabled="{Binding TogetherP2P}">
                            <CheckBox Theme="{StaticResource Switch}" IsChecked="{Binding TogetherSendAsHost}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{local:T 'When you\'re the host, send the songs yourself'}"/>
                                    <TextBlock Classes="hint"
                                               Text="{local:T 'Whoever turned on “Take the songs from the host” gets them from you instead of downloading them from the internet: worth it if your connection is fast. The others download them as usual.'}"/>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Theme="{StaticResource Switch}" IsChecked="{Binding TogetherTakeFromHost}">
                                <StackPanel>
                                    <TextBlock Text="{local:T 'Take the songs from the host'}"/>
                                    <TextBlock Classes="hint"
                                               Text="{local:T 'If the host sends them, the ones it gets ready come from it; you download the others and, if they can\'t be found, wait for the host. Off (or if the host doesn\'t send them): from the link first, then from whoever in the room has it.'}"/>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- network -->
                <Border Theme="{StaticResource Card}" views:SettingsView.Group="connect" Padding="22" Tag="whole" views:SettingsView.Keywords="{local:T 'network lan radmin vpn firewall'}">
                    <StackPanel>
                        <TextBlock Text="{local:T Network}" Classes="card-title"/>
                        <TextBlock Classes="hint" Margin="0,0,0,10"
                                   Text="{local:T 'If others can\'t join your room (or you theirs), it\'s usually Windows Firewall: allow the app on every network (needs administrator confirmation).'}"/>
                        <Button Theme="{StaticResource GhostButton}" HorizontalAlignment="Left" Command="{Binding FirewallCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{local:Icon EA18}" Classes="glyph"/>
                                <TextBlock Text="{local:T 'Allow through the firewall'}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- ==================================================== stream overlays (OBS) -->
                <Border Theme="{StaticResource Card}" views:SettingsView.Group="overlay" Padding="22" Tag="whole" views:SettingsView.Keywords="{local:T 'obs stream streaming streamer overlay browser source twitch youtube now playing vinyl'}">
                    <StackPanel DataContext="{x:Static local:OverlaySourcesViewModel.Shared}">
                        <DockPanel Margin="0,0,0,16">
                            <TextBlock DockPanel.Dock="Left" Text="{local:T 'Stream overlay'}" Classes="card-title" Margin="0"/>
                            <!-- (the same words in every language, like a stamp) -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12,0,0,2">
                                <Button Theme="{StaticResource LinkButton}" Classes="greylink" FontSize="12.5" Click="Zanno_Click" ToolTip.Tip="twitch.tv/zanno_tw">
                                    <TextBlock Text="Zanno" TextDecorations="Underline"/>
                                </Button>
                                <TextBlock Text="approved" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="4,0,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Classes="hint" Text="{local:T 'What you are listening to, on your stream: copy the link and add it in OBS as a Browser source. Transparent background, it fits any size, and it only works from this computer.'}"/>
                        <ItemsControl ItemsSource="{Binding Sources}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,10,0,0" ColumnDefinitions="Auto,*,Auto">
                                        <!-- how it looks: what its editor last showed, or the picture of its look -->
                                        <Border Width="96" Height="60" CornerRadius="8" Margin="0,0,12,0">
                                            <Border.Background>
                                                <ImageBrush Source="{Binding Picture}" Stretch="UniformToFill" AlignmentY="{Binding PictureY}"/>
                                            </Border.Background>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Summary}" Classes="hint"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Theme="{StaticResource GhostButton}" Padding="14,7" Margin="0,0,6,0" Content="{local:T 'Copy link'}" Command="{Binding CopyCommand}"/>
                                            <Button Theme="{StaticResource IconButton}" Width="32" Height="32" FontSize="14" Content="{local:Icon E8A7}" ToolTip.Tip="{local:T Preview}" Command="{Binding PreviewCommand}"/>
                                            <Button Theme="{StaticResource IconButton}" Width="32" Height="32" FontSize="14" Content="{local:Icon E70F}" ToolTip.Tip="{local:T Edit}" Command="{Binding EditCommand}"/>
                                            <Button Theme="{StaticResource IconButton}" Width="32" Height="32" FontSize="14" Content="{local:Icon E74D}" ToolTip.Tip="{local:T Delete}" Command="{Binding DeleteCommand}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Theme="{StaticResource GhostButton}" Padding="16,8" Margin="0,14,0,0" HorizontalAlignment="Left" Content="{local:T 'Add an overlay'}" Command="{Binding AddCommand}"/>
                    </StackPanel>
                </Border>

                <!-- ==================================================== integrations -->
                <Border Theme="{StaticResource Card}" views:SettingsView.Group="integrations" Padding="22" Tag="whole" views:SettingsView.Keywords="{local:T 'discord status activity rich presence'}">
                    <StackPanel>
                        <TextBlock Text="Discord" Classes="card-title"/>
                        <CheckBox Theme="{StaticResource Switch}" IsChecked="{Binding DiscordPresence}" IsEnabled="{Binding DiscordAvailable}">
                            <StackPanel>
                                <TextBlock Text="{local:T 'Show what you\'re listening to on Discord'}"/>
                                <TextBlock Text="{local:T 'Song title, artist, cover and progress on your Discord profile (while Discord is open).'}"
                                           Classes="hint"/>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- what this profile listens to, to Last.fm and ListenBrainz -->
                <Border Theme="{StaticResource Card}" views:SettingsView.Group="integrations" Padding="22" views:SettingsView.Keywords="{local:T 'lastfm last.fm listenbrainz scrobble scrobbling'}">
                    <StackPanel>
                        <TextBlock Text="Scrobbling" Classes="card-title"/>
                        <Grid DataContext="{Binding Scrobbling}" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Last.fm"/>
                                <TextBlock Text="{Binding LastFmText}" Classes="hint"/>
                                <Button Theme="{StaticResource LinkButton}" Content="{local:T 'Import your loved songs and scrobbles…'}" Command="{Binding ImportLastFmCommand}"
                                        HorizontalAlignment="Left" Margin="0,4,0,0" IsVisible="{Binding LastFmOn}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Theme="{StaticResource GhostButton}" Padding="16,8" Content="{Binding LastFmButton}" Command="{Binding LastFmCommand}"
                                    VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="1" Margin="0,12,0,0" VerticalAlignment="Center">
                                <TextBlock Text="ListenBrainz"/>
                                <TextBlock Text="{Binding ListenBrainzText}" Classes="hint"/>
                            </StackPanel>
                            <Button Grid.Row="1" Grid.Column="1" Theme="{StaticResource GhostButton}" Padding="16,8" Margin="0,12,0,0" Content="{Binding ListenBrainzButton}"
                                    Command="{Binding ListenBrainzCommand}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Classes="hint" Margin="0,12,0,0" TextWrapping="Wrap"
                                       Text="{local:T 'Scrobbling: what this profile listens to goes to your accounts (half of a song is enough, at most 4 minutes). Without a connection the plays wait and go later.'}"/>
                            <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding WaitingText}" Classes="hint" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"
                                       IsVisible="{Binding HasWaiting}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ==================================================== about: updates, help, support the project -->
                <!-- updates -->
                <Border Theme="{StaticResource Card}" views:SettingsView.Group="about" Padding="22" views:SettingsView.Keywords="{local:T 'updates update version github engines yt-dlp gallery-dl data'}">
                    <StackPanel>
                        <TextBlock Text="{local:T Updates}" Classes="card-title"/>
                        <CheckBox Theme="{StaticResource SettingSwitch}" IsChecked="{Binding AutoUpdateApp}">
                            <StackPanel>
                                <TextBlock Text="{local:T 'Update the app automatically'}"/>
                                <TextBlock Text="{local:T 'Downloads the latest version by itself and installs it when you close the app.'}" Classes="hint"/>
                            </StackPanel>
                        </CheckBox>
                        <DockPanel Margin="0,0,0,16">
                            <Button DockPanel.Dock="Right" Theme="{StaticResource GhostButton}" Command="{Binding CheckAppUpdateCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{local:Icon E777}" Classes="glyph"/>
                                    <TextBlock Text="{local:T 'Update now'}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button DockPanel.Dock="Right" Theme="{StaticResource GhostButton}" Command="{Binding WhatsNewCommand}"
                                    Content="{local:T 'Release notes'}" Margin="0,0,10,0"/>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="{Binding Version}"/>
                                <TextBlock Text="{Binding Host.Updates.Status}" Classes="hint"
                                           IsVisible="{Binding Host.Updates.Status, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                            </StackPanel>
                        </DockPanel>
                        <CheckBox Theme="{StaticResource SettingSwitch}" IsChecked="{Binding ShowWhatsNew}">
                            <StackPanel>
                                <TextBlock Text="{local:T 'Show the release notes after an update'}"/>
                                <TextBlock Text="{local:T 'The changes of every version since the last one you opened.'}" Classes="hint"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Theme="{StaticResource SettingSwitch}" IsChecked="{Binding AutoUpdateEngines}">
                            <StackPanel>
                                <TextBlock Text="{local:T 'Update download engines'}"/>
                                <TextBlock Text="{local:T 'Sites change often: yt-dlp and gallery-dl update once a day.'}" Classes="hint"/>
                            </StackPanel>
                        </CheckBox>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Theme="{StaticResource GhostButton}" Command="{Binding UpdateEnginesCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{local:Icon E895}" Classes="glyph"/>
                                    <TextBlock Text="{local:T 'Update engines'}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding EngineInfo}" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </DockPanel>
                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,18"/>
                        <Button Theme="{StaticResource LinkButton}" Content="{local:T 'Open data folder'}" Command="{Binding OpenDataDirCommand}"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- help -->
                <Border Theme="{StaticResource Card}" views:SettingsView.Group="about" Padding="22" Tag="whole" views:SettingsView.Keywords="{local:T 'help support report problem bug error github issue idea suggestion feature contact terms use conditions copyright'}">
                    <StackPanel>
                        <TextBlock Text="{local:T 'Help &amp; support'}" Classes="card-title"/>
                        <TextBlock Text="{local:T 'Something wrong, or a feature you miss? Tell us on GitHub: first check whether someone has already reported it.'}"
                                   Classes="hint" Margin="0,-8,0,14"/>
                        <UniformGrid Columns="2">
                            <Button Theme="{StaticResource SupportTile}" Command="{Binding ReportProblemCommand}" Margin="0,0,6,0"
                                    AutomationProperties.Name="{local:T 'Report a problem'}">
                                <StackPanel>
                                    <Grid Width="38" Height="38" HorizontalAlignment="Left">
                                        <Ellipse Fill="{DynamicResource ErrorSoftBrush}"/>
                                        <TextBlock Text="{local:Icon EBE8}" Classes="glyph" FontSize="17" Foreground="{DynamicResource ErrorBrush}" HorizontalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="{local:T 'Report a problem'}" FontWeight="SemiBold" Margin="0,12,0,2"/>
                                    <TextBlock Text="{local:T 'Something doesn\'t work as it should'}" Classes="hint" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button Theme="{StaticResource SupportTile}" Command="{Binding SuggestIdeaCommand}" Margin="6,0,0,0"
                                    AutomationProperties.Name="{local:T 'Suggest an idea'}">
                                <StackPanel>
                                    <Grid Width="38" Height="38" HorizontalAlignment="Left">
                                        <Ellipse Fill="{DynamicResource WarningSoftBrush}"/>
                                        <TextBlock Text="{local:Icon EA80}" Classes="glyph" FontSize="17" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="{local:T 'Suggest an idea'}" FontWeight="SemiBold" Margin="0,12,0,2"/>
                                    <TextBlock Text="{local:T 'A feature you\'d like'}" Classes="hint" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                        <WrapPanel Margin="0,12,0,0">
                            <Button Theme="{StaticResource GhostButton}" Command="{Binding OpenIssuesCommand}" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{local:Icon E721}" Classes="glyph"/>
                                    <TextBlock Text="{local:T 'Existing reports'}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Theme="{StaticResource GhostButton}" Command="{Binding OpenRepoCommand}" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{local:Icon E8A7}" Classes="glyph"/>
                                    <TextBlock Text="{local:T 'Project page'}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                        <TextBlock Text="{local:T 'GitHub opens in your browser (a free account is needed). The app and Windows versions are already filled in.'}"
                                   Classes="hint" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16"/>
                        <Button Theme="{StaticResource LinkButton}" Content="{local:T 'Terms of use'}" Command="{Binding ShowTermsCommand}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- support the project: donations, the people who support it -->
                <Border Theme="{StaticResource Card}" views:SettingsView.Group="about" Padding="22" Tag="whole" views:SettingsView.Keywords="{local:T 'support donate donation sponsor sponsors ko-fi coffee money thanks supporters'}">
                    <StackPanel>
                        <TextBlock Text="{local:T 'Support the project'}" Classes="card-title"/>
                        <TextBlock Text="{local:T 'Ultimate MP3 Player is free, with no ads, and made in spare time. If it\'s useful to you, a donation helps keep it going.'}"
                                   Classes="hint" Margin="0,-8,0,14"/>
                        <UniformGrid Columns="2">
                            <Button Theme="{StaticResource SupportTile}" Command="{Binding SponsorCommand}" Margin="0,0,6,0"
                                    AutomationProperties.Name="GitHub Sponsors">
                                <StackPanel>
                                    <Grid Width="38" Height="38" HorizontalAlignment="Left">
                                        <Ellipse Fill="{DynamicResource ErrorSoftBrush}"/>
                                        <TextBlock Text="{local:Icon EB51}" Classes="glyph" FontSize="17" Foreground="{DynamicResource ErrorBrush}" HorizontalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="GitHub Sponsors" FontWeight="SemiBold" Margin="0,12,0,2"/>
                                    <TextBlock Text="{local:T 'Monthly or once, with a GitHub account'}" Classes="hint" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button Theme="{StaticResource SupportTile}" Command="{Binding KofiCommand}" Margin="6,0,0,0"
                                    AutomationProperties.Name="Ko-fi">
                                <StackPanel>
                                    <Grid Width="38" Height="38" HorizontalAlignment="Left">
                                        <Ellipse Fill="{DynamicResource AccentSoftBrush}"/>
                                        <TextBlock Text="{local:Icon E734}" Classes="glyph" FontSize="17" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="Ko-fi" FontWeight="SemiBold" Margin="0,12,0,2"/>
                                    <TextBlock Text="{local:T 'Once, by card or PayPal, no account needed'}" Classes="hint" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                        <StackPanel IsVisible="{Binding Supporters, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16"/>
                            <TextBlock Text="{local:T 'Thanks to'}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding Supporters}" Classes="hint" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </views:MasonryPanel>
        </StackPanel>
    </ScrollViewer>
            </views:AnimatedContent.Content>
        </views:AnimatedContent>
    </Grid>
</UserControl>
