<!-- The Windows app's Views\MainWindow.xaml: title bar, sidebar, page, player bar. -->
<Window x:Class="UltimateMP3Player.Views.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UltimateMP3Player"
        xmlns:vm="clr-namespace:UltimateMP3Player.ViewModels"
        xmlns:views="clr-namespace:UltimateMP3Player.Views"
        Title="Ultimate MP3 Player" Width="1280" Height="820" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource TitleBarBrush}"
        Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource UiFont}" FontSize="14"
        DragDrop.AllowDrop="True" UseLayoutRounding="True">

    <Window.DataTemplates>
        <DataTemplate DataType="vm:HomeViewModel"><views:HomeView/></DataTemplate>
        <DataTemplate DataType="vm:LibraryHubViewModel"><views:LibraryHubView/></DataTemplate>
        <DataTemplate DataType="vm:LibraryViewModel"><views:LibraryView/></DataTemplate>
        <DataTemplate DataType="vm:PlaylistsPageViewModel"><views:PlaylistsView/></DataTemplate>
        <DataTemplate DataType="vm:PlaylistPageViewModel"><views:PlaylistView/></DataTemplate>
        <DataTemplate DataType="vm:SearchViewModel"><views:SearchView/></DataTemplate>
        <DataTemplate DataType="vm:NowPlayingViewModel"><views:NowPlayingView/></DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel"><views:SettingsView/></DataTemplate>
        <DataTemplate DataType="vm:DjViewModel"><views:DjView/></DataTemplate>
        <DataTemplate DataType="vm:TogetherViewModel"><views:TogetherView/></DataTemplate>
        <DataTemplate DataType="vm:StatsViewModel"><views:StatsView/></DataTemplate>
        <DataTemplate DataType="vm:ArtistsViewModel"><views:ArtistsView/></DataTemplate>
        <DataTemplate DataType="vm:StationsViewModel"><views:StationsView/></DataTemplate>
        <DataTemplate DataType="vm:ArtistPageViewModel"><views:ArtistView/></DataTemplate>
        <DataTemplate DataType="vm:RecapViewModel"><views:RecapView/></DataTemplate>
    </Window.DataTemplates>

    <Window.Resources>
        <local:BoolChoice x:Key="HeartGlyph" True="{local:Icon EB52}" False="{local:Icon EB51}"/>

        <!-- back and forward in the title bar: dimmed when there's nowhere to go -->
        <ControlTheme x:Key="TitleNavButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Setter Property="Width" Value="40"/>
            <Style Selector="^:disabled">
                <Setter Property="Opacity" Value="0.3"/>
            </Style>
        </ControlTheme>

        <!-- a preset of the speed: lit when it's the speed playing -->
        <ControlTheme x:Key="SpeedPresetButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="0,6"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Style Selector="^.current">
                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
            </Style>
        </ControlTheme>

        <!-- the playback panel's button: its icon, and the speed when it isn't the normal one -->
        <ControlTheme x:Key="PlaybackToggle" TargetType="ToggleButton">
            <Setter Property="local:Ui.GrayText" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" CornerRadius="18" Background="Transparent" Padding="9,0">
                        <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#Bd">
                <Setter Property="Background" Value="{DynamicResource Surface3Brush}"/>
            </Style>
            <Style Selector="^:pointerover">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            </Style>
            <Style Selector="^:checked /template/ Border#Bd">
                <Setter Property="Background" Value="{DynamicResource Surface3Brush}"/>
            </Style>
            <Style Selector="^:checked">
                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
            </Style>
        </ControlTheme>
    </Window.Resources>

    <Window.Styles>
        <!-- sidebar entries (playlists and tags): hover, open, playing from -->
        <Style Selector="Border.side">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.side:pointerover">
            <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
        </Style>
        <Style Selector="Border.side.selected">
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
        </Style>
        <Style Selector="Border.side.from TextBlock.name">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
        </Style>
        <Style Selector="TextBlock.heart.fav">
            <Setter Property="Foreground" Value="{DynamicResource PinkBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFontFilled}"/>
        </Style>
        <Style Selector="TextBlock.panel-heading">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
        </Style>
        <Style Selector="StackPanel.eq:disabled">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
    </Window.Styles>

    <Panel x:Name="Root">
        <Grid RowDefinitions="32,*,Auto">

            <!-- ============================================================ title bar -->
            <Grid x:Name="TitleBar" Background="{DynamicResource TitleBarBrush}">
                <!-- back and forward (the pages' history), like a browser's; the mouse's side buttons and Alt+arrows do the same.
                     (one block with the name: on macOS it moves right of the traffic lights) -->
                <StackPanel x:Name="TitleText" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="BackButton" Theme="{StaticResource TitleNavButton}" Content="{local:Icon E72B}" Command="{Binding BackCommand}"
                            ToolTip.Tip="{local:T 'Back (Alt+←)'}"/>
                    <Button Theme="{StaticResource TitleNavButton}" Command="{Binding ForwardCommand}" ToolTip.Tip="{local:T 'Forward (Alt+→)'}">
                        <TextBlock Text="{local:Icon E72B}" RenderTransform="scale(-1, 1)"/>
                    </Button>
                    <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Image Source="/Assets/app-256.png" Width="16" Height="16" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                        <TextBlock Text="Ultimate MP3 Player" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" Margin="9,0,0,1"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="WindowButtons" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="MinButton" Theme="{StaticResource TitleBarButton}" Content="{local:Icon E921}" ToolTip.Tip="{local:T Minimize}"/>
                    <Button x:Name="MaxButton" Theme="{StaticResource TitleBarButton}" Content="{local:Icon E922}"/>
                    <Button x:Name="CloseButton" Theme="{StaticResource TitleBarCloseButton}" Content="{local:Icon E8BB}" ToolTip.Tip="{local:T Close}"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="248,*">

                <!-- ======================================================== sidebar -->
                <!-- no line against the page: its own tone is enough -->
                <Border Background="{DynamicResource SidebarBrush}">
                    <!-- the pages (Ctrl+1…5, Ctrl+↑/↓); the playlists take what is left; the tags (folded under their heading if you like);
                         the profile and the settings -->
                    <Grid Margin="14,12,14,12" RowDefinitions="Auto,*,Auto,Auto">
                        <Panel>
                            <!-- the open page's pill, gliding with the page -->
                            <views:SlidingPill Target="{Binding #NavPanel}" Fill="{DynamicResource Surface2Brush}"/>
                            <StackPanel x:Name="NavPanel">
                                <RadioButton Theme="{StaticResource NavButton}" GroupName="nav" local:Ui.Glyph="&#xE80F;" Content="{local:T Home}" IsChecked="{Binding IsHome}"
                                             ToolTip.Tip="{local:T 'Home (Ctrl+1)'}"/>
                                <RadioButton Theme="{StaticResource NavButton}" GroupName="nav" local:Ui.Glyph="&#xE721;" IsChecked="{Binding IsSearch}"
                                             ToolTip.Tip="{local:T 'Search your songs and online, or paste a link to download (Ctrl+2)'}">
                                    <DockPanel>
                                        <!-- downloads going on -->
                                        <Border DockPanel.Dock="Right" CornerRadius="9" MinWidth="18" Height="18" Padding="5,0" Background="{DynamicResource AccentGradient}"
                                                IsVisible="{Binding Queue.HasActive}">
                                            <TextBlock Text="{Binding Queue.ActiveCount}" FontSize="11" Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{local:T Search}"/>
                                    </DockPanel>
                                </RadioButton>
                                <RadioButton Theme="{StaticResource NavButton}" GroupName="nav" local:Ui.Glyph="&#xE8F1;" IsChecked="{Binding IsLibraryNav}"
                                             ToolTip.Tip="{local:T 'Your songs, playlists, artists and radios (Ctrl+3)'}">
                                    <DockPanel>
                                        <!-- the followed artists' new releases not seen yet -->
                                        <Border DockPanel.Dock="Right" CornerRadius="9" MinWidth="18" Height="18" Padding="5,0" Background="{DynamicResource AccentGradient}"
                                                IsVisible="{Binding HasNewReleases}">
                                            <TextBlock Text="{Binding NewReleases}" FontSize="11" Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{local:T Library}"/>
                                    </DockPanel>
                                </RadioButton>
                                <RadioButton Theme="{StaticResource NavButton}" GroupName="nav" local:Ui.Glyph="&#xE716;" IsChecked="{Binding IsTogether}"
                                             ToolTip.Tip="{local:T 'Listen together (Ctrl+4)'}">
                                    <DockPanel>
                                        <!-- in a room -->
                                        <Ellipse DockPanel.Dock="Right" Width="8" Height="8" Margin="0,0,4,0" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center"
                                                 IsVisible="{Binding Together.InRoom}"/>
                                        <TextBlock Text="{local:T 'Listen together'}" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </RadioButton>
                                <RadioButton Theme="{StaticResource NavButton}" GroupName="nav" local:Ui.Glyph="&#xE8D6;" Content="DJ" IsChecked="{Binding IsDj}"
                                             ToolTip.Tip="{local:T 'DJ: mix two songs (tempo, pitch, trim and volume) (Ctrl+5)'}"/>
                            </StackPanel>
                        </Panel>

                        <DockPanel Grid.Row="1">
                            <DockPanel DockPanel.Dock="Top" Margin="8,18,0,6">
                                <Button DockPanel.Dock="Right" Theme="{StaticResource IconButton}" Width="28" Height="28" FontSize="13" Content="{local:Icon E710}"
                                        Command="{Binding NewPlaylistCommand}" ToolTip.Tip="{local:T 'New playlist'}"/>
                                <TextBlock Text="{local:T 'YOUR PLAYLISTS'}" Classes="small-caps" VerticalAlignment="Center"/>
                            </DockPanel>

                            <ListBox x:Name="PlaylistList" Theme="{StaticResource PlainList}" ItemsSource="{Binding Playlists}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="side" Classes.selected="{Binding IsSelected}" Classes.from="{Binding IsPlayingFrom}" CornerRadius="12" Padding="6" Cursor="Hand"
                                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0"
                                                views:Drops.Target="playlist" views:Rows.Menu="playlist" local:Marquee.Host="True">
                                            <Grid ColumnDefinitions="42,*,Auto">
                                                <ContentControl Width="42" Height="42" Content="{Binding}" ContentTemplate="{StaticResource PlaylistCover}"/>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Classes="name" Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="13.5" local:Marquee.IsEnabled="True"/>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Left" Text="{Binding DeviceGlyph, Converter={StaticResource Icon}}" Classes="glyph" FontSize="10.5"
                                                                   Foreground="{DynamicResource MutedBrush}" Margin="0,0,5,0" VerticalAlignment="Center" IsVisible="{Binding HasDevice}"/>
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                                    </DockPanel>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{local:Icon E995}" Classes="glyph" Foreground="{DynamicResource AccentTextBrush}"
                                                           FontSize="12" Margin="6,0,2,0" IsVisible="{Binding IsPlayingFrom}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <!-- tags: each one opens the page of its songs; songs can be dropped on them. A click on the heading folds them. -->
                        <DockPanel Grid.Row="2" Margin="0,4,0,0">
                            <DockPanel DockPanel.Dock="Top" Margin="0,6,0,4">
                                <Button DockPanel.Dock="Right" Theme="{StaticResource IconButton}" Width="28" Height="28" FontSize="13" Content="{local:Icon E710}"
                                        Command="{Binding NewTagCommand}" ToolTip.Tip="{local:T 'New tag'}"/>
                                <Button Theme="{StaticResource SubtleButton}" Padding="8,4" HorizontalAlignment="Left" Command="{Binding ToggleTagsCommand}"
                                        ToolTip.Tip="{local:T 'Show or hide the tags'}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{local:T TAGS}" Classes="small-caps" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding TagsChevron, Converter={StaticResource Icon}}" Classes="glyph" FontSize="9" Margin="7,0,0,0"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                    </StackPanel>
                                </Button>
                            </DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{local:T 'Colored labels to group songs and playlists your way.'}" Classes="hint"
                                       FontSize="12" Margin="8,0,8,4" TextWrapping="Wrap">
                                <TextBlock.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="TagsOpen"/>
                                        <Binding Path="!HasTags"/>
                                    </MultiBinding>
                                </TextBlock.IsVisible>
                            </TextBlock>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" MaxHeight="190" IsVisible="{Binding TagsOpen}">
                                <ItemsControl ItemsSource="{Binding Tags}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Classes="side" Classes.selected="{Binding IsSelected}" CornerRadius="17" Padding="12,7" Cursor="Hand"
                                                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0"
                                                    views:Drops.Target="tag" views:Rows.Menu="tag" ToolTip.Tip="{Binding CountText}" local:Marquee.Host="True"
                                                    views:Click.Command="{Binding $parent[Window].DataContext.OpenTagCommand}">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding DeviceGlyph, Converter={StaticResource Icon}}" Classes="glyph" FontSize="11"
                                                               Foreground="{DynamicResource MutedBrush}" Margin="0,0,6,0" VerticalAlignment="Center" IsVisible="{Binding HasDevice}"/>
                                                    <Ellipse Width="10" Height="10" Fill="{Binding Brush}" VerticalAlignment="Center"/>
                                                    <TextBlock Classes="name" Text="{Binding Name}" Margin="11,0,8,0" FontSize="13.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                               local:Marquee.IsEnabled="True"/>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>

                        <!-- the profile; the settings -->
                        <Grid Grid.Row="3" Margin="0,10,0,0" ColumnDefinitions="*,Auto">
                            <Button Theme="{StaticResource SubtleButton}" Padding="6,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Command="{Binding SwitchProfileCommand}" ToolTip.Tip="{local:T 'Switch or manage profiles'}">
                                <Grid ColumnDefinitions="Auto,*">
                                <Panel>
                                    <!-- both devices' music (Connect phone): the other device's profile behind this one's -->
                                    <Panel Width="26" Height="26" Margin="20,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsVisible="{Binding HasSecondProfile}">
                                        <Ellipse Fill="{Binding SecondBrush}"/>
                                        <TextBlock Text="{Binding SecondInitial}" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <views:CoverImage Margin="2" IsCircle="True" Source="{Binding SecondAvatar}"/>
                                    </Panel>
                                    <Panel Width="32" Height="32" HorizontalAlignment="Left">
                                        <Ellipse Margin="-2" Fill="{DynamicResource SidebarBrush}" IsVisible="{Binding HasSecondProfile}"/>
                                        <Ellipse Fill="{Binding ProfileBrush}"/>
                                        <TextBlock Text="{Binding ProfileInitial}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <views:CoverImage Margin="2.5" IsCircle="True" Source="{Binding ProfileAvatar}"/>
                                    </Panel>
                                </Panel>
                                    <TextBlock Grid.Column="1" Margin="9,0,0,0" Text="{Binding ProfileName}" Foreground="{DynamicResource TextBrush}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            <RadioButton Grid.Column="1" Theme="{StaticResource NavIconButton}" GroupName="nav" local:Ui.Glyph="&#xE713;" IsChecked="{Binding IsSettings}"
                                         VerticalAlignment="Center" ToolTip.Tip="{local:T 'Settings (Ctrl+,)'}"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ======================================================== content -->
                <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">
                    <StackPanel Grid.Row="1" Margin="20,0,20,0">
                        <Border Margin="0,10,0,0" CornerRadius="10" Padding="14,8" Background="{DynamicResource WarningSoftBrush}"
                                IsVisible="{Binding Host.EngineStatus, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{local:Icon E896}" Classes="glyph" Foreground="{DynamicResource WarningBrush}"/>
                                <TextBlock Text="{Binding Host.EngineStatus}" Margin="10,0,0,0" Foreground="{DynamicResource WarningBrush}" FontSize="13"/>
                            </StackPanel>
                        </Border>
                        <Border Margin="0,10,0,0" CornerRadius="10" Padding="14,6,6,6" Background="{DynamicResource AccentSoftBrush}"
                                IsVisible="{Binding Host.Updates.IsReady, FallbackValue=False}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Theme="{StaticResource PrimaryButton}" Padding="12,5" Content="{local:T 'Restart now'}"
                                        Command="{Binding Host.RestartToUpdateCommand}"/>
                                <TextBlock Text="{local:Icon E777}" Classes="glyph" Foreground="{DynamicResource AccentTextBrush}"/>
                                <TextBlock Text="{Binding Host.Updates.ReadyText}" Margin="10,0,10,0" VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- the page: it slides in from where its entry is in the sidebar (AnimatedContent, MainViewModel.OrderOf) -->
                    <views:AnimatedContent Grid.Row="2" Content="{Binding Shown}" KeepViews="True"/>

                    <!-- up next popped out of the player bar (a click elsewhere or Esc folds it) -->
                    <views:QueuePopup x:Name="QueuePanel" Grid.Row="1" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,20,16,12"
                                      IsVisible="{Binding QueueOpen}"/>

                    <!-- toast -->
                    <Border x:Name="ToastBox" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18" CornerRadius="10"
                            Padding="16,10" Background="{DynamicResource PopupBrush}"
                            IsVisible="{Binding ToastText, Converter={x:Static ObjectConverters.IsNotNull}}" IsHitTestVisible="False" MaxWidth="640"
                            BoxShadow="{DynamicResource PopupShadow}">
                        <TextBlock Text="{Binding ToastText}" TextWrapping="Wrap"/>
                    </Border>

                    <!-- downloads going on, seen from any page: each group (a song, or the songs of a link) with how far it is and a
                         button that cancels it; a click opens the downloads (the search's page without words) -->
                    <Border Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,16" Width="320" CornerRadius="14" Padding="4"
                            Background="{DynamicResource PopupBrush}" BoxShadow="{DynamicResource PopupShadow}" IsVisible="{Binding ShowDownloadPanel}">
                        <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Queue.Groups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:DownloadGroupViewModel">
                                        <Button Theme="{StaticResource SubtleButton}" Padding="10,7,4,7" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                Command="{Binding OpenCommand}" ToolTip.Tip="{local:T 'Open the downloads'}">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <TextBlock Text="{local:Icon E896}" Classes="glyph" FontSize="15" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,5"/>
                                                    <ProgressBar Value="{Binding Percent}" IsIndeterminate="{Binding Indeterminate}"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Theme="{StaticResource IconButton}" Content="{local:Icon E711}" Command="{Binding CancelCommand}"
                                                        VerticalAlignment="Center" ToolTip.Tip="{local:T 'Cancel the download'}"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <!-- ============================================================ player bar -->
            <!-- (away while the DJ is the page, sliding down out of the window: MainWindow.SlideBar) -->
            <Border x:Name="PlayerBar" Grid.Row="2" Background="{DynamicResource SidebarBrush}"
                    Padding="14,10">
                <Grid x:Name="PlayerGrid" DataContext="{Binding Player}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" MinWidth="300" MaxWidth="400"/>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="3*" MinWidth="300" MaxWidth="400"/>
                    </Grid.ColumnDefinitions>

                    <!-- nothing playing: said, not an empty corner -->
                    <Grid VerticalAlignment="Center" IsVisible="{Binding ShowNothingPlaying}" ColumnDefinitions="Auto,*">
                        <Border Width="58" Height="58" CornerRadius="8" Background="{DynamicResource Surface2Brush}">
                            <TextBlock Text="{local:Icon EC4F}" Classes="glyph" FontSize="22" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,6,0" VerticalAlignment="Center">
                            <TextBlock Text="{local:T 'Nothing playing'}" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{local:T 'Pick a song to start'}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>

                    <!-- now playing -->
                    <Grid VerticalAlignment="Center" IsVisible="{Binding ShowNowPlaying}" ColumnDefinitions="Auto,*,Auto"
                          views:Rows.Menu="current" Background="Transparent" local:Marquee.Host="True">
                        <Button Theme="{StaticResource SubtleButton}" Padding="0" Width="58" Height="58"
                                Command="{Binding $parent[Window].DataContext.GoNowPlayingCommand}" ToolTip.Tip="{local:T 'Open song view'}">
                            <ContentControl Width="58" Height="58" Content="{Binding Current}" ContentTemplate="{StaticResource TrackCoverSmall}"/>
                        </Button>
                        <StackPanel Grid.Column="1" Margin="12,0,6,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Current.Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" local:Marquee.IsEnabled="True"/>
                            <!-- the artist; before it the song's sign (the exception to Settings › Download: TrackViewModel.ShowSign) -->
                            <DockPanel Margin="0,2,0,0">
                                <TextBlock DockPanel.Dock="Left" Classes="glyph cloud" Classes.gone="{Binding Current.SignIsGone, FallbackValue=False}"
                                           Text="{Binding Current.SignGlyph, Converter={StaticResource Icon}}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"
                                           ToolTip.Tip="{Binding Current.SignTip}" IsVisible="{Binding Current.ShowSign, FallbackValue=False}"/>
                                <TextBlock Text="{Binding Current.Artist}" FontSize="12.5" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis" local:Marquee.IsEnabled="True"
                                           Cursor="Hand" PointerReleased="Artist_Click" ToolTip.Tip="{local:T 'Go to the artist'}" ToolTip.ShowDelay="900"/>
                            </DockPanel>
                            <!-- a suggested song still downloading (it starts by itself), or more of them on their way -->
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" IsVisible="{Binding IsWaiting}">
                                <Ellipse Classes="spinner" Width="12" Height="12" StrokeThickness="1.5"/>
                                <TextBlock Text="{Binding WaitText}" FontSize="11.5" Foreground="{DynamicResource SubTextBrush}" Margin="7,0,0,0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <!-- in a room: which one (green dot), a click opens it -->
                            <Button Theme="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,3,0,0" FontSize="11.5" Command="{Binding OpenRoomCommand}"
                                    IsVisible="{Binding InRoom}" ToolTip.Tip="{local:T 'You\'re in a Listen together room: open it'}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding RoomName}" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <!-- a phone connected (Connect phone): which one, a spinner while it comes back; a click opens its window -->
                            <Button Theme="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,3,0,0" FontSize="11.5" Command="{Binding OpenPhoneCommand}"
                                    IsVisible="{Binding PhoneLinked}" ToolTip.Tip="{Binding PhoneTip}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" IsVisible="{Binding !PhoneAway}"/>
                                    <Ellipse Classes="spinner" Width="9" Height="9" StrokeThickness="1.5" VerticalAlignment="Center" IsVisible="{Binding PhoneAway}"/>
                                    <TextBlock Text="{local:Icon E8EA}" Classes="glyph" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding PhoneName}" Margin="5,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <!-- the library icon for a song not in the library (in the cloud, a ring while it's saved); + = a playlist; the heart.
                             Saving a song of the library on the device is in its menu (right click). -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Theme="{StaticResource ControlButton}" Command="{Binding SaveCurrentCommand}" ToolTip.Tip="{Binding Current.SaveTip}"
                                    IsVisible="{Binding CanAddToLibrary}">
                                <Panel>
                                    <TextBlock Text="{local:Icon E8F1}" Classes="glyph" FontSize="16" IsVisible="{Binding !Current.IsSaving, FallbackValue=True}"/>
                                    <views:ProgressRing Width="18" Height="18" Value="{Binding Current.SavePct}" IsIndeterminate="{Binding Current.SaveIndeterminate}"
                                                        Stroke="{DynamicResource AccentBrush}" Track="{DynamicResource Surface3Brush}"
                                                        IsVisible="{Binding Current.IsSaving, FallbackValue=False}"/>
                                </Panel>
                            </Button>
                            <Button x:Name="AddToPlaylistButton" Theme="{StaticResource ControlButton}" Content="{local:Icon E710}" ToolTip.Tip="{local:T 'Add to a playlist'}"/>
                            <Button Theme="{StaticResource ControlButton}" Command="{Binding FavoriteCommand}" ToolTip.Tip="{local:T Favorites}">
                                <TextBlock Classes="heart" Classes.fav="{Binding Current.IsFavorite}" FontSize="15"
                                           Text="{Binding Current.IsFavorite, Converter={StaticResource HeartGlyph}, FallbackValue={local:Icon EB51}}"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- transport + waveform -->
                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <!-- in a room shuffle and repeat don't apply (dimmed); prev/play/next need the host's permission (greyed out, the tooltip says why) -->
                            <ToggleButton Theme="{StaticResource ToggleIcon}" Content="{local:Icon E8B1}" IsChecked="{Binding Shuffle}"
                                          ToolTip.Tip="{local:T Shuffle}" IsEnabled="{Binding NotInRoom}"/>
                            <Button Theme="{StaticResource ControlButton}" Content="{local:Icon E892}" Command="{Binding PreviousCommand}"
                                    Margin="8,0,0,0" ToolTip.Tip="{Binding PreviousTip}" ToolTip.ShowOnDisabled="True"/>
                            <Button Theme="{StaticResource PlayButton}" Content="{Binding PlayGlyph, Converter={StaticResource Icon}}" Command="{Binding PlayPauseCommand}"
                                    Margin="12,0" ToolTip.Tip="{Binding PlayTip}" ToolTip.ShowOnDisabled="True"/>
                            <Button Theme="{StaticResource ControlButton}" Content="{local:Icon E893}" Command="{Binding NextCommand}"
                                    Margin="0,0,8,0" ToolTip.Tip="{Binding NextTip}" ToolTip.ShowOnDisabled="True"/>
                            <local:CommandToggle Theme="{StaticResource ToggleIcon}" Content="{Binding RepeatGlyph, Converter={StaticResource Icon}}"
                                                 IsChecked="{Binding RepeatOn, Mode=OneWay}" Command="{Binding CycleRepeatCommand}" ToolTip.Tip="{Binding RepeatTip}"/>
                        </StackPanel>
                        <Grid Margin="0,6,0,0" MinHeight="30" ColumnDefinitions="44,*,44">
                            <TextBlock Text="{Binding PositionText}" FontSize="11.5" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                                       IsVisible="{Binding !IsLive}"/>
                            <views:WaveformBar Grid.Column="1" Height="30" Peaks="{Binding Current.Wave}" Progress="{Binding Progress}"
                                               IsPlaying="{Binding Animate}" Duration="{Binding Duration}" Rate="{Binding Speed}"
                                               PlayedBrush="{DynamicResource ProgressGradient}" RestBrush="{DynamicResource WaveBrush}"
                                               SeekCommand="{Binding SeekCommand}" ToolTip.Tip="{Binding SeekTip}" IsVisible="{Binding !IsLive}"/>
                            <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="11.5" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Margin="8,0,0,0"
                                       IsVisible="{Binding !IsLive}"/>
                            <!-- a radio: nothing to seek, only that it's live -->
                            <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsLive}">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentGradient}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DurationText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" Margin="7,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- right side: how the queue goes on, the song view, the queue, the playback panel, the volume (the slider narrows on
                         small windows: MainWindow.FitRightBlock) -->
                    <StackPanel x:Name="RightBlock" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- automatic queue: lit = "next up" refills itself at every song (in a room the room's queue rules) -->
                        <ToggleButton Theme="{StaticResource ToggleIcon}" Content="{local:Icon E90B}" IsChecked="{Binding AutoQueue}"
                                      ToolTip.Tip="{Binding AutoQueueTip}" IsVisible="{Binding !InRoom}"/>
                        <Border Width="1" Height="18" Margin="6,0" Background="{DynamicResource BorderBrush}" VerticalAlignment="Center" IsVisible="{Binding !InRoom}"/>
                        <!-- the song view (video, lyrics, the big queue) -->
                        <local:CommandToggle Theme="{StaticResource ToggleIcon}" Content="{local:Icon E70E}"
                                             IsChecked="{Binding $parent[Window].DataContext.IsNowPlaying, Mode=OneWay}"
                                             Command="{Binding $parent[Window].DataContext.GoNowPlayingCommand}" ToolTip.Tip="{local:T 'Song view: video and lyrics'}"/>
                        <!-- up next: popping out over the page (Views/QueuePopup), or the song view's big one when that's the page -->
                        <local:CommandToggle x:Name="QueueButton" Theme="{StaticResource ToggleIcon}" Content="{local:Icon E8FD}"
                                             IsChecked="{Binding $parent[Window].DataContext.QueueShown, Mode=OneWay}"
                                             Command="{Binding $parent[Window].DataContext.ToggleQueueCommand}" ToolTip.Tip="{local:T 'Up next'}"/>
                        <!-- playback: speed, steady volume, crossfade, equalizer (in a room: the room's speed, with the permission) -->
                        <Panel Margin="2,0,0,0" VerticalAlignment="Center">
                            <ToggleButton x:Name="PlaybackButton" Theme="{StaticResource PlaybackToggle}" ToolTip.Tip="{local:T 'Playback: speed, volume, crossfade, equalizer'}"
                                          IsChecked="{Binding #PlaybackPopup.IsOpen, Mode=TwoWay}" IsHitTestVisible="{Binding !#PlaybackPopup.IsOpen}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{local:Icon E9E9}" Classes="glyph" FontSize="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SpeedText}" FontSize="12.5" FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentTextBrush}" IsVisible="{Binding IsSpeedChanged}"/>
                                </StackPanel>
                            </ToggleButton>
                            <Popup x:Name="PlaybackPopup" PlacementTarget="{Binding #PlaybackButton}" Placement="TopEdgeAlignedRight" IsLightDismissEnabled="True"
                                   HorizontalOffset="120" VerticalOffset="-4">
                                <!-- two columns: speed and volume on the left, the equalizer on the right -->
                                <Border Margin="10" Width="720" Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="18" Padding="22,18,22,18" BoxShadow="{DynamicResource PopupShadow}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="600">
                                        <Grid ColumnDefinitions="*,41,*">
                                            <StackPanel>
                                                <TextBlock Text="{local:T Playback}" FontSize="17" FontWeight="Bold"/>

                                                <!-- speed, like YouTube's -->
                                                <DockPanel Margin="0,16,0,8">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SpeedValueText}" FontWeight="Bold"/>
                                                    <TextBlock Text="{local:T 'Playback speed'}" Classes="panel-heading"/>
                                                </DockPanel>
                                                <StackPanel IsEnabled="{Binding CanSetSpeed}">
                                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                                        <Button Theme="{StaticResource ControlButton}" Width="32" Height="32" FontSize="12" Content="{local:Icon E738}"
                                                                Command="{Binding SpeedStepCommand}" CommandParameter="-0.05" ToolTip.Tip="{local:T Slower}"/>
                                                        <Slider x:Name="SpeedSlider" Grid.Column="1" Theme="{StaticResource KnobSlider}" Margin="6,0" Minimum="0.5" Maximum="2" Value="{Binding Speed}"
                                                                SmallChange="0.05" LargeChange="0.25" IsSnapToTickEnabled="True" TickFrequency="0.05" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="2" Theme="{StaticResource ControlButton}" Width="32" Height="32" FontSize="12" Content="{local:Icon E710}"
                                                                Command="{Binding SpeedStepCommand}" CommandParameter="0.05" ToolTip.Tip="{local:T Faster}"/>
                                                    </Grid>
                                                    <ItemsControl ItemsSource="{Binding SpeedPresets}" Margin="-3,10,-3,0" Focusable="False">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <UniformGrid Rows="1"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Theme="{StaticResource SpeedPresetButton}" Classes.current="{Binding IsCurrent}" Content="{Binding Label}" Command="{Binding Command}"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <CheckBox Margin="0,12,0,0" IsChecked="{Binding SpeedPitch}" VerticalContentAlignment="Top">
                                                        <StackPanel>
                                                            <TextBlock Text="{local:T 'Change the pitch too'}"/>
                                                            <TextBlock Text="{local:T 'Faster = higher, like a record spun faster.'}" Classes="hint" FontSize="12" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </CheckBox>
                                                </StackPanel>
                                                <TextBlock Text="{Binding SpeedHint}" Classes="hint" FontSize="12" Margin="0,8,0,0" Foreground="{DynamicResource MutedBrush}"
                                                           TextWrapping="Wrap"/>

                                                <Border Height="1" Margin="0,16" Background="{DynamicResource BorderBrush}"/>

                                                <!-- steady volume and crossfade (the same switches as in Settings › Playback) -->
                                                <CheckBox Theme="{StaticResource Switch}" IsChecked="{Binding Normalize}" Margin="0,0,0,14">
                                                    <StackPanel>
                                                        <TextBlock Text="{local:T 'Normalize volume'}"/>
                                                        <TextBlock Text="{local:T 'All songs at the same volume, even if they come from different sites.'}" Classes="hint"
                                                                   FontSize="12" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </CheckBox>
                                                <CheckBox Theme="{StaticResource Switch}" IsChecked="{Binding Main.Settings.Crossfade}">
                                                    <StackPanel>
                                                        <TextBlock Text="{local:T Crossfade}"/>
                                                        <TextBlock Text="{local:T 'The next song fades in as the current one fades out, with no silence.'}" Classes="hint"
                                                                   FontSize="12" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </CheckBox>
                                                <Grid Margin="0,10,0,0" ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding Main.Settings.Crossfade}">
                                                    <TextBlock Text="{local:T Duration}" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="13"/>
                                                    <Slider Grid.Column="1" Minimum="1" Maximum="12" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="1"
                                                            Value="{Binding Main.Settings.CrossfadeSeconds}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Main.Settings.CrossfadeText}" Margin="12,0,0,0" VerticalAlignment="Center" MinWidth="34" FontSize="13"/>
                                                </Grid>
                                            </StackPanel>

                                            <Border Grid.Column="1" Width="1" HorizontalAlignment="Center" Background="{DynamicResource BorderBrush}"/>

                                            <!-- the equalizer: the same one as in Settings, smaller -->
                                            <StackPanel Grid.Column="2">
                                                <StackPanel DataContext="{Binding Main.Settings.Equalizer}">
                                                    <DockPanel>
                                                        <CheckBox DockPanel.Dock="Right" Theme="{StaticResource Switch}" IsChecked="{Binding Enabled}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{local:T Equalizer}" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    </DockPanel>
                                                    <StackPanel Classes="eq" IsEnabled="{Binding Enabled}" Margin="0,16,0,0">
                                                        <DockPanel Margin="0,0,0,10">
                                                            <Button DockPanel.Dock="Right" Theme="{StaticResource SubtleButton}" Content="{local:T Reset}" Command="{Binding ResetCommand}"
                                                                    Margin="8,0,0,0"/>
                                                            <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding Preset}" HorizontalAlignment="Stretch"/>
                                                        </DockPanel>
                                                        <Border CornerRadius="12" Background="{DynamicResource BgBrush}" Padding="6,10">
                                                            <Grid RowDefinitions="120,Auto">
                                                                <Border Height="1" Background="{DynamicResource BorderStrongBrush}" VerticalAlignment="Center" Margin="4,0"/>
                                                                <views:EqCurve Gains="{Binding Gains}" Version="{Binding CurveVersion}" Stroke="{DynamicResource AccentTextBrush}"
                                                                               IsHitTestVisible="False"/>
                                                                <ItemsControl ItemsSource="{Binding Bands}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <UniformGrid Rows="1"/>
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate DataType="{x:Type vm:EqBandViewModel}">
                                                                            <Slider Theme="{StaticResource EqSlider}" Height="120" Value="{Binding Gain}" HorizontalAlignment="Center"
                                                                                    Classes="eqband" ToolTip.Tip="{Binding GainText}"/>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <ItemsControl Grid.Row="1" ItemsSource="{Binding Bands}" Margin="0,6,0,0">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <UniformGrid Rows="1"/>
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate DataType="{x:Type vm:EqBandViewModel}">
                                                                            <TextBlock Text="{Binding Label}" FontSize="10.5" HorizontalAlignment="Center" Foreground="{DynamicResource SubTextBrush}"/>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Grid>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                                <Button x:Name="PlaybackSettingsButton" Theme="{StaticResource LinkButton}" HorizontalAlignment="Right" Margin="0,14,0,0"
                                                        Content="{local:T 'More in Settings'}"/>
                                            </StackPanel>
                                        </Grid>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Panel>
                        <Button Theme="{StaticResource ControlButton}" Content="{Binding VolumeGlyph, Converter={StaticResource Icon}}" Command="{Binding ToggleMuteCommand}"
                                Margin="2,0,0,0" ToolTip.Tip="{local:T Mute}"/>
                        <Slider x:Name="VolumeSlider" Width="110" Minimum="0" Maximum="1" Value="{Binding Volume}" Margin="4,0,0,0" VerticalAlignment="Center"
                                SmallChange="0.02" LargeChange="0.1" ToolTip.Tip="{local:T Volume}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================================================ a .ump pack dragged over the window -->
            <Border x:Name="PackDrop" Grid.Row="1" Grid.RowSpan="2" Background="{DynamicResource VeilBrush}" IsHitTestVisible="False" IsVisible="False">
                <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border CornerRadius="24" Background="{DynamicResource SurfaceBrush}" Padding="48,32,48,30" MinWidth="360" BoxShadow="{DynamicResource PopupShadow}">
                        <StackPanel>
                            <Image Source="/Assets/pack-256.png" Width="104" Height="104" HorizontalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                            <TextBlock Text="{local:T 'Drop to import'}" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,18,0,4"/>
                            <TextBlock x:Name="PackDropName" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center" MaxWidth="420"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                    <Rectangle RadiusX="24" RadiusY="24" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeDashArray="5,3" Margin="8"/>
                </Panel>
            </Border>
        </Grid>

        <!-- Linux: the window has no frame of its own, these edges resize it (WindowFrame) -->
        <Panel x:Name="ResizeEdges" IsVisible="False"/>
    </Panel>
</Window>
