<!-- The Windows app's Views\Templates.xaml for Avalonia: covers, song rows, cards. WPF's DataTriggers are classes on the row
     (Classes.current="{Binding Track.IsCurrent}") and the styles inside it; the mouse actions are views:Click / views:Rows. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:UltimateMP3Player"
                    xmlns:vm="clr-namespace:UltimateMP3Player.ViewModels"
                    xmlns:views="clr-namespace:UltimateMP3Player.Views">

    <local:BoolChoice x:Key="PlayOrAdd" True="{local:Icon E710}" False="{local:Icon E768}"/>

    <!-- ============================================================ covers -->

    <!-- Song cover, or a note on a gradient. The pictures are CoverImage, drawn straight (an ImageBrush costs an offscreen
         surface at every frame in Avalonia's renderer); the placeholder only while there's no picture. -->
    <DataTemplate x:Key="TrackCoverSmall">
        <Panel>
            <Border CornerRadius="5" Background="{DynamicResource PlaceholderGradient}" IsVisible="{Binding Cover48, Converter={x:Static ObjectConverters.IsNull}}">
                <TextBlock Text="{local:Icon EC4F}" Classes="glyph" HorizontalAlignment="Center" FontSize="16" Foreground="{DynamicResource MutedBrush}"/>
            </Border>
            <views:CoverImage CornerRadius="5" Source="{Binding Cover48}"/>
        </Panel>
    </DataTemplate>

    <DataTemplate x:Key="TrackCoverMedium">
        <Panel>
            <Border CornerRadius="10" Background="{DynamicResource PlaceholderGradient}" IsVisible="{Binding Cover160, Converter={x:Static ObjectConverters.IsNull}}">
                <TextBlock Text="{local:Icon EC4F}" Classes="glyph" HorizontalAlignment="Center" FontSize="44" Foreground="{DynamicResource MutedBrush}"/>
            </Border>
            <views:CoverImage CornerRadius="10" Source="{Binding Cover160}"/>
        </Panel>
    </DataTemplate>

    <!-- Playlist cover: custom, favorites, mosaic or first cover. -->
    <DataTemplate x:Key="PlaylistCover">
        <Panel>
            <Border CornerRadius="8" Background="{DynamicResource PlaceholderGradient}" IsVisible="{Binding ShowPlaceholder}">
                <Viewbox>
                    <Border Width="100" Height="100" Padding="30">
                        <Viewbox>
                            <TextBlock Text="{local:Icon EC4F}" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource MutedBrush}"/>
                        </Viewbox>
                    </Border>
                </Viewbox>
            </Border>
            <Border CornerRadius="8" Background="{DynamicResource FavoritesGradient}" IsVisible="{Binding IsFavorites}">
                <Viewbox>
                    <Border Width="100" Height="100" Padding="30">
                        <Viewbox>
                            <TextBlock Text="{local:Icon EB52}" FontFamily="{StaticResource IconFontFilled}" Foreground="White"/>
                        </Viewbox>
                    </Border>
                </Viewbox>
            </Border>
            <Border CornerRadius="8" ClipToBounds="True">
                <Border.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="!ShowMosaic"/>
                        <Binding Path="FirstCover" Converter="{x:Static ObjectConverters.IsNotNull}"/>
                    </MultiBinding>
                </Border.IsVisible>
                <ContentControl Content="{Binding FirstCover}" ContentTemplate="{StaticResource TrackCoverMedium}"/>
            </Border>
            <Border CornerRadius="8" ClipToBounds="True" IsVisible="{Binding ShowMosaic}">
                <ItemsControl ItemsSource="{Binding CoverTracks}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="2" Columns="2"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:CoverImage Source="{Binding Cover160}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <views:CoverImage CornerRadius="8" Source="{Binding CustomCover}" IsVisible="{Binding HasCustomCover}"/>
        </Panel>
    </DataTemplate>

    <!-- ============================================================ track rows -->

    <ControlTheme x:Key="RowIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="FontSize" Value="15"/>
    </ControlTheme>

    <!-- A list inside a page that scrolls by itself (Home): no scroll of its own; rows or cards selectable with Ctrl or Shift + click. -->
    <ControlTheme x:Key="BareList" TargetType="ListBox" BasedOn="{StaticResource PlainList}">
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel/>
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"/>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- Only a sign, next to the heart: a cloud for a song not saved on the device, a ring while it's being saved, a warning
         sign when it's no longer available online; nothing for a saved song. Saving is in the menu and next to the heart below. -->
    <DataTemplate x:Key="TrackCloudCell">
        <Panel Width="32" Height="32">
            <Panel Background="Transparent" ToolTip.Tip="{Binding CloudTip}" IsVisible="{Binding ShowCloud}">
                <TextBlock Classes="glyph cloud" Classes.gone="{Binding IsUnavailable}" Text="{Binding CloudGlyph, Converter={StaticResource Icon}}"
                           FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Panel>
            <Panel Background="Transparent" ToolTip.Tip="{Binding CloudTip}" IsVisible="{Binding IsSaving}">
                <views:ProgressRing Width="17" Height="17" Value="{Binding SavePct}" IsIndeterminate="{Binding SaveIndeterminate}"
                                    Stroke="{DynamicResource AccentBrush}" Track="{DynamicResource Surface3Brush}"/>
            </Panel>
        </Panel>
    </DataTemplate>

    <!-- A tag like a Discord role: coloured dot and name; a click opens its page. -->
    <DataTemplate x:Key="TagChip">
        <Border CornerRadius="10" Padding="7,2,9,2" Margin="0,0,5,0" Background="{DynamicResource Surface3Brush}" Cursor="Hand"
                ToolTip.Tip="{local:T 'Open the tag'}"
                views:Click.Command="{Binding $parent[Window].DataContext.OpenTagCommand}">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}" FontSize="11.5" Margin="5,0,0,1" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- A song with a tick box (tags on a playlist's songs). -->
    <DataTemplate x:Key="SongChoiceTemplate">
        <Border Classes="choice" Classes.off="{Binding !IsSelected}" CornerRadius="8" Padding="8,5">
            <Border.Styles>
                <Style Selector="Border.choice">
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
                <Style Selector="Border.choice:pointerover">
                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                </Style>
                <Style Selector="Border.choice.off">
                    <Setter Property="Opacity" Value="0.5"/>
                </Style>
            </Border.Styles>
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center"/>
                <ContentControl Grid.Column="1" Width="36" Height="36" Margin="12,0,0,0" Content="{Binding Track}" ContentTemplate="{StaticResource TrackCoverSmall}"/>
                <StackPanel Grid.Column="2" Margin="12,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Track.Title}" TextTrimming="CharacterEllipsis" FontSize="13.5"/>
                    <TextBlock Text="{Binding Track.Artist}" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{DynamicResource SubTextBrush}"/>
                </StackPanel>
                <TextBlock Grid.Column="3" Text="{Binding Track.TagsText}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" MaxWidth="160"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- A song of a .ump pack being imported: new, already in the library, to download, missing. -->
    <DataTemplate x:Key="PackSongTemplate">
        <Border Classes="pack" Classes.out="{Binding !IsIncluded}" CornerRadius="8" Padding="8,4" ToolTip.Tip="{Binding StateTip}">
            <Border.Styles>
                <Style Selector="Border.pack">
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
                <Style Selector="Border.pack:pointerover">
                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                </Style>
                <Style Selector="Border.pack.out">
                    <Setter Property="Opacity" Value="0.4"/>
                </Style>
            </Border.Styles>
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Panel Width="34" Height="34">
                    <Border CornerRadius="5" Background="{DynamicResource PlaceholderGradient}">
                        <TextBlock Text="{local:Icon EC4F}" Classes="glyph" HorizontalAlignment="Center" FontSize="15" Foreground="{DynamicResource MutedBrush}"/>
                    </Border>
                    <views:CoverImage CornerRadius="5" Source="{Binding Cover}"/>
                </Panel>
                <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="13.5"/>
                    <TextBlock Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{DynamicResource SubTextBrush}"/>
                </StackPanel>
                <Border Grid.Column="2" CornerRadius="10" Padding="8,2,10,3" Background="{DynamicResource Surface3Brush}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{Binding StateBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StateText}" FontSize="11.5" Margin="6,0,0,1" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </DataTemplate>



    <DataTemplate x:Key="TrackRowTemplate">
        <Border Classes="row" Classes.current="{Binding Track.IsCurrent}" Classes.playing="{Binding Track.IsPlaying}" Classes.fav="{Binding Track.IsFavorite}"
                Classes.room="{Binding $parent[Window].DataContext.InRoom, FallbackValue=False}"
                Classes.noadd="{Binding !$parent[Window].DataContext.CanAddToRoom, FallbackValue=False}"
                Classes.gone="{Binding Track.IsUnavailable}" Classes.cloud="{Binding Track.IsCloud}"
                CornerRadius="8" Padding="8,5" Margin="0,0,0,1"
                views:Rows.Menu="track" views:Rows.Drag="True" views:Click.Double="{Binding PlayCommand}"
                ToolTip.ShowDelay="900" local:Marquee.Host="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="2.6*"/>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="{DynamicResource TagColumnWidth}"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="36"/>
                </Grid.ColumnDefinitions>

                <Panel>
                    <TextBlock Classes="num" Text="{Binding Number}" Foreground="{DynamicResource SubTextBrush}" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <!-- play, or pause/resume on the song already playing; in a room "+" (into the room's queue) -->
                    <Button Classes="play" Theme="{StaticResource RowIconButton}" Command="{Binding PlayPauseCommand}"
                            Foreground="{DynamicResource TextBrush}" ToolTip.ShowOnDisabled="True"/>
                </Panel>

                <Grid Grid.Column="1" Margin="4,0,12,0" ColumnDefinitions="40,*">
                    <ContentControl Width="40" Height="40" Content="{Binding Track}" ContentTemplate="{StaticResource TrackCoverSmall}"/>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <views:InlinePanel>
                            <TextBlock Classes="title" Text="{Binding Track.Title}" FontSize="14" TextTrimming="CharacterEllipsis" local:Marquee.IsEnabled="True"/>
                            <Border Margin="8,0,0,0" CornerRadius="4" Padding="5,0" Background="{DynamicResource Surface3Brush}" VerticalAlignment="Center"
                                    IsVisible="{Binding Track.HasVideo}" ToolTip.Tip="{local:T 'Has video too'}">
                                <TextBlock Text="{local:Icon E714}" Classes="glyph" FontSize="11" Foreground="{DynamicResource SubTextBrush}" Margin="0,2"/>
                            </Border>
                        </views:InlinePanel>
                        <TextBlock Text="{Binding Track.Artist}" FontSize="12.5" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                   local:Marquee.IsEnabled="True"/>
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Column="2" Text="{Binding Track.AlbumText}" FontSize="13" Foreground="{DynamicResource SubTextBrush}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0" local:Marquee.IsEnabled="True"/>

                <!-- the chips get all the room they want inside the canvas, which clips them (soft right edge) -->
                <Canvas Grid.Column="3" Height="22" Margin="0,0,10,0" ClipToBounds="True" VerticalAlignment="Center" Background="Transparent"
                        ToolTip.Tip="{Binding Track.TagsText}" ToolTip.IsOpen="False" local:Ui.FadeRight="22">
                    <ItemsControl ItemsSource="{Binding Track.Tags}" ItemTemplate="{StaticResource TagChip}" Focusable="False" Canvas.Top="1">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Canvas>

                <ContentControl Grid.Column="4" Content="{Binding Track}" ContentTemplate="{StaticResource TrackCloudCell}"/>

                <Button Classes="heart" Grid.Column="5" Theme="{StaticResource RowIconButton}" Command="{Binding FavoriteCommand}"/>

                <TextBlock Grid.Column="6" Text="{Binding Track.DurationText}" FontSize="13" Foreground="{DynamicResource SubTextBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>

                <Button Classes="more" Grid.Column="7" Theme="{StaticResource RowIconButton}" Content="{local:Icon E712}"
                        Command="{x:Static views:Menus.MoreCommand}" CommandParameter="{Binding $self}" ToolTip.Tip="{local:T 'More options'}"/>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- Column titles above a track list. -->
    <DataTemplate x:Key="TrackHeader">
        <!-- the line under the header stops short of the edges; the header itself stays where it was -->
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,10,8" Margin="8,0,8,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="2.6*"/>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="{DynamicResource TagColumnWidth}"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="36"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="#" Classes="small-caps" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{local:T TITLE}" Classes="small-caps" Margin="4,0,0,0"/>
                <TextBlock Grid.Column="2" Text="ALBUM" Classes="small-caps"/>
                <TextBlock Grid.Column="3" Text="{local:T TAGS}" Classes="small-caps"/>
                <TextBlock Grid.Column="6" Text="{local:Icon E823}" Classes="glyph" FontSize="14" Foreground="{DynamicResource MutedBrush}"
                           HorizontalAlignment="Right" Margin="0,0,12,0"/>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- A song of the statistics page: how many plays, how long, when last. -->
    <DataTemplate x:Key="StatsRowTemplate">
        <Border Classes="row" Classes.current="{Binding Track.IsCurrent}" Classes.playing="{Binding Track.IsPlaying}" Classes.fav="{Binding Track.IsFavorite}"
                Classes.never="{Binding Track.Plays, Converter={StaticResource IsZero}}"
                Classes.room="{Binding $parent[Window].DataContext.InRoom, FallbackValue=False}"
                Classes.gone="{Binding Track.IsUnavailable}" Classes.cloud="{Binding Track.IsCloud}"
                CornerRadius="8" Padding="8,5" Margin="0,0,0,1"
                views:Rows.Menu="track" views:Rows.Drag="True" views:Click.Double="{Binding PlayCommand}"
                ToolTip.ShowDelay="900" local:Marquee.Host="True">
            <Grid ColumnDefinitions="40,2.6*,0.9*,0.9*,1*,32,36,64,36">
                <Panel>
                    <TextBlock Classes="num" Text="{Binding Number}" Foreground="{DynamicResource SubTextBrush}" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button Classes="play" Theme="{StaticResource RowIconButton}" Command="{Binding PlayPauseCommand}" Foreground="{DynamicResource TextBrush}"/>
                </Panel>

                <Grid Grid.Column="1" Margin="4,0,12,0" ColumnDefinitions="40,*">
                    <ContentControl Width="40" Height="40" Content="{Binding Track}" ContentTemplate="{StaticResource TrackCoverSmall}"/>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Classes="title" Text="{Binding Track.Title}" FontSize="14" TextTrimming="CharacterEllipsis" local:Marquee.IsEnabled="True"/>
                        <TextBlock Text="{Binding Track.Artist}" FontSize="12.5" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                   local:Marquee.IsEnabled="True"/>
                    </StackPanel>
                </Grid>

                <TextBlock Classes="plays" Grid.Column="2" Text="{Binding Track.PlaysText}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                <TextBlock Grid.Column="3" Text="{Binding Track.ListenedText}" FontSize="13" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                <TextBlock Grid.Column="4" Text="{Binding Track.LastPlayedText}" FontSize="13" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>

                <ContentControl Grid.Column="5" Content="{Binding Track}" ContentTemplate="{StaticResource TrackCloudCell}"/>

                <Button Classes="heart" Grid.Column="6" Theme="{StaticResource RowIconButton}" Command="{Binding FavoriteCommand}"/>

                <TextBlock Grid.Column="7" Text="{Binding Track.DurationText}" FontSize="13" Foreground="{DynamicResource SubTextBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>

                <Button Classes="more" Grid.Column="8" Theme="{StaticResource RowIconButton}" Content="{local:Icon E712}"
                        Command="{x:Static views:Menus.MoreCommand}" CommandParameter="{Binding $self}" ToolTip.Tip="{local:T 'More options'}"/>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="StatsHeader">
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,10,8" Margin="8,0,8,8">
            <Grid ColumnDefinitions="40,2.6*,0.9*,0.9*,1*,32,36,64,36">
                <TextBlock Text="#" Classes="small-caps" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{local:T TITLE}" Classes="small-caps" Margin="4,0,0,0"/>
                <TextBlock Grid.Column="2" Text="{local:T PLAYS}" Classes="small-caps"/>
                <TextBlock Grid.Column="3" Text="{local:T TIME}" Classes="small-caps"/>
                <TextBlock Grid.Column="4" Text="{local:T 'LAST PLAYED'}" Classes="small-caps"/>
                <TextBlock Grid.Column="7" Text="{local:Icon E823}" Classes="glyph" FontSize="14" Foreground="{DynamicResource MutedBrush}"
                           HorizontalAlignment="Right" Margin="0,0,12,0"/>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- ============================================================ cards -->

    <DataTemplate x:Key="TrackCard">
        <Border Classes="card" Classes.current="{Binding IsCurrent}" Classes.playing="{Binding IsPlaying}"
                Classes.room="{Binding $parent[Window].DataContext.InRoom, FallbackValue=False}"
                CornerRadius="12" Padding="12" Cursor="Hand" local:Marquee.Host="True"
                views:Rows.Menu="card" views:Click.Command="{Binding $parent[Window].DataContext.PlayTrackCommand}">
            <Border.Styles>
                <Style Selector="Border.card">
                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                </Style>
                <Style Selector="Border.card:pointerover">
                    <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
                </Style>
                <Style Selector="Border.card:pointerover Border.disc, Border.card.playing Border.disc">
                    <Setter Property="Opacity" Value="1"/>
                </Style>
                <Style Selector="Border.card.current TextBlock.title">
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                </Style>
                <Style Selector="Border.card TextBlock.ico">
                    <Setter Property="Text" Value="{local:Icon E768}"/>
                </Style>
                <Style Selector="Border.card.playing TextBlock.ico">
                    <Setter Property="Text" Value="{local:Icon E769}"/>
                </Style>
                <Style Selector="Border.card.room TextBlock.ico">
                    <Setter Property="Text" Value="{local:Icon E710}"/>
                </Style>
                <Style Selector="Border.card.room">
                    <Setter Property="ToolTip.Tip" Value="{local:T 'Add to the room\'s queue'}"/>
                </Style>
                <!-- selected with Ctrl or Shift + click -->
                <Style Selector="ListBoxItem:selected Border.card">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                </Style>
            </Border.Styles>
            <StackPanel>
                <views:SquareBox>
                    <Panel>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TrackCoverMedium}"/>
                        <Border Classes="disc" Width="44" Height="44" CornerRadius="22" Background="{DynamicResource AccentGradient}"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8" Opacity="0">
                            <TextBlock Classes="glyph ico" Foreground="{DynamicResource OnAccentBrush}" FontSize="17" HorizontalAlignment="Center"/>
                        </Border>
                        <!-- not saved on the device: a cloud on the cover (only a sign; a ring while it's being saved) -->
                        <Border Width="28" Height="28" CornerRadius="14" Background="#A6000000" ToolTip.Tip="{Binding CloudTip}"
                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7" IsVisible="{Binding IsCloud}">
                            <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CloudGlyph, Converter={StaticResource Icon}}" Classes="glyph" FontSize="14" Foreground="White"
                                           IsVisible="{Binding ShowCloud}"/>
                                <views:ProgressRing Width="16" Height="16" Value="{Binding SavePct}" IsIndeterminate="{Binding SaveIndeterminate}" Stroke="White"
                                                    Track="#50FFFFFF" IsVisible="{Binding IsSaving}"/>
                            </Panel>
                        </Border>
                    </Panel>
                </views:SquareBox>
                <TextBlock Classes="title" Text="{Binding Title}" FontWeight="SemiBold" Margin="0,10,0,2" TextTrimming="CharacterEllipsis" local:Marquee.IsEnabled="True"/>
                <TextBlock Text="{Binding Artist}" FontSize="12.5" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis" local:Marquee.IsEnabled="True"/>
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="PlaylistCard">
        <Border Classes="card" CornerRadius="12" Padding="12" Cursor="Hand" local:Marquee.Host="True"
                views:Rows.Menu="playlist" views:Click.Command="{Binding $parent[Window].DataContext.OpenPlaylistCommand}">
            <Border.Styles>
                <Style Selector="Border.card">
                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                </Style>
                <Style Selector="Border.card:pointerover">
                    <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
                </Style>
                <Style Selector="Border.card:pointerover Button.disc">
                    <Setter Property="Opacity" Value="1"/>
                </Style>
                <!-- selected with Ctrl or Shift + click -->
                <Style Selector="ListBoxItem:selected Border.card">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                </Style>
            </Border.Styles>
            <StackPanel>
                <views:SquareBox>
                    <Panel>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PlaylistCover}"/>
                        <Button Classes="disc" Theme="{StaticResource BigPlayButton}" Width="44" Height="44" FontSize="17"
                                Content="{Binding $parent[Window].DataContext.InRoom, Converter={StaticResource PlayOrAdd}, FallbackValue={local:Icon E768}}"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8" Opacity="0"
                                Command="{Binding $parent[Window].DataContext.PlayPlaylistCommand}" CommandParameter="{Binding}" ToolTip.Tip="{local:T Play}"/>
                    </Panel>
                </views:SquareBox>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,10,0,2" TextTrimming="CharacterEllipsis" local:Marquee.IsEnabled="True"/>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding DeviceGlyph, Converter={StaticResource Icon}}" Classes="glyph" FontSize="11"
                               Foreground="{DynamicResource SubTextBrush}" Margin="0,0,5,0" VerticalAlignment="Center" IsVisible="{Binding HasDevice}"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis" local:Marquee.IsEnabled="True"/>
                </DockPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- The big play / shuffle buttons of a page: in a room they put the whole list in the room's queue. -->
    <ControlTheme x:Key="HeaderPlayButton" TargetType="Button" BasedOn="{StaticResource BigPlayButton}">
        <Setter Property="Content" Value="{Binding $parent[Window].DataContext.InRoom, Converter={StaticResource PlayOrAdd}, FallbackValue={local:Icon E768}}"/>
        <Setter Property="ToolTip.Tip" Value="{local:T Play}"/>
        <Setter Property="ToolTip.ShowOnDisabled" Value="True"/>
    </ControlTheme>

    <ControlTheme x:Key="HeaderShuffleButton" TargetType="Button" BasedOn="{StaticResource BigPlayButton}">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="46"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Content" Value="{local:Icon E8B1}"/>
        <Setter Property="ToolTip.Tip" Value="{local:T 'Shuffle play'}"/>
    </ControlTheme>

    <!-- "Tag" filter pill above a song list (only once there are tags); highlighted while it filters. -->
    <ControlTheme x:Key="TagFilterButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="ToolTip.Tip" Value="{local:T 'Filter by tag'}"/>
        <Setter Property="IsVisible" Value="{Binding $parent[Window].DataContext.HasTags, FallbackValue=False}"/>
        <Setter Property="Content" Value="{Binding TagFilter}"/>
        <Setter Property="ContentTemplate">
            <DataTemplate>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{local:Icon E71C}" Classes="glyph" FontSize="14"/>
                    <TextBlock Text="{Binding Label}" Margin="8,0,0,0" Classes="label" local:ToolbarPanel.Priority="1"/>
                </StackPanel>
            </DataTemplate>
        </Setter>
    </ControlTheme>

    <!-- "On the device / in the cloud" filter pill above a song list (while the page has songs in the cloud, or it filters):
         its icon and name say what it shows; highlighted (class "on") while it hides some. -->
    <ControlTheme x:Key="StorageFilterButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="ToolTip.Tip" Value="{Binding Storage.Tip}"/>
        <Setter Property="IsVisible" Value="{Binding Storage.IsVisible}"/>
        <Setter Property="Content" Value="{Binding Storage}"/>
        <Setter Property="ContentTemplate">
            <DataTemplate>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Glyph, Converter={StaticResource Icon}}" Classes="glyph" FontSize="14"/>
                    <!-- (a narrow window: its name is the first text to go, the last one while it filters) -->
                    <TextBlock Text="{Binding Label}" Margin="8,0,0,0" Classes="label"
                               local:ToolbarPanel.Priority="{Binding IsActive, Converter={x:Static local:ToolbarPanel.KeepWhen}}"/>
                </StackPanel>
            </DataTemplate>
        </Setter>
        <Style Selector="^.on">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
        </Style>
    </ControlTheme>

    <!-- A mix of Home › For you: its first song's cover with a band in its colour and its name; a click plays it. -->
    <DataTemplate x:Key="MixCard">
        <Border Classes="card" CornerRadius="12" Padding="12" Cursor="Hand" views:Click.Command="{Binding PlayCommand}">
            <Border.Styles>
                <Style Selector="Border.card">
                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                </Style>
                <Style Selector="Border.card:pointerover">
                    <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
                </Style>
                <Style Selector="Border.card:pointerover Border.disc">
                    <Setter Property="Opacity" Value="1"/>
                </Style>
            </Border.Styles>
            <StackPanel>
                <views:SquareBox>
                    <Panel>
                        <ContentControl Content="{Binding Cover}" ContentTemplate="{StaticResource TrackCoverMedium}"/>
                        <Border VerticalAlignment="Bottom" CornerRadius="0,0,10,10" Background="{Binding Brush}" Padding="12,9,12,10">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph, Converter={StaticResource Icon}}" Classes="glyph" FontSize="15" Foreground="White"
                                           Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <Border Classes="disc" Width="44" Height="44" CornerRadius="22" Background="{DynamicResource AccentGradient}" HorizontalAlignment="Right"
                                VerticalAlignment="Top" Margin="0,8,8,0" Opacity="0">
                            <TextBlock Text="{local:Icon E768}" Classes="glyph" Foreground="{DynamicResource OnAccentBrush}" FontSize="17" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Panel>
                </views:SquareBox>
                <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Foreground="{DynamicResource SubTextBrush}" Margin="0,10,0,0" TextWrapping="Wrap" MaxLines="2"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ============================================================ artists -->

    <!-- An artist: its picture in a circle (or its initial on a colour of its own) and its name; a click opens its page. The
         round button follows it (a tick once followed); a dot = a release of its not seen yet. -->
    <DataTemplate x:Key="ArtistCard">
        <Border Classes="card" CornerRadius="12" Padding="12" Cursor="Hand" local:Marquee.Host="True" views:Click.Command="{Binding OpenCommand}" views:Rows.Menu="artist">
            <Border.Styles>
                <Style Selector="Border.card">
                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                </Style>
                <Style Selector="Border.card:pointerover">
                    <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
                </Style>
                <Style Selector="Border.card:pointerover Button.disc">
                    <Setter Property="Opacity" Value="1"/>
                </Style>
            </Border.Styles>
            <StackPanel>
                <views:SquareBox>
                    <Panel>
                        <Ellipse Fill="{Binding Brush}"/>
                        <Viewbox Margin="30">
                            <TextBlock Text="{Binding Initial}" FontWeight="Bold" Foreground="White"/>
                        </Viewbox>
                        <views:CoverImage IsCircle="True" Source="{Binding Picture}"/>
                        <Ellipse Width="14" Height="14" Fill="{DynamicResource AccentGradient}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"
                                 IsVisible="{Binding HasNew}" ToolTip.Tip="{local:T 'New release'}"/>
                        <Button Classes="disc" Theme="{StaticResource BigPlayButton}" Width="40" Height="40" FontSize="15"
                                Content="{Binding FollowGlyph, Converter={StaticResource Icon}}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Opacity="0"
                                Command="{Binding FollowCommand}" ToolTip.Tip="{Binding FollowTip}"/>
                    </Panel>
                </views:SquareBox>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,10,0,2" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"
                           local:Marquee.IsEnabled="True"/>
                <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"
                           IsVisible="{Binding HasSubtitle}"/>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- An internet radio: its picture on its colour (or its initial), name, what it plays; a click plays it live, the heart keeps it. -->
    <DataTemplate x:Key="StationCard">
        <Border Classes="card" CornerRadius="12" Padding="12" Cursor="Hand" local:Marquee.Host="True" views:Click.Command="{Binding PlayCommand}">
            <Border.Styles>
                <Style Selector="Border.card">
                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                </Style>
                <Style Selector="Border.card:pointerover">
                    <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
                </Style>
                <Style Selector="Border.card:pointerover Button.disc">
                    <Setter Property="Opacity" Value="1"/>
                </Style>
                <!-- (the full heart is in the filled font) -->
                <Style Selector="Button.saved">
                    <Setter Property="FontFamily" Value="{StaticResource IconFontFilled}"/>
                </Style>
            </Border.Styles>
            <StackPanel>
                <views:SquareBox>
                    <Panel>
                        <Border CornerRadius="10" Background="{Binding Brush}">
                            <Panel>
                                <Viewbox Margin="34" IsVisible="{Binding !HasPicture}">
                                    <TextBlock Text="{Binding Initial}" FontWeight="Bold" Foreground="White"/>
                                </Viewbox>
                                <Image Source="{Binding Picture}" Stretch="Uniform" Margin="16" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                            </Panel>
                        </Border>
                        <Border CornerRadius="9" Padding="8,2" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource AccentGradient}"
                                IsVisible="{Binding IsCurrent}">
                            <TextBlock Text="{local:T LIVE}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource OnAccentBrush}"/>
                        </Border>
                        <Button Classes="disc" Theme="{StaticResource BigPlayButton}" Width="40" Height="40" FontSize="15"
                                Content="{Binding SaveGlyph, Converter={StaticResource Icon}}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Opacity="0"
                                Classes.saved="{Binding IsSaved}" Command="{Binding SaveCommand}" ToolTip.Tip="{Binding SaveTip}"/>
                    </Panel>
                </views:SquareBox>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,10,0,2" TextTrimming="CharacterEllipsis" local:Marquee.IsEnabled="True"/>
                <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding HasSubtitle}"/>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- A new album, EP or single of a followed artist: its cover ("NEW" until seen); a click opens it like its link, its button
         plays it without saving it. -->
    <DataTemplate x:Key="ReleaseCard">
        <Border Classes="card" CornerRadius="12" Padding="12" Cursor="Hand" local:Marquee.Host="True" views:Click.Command="{Binding OpenCommand}">
            <Border.Styles>
                <Style Selector="Border.card">
                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                </Style>
                <Style Selector="Border.card:pointerover">
                    <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
                </Style>
                <Style Selector="Border.card:pointerover Button.disc">
                    <Setter Property="Opacity" Value="1"/>
                </Style>
            </Border.Styles>
            <StackPanel>
                <views:SquareBox>
                    <Panel>
                        <Border CornerRadius="8" Background="{DynamicResource PlaceholderGradient}" IsVisible="{Binding Cover, Converter={x:Static ObjectConverters.IsNull}}">
                            <TextBlock Text="{local:Icon EC4F}" Classes="glyph" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                        </Border>
                        <views:CoverImage CornerRadius="8" Source="{Binding Cover}"/>
                        <Border CornerRadius="9" Padding="8,2,8,3" Margin="8" Background="{DynamicResource AccentGradient}" HorizontalAlignment="Left" VerticalAlignment="Top"
                                IsVisible="{Binding IsNew}">
                            <TextBlock Text="{local:T NEW}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource OnAccentBrush}"/>
                        </Border>
                        <Button Classes="disc" Theme="{StaticResource BigPlayButton}" Width="44" Height="44" FontSize="17" Content="{local:Icon E768}"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8" Opacity="0"
                                Command="{Binding PlayCommand}" ToolTip.Tip="{local:T 'Play without saving'}"/>
                    </Panel>
                </views:SquareBox>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,10,0,2" TextTrimming="CharacterEllipsis" local:Marquee.IsEnabled="True"/>
                <TextBlock Text="{Binding Artist}" FontSize="12.5" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis" local:Marquee.IsEnabled="True"/>
                <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- An album or a playlist found online (an artist's page, the search): its cover; a click opens it like its link, its button
         plays it without saving it. -->
    <DataTemplate x:Key="AlbumCard">
        <Border Classes="card" CornerRadius="12" Padding="12" Cursor="Hand" local:Marquee.Host="True" views:Click.Command="{Binding DownloadCommand}">
            <Border.Styles>
                <Style Selector="Border.card">
                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                </Style>
                <Style Selector="Border.card:pointerover">
                    <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
                </Style>
                <Style Selector="Border.card:pointerover Button.disc">
                    <Setter Property="Opacity" Value="1"/>
                </Style>
            </Border.Styles>
            <StackPanel>
                <views:SquareBox>
                    <Panel>
                        <Border CornerRadius="8" Background="{DynamicResource PlaceholderGradient}" IsVisible="{Binding Thumb, Converter={x:Static ObjectConverters.IsNull}}">
                            <TextBlock Text="{local:Icon EC4F}" Classes="glyph" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                        </Border>
                        <views:CoverImage CornerRadius="8" Source="{Binding Thumb}"/>
                        <Button Classes="disc" Theme="{StaticResource BigPlayButton}" Width="44" Height="44" FontSize="17" Content="{local:Icon E768}"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8" Opacity="0"
                                Command="{Binding PlayCommand}" ToolTip.Tip="{local:T 'Play without saving'}"/>
                    </Panel>
                </views:SquareBox>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,10,0,2" TextTrimming="CharacterEllipsis" local:Marquee.IsEnabled="True"/>
                <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis" local:Marquee.IsEnabled="True"/>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- A song found online (the search, an artist's popular songs): a click plays it without saving it, its button downloads it
         (its card, as a pasted link); an album or a playlist the other way round: a click opens its card, its button plays it.
         Your songs' columns (TrackRowTemplate), so the two line up under the search's "Songs": the site where the tags, the
         cloud and the heart are, the button where "more" is. -->
    <DataTemplate x:Key="HitRowTemplate">
        <Border Classes="hitrow" Classes.song="{Binding IsSong}" CornerRadius="8" Padding="8,5" Margin="0,0,0,1" Cursor="Hand" local:Marquee.Host="True"
                views:Click.Command="{Binding TapCommand}" views:Rows.Menu="hit" views:Rows.Drag="True">
            <Border.Styles>
                <Style Selector="Border.hitrow">
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
                <Style Selector="Border.hitrow:pointerover">
                    <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                </Style>
                <!-- a song: "play" in its number's place under the mouse (the row plays it) -->
                <Style Selector="TextBlock.hitplay">
                    <Setter Property="Opacity" Value="0"/>
                </Style>
                <Style Selector="Border.hitrow.song:pointerover TextBlock.hitplay">
                    <Setter Property="Opacity" Value="1"/>
                </Style>
                <Style Selector="Border.hitrow.song:pointerover TextBlock.hitnum">
                    <Setter Property="Opacity" Value="0"/>
                </Style>
            </Border.Styles>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="2.6*"/>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="{DynamicResource TagColumnWidth}"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="36"/>
                </Grid.ColumnDefinitions>

                <Panel>
                    <TextBlock Classes="hitnum" Text="{Binding Number}" Foreground="{DynamicResource SubTextBrush}" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Classes="hitplay glyph" Text="{local:Icon E768}" FontSize="13" Foreground="{DynamicResource TextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Panel>

                <Grid Grid.Column="1" Margin="4,0,12,0" ColumnDefinitions="40,*">
                    <Panel Width="40" Height="40">
                        <Border CornerRadius="5" Background="{DynamicResource PlaceholderGradient}" IsVisible="{Binding Thumb, Converter={x:Static ObjectConverters.IsNull}}">
                            <TextBlock Text="{local:Icon EC4F}" Classes="glyph" FontSize="15" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                        </Border>
                        <views:CoverImage CornerRadius="5" Source="{Binding Thumb}"/>
                    </Panel>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" local:Marquee.IsEnabled="True"/>
                        <DockPanel Margin="0,2,0,0">
                            <Border DockPanel.Dock="Left" CornerRadius="7" Padding="6,0" Margin="0,0,8,0" Background="{DynamicResource SuccessSoftBrush}" VerticalAlignment="Center"
                                    IsVisible="{Binding InLibrary}" ToolTip.Tip="{local:T 'You already have it in your library'}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{local:Icon E73E}" Classes="glyph" FontSize="9" Foreground="{DynamicResource SuccessBrush}"/>
                                    <TextBlock Text="{local:T 'in library'}" FontSize="11" FontWeight="SemiBold" Margin="4,0,0,1" Foreground="{DynamicResource SuccessBrush}"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding Line}" FontSize="12.5" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis"
                                       local:Marquee.IsEnabled="True"/>
                        </DockPanel>
                    </StackPanel>
                </Grid>

                <DockPanel Grid.Column="2" Grid.ColumnSpan="4">
                    <Border DockPanel.Dock="Right" CornerRadius="10" Padding="8,2,9,2" Background="{DynamicResource Surface3Brush}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{Binding ServiceBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Service}" FontSize="11.5" Margin="6,0,0,0" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding AlbumText}" FontSize="13" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Margin="0,0,12,0" local:Marquee.IsEnabled="True"/>
                </DockPanel>

                <TextBlock Grid.Column="6" Text="{Binding DurationText}" FontSize="13" Foreground="{DynamicResource SubTextBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>

                <Button Grid.Column="7" Theme="{StaticResource RowIconButton}" Content="{Binding SideGlyph, Converter={StaticResource Icon}}"
                        Command="{Binding SideCommand}" ToolTip.Tip="{Binding SideTip}"/>
            </Grid>
        </Border>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="CardGridTemplate">
        <views:CardGrid/>
    </ItemsPanelTemplate>
</ResourceDictionary>
