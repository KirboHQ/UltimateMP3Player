<UserControl x:Class="UltimateMP3Player.Views.SearchView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UltimateMP3Player"
             xmlns:vm="clr-namespace:UltimateMP3Player.ViewModels"
             xmlns:views="clr-namespace:UltimateMP3Player.Views">
    <UserControl.Resources>
        <!-- a site filter over the online results: coloured dot, name, how many -->
        <ControlTheme x:Key="ServiceChip" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="Margin" Value="0,0,8,6"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" CornerRadius="15" Height="30" Padding="12,0" Background="{DynamicResource Surface2Brush}"
                            BorderBrush="Transparent" BorderThickness="1">
                        <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#Bd">
                <Setter Property="Background" Value="{DynamicResource Surface3Brush}"/>
            </Style>
            <Style Selector="^:pointerover">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            </Style>
            <Style Selector="^.selected /template/ Border#Bd">
                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            </Style>
            <Style Selector="^.selected">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            </Style>
        </ControlTheme>

        <!-- a song found online: the whole row is the button (it opens the download, as a pasted link) -->
        <ControlTheme x:Key="HitRow" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" CornerRadius="8" Padding="8,6" Margin="0,0,10,1" Background="Transparent">
                        <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#Bd">
                <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
            </Style>
            <Style Selector="^:pressed /template/ Border#Bd">
                <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
            </Style>
        </ControlTheme>
    </UserControl.Resources>
    <!-- The "Scarica" pill lit under the mouse: outside the ControlTheme, which may not style its content (Avalonia threw
         "ControlTheme style may not directly contain a child or descendent selector" when the online results appeared). -->
    <UserControl.Styles>
        <Style Selector="Button.hit:pointerover Border.get">
            <Setter Property="Background" Value="{DynamicResource AccentGradient}"/>
        </Style>
        <Style Selector="Button.hit:pointerover Border.get TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
        </Style>
    </UserControl.Styles>

    <Grid Margin="20,6,12,0" RowDefinitions="Auto,*">
        <DockPanel Margin="8,0,10,14">
            <!-- your songs / the music sites -->
            <Border DockPanel.Dock="Right" Margin="16,0,0,0" CornerRadius="20" Padding="4" Background="{DynamicResource SurfaceBrush}" VerticalAlignment="Center"
                    BorderBrush="Transparent" BorderThickness="1" IsVisible="{Binding OnlineEnabled}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Theme="{StaticResource Segment}" GroupName="SearchTabs" local:Ui.Glyph="&#xE8F1;" Content="{Binding LocalTabText}"
                                 IsChecked="{Binding LocalMode, Mode=OneWay}" Command="{Binding ShowLocalCommand}"/>
                    <RadioButton Theme="{StaticResource Segment}" GroupName="SearchTabs" local:Ui.Glyph="&#xE774;" Content="{Binding OnlineTabText}" Margin="4,0,0,0"
                                 IsChecked="{Binding OnlineMode, Mode=OneWay}" Command="{Binding ShowOnlineCommand}"
                                 ToolTip.Tip="{local:T 'Songs found on YouTube Music, SoundCloud, YouTube and Deezer: click one to download it'}"/>
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding Title}" Classes="section-title" Margin="0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <!-- ============================================================ your songs -->
        <Grid Grid.Row="1" IsVisible="{Binding LocalMode}" RowDefinitions="Auto,Auto,*">
            <StackPanel Margin="8,0,0,6" IsVisible="{Binding HasPlaylists}">
                <TextBlock Text="PLAYLIST" Classes="small-caps" Margin="0,0,0,10"/>
                <ItemsControl ItemsSource="{Binding PlaylistResults}" ItemTemplate="{StaticResource PlaylistCard}" Margin="0,0,10,12">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <views:CardGrid MaxRows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>

            <ContentControl Grid.Row="1" ContentTemplate="{StaticResource TrackHeader}" Content="{Binding}" Margin="0,0,10,0"/>
            <ListBox x:Name="List" Grid.Row="2" Theme="{StaticResource PlainList}" ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource TrackRowTemplate}"/>
            <views:SelectionBar Grid.Row="2" List="{Binding #List}" ZIndex="1"/>
            <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0" IsVisible="{Binding NoResults}">
                <TextBlock Text="{local:T 'No results'}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding LocalEmptyHint}" Classes="hint" Margin="0,8,0,0" TextAlignment="Center" MaxWidth="460"/>
            </StackPanel>
        </Grid>

        <!-- ============================================================ online -->
        <Grid Grid.Row="1" IsVisible="{Binding OnlineMode}" RowDefinitions="Auto,*">
            <DockPanel Margin="8,0,10,8" MinHeight="36">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                    <Ellipse Classes="spinner" Width="14" Height="14" StrokeThickness="2.5" Margin="0,0,8,0" VerticalAlignment="Center"
                             IsVisible="{Binding OnlineBusy}"/>
                    <TextBlock Text="{Binding OnlineStatus}" Classes="hint" FontSize="12" VerticalAlignment="Center" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                    <Button Theme="{StaticResource IconButton}" Width="30" Height="30" FontSize="13" Content="{local:Icon E713}" Margin="6,0,0,0"
                            Command="{Binding OnlineSettingsCommand}" ToolTip.Tip="{local:T 'Which sites to search and in what order (Settings)'}"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding ServiceTabs}" Focusable="False" IsVisible="{Binding HasServiceTabs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Theme="{StaticResource ServiceChip}" Classes.selected="{Binding IsSelected}" CommandParameter="{Binding}"
                                    Command="{Binding $parent[UserControl].DataContext.SelectServiceCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{Binding Brush}" Margin="0,0,7,0" VerticalAlignment="Center" IsVisible="{Binding HasDot}"/>
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Count}" Foreground="{DynamicResource MutedBrush}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>

            <ListBox Grid.Row="1" Theme="{StaticResource PlainList}" ItemsSource="{Binding OnlineHits}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Button Theme="{StaticResource HitRow}" Classes="hit" Command="{Binding DownloadCommand}"
                                ToolTip.Tip="{local:T 'Open it to download it: choose the playlist and press Download'}" ToolTip.ShowDelay="1200">
                            <Grid local:Marquee.Host="True" ColumnDefinitions="Auto,*,Auto,56,Auto">
                                <Panel Width="48" Height="48">
                                    <Border CornerRadius="6" Background="{DynamicResource PlaceholderGradient}" IsVisible="{Binding Thumb, Converter={x:Static ObjectConverters.IsNull}}">
                                        <TextBlock Text="{local:Icon EC4F}" Classes="glyph" FontSize="17" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                                    </Border>
                                    <views:CoverImage CornerRadius="6" Source="{Binding Thumb}"/>
                                </Panel>
                                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" local:Marquee.IsEnabled="True"/>
                                    <DockPanel Margin="0,2,0,0">
                                        <Border DockPanel.Dock="Left" CornerRadius="7" Padding="6,0" Margin="0,0,8,0" Background="{DynamicResource SuccessSoftBrush}" VerticalAlignment="Center"
                                                IsVisible="{Binding InLibrary}" ToolTip.Tip="{local:T 'You already have it in your library'}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{local:Icon E73E}" Classes="glyph" FontSize="9" Foreground="{DynamicResource SuccessBrush}"/>
                                                <TextBlock Text="{local:T 'in library'}" FontSize="11" FontWeight="SemiBold" Margin="4,0,0,1" Foreground="{DynamicResource SuccessBrush}"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis"
                                                   local:Marquee.IsEnabled="True"/>
                                    </DockPanel>
                                </StackPanel>
                                <Border Grid.Column="2" CornerRadius="10" Padding="8,2,9,2" Background="{DynamicResource Surface3Brush}" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="{Binding ServiceBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Service}" FontSize="11.5" Margin="6,0,0,0" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Grid.Column="3" Text="{Binding DurationText}" FontSize="12.5" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                                <Border Classes="get" Grid.Column="4" CornerRadius="15" Height="30" Padding="13,0" Margin="14,0,4,0" VerticalAlignment="Center"
                                        Background="{DynamicResource Surface3Brush}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{local:Icon E896}" Classes="glyph" FontSize="12" Foreground="{DynamicResource SubTextBrush}"/>
                                        <TextBlock Text="{local:T 'Download|verb'}" FontSize="12.5" FontWeight="SemiBold" Margin="7,0,0,0"
                                                   Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0" MaxWidth="460" IsVisible="{Binding NoOnlineResults}">
                <TextBlock Text="{Binding NoOnlineText}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock Text="{local:T 'Try the title and the artist, or paste the song\'s link directly.'}" Classes="hint"
                           Margin="0,8,0,0" TextAlignment="Center"/>
            </StackPanel>
            <!-- the Spotify tab without a key (or with one Spotify refuses): what it takes, and the way to Settings -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0" MaxWidth="480" IsVisible="{Binding ShowSpotifySetup}">
                <TextBlock Text="{local:T 'Search Spotify too'}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding SpotifySetupText}" Classes="hint" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
                <Button Theme="{StaticResource PrimaryButton}" Content="{local:T 'Set it up in Settings'}" Command="{Binding SpotifySettingsCommand}"
                        HorizontalAlignment="Center" Margin="0,18,0,0"/>
            </StackPanel>
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,48,0,0" Orientation="Horizontal" IsVisible="{Binding ShowSearching}">
                <Ellipse Classes="spinner" Width="20" Height="20" StrokeThickness="3"/>
                <TextBlock Text="{local:T 'Searching online…'}" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
