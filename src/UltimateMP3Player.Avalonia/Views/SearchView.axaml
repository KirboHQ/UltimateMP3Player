<!-- The search: its box at the top, chips (All, Songs, Artists, Albums and EPs, Playlists) over one list made of headings, your songs,
     the sites' songs, shelves of cards and notes (SearchViewModel.Items). -->
<UserControl x:Class="UltimateMP3Player.Views.SearchView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UltimateMP3Player"
             xmlns:vm="clr-namespace:UltimateMP3Player.ViewModels"
             xmlns:views="clr-namespace:UltimateMP3Player.Views">
    <UserControl.Resources>
        <!-- a chip over the results (the kinds) or over the online songs (the sites) -->
        <ControlTheme x:Key="ServiceChip" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="Margin" Value="0,0,8,6"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" CornerRadius="16" Height="32" Padding="14,0" Background="{DynamicResource Surface2Brush}"
                            BorderBrush="Transparent" BorderThickness="1">
                        <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#Bd">
                <Setter Property="Background" Value="{DynamicResource Surface3Brush}"/>
            </Style>
            <Style Selector="^:pointerover">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            </Style>
            <Style Selector="^.selected /template/ Border#Bd">
                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            </Style>
            <Style Selector="^.selected">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            </Style>
        </ControlTheme>
    </UserControl.Resources>
    <UserControl.Styles>
        <!-- (the cards' colour from a style, not set on them: a value set on them would win over the hover) -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        </Style>
        <Style Selector="Border.card:pointerover">
            <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
        </Style>
        <!-- the box while it's being written in (SearchView: "focused") -->
        <Style Selector="Border#SearchPill">
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Border#SearchPill.focused">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="TextBlock#SearchIcon">
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
        </Style>
        <Style Selector="Border#SearchPill.focused TextBlock#SearchIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
    </UserControl.Styles>

    <Grid Margin="20,12,12,0" RowDefinitions="Auto,*">
        <StackPanel Margin="8,0,10,8">
            <!-- the box (your songs and online, or a link to download) across the page, the sites' settings on its right -->
            <Grid ColumnDefinitions="*,Auto">
                <Border x:Name="SearchPill" Height="46" CornerRadius="23" Background="{DynamicResource SurfaceBrush}" BorderThickness="1" Padding="16,0,6,0"
                        DataContext="{Binding Main}">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <TextBlock x:Name="SearchIcon" Text="{local:Icon E721}" Classes="glyph" FontSize="16"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1" Theme="{StaticResource BareTextBox}" FontSize="15" Margin="11,0,2,0"
                                 Watermark="{local:T Search}" Text="{Binding SearchText}"
                                 ToolTip.Tip="{local:T 'Search your songs and online, or paste a link to download (YouTube, Spotify, SoundCloud, TikTok…)'}"/>
                        <Button Grid.Column="2" Theme="{StaticResource IconButton}" Width="30" Height="30" FontSize="11" Content="{local:Icon E711}"
                                Command="{Binding ClearSearchCommand}" ToolTip.Tip="{local:T Clear}" IsVisible="{Binding HasSearchText}"/>
                        <Button Grid.Column="3" Theme="{StaticResource BigPlayButton}" Width="34" Height="34" FontSize="13" Margin="2,0,0,0" Content="{local:Icon E896}"
                                Command="{Binding SubmitSearchCommand}" ToolTip.Tip="{local:T 'Download link'}" IsVisible="{Binding IsLink}"/>
                    </Grid>
                </Border>
                <Button Grid.Column="1" Theme="{StaticResource IconButton}" Width="30" Height="30" FontSize="13" Content="{local:Icon E713}" Margin="12,0,0,0"
                        Command="{Binding OnlineSettingsCommand}" ToolTip.Tip="{local:T 'Which sites to search and in what order (Settings)'}"/>
            </Grid>
            <!-- the kinds; on the right, under the gear, how the sites are doing (there the box keeps its width while they answer) -->
            <DockPanel Margin="0,14,0,0" IsVisible="{Binding ShowResults}">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Height="32" VerticalAlignment="Top" Margin="12,0,0,0">
                    <Ellipse Classes="spinner" Width="14" Height="14" StrokeThickness="2.5" Margin="0,0,8,0" VerticalAlignment="Center" IsVisible="{Binding OnlineBusy}"/>
                    <TextBlock Text="{Binding OnlineStatus}" Classes="hint" FontSize="12" VerticalAlignment="Center" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                </StackPanel>
                <!-- tabs like the library's: the tint glides to the one picked and its list slides in from that side (Ctrl+←/→ too) -->
                <Border HorizontalAlignment="Left" CornerRadius="20" Padding="4" Background="{DynamicResource SurfaceBrush}">
                    <Panel>
                        <views:SlidingPill Target="{Binding #FilterTabs}" Fill="{DynamicResource AccentSoftBrush}"/>
                        <ItemsControl x:Name="FilterTabs" ItemsSource="{Binding Filters}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Theme="{StaticResource TabSegment}" GroupName="SearchFilter" Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                 CommandParameter="{Binding}" Command="{Binding $parent[UserControl].DataContext.SelectFilterCommand}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Panel>
                </Border>
            </DockPanel>
        </StackPanel>

        <!-- no words (or a link open, a song found online opened): the downloads part, the link being added and the queue -->
        <Border Grid.Row="1" IsVisible="{Binding ShowDownloads}">
            <views:DownloadsView DataContext="{Binding Main.Downloads}"/>
        </Border>

        <!-- the chip's list (SearchViewModel.Results): it slides in from the side of its chip -->
        <views:AnimatedContent Grid.Row="1" Horizontal="True" Content="{Binding Results}" IsVisible="{Binding ShowResults}">
            <views:AnimatedContent.DataTemplates>
                <DataTemplate DataType="vm:SearchResults">
                    <ListBox Theme="{StaticResource PlainList}" ItemsSource="{Binding Items}" SelectionMode="Multiple" SelectionChanged="List_SelectionChanged"
                             Loaded="List_Loaded" Unloaded="List_Unloaded">
                        <ListBox.DataTemplates>
                            <!-- your songs: as in every list (play, select, drag, the menu) -->
                            <DataTemplate DataType="vm:TrackRow">
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TrackRowTemplate}"/>
                            </DataTemplate>
            
                            <!-- a heading, with "Show all" leading to its chip -->
                            <DataTemplate DataType="vm:SearchSection">
                                <DockPanel Margin="8,22,18,8">
                                    <Button DockPanel.Dock="Right" Theme="{StaticResource LinkButton}" Content="{local:T 'Show all'}" Command="{Binding MoreCommand}"
                                            IsVisible="{Binding HasMore}" VerticalAlignment="Bottom"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Count}" FontSize="14" Foreground="{DynamicResource MutedBrush}" Margin="10,0,0,1" VerticalAlignment="Bottom"
                                                   IsVisible="{Binding HasCount}"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
            
                            <!-- artists, albums, playlists side by side: one row in "All", all of them under their chip -->
                            <DataTemplate DataType="vm:CardShelf">
                                <ItemsControl ItemsSource="{Binding Cards}" Margin="0,0,18,4" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <views:CardGrid MaxRows="{Binding MaxRows}"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.DataTemplates>
                                        <DataTemplate DataType="vm:ArtistCardViewModel">
                                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ArtistCard}"/>
                                        </DataTemplate>
                                        <DataTemplate DataType="vm:PlaylistViewModel">
                                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PlaylistCard}"/>
                                        </DataTemplate>
                                        <DataTemplate DataType="vm:OnlineHitViewModel">
                                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AlbumCard}"/>
                                        </DataTemplate>
                                        <DataTemplate DataType="vm:StationViewModel">
                                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StationCard}"/>
                                        </DataTemplate>
                                    </ItemsControl.DataTemplates>
                                </ItemsControl>
                            </DataTemplate>
            
                            <!-- the artist the words name: big, first -->
                            <DataTemplate DataType="vm:TopArtistResult">
                                <Border Classes="card" CornerRadius="14" Padding="18" Margin="0,4,18,0" Cursor="Hand" views:Click.Command="{Binding OpenCommand}"
                                        views:Rows.Menu="artist" DataContext="{Binding Artist}">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Panel Width="112" Height="112">
                                            <Ellipse Fill="{Binding Brush}"/>
                                            <TextBlock Text="{Binding Initial}" FontSize="44" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <views:CoverImage IsCircle="True" Source="{Binding Picture}"/>
                                        </Panel>
                                        <StackPanel Grid.Column="1" Margin="22,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{local:T ARTIST}" Classes="small-caps" Foreground="{DynamicResource AccentTextBrush}"/>
                                            <TextBlock Text="{Binding Name}" FontSize="30" FontWeight="Bold" Margin="0,2,0,4" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource SubTextBrush}" IsVisible="{Binding HasSubtitle}"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Theme="{StaticResource GhostButton}" Padding="16,8" VerticalAlignment="Center" Command="{Binding FollowCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding FollowGlyph, Converter={StaticResource Icon}}" Classes="glyph"/>
                                                <TextBlock Text="{Binding FollowTip}" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
            
                            <!-- the album or playlist named as the words: big, first -->
                            <DataTemplate DataType="vm:FeaturedHitViewModel">
                                <Border Classes="card" CornerRadius="14" Padding="14" Margin="0,4,18,0" Cursor="Hand" views:Click.Command="{Binding DownloadCommand}"
                                        ToolTip.Tip="{local:T 'Open it to choose its songs and the playlist to save them in'}" ToolTip.ShowDelay="1200">
                                    <Grid local:Marquee.Host="True" ColumnDefinitions="Auto,*,Auto">
                                        <Panel Width="112" Height="112">
                                            <Border CornerRadius="8" Background="{DynamicResource PlaceholderGradient}" IsVisible="{Binding Thumb, Converter={x:Static ObjectConverters.IsNull}}">
                                                <TextBlock Text="{local:Icon E8FD}" Classes="glyph" FontSize="30" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                                            </Border>
                                            <views:CoverImage CornerRadius="8" Source="{Binding Thumb}"/>
                                        </Panel>
                                        <StackPanel Grid.Column="1" Margin="20,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Kind}" Classes="small-caps" Foreground="{DynamicResource AccentTextBrush}"/>
                                            <TextBlock Text="{Binding Title}" FontSize="26" FontWeight="Bold" Margin="0,2,0,6" TextTrimming="CharacterEllipsis" local:Marquee.IsEnabled="True"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" Fill="{Binding ServiceBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Service}" FontSize="12.5" Margin="6,0,10,0" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Details}" FontSize="12.5" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="2" Theme="{StaticResource BigPlayButton}" Width="48" Height="48" FontSize="18" Content="{local:Icon E768}"
                                                VerticalAlignment="Center" Command="{Binding PlayCommand}" ToolTip.Tip="{local:T 'Play without saving'}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
            
                            <!-- a song (or a list) found online -->
                            <DataTemplate DataType="vm:OnlineHitViewModel">
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource HitRowTemplate}"/>
                            </DataTemplate>
            
                            <!-- the sites over the online songs -->
                            <DataTemplate DataType="vm:SiteChips">
                                <ItemsControl ItemsSource="{Binding Tabs}" Margin="8,0,18,6" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Theme="{StaticResource ServiceChip}" Classes.selected="{Binding IsSelected}" CommandParameter="{Binding}"
                                                    Command="{Binding $parent[ItemsControl].DataContext.SelectCommand}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Fill="{Binding Brush}" Margin="0,0,7,0" VerticalAlignment="Center" IsVisible="{Binding HasDot}"/>
                                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Count}" Foreground="{DynamicResource MutedBrush}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
            
                            <!-- searching, nothing found, Spotify without its key -->
                            <DataTemplate DataType="vm:SearchNote">
                                <StackPanel HorizontalAlignment="Center" Margin="24,32,24,24" MaxWidth="480">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Ellipse Classes="spinner" Width="18" Height="18" StrokeThickness="3" Margin="0,0,12,0" VerticalAlignment="Center" IsVisible="{Binding Busy}"/>
                                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Text}" Classes="hint" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap" IsVisible="{Binding HasText}"/>
                                    <Button Theme="{StaticResource PrimaryButton}" Content="{Binding ButtonText}" Command="{Binding Command}" HorizontalAlignment="Center"
                                            Margin="0,18,0,0" IsVisible="{Binding HasButton}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.DataTemplates>
                    </ListBox>
                </DataTemplate>
            </views:AnimatedContent.DataTemplates>
        </views:AnimatedContent>
        <views:SelectionBar x:Name="Bar" Grid.Row="1" ZIndex="1"/>
    </Grid>
</UserControl>
