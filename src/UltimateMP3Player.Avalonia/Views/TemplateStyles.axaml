<!-- The styles of the song rows of Templates.axaml (WPF: the DataTemplate triggers), for every row at once. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UltimateMP3Player">
        <Style Selector="Border.row">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.row:pointerover">
            <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
        </Style>
        <Style Selector="ListBoxItem:selected Border.row">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
        </Style>
        <Style Selector="Border.row Button.play">
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="Content" Value="{local:Icon E768}"/>
            <Setter Property="ToolTip.Tip" Value="{local:T Play}"/>
        </Style>
        <Style Selector="Border.row:pointerover Button.play">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector="Border.row:pointerover TextBlock.num">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Border.row.playing Button.play">
            <Setter Property="Content" Value="{local:Icon E769}"/>
            <Setter Property="ToolTip.Tip" Value="{local:T Pause}"/>
        </Style>
        <Style Selector="Border.row.room Button.play">
            <Setter Property="Content" Value="{local:Icon E710}"/>
            <Setter Property="ToolTip.Tip" Value="{local:T 'Add to the room\'s queue (double-click works too)'}"/>
        </Style>
        <Style Selector="Border.row.room.noadd Button.play">
            <Setter Property="IsEnabled" Value="False"/>
            <Setter Property="ToolTip.Tip" Value="{local:T 'Only people with permission can add songs to the room (the host decides)'}"/>
        </Style>
        <Style Selector="Border.row.current TextBlock.title">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
        </Style>
        <Style Selector="Border.row.current TextBlock.num">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
        </Style>
        <Style Selector="Border.row Button.heart">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Content" Value="{local:Icon EB51}"/>
            <Setter Property="ToolTip.Tip" Value="{local:T 'Add to Favorites'}"/>
        </Style>
        <Style Selector="Border.row Button.more">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="Border.row:pointerover Button.heart, Border.row:pointerover Button.more">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Border.row.fav Button.heart">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Content" Value="{local:Icon EB52}"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFontFilled}"/>
            <Setter Property="Foreground" Value="{DynamicResource PinkBrush}"/>
            <Setter Property="ToolTip.Tip" Value="{local:T 'Remove from Favorites'}"/>
        </Style>
        <!-- the song's sign (in the cloud, or saved on the device: TrackViewModel.ShowSign), muted like a hint; a warning sign when it's no longer online -->
        <Style Selector="TextBlock.cloud">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        </Style>
        <Style Selector="TextBlock.cloud.gone">
            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
        </Style>
        <Style Selector="Border.row.gone.cloud TextBlock.title">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        </Style>
        <Style Selector="Border.row.never TextBlock.plays">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
    </Styles>
