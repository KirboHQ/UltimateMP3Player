<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>UltimateMP3Player.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Overlay.html" LogicalName="UltimateMP3Player.Core.Overlay.html" />
  </ItemGroup>

  <ItemGroup>
    <!-- Mods' JavaScript (Core/Mods): an interpreter in C#, so it runs where no JIT is allowed (iOS) as everywhere else. -->
    <PackageReference Include="Jint" Version="4.18.1" />
  </ItemGroup>

</Project>
