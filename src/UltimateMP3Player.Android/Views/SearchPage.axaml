<!-- Cerca, with the downloads (like the computer's box): your songs and the music sites together, in one list under chips
     (All, Songs, Artists, Albums and EPs, Playlists: SearchViewModel.Items); a link written or pasted here is downloaded. A song
     found online plays with a tap, its button opens it in the download part, as a pasted link. -->
<UserControl x:Class="UltimateMP3Player.Views.SearchPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UltimateMP3Player"
             xmlns:vm="clr-namespace:UltimateMP3Player.ViewModels"
             xmlns:views="clr-namespace:UltimateMP3Player.Views">
    <UserControl.Styles>
        <!-- the big cards (the artist or the list named as the words), darker while pressed (their colour from a style: one set on
             them would win) -->
        <Style Selector="Border.featured">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        </Style>
        <Style Selector="Border.featured:pressed">
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
        </Style>
    </UserControl.Styles>
    <!-- while choosing several things: the bar with what to do sits under the page (the last rows stay reachable) -->
    <Grid RowDefinitions="*,Auto">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="16,12,16,4">
            <TextBlock Text="{local:T Search}" Classes="page-title" Margin="2,0,0,12"/>
            <Border Height="50" CornerRadius="25" Background="{DynamicResource Surface2Brush}" BorderBrush="Transparent" BorderThickness="1"
                    Padding="16,0,4,0">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <TextBlock Text="{local:Icon E721}" Classes="glyph" Foreground="{DynamicResource SubTextBrush}" FontSize="17"/>
                    <TextBox x:Name="Box" Grid.Column="1" Theme="{StaticResource BareTextBox}" FontSize="15.5" Margin="12,0,4,0"
                             Watermark="{local:T 'Songs, artists, or a link'}"/>
                    <Button x:Name="ClearButton" Grid.Column="2" Theme="{StaticResource TouchIcon}" Width="40" Height="40" FontSize="13" Content="{local:Icon E711}"
                            Click="Clear_Click" IsVisible="False"/>
                    <Button Grid.Column="3" Theme="{StaticResource TouchIcon}" Width="42" Height="42" FontSize="17" Content="{local:Icon E77F}" Click="Paste_Click"/>
                </Grid>
            </Border>
            <!-- a link: download it -->
            <Button x:Name="DownloadLink" Theme="{StaticResource TouchPrimary}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,12,0,0"
                    IsVisible="False" Click="Download_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{local:Icon E896}" Classes="glyph"/>
                    <TextBlock Text="{local:T 'Download this link'}" Margin="8,0,0,0"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- the kinds of results: sideways only (at its ends a swipe stops there) -->
        <ScrollViewer x:Name="Chips" DockPanel.Dock="Top" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" IsScrollChainingEnabled="False"
                      IsVisible="False" Margin="0,8,0,4">
            <ItemsControl ItemsSource="{Binding Filters}" Margin="16,0,8,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ToggleButton Theme="{StaticResource Chip}" IsChecked="{Binding IsSelected, Mode=OneWay}" Content="{Binding Label}" CommandParameter="{Binding}"
                                      Command="{Binding $parent[views:SearchPage].DataContext.SelectFilterCommand}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Panel>
            <!-- nothing written yet, or a link open (pasted, shared, a song found online): the download part, as the computer's
                 Download page; Back from a song found online goes back to the results -->
            <views:DownloadsPage x:Name="DownloadsPart" DataContext="{Binding $parent[views:MainView].DataContext.Downloads}"/>

            <ListBox x:Name="List" Theme="{StaticResource PlainList}" ItemContainerTheme="{StaticResource PlainListItem}" IsVisible="False">
                <ListBox.DataTemplates>
                    <!-- your songs and playlists: as in every list -->
                    <StaticResource ResourceKey="TrackRowTemplate"/>
                    <DataTemplate DataType="vm:PlaylistViewModel">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PlaylistRowTemplate}"/>
                    </DataTemplate>
                    <!-- an artist (its chip): its row -->
                    <DataTemplate DataType="vm:ArtistCardViewModel">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ArtistRowTemplate}"/>
                    </DataTemplate>

                    <!-- a heading, with "Show all" leading to its chip -->
                    <DataTemplate DataType="vm:SearchSection">
                        <DockPanel Margin="18,20,10,8">
                            <Button DockPanel.Dock="Right" Theme="{StaticResource LinkButton}" Content="{local:T 'Show all'}" Command="{Binding MoreCommand}"
                                    IsVisible="{Binding HasMore}" VerticalAlignment="Center" Padding="8,6"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Count}" FontSize="14" Foreground="{DynamicResource MutedBrush}" Margin="8,0,0,1" VerticalAlignment="Bottom"
                                           IsVisible="{Binding HasCount}"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>

                    <!-- artists, albums, playlists side by side (in "All"): a shelf that scrolls sideways -->
                    <DataTemplate DataType="vm:CardShelf">
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" IsScrollChainingEnabled="False" Margin="0,0,0,6">
                            <ItemsControl ItemsSource="{Binding Cards}" Margin="18,0,4,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.DataTemplates>
                                    <DataTemplate DataType="vm:ArtistCardViewModel">
                                        <Border Width="124" Margin="0,0,14,0" Background="Transparent" views:Touch.Tap="{Binding OpenCommand}" views:Touch.Menu="artist">
                                            <StackPanel>
                                                <Panel Width="124" Height="124">
                                                    <Ellipse Fill="{Binding Brush}"/>
                                                    <TextBlock Text="{Binding Initial}" FontSize="44" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <views:CoverImage IsCircle="True" Source="{Binding Picture}"/>
                                                </Panel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Margin="2,9,2,1" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis"
                                                           HorizontalAlignment="Center" IsVisible="{Binding HasSubtitle}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                    <DataTemplate DataType="vm:PlaylistViewModel">
                                        <Border Width="148" Margin="0,0,14,0" Background="Transparent" views:Touch.Menu="playlist"
                                                views:Touch.Tap="{Binding $parent[views:MainView].DataContext.OpenPlaylistCommand}">
                                            <StackPanel>
                                                <ContentControl Width="148" Height="148" Content="{Binding}" ContentTemplate="{StaticResource PlaylistCover}"/>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Margin="2,9,2,1" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Foreground="{DynamicResource SubTextBrush}" Margin="2,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                    <DataTemplate DataType="vm:OnlineHitViewModel">
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AlbumCardTemplate}"/>
                                    </DataTemplate>
                                </ItemsControl.DataTemplates>
                            </ItemsControl>
                        </ScrollViewer>
                    </DataTemplate>

                    <!-- the artist the words name: big, first -->
                    <DataTemplate DataType="vm:TopArtistResult">
                        <Border Classes="featured" Margin="12,4,12,6" Padding="12" CornerRadius="14" DataContext="{Binding Artist}"
                                views:Touch.Tap="{Binding OpenCommand}" views:Touch.Menu="artist">
                            <Grid ColumnDefinitions="88,*,Auto">
                                <Panel Width="88" Height="88">
                                    <Ellipse Fill="{Binding Brush}"/>
                                    <TextBlock Text="{Binding Initial}" FontSize="34" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <views:CoverImage IsCircle="True" Source="{Binding Picture}"/>
                                </Panel>
                                <StackPanel Grid.Column="1" Margin="14,0,4,0" VerticalAlignment="Center">
                                    <TextBlock Text="{local:T ARTIST}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}"/>
                                    <TextBlock Text="{Binding Name}" FontSize="21" FontWeight="Bold" Margin="0,2,0,3" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Subtitle}" FontSize="13" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding HasSubtitle}"/>
                                </StackPanel>
                                <Button Grid.Column="2" Theme="{StaticResource TouchIcon}" Content="{Binding FollowGlyph, Converter={StaticResource Icon}}" FontSize="19"
                                        Command="{Binding FollowCommand}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>

                    <!-- the album or playlist named as the words: a big card first, so it's clear it's a whole list -->
                    <DataTemplate DataType="vm:FeaturedHitViewModel">
                        <Border Classes="featured" Margin="12,4,12,6" Padding="12" CornerRadius="14" views:Touch.Tap="{Binding DownloadCommand}" views:Touch.Menu="hit">
                            <Grid ColumnDefinitions="96,*,Auto">
                                <Panel Width="96" Height="96">
                                    <Border CornerRadius="8" Background="{DynamicResource PlaceholderGradient}">
                                        <TextBlock Text="{local:Icon E8FD}" Classes="glyph" FontSize="26" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                                    </Border>
                                    <views:CoverImage CornerRadius="8" Source="{Binding Thumb}"/>
                                </Panel>
                                <StackPanel Grid.Column="1" Margin="14,0,4,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{local:Icon E8FD}" Classes="glyph" FontSize="12" Foreground="{DynamicResource AccentTextBrush}"/>
                                        <TextBlock Text="{Binding Kind}" FontSize="12.5" FontWeight="Bold" Margin="6,0,0,0" Foreground="{DynamicResource AccentTextBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="Bold" Margin="0,3,0,4" TextWrapping="Wrap" MaxLines="2"
                                               TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="{Binding ServiceBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Service}" FontSize="12" Margin="6,0,8,0" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Details}" FontSize="12.5" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="2" Theme="{StaticResource BigPlayButton}" Width="46" Height="46" FontSize="17" Content="{local:Icon E768}"
                                        VerticalAlignment="Center" Command="{Binding PlayCommand}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>

                    <!-- a song (or a list) found online -->
                    <DataTemplate DataType="vm:OnlineHitViewModel">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource HitRowTemplate}"/>
                    </DataTemplate>

                    <!-- the sites over the online songs -->
                    <DataTemplate DataType="vm:SiteChips">
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" IsScrollChainingEnabled="False" Margin="0,0,0,6">
                            <ItemsControl ItemsSource="{Binding Tabs}" Margin="16,0,8,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ToggleButton Theme="{StaticResource Chip}" IsChecked="{Binding IsSelected, Mode=OneWay}" CommandParameter="{Binding}"
                                                      Command="{Binding $parent[ItemsControl].DataContext.SelectCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Fill="{Binding Brush}" Margin="0,0,7,0" VerticalAlignment="Center" IsVisible="{Binding HasDot}"/>
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Count}" Foreground="{DynamicResource MutedBrush}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </ToggleButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DataTemplate>

                    <!-- searching, nothing found, Spotify without its key -->
                    <DataTemplate DataType="vm:SearchNote">
                        <StackPanel Margin="28,32,28,24" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Ellipse Classes="spinner" Width="18" Height="18" StrokeThickness="3" Margin="0,0,12,0" VerticalAlignment="Center" IsVisible="{Binding Busy}"/>
                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Text}" Classes="hint" FontSize="14" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap" IsVisible="{Binding HasText}"/>
                            <Button Theme="{StaticResource TouchPrimary}" Content="{Binding ButtonText}" Command="{Binding Command}" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center" Margin="0,20,0,0" MaxWidth="420" IsVisible="{Binding HasButton}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.DataTemplates>
            </ListBox>
        </Panel>
    </DockPanel>
    <!-- choosing several of your songs or playlists (Select in a menu) -->
    <views:PickTop Picks="{Binding $parent[views:SearchPage].Picks}"/>
    <views:PickActions Grid.Row="1" Picks="{Binding $parent[views:SearchPage].Picks}"/>
    </Grid>
</UserControl>
