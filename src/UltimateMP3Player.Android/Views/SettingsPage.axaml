<!-- The settings that make sense on a phone (the computer apps' ones, without the window, the tray, Discord, the smooth
     scrolling, the DJ, the firewall; instead of a browser's cookies, the logins made inside the app). A row with an
     arrow opens its choices. The search box under the title keeps only the cards and the rows that match (Keywords: more
     words that find a card). -->
<UserControl x:Class="UltimateMP3Player.Views.SettingsPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UltimateMP3Player"
             xmlns:vm="clr-namespace:UltimateMP3Player.ViewModels"
             xmlns:views="clr-namespace:UltimateMP3Player.Views">
    <UserControl.Styles>
        <Style Selector="TextBlock.card-title">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
            <Setter Property="Margin" Value="4,6,0,4"/>
        </Style>
        <Style Selector="CheckBox.switch">
            <Setter Property="Margin" Value="0,10"/>
        </Style>
        <Style Selector="Border.line">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style Selector="TextBlock.value">
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Styles>

    <Panel>
    <ScrollViewer x:Name="Scroller" views:Pane.Side="-1">
        <StackPanel Margin="16,12,16,28">
            <TextBlock x:Name="PageTitle" Text="{local:T Settings}" Classes="page-title" Margin="2,0,0,14"/>
            <TextBox x:Name="SearchBox" Theme="{StaticResource TouchSearchBox}" Watermark="{local:T 'Search settings'}" Margin="0,0,0,16"/>

            <StackPanel x:Name="Cards">
            <!-- ============================================================ profile -->
            <Border Classes="card" views:SettingsPage.Keywords="{local:T 'profile profiles user name photo picture avatar who\'s listening startup'}">
                <StackPanel>
                    <Button Theme="{StaticResource SettingRow}" Command="{Binding ManageProfilesCommand}">
                        <Grid ColumnDefinitions="Auto,*">
                            <Panel>
                                <!-- both devices' music (Connect to computer): the computer's profile behind this one's -->
                                <Panel Width="36" Height="36" Margin="32,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                       IsVisible="{Binding $parent[views:MainView].DataContext.HasSecondProfile}">
                                    <Ellipse Margin="1" Fill="{Binding $parent[views:MainView].DataContext.SecondBrush}"/>
                                    <TextBlock Text="{Binding $parent[views:MainView].DataContext.SecondInitial}" Foreground="White" FontWeight="Bold" FontSize="15"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <views:CoverImage IsCircle="True" Source="{Binding $parent[views:MainView].DataContext.SecondAvatar}"/>
                                </Panel>
                                <Panel Width="46" Height="46" HorizontalAlignment="Left">
                                    <Ellipse Margin="-2" Fill="{DynamicResource SurfaceBrush}" IsVisible="{Binding $parent[views:MainView].DataContext.HasSecondProfile}"/>
                                    <Ellipse Margin="1" Fill="{Binding $parent[views:MainView].DataContext.ProfileBrush}"/>
                                    <TextBlock Text="{Binding $parent[views:MainView].DataContext.ProfileInitial}" Foreground="White" FontWeight="Bold" FontSize="18"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <views:CoverImage IsCircle="True" Source="{Binding $parent[views:MainView].DataContext.ProfileAvatar}"/>
                                </Panel>
                            </Panel>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding $parent[views:MainView].DataContext.ProfileName}" FontSize="16.5" FontWeight="SemiBold"/>
                                <TextBlock Text="{local:T 'Switch or manage profiles'}" Classes="value"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                    <StackPanel IsVisible="{Binding $parent[views:MainView].DataContext.MultipleProfiles}">
                        <Border Classes="line"/>
                        <Button Theme="{StaticResource SettingRow}" Tag="StartupProfile" Click="Choose_Click">
                            <StackPanel>
                                <TextBlock Text="{local:T 'At startup'}" Classes="setting"/>
                                <TextBlock Text="{Binding StartupProfile.Label}" Classes="value"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============================================================ appearance -->
            <TextBlock Text="{local:T APPEARANCE}" Classes="card-title"/>
            <Border Classes="card" views:SettingsPage.Group="appearance" views:SettingsPage.Keywords="{local:T 'appearance theme colours colors light dark night mode language english italian animations motion cover 3d speed visualizer bars waves'}">
                <StackPanel>
                    <StackPanel Margin="0,12">
                        <TextBlock Text="{local:T 'Light or dark'}" Classes="setting" Margin="0,0,0,8"/>
                        <views:ChoiceTiles Picture="look" Items="{Binding Appearances}" Selected="{Binding Appearance}"/>
                    </StackPanel>
                    <Border Classes="line"/>
                    <StackPanel Margin="0,12">
                        <TextBlock Text="{local:T Language}" Classes="setting" Margin="0,0,0,8"/>
                        <views:ChoiceTiles Items="{Binding Languages}" Selected="{Binding Language}"/>
                    </StackPanel>
                    <Border Classes="line"/>
                    <TextBlock Text="{local:T Theme}" Classes="setting" Margin="0,12,0,8"/>
                    <TextBlock Text="{local:T Dynamic}" Classes="setting-hint" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding MovingThemes}" Margin="0,0,0,12">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:ThemeOption">
                                <Panel Height="44" Background="Transparent"
                                       views:Touch.Tap="{Binding $parent[views:SettingsPage].DataContext.SelectThemeCommand}" views:Touch.TapParameter="{Binding Id}">
                                    <Border CornerRadius="22" Background="{DynamicResource Surface2Brush}"/>
                                    <Border CornerRadius="22" Background="{DynamicResource AccentSoftBrush}" IsVisible="{Binding IsSelected}"/>
                                    <StackPanel Orientation="Horizontal" Margin="6,0,16,0">
                                        <Ellipse Width="32" Height="32" Fill="{Binding Swatch}"/>
                                        <TextBlock Text="{Binding Label}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Panel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Margin="0,0,0,10" views:Fold.Open="{Binding IsRgbTheme}">
                        <TextBlock Text="{local:T Speed}" Classes="setting-hint"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <Slider Theme="{StaticResource KnobSlider}" Minimum="1" Maximum="10" Value="{Binding RgbSpeed}" SmallChange="0.5" LargeChange="0.5"
                                    IsSnapToTickEnabled="True" TickFrequency="0.5" Height="40" AutomationProperties.Name="{local:T 'RGB speed'}"/>
                            <TextBlock Grid.Column="1" Text="{Binding RgbSpeedText}" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Width="48"/>
                        </Grid>
                    </StackPanel>
                    <TextBlock Text="{local:T Colors}" Classes="setting-hint" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding ColorThemes}" Margin="0,0,0,10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <views:SwatchGrid/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:ThemeOption">
                                <Panel Width="50" Height="50" Margin="0,0,0,8" Background="Transparent"
                                       views:Touch.Tap="{Binding $parent[views:SettingsPage].DataContext.SelectThemeCommand}" views:Touch.TapParameter="{Binding Id}">
                                    <Ellipse Stroke="{DynamicResource TextBrush}" StrokeThickness="2.5" IsVisible="{Binding IsSelected}"/>
                                    <Ellipse Margin="6" Fill="{Binding Swatch}"/>
                                </Panel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Margin="0,0,0,10" views:Fold.Open="{Binding IsCustomTheme}">
                        <TextBlock Text="{local:T Hue}" Classes="setting-hint"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <Slider Theme="{StaticResource KnobSlider}" Minimum="0" Maximum="359" Value="{Binding CustomHue}" Height="40" AutomationProperties.Name="{local:T Hue}"/>
                            <TextBox Grid.Column="1" Width="120" Margin="12,0,0,0" MaxLength="7" Text="{Binding CustomColorText}" VerticalAlignment="Center" AutomationProperties.Name="{local:T 'Custom colour'}"/>
                        </Grid>
                    </StackPanel>
                    <TextBlock Text="{Binding ThemeHint}" Classes="setting-hint" Margin="0,0,0,10" views:Fold.Open="{Binding HasThemeHint}"/>
                    <!-- the glass look and its choices (Core Glass), as on the computer -->
                    <Border Classes="line"/>
                    <CheckBox Theme="{StaticResource Switch}" Classes="switch" IsChecked="{Binding GlassOn}">
                        <StackPanel>
                            <TextBlock Text="{local:T Glass}" Classes="setting"/>
                            <TextBlock Text="{local:T 'The window lies on the cover of the song playing, blurred, under panes of glass.'}" Classes="setting-hint"/>
                        </StackPanel>
                    </CheckBox>
                    <StackPanel Margin="0,0,0,10" views:Fold.Open="{Binding GlassOn}">
                        <TextBlock Text="{local:T Background}" Classes="setting-hint" Margin="0,0,0,8"/>
                        <views:ChoiceTiles Picture="glasspicture" Items="{Binding GlassPictures}" Selected="{Binding GlassPicture}"/>
                        <TextBlock Text="{local:T Panes}" Classes="setting-hint" Margin="0,12,0,8"/>
                        <views:ChoiceTiles Picture="glasstint" Items="{Binding GlassTints}" Selected="{Binding GlassTintChoice}"/>
                        <TextBlock Text="{local:T Blur}" Classes="setting-hint" Margin="0,12,0,0"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <Slider Theme="{StaticResource KnobSlider}" Minimum="0" Maximum="1" Value="{Binding GlassBlur}" SmallChange="0.05" LargeChange="0.1" Height="40" AutomationProperties.Name="{local:T Blur}"/>
                            <TextBlock Grid.Column="1" Text="{Binding GlassBlurText}" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Width="48"/>
                        </Grid>
                        <TextBlock Text="{local:T Brightness}" Classes="setting-hint"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <Slider Theme="{StaticResource KnobSlider}" Minimum="0" Maximum="1" Value="{Binding GlassBrightness}" SmallChange="0.05" LargeChange="0.1" Height="40" AutomationProperties.Name="{local:T Brightness}"/>
                            <TextBlock Grid.Column="1" Text="{Binding GlassBrightnessText}" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Width="48"/>
                        </Grid>
                        <TextBlock Text="{local:T Color}" Classes="setting-hint"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <Slider Theme="{StaticResource KnobSlider}" Minimum="0" Maximum="1" Value="{Binding GlassVivid}" SmallChange="0.05" LargeChange="0.1" Height="40" AutomationProperties.Name="{local:T Color}"/>
                            <TextBlock Grid.Column="1" Text="{Binding GlassVividText}" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Width="48"/>
                        </Grid>
                        <TextBlock Text="{local:T 'Opacity of the panes'}" Classes="setting-hint"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <Slider Theme="{StaticResource KnobSlider}" Minimum="0" Maximum="1" Value="{Binding GlassPanes}" SmallChange="0.05" LargeChange="0.1" Height="40" AutomationProperties.Name="{local:T 'Opacity of the panes'}"/>
                            <TextBlock Grid.Column="1" Text="{Binding GlassPanesText}" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Width="48"/>
                        </Grid>
                        <CheckBox Theme="{StaticResource Switch}" Classes="switch" IsChecked="{Binding GlassGrain}">
                            <TextBlock Text="{local:T Grain}" Classes="setting"/>
                        </CheckBox>
                        <Button Theme="{StaticResource SmallGhost}" HorizontalAlignment="Left" Content="{local:T Reset}" Command="{Binding GlassResetCommand}"/>
                    </StackPanel>
                    <!-- the layout: the bottom bar's tabs and Home's rows, shown or not, in their order (Core Layout) -->
                    <Border Classes="line"/>
                    <StackPanel Margin="0,12,0,8" views:SettingsPage.Keywords="{local:T 'layout menu side bar width order position hide floating attached home rows sections customize'}">
                        <StackPanel.DataTemplates>
                            <!-- (the handle drags it to another place: TouchReorder, like the search's sites) -->
                            <DataTemplate DataType="vm:LayoutRow">
                                <Grid ColumnDefinitions="*,Auto">
                                    <CheckBox Theme="{StaticResource Switch}" Classes="switch" IsChecked="{Binding Shown}" IsEnabled="{Binding CanHide}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Icon, Converter={StaticResource Icon}}" Classes="glyph" FontSize="20" Width="28" Margin="0,0,12,0" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Label}" Classes="setting" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <Border Grid.Column="1" Classes="handle" Width="44" Height="46" Background="Transparent">
                                        <StackPanel Width="18" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4">
                                            <Border Height="2" CornerRadius="1" Background="{DynamicResource MutedBrush}"/>
                                            <Border Height="2" CornerRadius="1" Background="{DynamicResource MutedBrush}"/>
                                            <Border Height="2" CornerRadius="1" Background="{DynamicResource MutedBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </StackPanel.DataTemplates>
                        <TextBlock Text="{local:T Layout}" Classes="setting"/>
                        <TextBlock Text="{local:T 'Tabs of the bottom bar'}" Classes="setting-hint" Margin="0,8,0,0"/>
                        <Panel x:Name="TabRowsArea">
                            <ItemsControl x:Name="TabRowsList" ItemsSource="{Binding MenuRows}"/>
                            <Canvas x:Name="TabRowsLayer" IsHitTestVisible="False"/>
                        </Panel>
                        <TextBlock Text="{local:T 'Rows of Home'}" Classes="setting-hint" Margin="0,8,0,0"/>
                        <Panel x:Name="HomeRowsArea">
                            <ItemsControl x:Name="HomeRowsList" ItemsSource="{Binding HomeRows}"/>
                            <Canvas x:Name="HomeRowsLayer" IsHitTestVisible="False"/>
                        </Panel>
                    </StackPanel>
                    <Border Classes="line"/>
                    <StackPanel Margin="0,12,0,4">
                        <TextBlock Text="{local:T 'Shape of the song bar'}" Classes="setting" Margin="0,0,0,8"/>
                        <Border CornerRadius="12" Background="{DynamicResource BgBrush}" Padding="12,10" Margin="0,0,0,8">
                            <views:WaveformBar Height="40" Peaks="{Binding SeekSample}" Progress="0.4" Shape="{Binding SeekStyle}" Mirrored="{Binding SeekMirrored}" BarWidth="3" IsHitTestVisible="False"
                                       PlayedBrush="{DynamicResource ProgressGradient}" RestBrush="{DynamicResource WaveBrush}"/>
                        </Border>
                        <views:ChoiceTiles Picture="shape" Items="{Binding VisualizerStyles}" Selected="{Binding SeekStyleChoice}"/>
                    </StackPanel>
                    <CheckBox Theme="{StaticResource Switch}" Classes="switch" IsChecked="{Binding SeekMirrored}">
                        <TextBlock Text="{local:T Mirrored}" Classes="setting"/>
                    </CheckBox>
                    <Border Classes="line"/>
                    <CheckBox Theme="{StaticResource Switch}" Classes="switch" IsChecked="{Binding Animations}">
                        <StackPanel>
                            <TextBlock Text="{local:T Animations}" Classes="setting"/>
                            <TextBlock Text="{local:T 'Sliding pages and sheets, moving cover'}" Classes="setting-hint"/>
                        </StackPanel>
                    </CheckBox>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10" views:Fold.Open="{Binding Animations}">
                        <Slider Theme="{StaticResource KnobSlider}" Minimum="0.25" Maximum="3" Value="{Binding AnimationSpeed}" SmallChange="0.25" LargeChange="0.25"
                                IsSnapToTickEnabled="True" TickFrequency="0.25" Height="40"/>
                        <TextBlock Grid.Column="1" Text="{Binding AnimationSpeedText}" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Width="48"/>
                    </Grid>
                    <Border Classes="line"/>
                    <CheckBox Theme="{StaticResource Switch}" Classes="switch" IsChecked="{Binding CoverTilt}">
                        <StackPanel>
                            <TextBlock Text="{local:T '3D cover'}" Classes="setting"/>
                            <TextBlock Text="{local:T 'On the song\'s screen it tilts under your finger, with a glint of light'}" Classes="setting-hint"/>
                        </StackPanel>
                    </CheckBox>
                    <Border Classes="line"/>
                    <CheckBox Theme="{StaticResource Switch}" Classes="switch" IsChecked="{Binding Visualizer}">
                        <StackPanel>
                            <TextBlock Text="{local:T 'Bars of the music'}" Classes="setting"/>
                            <TextBlock Text="{local:T 'On the song\'s screen, bars that follow the music'}" Classes="setting-hint"/>
                        </StackPanel>
                    </CheckBox>
                    <StackPanel views:Fold.Open="{Binding Visualizer}">
                        <!-- what the song's screen will show: the music playing, otherwise a made-up sound -->
                        <Border CornerRadius="12" Background="{DynamicResource BgBrush}" Height="64" Padding="10,8,10,0" Margin="0,4,0,6" ClipToBounds="True">
                            <views:WaveVisualizer IsPreview="True" HeightShare="1" Flow="{Binding NowPlaying.VisualizerFlow}" Place="{Binding NowPlaying.VisualizerPlace}" BarStyle="{Binding NowPlaying.VisualizerStyle}" Tint="{Binding NowPlaying.VisualizerTint}" Thickness="{Binding NowPlaying.VisualizerThickness}" Strength="{Binding NowPlaying.VisualizerStrength}"/>
                        </Border>
                        <StackPanel Margin="0,12">
                            <TextBlock Text="{local:T 'Shape of the bars'}" Classes="setting" Margin="0,0,0,8"/>
                            <views:ChoiceTiles Picture="shape" Items="{Binding VisualizerStyles}" Selected="{Binding VisualizerStyleChoice}"/>
                        </StackPanel>
                        <StackPanel Margin="0,12">
                            <TextBlock Text="{local:T 'Direction of the bars'}" Classes="setting" Margin="0,0,0,8"/>
                            <views:ChoiceTiles Picture="flow" TileWidth="150" Items="{Binding VisualizerFlows}" Selected="{Binding VisualizerFlowChoice}"/>
                        </StackPanel>
                        <StackPanel Margin="0,12">
                            <TextBlock Text="{local:T 'Position of the bars'}" Classes="setting" Margin="0,0,0,8"/>
                            <views:ChoiceTiles Picture="place" Items="{Binding VisualizerPlaces}" Selected="{Binding VisualizerPlaceChoice}"/>
                        </StackPanel>
                        <StackPanel Margin="0,12">
                            <TextBlock Text="{local:T 'Color of the bars'}" Classes="setting" Margin="0,0,0,8"/>
                            <views:ChoiceTiles Picture="tint" Items="{Binding VisualizerTints}" Selected="{Binding VisualizerTintChoice}"/>
                        </StackPanel>
                        <StackPanel Margin="0,12" views:Fold.Open="{Binding VisualizerHasThickness}">
                            <TextBlock Text="{Binding VisualizerThicknessLabel}" Classes="setting" Margin="0,0,0,8"/>
                            <views:ChoiceTiles Picture="thickness" Items="{Binding VisualizerThicknesses}" Selected="{Binding VisualizerThicknessChoice}"/>
                        </StackPanel>
                        <TextBlock Text="{local:T Height}" Classes="setting" Margin="0,8,0,0"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <Slider Theme="{StaticResource KnobSlider}" Minimum="0.15" Maximum="1" Value="{Binding VisualizerHeight}" SmallChange="0.05" LargeChange="0.05" Height="40"/>
                            <TextBlock Grid.Column="1" Text="{Binding VisualizerHeightText}" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Width="48"/>
                        </Grid>
                        <TextBlock Text="{local:T Strength}" Classes="setting" Margin="0,4,0,0"/>
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                            <Slider Theme="{StaticResource KnobSlider}" Minimum="0.2" Maximum="1" Value="{Binding VisualizerStrength}" SmallChange="0.05" LargeChange="0.05" Height="40"/>
                            <TextBlock Grid.Column="1" Text="{Binding VisualizerStrengthText}" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Width="48"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============================================================ playback -->
            <TextBlock Text="{local:T PLAYBACK}" Classes="card-title"/>
            <Border Classes="card" views:SettingsPage.Group="playback" views:SettingsPage.Keywords="{local:T 'playback audio sound equalizer eq bass treble volume normalize crossfade fade radio suggested'}">
                <StackPanel>
                    <Button x:Name="OutputRow" Theme="{StaticResource SettingRow}" Tag="OutputDevice" Click="Choose_Click"
                            views:SettingsPage.Keywords="{local:T 'output device headphones speaker bluetooth usb'}">
                        <StackPanel>
                            <TextBlock Text="{local:T 'Audio output'}" Classes="setting"/>
                            <TextBlock Text="{Binding OutputDevice.Label}" Classes="value"/>
                        </StackPanel>
                    </Button>
                    <Border x:Name="OutputLine" Classes="line"/>
                    <Button Theme="{StaticResource SettingRow}" Click="Equalizer_Click">
                        <StackPanel>
                            <TextBlock Text="{local:T Equalizer}" Classes="setting"/>
                            <TextBlock Text="{Binding Equalizer.Preset.Label}" Classes="value"/>
                        </StackPanel>
                    </Button>
                    <Border Classes="line"/>
                    <CheckBox Theme="{StaticResource Switch}" Classes="switch" IsChecked="{Binding Normalize}">
                        <StackPanel>
                            <TextBlock Text="{local:T 'Even volume'}" Classes="setting"/>
                            <TextBlock Text="{local:T 'All songs at the same volume, even if downloaded from different sites'}" Classes="setting-hint"/>
                        </StackPanel>
                    </CheckBox>
                    <Border Classes="line"/>
                    <CheckBox Theme="{StaticResource Switch}" Classes="switch" IsChecked="{Binding PlayWhileDownloading}">
                        <StackPanel>
                            <TextBlock Text="{local:T 'Start songs while they download'}" Classes="setting"/>
                            <TextBlock Text="{local:T 'Songs in the cloud and suggested ones play right away when nothing else is playing. Off: they wait for the whole download (less mobile data)'}"
                                       Classes="setting-hint"/>
                        </StackPanel>
                    </CheckBox>
                    <Border Classes="line"/>
                    <CheckBox Theme="{StaticResource Switch}" Classes="switch" IsChecked="{Binding Crossfade}">
                        <StackPanel>
                            <TextBlock Text="{local:T Crossfade}" Classes="setting"/>
                            <TextBlock Text="{local:T 'The next song starts while this one fades out'}" Classes="setting-hint"/>
                        </StackPanel>
                    </CheckBox>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10" views:Fold.Open="{Binding Crossfade}">
                        <Slider Theme="{StaticResource KnobSlider}" Minimum="1" Maximum="12" Value="{Binding CrossfadeSeconds}" SmallChange="1" LargeChange="2"
                                IsSnapToTickEnabled="True" TickFrequency="1" Height="40"/>
                        <TextBlock Grid.Column="1" Text="{Binding CrossfadeText}" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Width="40"/>
                    </Grid>
                    <Border Classes="line"/>
                    <CheckBox Theme="{StaticResource Switch}" Classes="switch" IsChecked="{Binding BpmMatch}">
                        <StackPanel>
                            <TextBlock Text="{local:T 'BPM-matched transition'}" Classes="setting"/>
                            <TextBlock Text="{local:T 'In its last seconds the song slows down or speeds up to the next one\'s BPM, so they meet on the beat'}" Classes="setting-hint"/>
                        </StackPanel>
                    </CheckBox>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10" views:Fold.Open="{Binding BpmMatch}">
                        <Slider Theme="{StaticResource KnobSlider}" Minimum="2" Maximum="30" Value="{Binding BpmMatchSeconds}" SmallChange="1" LargeChange="2"
                                IsSnapToTickEnabled="True" TickFrequency="1" Height="40"/>
                        <TextBlock Grid.Column="1" Text="{Binding BpmMatchText}" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Width="40"/>
                    </Grid>
                    <Border Classes="line"/>
                    <CheckBox Theme="{StaticResource Switch}" Classes="switch" IsChecked="{Binding RadioAfterSingle}">
                        <StackPanel>
                            <TextBlock Text="{local:T 'After a single song, similar songs'}" Classes="setting"/>
                            <TextBlock Text="{local:T 'A song played outside a list (search, downloads) goes on with songs like it found online, instead of with all of yours'}"
                                       Classes="setting-hint"/>
                        </StackPanel>
                    </CheckBox>
                    <Border Classes="line"/>
                    <StackPanel Margin="0,12">
                        <TextBlock Text="{local:T 'Where similar songs come from'}" Classes="setting" Margin="0,0,0,8"/>
                        <views:ChoiceTiles Items="{Binding RadioSourceChoices}" Selected="{Binding RadioSource}"/>
                        <TextBlock Text="{Binding RadioSourceHint}" Classes="setting-hint" Margin="0,6,0,0"/>
                    </StackPanel>
                    <Border Classes="line"/>
                    <StackPanel Margin="0,12">
                        <TextBlock Text="{local:T 'Similar songs prepared ahead'}" Classes="setting" Margin="0,0,0,8"/>
                        <views:ChoiceTiles Numbers="True" Items="{Binding TogetherAheadChoices}" Selected="{Binding RadioAhead}"/>
                    </StackPanel>
                    <Border x:Name="CloseLine" Classes="line"/>
                    <StackPanel Margin="0,12" x:Name="CloseRow">
                        <TextBlock Text="{local:T 'When you close the app'}" Classes="setting" Margin="0,0,0,8"/>
                        <views:ChoiceTiles Picture="close" Items="{Binding CloseChoices}" Selected="{Binding CloseChoice}"/>
                        <TextBlock Text="{local:T 'That is, when you swipe it away from the recent apps.'}" Classes="setting-hint" Margin="0,6,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============================================================ downloads -->
            <TextBlock Text="{local:T DOWNLOADS}" Classes="card-title"/>
            <Border Classes="card" views:SettingsPage.Group="download" views:SettingsPage.Keywords="{local:T 'downloads download format mp3 m4a opus flac quality video folder music storage'}">
                <StackPanel>
                    <CheckBox Theme="{StaticResource Switch}" Classes="switch" IsChecked="{Binding SaveAudio}">
                        <StackPanel>
                            <TextBlock Text="{local:T 'Save the audio on your device'}" Classes="setting"/>
                            <TextBlock Text="{local:T 'Songs you add from a link or a pack are downloaded. Off: they go into your library in the cloud, you listen from their link and save them whenever you like.'}" Classes="setting-hint"/>
                        </StackPanel>
                    </CheckBox>
                    <Border Classes="line"/>
                    <Button x:Name="LoginsRow" Theme="{StaticResource SettingRow}" Click="Logins_Click" views:SettingsPage.Keywords="{local:T 'sign in signed account login password cookies private members age youtube soundcloud instagram'}">
                        <StackPanel>
                            <TextBlock Text="{local:T 'Sign in to sites'}" Classes="setting"/>
                            <TextBlock x:Name="LoginsValue" Classes="value"/>
                            <TextBlock Text="{local:T 'To download private, members-only or age-restricted content: sign in to the site from the app'}" Classes="setting-hint"/>
                        </StackPanel>
                    </Button>
                    <Border x:Name="LoginsLine" Classes="line"/>
                    <StackPanel Margin="0,12">
                        <TextBlock Text="{local:T 'Audio format'}" Classes="setting" Margin="0,0,0,8"/>
                        <views:ChoiceTiles Items="{Binding AudioFormats}" Selected="{Binding AudioFormat}"/>
                    </StackPanel>
                    <Border Classes="line"/>
                    <CheckBox Theme="{StaticResource Switch}" Classes="switch" IsChecked="{Binding PreferAudioOnly}">
                        <StackPanel>
                            <TextBlock Text="{local:T 'Usually audio only'}" Classes="setting"/>
                            <TextBlock Text="{local:T 'The video is downloaded only if you choose it (saves space and data)'}" Classes="setting-hint"/>
                        </StackPanel>
                    </CheckBox>
                    <Border Classes="line"/>
                    <StackPanel Margin="0,12">
                        <TextBlock Text="{local:T 'Maximum video quality'}" Classes="setting" Margin="0,0,0,8"/>
                        <views:ChoiceTiles TileWidth="86" Items="{Binding VideoQualities}" Selected="{Binding VideoQuality}"/>
                    </StackPanel>
                    <Border Classes="line"/>
                    <StackPanel Margin="0,12">
                        <TextBlock Text="{local:T 'Downloads at once'}" Classes="setting" Margin="0,0,0,8"/>
                        <views:ChoiceTiles Numbers="True" Items="{Binding ParallelChoices}" Selected="{Binding Parallel}"/>
                    </StackPanel>
                    <Border Classes="line"/>
                    <StackPanel Margin="0,12,0,10">
                        <TextBlock Text="{local:T 'Where the music is saved'}" Classes="setting"/>
                        <TextBlock Text="{Binding MusicDir}" Classes="value" FontSize="12.5"/>
                        <TextBlock x:Name="MusicDirHint" Text="{local:T 'In the phone\'s storage, in the app\'s folder: you can see it by connecting the phone to a computer (Android › data). If you uninstall the app, Android asks whether to keep it.'}"
                                   Classes="setting-hint"/>
                    </StackPanel>
                    <Border Classes="line"/>
                    <StackPanel Margin="0,12" views:SettingsPage.Keywords="{local:T 'storage space cache suggested cloud unsaved clear empty'}">
                        <TextBlock Text="{local:T 'Temporary storage (unsaved songs)'}" Classes="setting" Margin="0,0,0,8"/>
                        <views:ChoiceTiles Numbers="True" Items="{Binding CacheChoices}" Selected="{Binding CacheSize}"/>
                        <TextBlock Text="{local:T 'Songs you play without having saved them on your phone (in the cloud, suggested, in rooms) stay ready for next time; beyond this number the oldest are deleted.'}"
                                   Classes="setting-hint" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding CacheText}" Classes="setting-hint"/>
                    </StackPanel>
                    <Button Theme="{StaticResource SmallGhost}" HorizontalAlignment="Left" Margin="0,0,0,10" Command="{Binding ClearCacheCommand}"
                            Content="{local:T 'Clear storage'}"/>
                </StackPanel>
            </Border>

            <!-- ============================================================ search and suggestions: online search, suggested songs, lyrics -->
            <TextBlock Text="{local:T 'SEARCH AND SUGGESTIONS'}" Classes="card-title"/>
            <Border Classes="card" views:SettingsPage.Group="search" views:SettingsPage.Keywords="{local:T 'search online internet sites youtube music soundcloud deezer order'}">
                <StackPanel>
                    <CheckBox Theme="{StaticResource Switch}" Classes="switch" IsChecked="{Binding OnlineSearch}">
                        <StackPanel>
                            <TextBlock Text="{local:T 'Search online too'}" Classes="setting"/>
                            <TextBlock Text="{local:T 'The Search page also finds songs on music sites, to download with a tap'}" Classes="setting-hint"/>
                        </StackPanel>
                    </CheckBox>
                    <StackPanel views:Fold.Open="{Binding OnlineSearch}">
                        <Border Classes="line"/>
                        <!-- the handle drags a site to another place (TouchReorder, like "Next up") -->
                        <Panel x:Name="ServicesArea" Margin="0,6,0,0">
                            <ItemsControl x:Name="ServicesList" ItemsSource="{Binding SearchServices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:SearchServiceOption">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,4">
                                            <Ellipse Width="10" Height="10" Fill="{Binding Brush}" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Margin="12,0,6,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Classes="setting"/>
                                                <TextBlock Text="{Binding Description}" Classes="setting-hint"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="2" Theme="{StaticResource Switch}" IsChecked="{Binding Enabled}" HorizontalAlignment="Right" Margin="6,0,0,0"/>
                                            <Border Grid.Column="3" Classes="handle" Width="44" Height="46" Background="Transparent">
                                                <StackPanel Width="18" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4">
                                                    <Border Height="2" CornerRadius="1" Background="{DynamicResource MutedBrush}"/>
                                                    <Border Height="2" CornerRadius="1" Background="{DynamicResource MutedBrush}"/>
                                                    <Border Height="2" CornerRadius="1" Background="{DynamicResource MutedBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Canvas x:Name="ServicesLayer" IsHitTestVisible="False"/>
                        </Panel>
                        <Border Classes="line"/>
                        <StackPanel Margin="0,12">
                            <TextBlock Text="{local:T 'How to search'}" Classes="setting" Margin="0,0,0,8"/>
                            <views:ChoiceTiles Picture="searchmode" TileWidth="150" Items="{Binding SearchModes}" Selected="{Binding SearchMode}"/>
                            <TextBlock Text="{Binding SearchModeHint}" Classes="setting-hint" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Border Classes="line"/>
                        <Button Theme="{StaticResource SettingRow}" Command="{Binding SpotifyKeyCommand}">
                            <StackPanel>
                                <TextBlock Text="{local:T 'Spotify key'}" Classes="setting"/>
                                <TextBlock Text="{Binding SpotifyKeyText}" Classes="value"/>
                                <TextBlock Text="{local:T 'Spotify only answers apps with a key: with yours (free; your Spotify account needs Premium) the search finds Spotify\'s songs and artists too. Without one, Deezer has the same catalogue. The audio comes from YouTube Music, as for Spotify links.'}"
                                           Classes="setting-hint"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Border Classes="line"/>
                    <CheckBox views:SettingsPage.Keywords="{local:T 'lyrics words karaoke lrclib synced'}" Theme="{StaticResource Switch}" Classes="switch" IsChecked="{Binding AutoLyrics}">
                        <StackPanel>
                            <TextBlock Text="{local:T 'Find lyrics automatically'}" Classes="setting"/>
                            <TextBlock Text="{local:T 'For new songs and for the one you\'re listening to, on LRCLIB (synced when available)'}" Classes="setting-hint"/>
                        </StackPanel>
                    </CheckBox>
                    <Border Classes="line"/>
                    <TextBlock Text="{Binding LyricsStats}" Classes="value" Margin="0,12,0,8"/>
                    <Button Theme="{StaticResource SmallGhost}" HorizontalAlignment="Left" Margin="0,0,0,10" Command="{Binding ScanLyricsCommand}"
                            Content="{local:T 'Look for missing lyrics'}"/>
                </StackPanel>
            </Border>

            <!-- ============================================================ library -->
            <TextBlock Text="{local:T LIBRARY}" Classes="card-title"/>
            <Border Classes="card" views:SettingsPage.Group="library" views:SettingsPage.Keywords="{local:T 'library songs import export pack ump file folder copy backup friend artist name'}">
                <StackPanel>
                    <Button Theme="{StaticResource SettingRow}" Command="{Binding ImportFilesCommand}">
                        <StackPanel>
                            <TextBlock Text="{local:T 'Add songs from your phone'}" Classes="setting"/>
                            <TextBlock Text="{local:T 'MP3, M4A, FLAC, video... are copied into the app'}" Classes="setting-hint"/>
                        </StackPanel>
                    </Button>
                    <Border Classes="line"/>
                    <Button Theme="{StaticResource SettingRow}" Command="{Binding ImportFolderCommand}">
                        <TextBlock Text="{local:T 'Add a music folder'}" Classes="setting"/>
                    </Button>
                    <Border Classes="line"/>
                    <Button Theme="{StaticResource SettingRow}" Command="{Binding ExportPackCommand}">
                        <StackPanel>
                            <TextBlock Text="{local:T 'Export to a .ump pack'}" Classes="setting"/>
                            <TextBlock Text="{local:T 'Playlists, tags or the whole library in one file: to keep as a backup or to send to a friend'}" Classes="setting-hint"/>
                        </StackPanel>
                    </Button>
                    <Border Classes="line"/>
                    <Button Theme="{StaticResource SettingRow}" Command="{Binding ImportPackCommand}">
                        <TextBlock Text="{local:T 'Import a .ump pack'}" Classes="setting"/>
                    </Button>
                    <Border Classes="line"/>
                    <Button Theme="{StaticResource SettingRow}" Click="RenameArtist_Click">
                        <StackPanel>
                            <TextBlock Text="{local:T 'Rename an artist'}" Classes="setting"/>
                            <TextBlock Text="{local:T 'The same name on all their songs at once'}" Classes="setting-hint"/>
                        </StackPanel>
                    </Button>
                    <Border Classes="line"/>
                    <Button Theme="{StaticResource SettingRow}" Command="{Binding FindMissingCommand}"
                            views:SettingsPage.Keywords="{local:T 'duplicates doubles same song twice copies join covers pictures images missing length album'}">
                        <StackPanel>
                            <TextBlock Text="{local:T 'Find missing covers'}" Classes="setting"/>
                            <TextBlock Text="{local:T 'Songs without a cover or a length (an import from Spotify brings none): looked up by title and artist'}" Classes="setting-hint"/>
                        </StackPanel>
                    </Button>
                    <Border Classes="line"/>
                    <Button Theme="{StaticResource SettingRow}" Command="{Binding RemoveDuplicatesCommand}"
                            views:SettingsPage.Keywords="{local:T 'duplicates doubles same song twice copies join'}">
                        <StackPanel>
                            <TextBlock Text="{local:T 'Remove duplicates'}" Classes="setting"/>
                            <TextBlock Text="{local:T 'The same song twice in the library: one copy stays, with the playlists, plays and tags of both'}" Classes="setting-hint"/>
                        </StackPanel>
                    </Button>
                    <Border Classes="line"/>
                    <CheckBox Theme="{StaticResource Switch}" Classes="switch" IsChecked="{Binding ReleaseNotifications}"
                              views:SettingsPage.Keywords="{local:T 'artists follow new releases albums notifications'}">
                        <StackPanel>
                            <TextBlock Text="{local:T 'Notify new releases'}" Classes="setting"/>
                            <TextBlock Text="{local:T 'Of the artists you follow (looked for every 12 hours)'}" Classes="setting-hint"/>
                        </StackPanel>
                    </CheckBox>
                    <Border Classes="line"/>
                    <Button Theme="{StaticResource SettingRow}" Command="{Binding OpenStatsCommand}" views:SettingsPage.Keywords="{local:T 'statistics plays listening time most played'}">
                        <StackPanel>
                            <TextBlock Text="{local:T 'Listening statistics'}" Classes="setting"/>
                            <TextBlock Text="{Binding StatsSummary}" Classes="value"/>
                        </StackPanel>
                    </Button>
                    <Border Classes="line"/>
                    <Button Theme="{StaticResource SettingRow}" Command="{Binding ImportSpotifyCommand}" views:SettingsPage.Keywords="{local:T 'spotify history import plays wrapped'}">
                        <StackPanel>
                            <TextBlock Text="{local:T 'Import from Spotify…'}" Classes="setting"/>
                            <TextBlock Text="{local:T 'Your liked songs, playlists and plays on Spotify'}" Classes="setting-hint"/>
                        </StackPanel>
                    </Button>
                    <Border Classes="line"/>
                    <Button Theme="{StaticResource SettingRow}" Command="{Binding ImportLastFmCommand}" views:SettingsPage.Keywords="lastfm last.fm scrobble">
                        <StackPanel>
                            <TextBlock Text="{local:T 'Import from Last.fm…'}" Classes="setting"/>
                            <TextBlock Text="{local:T 'Your loved songs as a playlist, your scrobbles into the statistics'}" Classes="setting-hint"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ============================================================ backup -->
            <TextBlock Text="{local:T BACKUP}" Classes="card-title"/>
            <Border Classes="card" views:SettingsPage.Group="backup" views:SettingsPage.Keywords="{local:T 'backup backups restore automatic copy safety data library playlists statistics zip reinstall'}">
                <StackPanel>
                    <StackPanel Margin="0,12">
                        <TextBlock Text="{local:T 'Automatic backup'}" Classes="setting" Margin="0,0,0,8"/>
                        <views:ChoiceTiles Items="{Binding Backups.EveryChoices}" Selected="{Binding Backups.Every}"/>
                        <TextBlock Text="{local:T 'Your library, playlists, tags, statistics, settings, covers and lyrics in one small file (not the music).'}" Classes="setting-hint" Margin="0,6,0,0"/>
                    </StackPanel>
                    <Border Classes="line"/>
                    <StackPanel Margin="0,12">
                        <TextBlock Text="{local:T 'Backups kept'}" Classes="setting" Margin="0,0,0,8"/>
                        <views:ChoiceTiles Numbers="True" Items="{Binding Backups.KeepChoices}" Selected="{Binding Backups.Keep}"/>
                    </StackPanel>
                    <Border Classes="line"/>
                    <Button Theme="{StaticResource SettingRow}" Command="{Binding Backups.ChooseFolderCommand}">
                        <StackPanel>
                            <TextBlock Text="{local:T 'Backup folder'}" Classes="setting"/>
                            <TextBlock Text="{Binding Backups.FolderText}" Classes="value"/>
                            <TextBlock x:Name="BackupFolderHint" Classes="setting-hint"/>
                        </StackPanel>
                    </Button>
                    <Button Theme="{StaticResource SmallGhost}" HorizontalAlignment="Left" Margin="0,0,0,8" Command="{Binding Backups.DefaultFolderCommand}"
                            Content="{local:T 'Back to the default folder'}" IsVisible="{Binding !Backups.IsDefaultFolder}"/>
                    <Border Classes="line"/>
                    <Button Theme="{StaticResource SettingRow}" Command="{Binding Backups.BackupNowCommand}">
                        <StackPanel>
                            <TextBlock Text="{local:T 'Back up now'}" Classes="setting"/>
                            <TextBlock Text="{Binding Backups.LastText}" Classes="setting-hint"/>
                        </StackPanel>
                    </Button>
                    <Border Classes="line"/>
                    <Button Theme="{StaticResource SettingRow}" Command="{Binding Backups.RestoreCommand}">
                        <StackPanel>
                            <TextBlock Text="{local:T 'Restore a backup…'}" Classes="setting"/>
                            <TextBlock Text="{local:T 'Its data takes the place of today\'s (a copy of today\'s is kept); then the app starts again.'}" Classes="setting-hint"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding Backups.Status}" Classes="setting-hint" Margin="0,4,0,10" TextWrapping="Wrap"
                               IsVisible="{Binding Backups.Status, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                </StackPanel>
            </Border>

            <!-- ============================================================ computer -->
            <TextBlock Text="{local:T COMPUTER}" Classes="card-title"/>
            <Border Classes="card" views:SettingsPage.Group="connect" views:SettingsPage.Keywords="{local:T 'connect computer pc remote control cable usb wifi send music'}">
                <StackPanel>
                    <Button Theme="{StaticResource SettingRow}" Click="Computer_Click">
                        <StackPanel>
                            <TextBlock Text="{local:T 'Connect to computer'}" Classes="setting"/>
                            <TextBlock Text="{Binding ComputerLink.SummaryText}" Classes="value"/>
                            <TextBlock Text="{local:T 'Control the music of the computer from the phone, and receive music from it'}" Classes="setting-hint"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ============================================================ listen together (no firewall here) -->
            <TextBlock Text="{local:T 'LISTEN TOGETHER'}" Classes="card-title"/>
            <Border Classes="card" views:SettingsPage.Group="connect" views:SettingsPage.Keywords="{local:T 'listen together room rooms friends network lan radmin vpn firewall p2p host ahead'}">
                <StackPanel>
                    <StackPanel Margin="0,12">
                        <TextBlock Text="{local:T 'Songs got ready ahead when you listen'}" Classes="setting" Margin="0,0,0,8"/>
                        <views:ChoiceTiles Numbers="True" Items="{Binding TogetherAheadChoices}" Selected="{Binding TogetherAhead}"/>
                    </StackPanel>
                    <Border Classes="line"/>
                    <StackPanel Margin="0,12">
                        <TextBlock Text="{local:T 'Songs got ready ahead when you\'re the host'}" Classes="setting" Margin="0,0,0,8"/>
                        <views:ChoiceTiles Numbers="True" Items="{Binding TogetherAheadChoices}" Selected="{Binding TogetherHostAhead}"/>
                        <TextBlock Text="{local:T 'How many songs of the queue to download before their turn, besides the one playing.'}" Classes="setting-hint" Margin="0,6,0,0"/>
                    </StackPanel>
                    <Border Classes="line"/>
                    <CheckBox Theme="{StaticResource Switch}" Classes="switch" IsChecked="{Binding TogetherP2P}">
                        <StackPanel>
                            <TextBlock Text="{local:T 'Exchange songs with the others'}" Classes="setting"/>
                            <TextBlock Text="{local:T 'Off: this phone gets the songs only from your library, the storage or their link, and sends none to anyone.'}" Classes="setting-hint"/>
                        </StackPanel>
                    </CheckBox>
                    <Border Classes="line"/>
                    <CheckBox Theme="{StaticResource Switch}" Classes="switch" IsChecked="{Binding TogetherSendAsHost}" IsEnabled="{Binding TogetherP2P}">
                        <StackPanel>
                            <TextBlock Text="{local:T 'When you\'re the host, send the songs yourself'}" Classes="setting"/>
                            <TextBlock Text="{local:T 'Whoever turned on “Take the songs from the host” gets them from you instead of downloading them from the internet: worth it if your connection is fast. The others download them as usual.'}" Classes="setting-hint"/>
                        </StackPanel>
                    </CheckBox>
                    <Border Classes="line"/>
                    <CheckBox Theme="{StaticResource Switch}" Classes="switch" IsChecked="{Binding TogetherTakeFromHost}" IsEnabled="{Binding TogetherP2P}">
                        <StackPanel>
                            <TextBlock Text="{local:T 'Take the songs from the host'}" Classes="setting"/>
                            <TextBlock Text="{local:T 'If the host sends them, the ones it gets ready come from it; you download the others and, if they can\'t be found, wait for the host. Off (or if the host doesn\'t send them): from the link first, then from whoever in the room has it.'}" Classes="setting-hint"/>
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- ============================================================ the car (not on the iPhone: SettingsPage) -->
            <TextBlock x:Name="CarTitle" Text="{local:T 'IN THE CAR'}" Classes="card-title"/>
            <Border x:Name="CarCard" Classes="card" views:SettingsPage.Group="integrations" views:SettingsPage.Keywords="{local:T 'car android auto driving head unit unknown sources developer'}">
                <StackPanel>
                    <Button Theme="{StaticResource SettingRow}" Click="Car_Click">
                        <StackPanel>
                            <TextBlock Text="Android Auto" Classes="setting"/>
                            <TextBlock Text="{local:T 'Your library on the car’s screen. Android Auto hides apps that don’t come from Google Play until you allow them: tap to see how.'}" Classes="setting-hint"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ============================================================ integrations: the plays to Last.fm and ListenBrainz -->
            <TextBlock Text="{local:T INTEGRATIONS}" Classes="card-title"/>
            <Border Classes="card" views:SettingsPage.Group="integrations" DataContext="{Binding Scrobbling}" views:SettingsPage.Keywords="{local:T 'lastfm last.fm listenbrainz scrobble scrobbling integrations'}">
                <StackPanel>
                    <Button Theme="{StaticResource SettingRow}" Command="{Binding LastFmCommand}">
                        <StackPanel>
                            <TextBlock Text="Last.fm" Classes="setting"/>
                            <TextBlock Text="{Binding LastFmText}" Classes="value"/>
                        </StackPanel>
                    </Button>
                    <Border Classes="line"/>
                    <Button Theme="{StaticResource SettingRow}" Command="{Binding ListenBrainzCommand}">
                        <StackPanel>
                            <TextBlock Text="ListenBrainz" Classes="setting"/>
                            <TextBlock Text="{Binding ListenBrainzText}" Classes="value"/>
                            <TextBlock Text="{local:T 'Scrobbling: what this profile listens to goes to your accounts (half of a song is enough, at most 4 minutes). Without a connection the plays wait and go later.'}"
                                       Classes="setting-hint"/>
                            <TextBlock Text="{Binding WaitingText}" Classes="setting-hint" IsVisible="{Binding HasWaiting}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ============================================================ about: updates, help, support the project -->
            <TextBlock Text="{local:T ABOUT}" Classes="card-title"/>
            <Border Classes="card" views:SettingsPage.Group="about" views:SettingsPage.Keywords="{local:T 'updates version new github engines yt-dlp ffmpeg'}">
                <StackPanel>
                    <CheckBox x:Name="AutoUpdateSwitch" Theme="{StaticResource Switch}" Classes="switch" IsChecked="{Binding AutoUpdateApp}">
                        <StackPanel>
                            <TextBlock Text="{local:T 'Update the app automatically'}" Classes="setting"/>
                            <TextBlock Text="{local:T 'New versions from GitHub are downloaded on Wi-Fi; Android asks before installing them'}" Classes="setting-hint"/>
                        </StackPanel>
                    </CheckBox>
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,10">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Version}" Classes="setting"/>
                            <TextBlock Text="{Binding Host.Updates.Status}" Classes="value" IsVisible="{Binding Host.Updates.Status, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Theme="{StaticResource SmallGhost}" Command="{Binding WhatsNewCommand}" Content="{local:T 'Release notes'}" Margin="10,0,0,0"/>
                        <Button Grid.Column="2" Theme="{StaticResource SmallGhost}" Command="{Binding CheckAppUpdateCommand}" Content="{local:T Check}" Margin="8,0,0,0"/>
                    </Grid>
                    <Border Classes="line"/>
                    <CheckBox Theme="{StaticResource Switch}" Classes="switch" IsChecked="{Binding ShowWhatsNew}">
                        <StackPanel>
                            <TextBlock Text="{local:T 'Show the release notes after an update'}" Classes="setting"/>
                            <TextBlock Text="{local:T 'The changes of every version since the last one you opened.'}" Classes="setting-hint"/>
                        </StackPanel>
                    </CheckBox>
                    <Border x:Name="EnginesLine" Classes="line"/>
                    <CheckBox x:Name="EnginesSwitch" Theme="{StaticResource Switch}" Classes="switch" IsChecked="{Binding AutoUpdateEngines}">
                        <StackPanel>
                            <TextBlock Text="{local:T 'Update download engines'}" Classes="setting"/>
                            <TextBlock Text="{local:T 'yt-dlp changes often to keep up with the sites: it\'s updated once a day'}" Classes="setting-hint"/>
                        </StackPanel>
                    </CheckBox>
                    <Grid x:Name="EnginesRow" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                        <TextBlock Text="{Binding EngineInfo}" Classes="value" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Theme="{StaticResource SmallGhost}" Command="{Binding UpdateEnginesCommand}" Content="{local:T 'Update now'}" Margin="10,0,0,0"/>
                    </Grid>
                    <Border Classes="line"/>
                    <Button views:SettingsPage.Keywords="{local:T 'help support problem error bug idea github terms'}" Theme="{StaticResource SettingRow}" Command="{Binding ReportProblemCommand}">
                        <TextBlock Text="{local:T 'Report a problem'}" Classes="setting"/>
                    </Button>
                    <Border Classes="line"/>
                    <Button Theme="{StaticResource SettingRow}" Command="{Binding SuggestIdeaCommand}">
                        <TextBlock Text="{local:T 'Suggest an idea'}" Classes="setting"/>
                    </Button>
                    <Border Classes="line"/>
                    <Button Theme="{StaticResource SettingRow}" Command="{Binding OpenRepoCommand}">
                        <TextBlock Text="{local:T 'Project page on GitHub'}" Classes="setting"/>
                    </Button>
                    <Border Classes="line"/>
                    <Button Theme="{StaticResource SettingRow}" Command="{Binding ShowTermsCommand}">
                        <TextBlock Text="{local:T 'Terms of use'}" Classes="setting"/>
                    </Button>
                    <Border Classes="line"/>
                    <TextBlock views:SettingsPage.Keywords="{local:T 'support donate donation sponsor sponsors ko-fi coffee money thanks supporters'}" Text="{local:T 'Ultimate MP3 Player is free, with no ads, and made in spare time. If it\'s useful to you, a donation helps keep it going.'}"
                               Classes="setting-hint" Margin="0,12,0,0"/>
                    <Button Theme="{StaticResource SettingRow}" Command="{Binding SponsorCommand}">
                        <StackPanel>
                            <TextBlock Text="GitHub Sponsors" Classes="setting"/>
                            <TextBlock Text="{local:T 'Monthly or once, with a GitHub account'}" Classes="setting-hint"/>
                        </StackPanel>
                    </Button>
                    <Border Classes="line"/>
                    <Button Theme="{StaticResource SettingRow}" Command="{Binding KofiCommand}">
                        <StackPanel>
                            <TextBlock Text="Ko-fi" Classes="setting"/>
                            <TextBlock Text="{local:T 'Once, by card or PayPal, no account needed'}" Classes="setting-hint"/>
                        </StackPanel>
                    </Button>
                    <StackPanel IsVisible="{Binding Supporters, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Border Classes="line"/>
                        <StackPanel Margin="0,12">
                            <TextBlock Text="{local:T 'Thanks to'}" Classes="setting"/>
                            <TextBlock Text="{Binding Supporters}" Classes="setting-hint"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
            </StackPanel>
            <!-- the groups (the profile above them, as on an iPhone); the search box looks in all of them -->
            <Border x:Name="GroupList" Classes="card">
                <StackPanel>
                    <Button Theme="{StaticResource SettingRow}" Tag="appearance" Click="Group_Click">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock Text="{local:Icon E890}" Classes="glyph" FontSize="16" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{local:T Appearance}" Classes="setting" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Border Classes="line"/>
                    <Button Theme="{StaticResource SettingRow}" Tag="playback" Click="Group_Click">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock Text="{local:Icon E768}" Classes="glyph" FontSize="16" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{local:T Playback}" Classes="setting" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Border Classes="line"/>
                    <Button Theme="{StaticResource SettingRow}" Tag="download" Click="Group_Click">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock Text="{local:Icon E896}" Classes="glyph" FontSize="16" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{local:T Download}" Classes="setting" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Border Classes="line"/>
                    <Button Theme="{StaticResource SettingRow}" Tag="search" Click="Group_Click">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock Text="{local:Icon E721}" Classes="glyph" FontSize="16" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{local:T 'Search and suggestions'}" Classes="setting" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Border Classes="line"/>
                    <Button Theme="{StaticResource SettingRow}" Tag="library" Click="Group_Click">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock Text="{local:Icon E8F1}" Classes="glyph" FontSize="16" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{local:T Library}" Classes="setting" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Border Classes="line"/>
                    <Button Theme="{StaticResource SettingRow}" Tag="backup" Click="Group_Click">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock Text="{local:Icon E74E}" Classes="glyph" FontSize="16" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{local:T 'Backup and export'}" Classes="setting" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Border Classes="line"/>
                    <Button Theme="{StaticResource SettingRow}" Tag="connect" Click="Group_Click">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock Text="{local:Icon E716}" Classes="glyph" FontSize="16" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{local:T 'Computer and rooms'}" Classes="setting" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Border Classes="line"/>
                    <Button Theme="{StaticResource SettingRow}" Tag="integrations" Click="Group_Click">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock Text="{local:Icon E71B}" Classes="glyph" FontSize="16" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{local:T Integrations}" Classes="setting" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Border Classes="line"/>
                    <Button Theme="{StaticResource SettingRow}" Tag="about" Click="Group_Click">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock Text="{local:Icon E946}" Classes="glyph" FontSize="16" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{local:T About}" Classes="setting" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>
            <StackPanel x:Name="NoResults" IsVisible="False" Margin="12,36,12,24" HorizontalAlignment="Center">
                <TextBlock Text="{local:T 'No settings found'}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center"/>
                <TextBlock Text="{local:T 'Try other words.'}" Classes="hint" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
            <TextBlock x:Name="Footer" Text="Ultimate MP3 Player" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="12.5" Margin="0,8,0,0"/>
        </StackPanel>
    </ScrollViewer>
    <!-- a group open, like an iPhone's settings: back to the list, its name and its cards (SettingsPage.OpenGroup brings them here) -->
    <ScrollViewer x:Name="GroupPage" views:Pane.Shown="False">
        <StackPanel x:Name="GroupCards" Margin="16,12,16,28">
            <Grid ColumnDefinitions="Auto,*" Margin="-10,-6,0,12">
                <Button Theme="{StaticResource TouchIcon}" Content="{local:Icon E72B}" Click="GroupBack_Click" AutomationProperties.Name="{local:T Back}"/>
                <TextBlock x:Name="GroupTitle" Grid.Column="1" Classes="page-title" Margin="4,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
    </Panel>
</UserControl>
