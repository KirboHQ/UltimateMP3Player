<!-- The phone's rows and cards. The covers are the computer apps' (Linux/macOS Views\Templates.axaml); a song row is one line
     with the cover, title and artist, the heart and "⋮" (a tap plays it, a long press opens its menu). -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:UltimateMP3Player"
                    xmlns:vm="clr-namespace:UltimateMP3Player.ViewModels"
                    xmlns:views="clr-namespace:UltimateMP3Player.Views">

    <local:BoolChoice x:Key="HeartGlyph" True="{local:Icon EB52}" False="{local:Icon EB51}"/>

    <!-- ============================================================ covers -->

    <!-- (the templates of the long lists' rows have compiled bindings: no reflection for each row that scrolls in) -->
    <!-- (the placeholder only while there's no picture: not drawn under every cover at every frame of a scroll; the pictures
         are CoverImage, drawn straight: an ImageBrush costs an offscreen surface per frame) -->
    <DataTemplate x:Key="TrackCoverSmall" x:DataType="vm:TrackViewModel" x:CompileBindings="True">
        <Panel>
            <Border CornerRadius="6" Background="{DynamicResource PlaceholderGradient}" IsVisible="{Binding Cover48, Converter={x:Static ObjectConverters.IsNull}}">
                <TextBlock Text="{local:Icon EC4F}" Classes="glyph" HorizontalAlignment="Center" FontSize="18" Foreground="{DynamicResource MutedBrush}"/>
            </Border>
            <views:CoverImage CornerRadius="6" Source="{Binding Cover48}"/>
        </Panel>
    </DataTemplate>

    <DataTemplate x:Key="TrackCoverMedium" x:DataType="vm:TrackViewModel" x:CompileBindings="True">
        <Panel>
            <Border CornerRadius="10" Background="{DynamicResource PlaceholderGradient}" IsVisible="{Binding Cover160, Converter={x:Static ObjectConverters.IsNull}}">
                <TextBlock Text="{local:Icon EC4F}" Classes="glyph" HorizontalAlignment="Center" FontSize="40" Foreground="{DynamicResource MutedBrush}"/>
            </Border>
            <views:CoverImage CornerRadius="10" Source="{Binding Cover160}"/>
        </Panel>
    </DataTemplate>

    <DataTemplate x:Key="PlaylistCover">
        <Panel>
            <Border CornerRadius="8" Background="{DynamicResource PlaceholderGradient}" IsVisible="{Binding ShowPlaceholder}">
                <Viewbox>
                    <Border Width="100" Height="100" Padding="30">
                        <Viewbox>
                            <TextBlock Text="{local:Icon EC4F}" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource MutedBrush}"/>
                        </Viewbox>
                    </Border>
                </Viewbox>
            </Border>
            <Border CornerRadius="8" Background="{DynamicResource FavoritesGradient}" IsVisible="{Binding IsFavorites}">
                <Viewbox>
                    <Border Width="100" Height="100" Padding="30">
                        <Viewbox>
                            <TextBlock Text="{local:Icon EB52}" FontFamily="{StaticResource IconFontFilled}" Foreground="White"/>
                        </Viewbox>
                    </Border>
                </Viewbox>
            </Border>
            <Border CornerRadius="8" ClipToBounds="True">
                <Border.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="!ShowMosaic"/>
                        <Binding Path="FirstCover" Converter="{x:Static ObjectConverters.IsNotNull}"/>
                    </MultiBinding>
                </Border.IsVisible>
                <ContentControl Content="{Binding FirstCover}" ContentTemplate="{StaticResource TrackCoverMedium}"/>
            </Border>
            <Border CornerRadius="8" ClipToBounds="True" IsVisible="{Binding ShowMosaic}">
                <ItemsControl ItemsSource="{Binding CoverTracks}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="2" Columns="2"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TrackViewModel" x:CompileBindings="True">
                            <views:CoverImage Source="{Binding Cover160}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <views:CoverImage CornerRadius="8" Source="{Binding CustomCover}" IsVisible="{Binding HasCustomCover}"/>
        </Panel>
    </DataTemplate>

    <!-- ============================================================ song rows -->

    <!-- Only a sign, before the menu dots, where the song is the exception to Settings › Download (TrackViewModel.ShowSign): a cloud
         on one not saved while MP3s are saved, a mark on one saved while the library is in the cloud; a warning sign when it's no longer
         online, a ring while it's being saved. -->
    <DataTemplate x:Key="TrackCloudCell" DataType="vm:TrackViewModel" x:DataType="vm:TrackViewModel" x:CompileBindings="True">
        <Panel>
            <TextBlock Classes="glyph cloud" Classes.gone="{Binding SignIsGone}" Classes.saved="{Binding SignIsSaved}" Width="40" FontSize="17"
                       TextAlignment="Center" VerticalAlignment="Center" Text="{Binding SignGlyph, Converter={x:Static views:Converters.Glyph}}" IsVisible="{Binding ShowSign}"/>
            <Panel Width="40" IsVisible="{Binding IsSaving}">
                <views:ProgressRing Width="20" Height="20" Value="{Binding SavePct}" IsIndeterminate="{Binding SaveIndeterminate}"
                                    Stroke="{DynamicResource AccentBrush}" Track="{DynamicResource Surface3Brush}"/>
            </Panel>
        </Panel>
    </DataTemplate>

    <!-- A song of a list (SongItem): while choosing songs a tick in front (Selection), the one playing in the accent colour. -->
    <DataTemplate x:Key="SongRowTemplate" DataType="views:SongItem" x:DataType="views:SongItem" x:CompileBindings="True">
        <Border Classes="row" Classes.current="{Binding Track.IsCurrent}" Classes.picked="{Binding IsChecked}" Classes.gone="{Binding Track.IsUnavailable}"
                Classes.moving="{Binding IsMoving}"
                Classes.picking="{Binding $parent[views:SongList].Picks.IsActive, FallbackValue=False}"
                Padding="16,7,4,7" views:Touch.Menu="track" views:Touch.Tap="{Binding PlayCommand}">
            <Grid ColumnDefinitions="Auto,52,*,Auto,Auto,Auto">
                <Border Classes="tick" Margin="0,0,14,0">
                    <TextBlock Classes="glyph" Text="{local:Icon E73E}" FontSize="12" Foreground="White" HorizontalAlignment="Center"/>
                </Border>
                <ContentControl Grid.Column="1" Width="52" Height="52" Content="{Binding Track}" ContentTemplate="{StaticResource TrackCoverSmall}"/>
                <StackPanel Grid.Column="2" Margin="14,0,8,0" VerticalAlignment="Center">
                    <views:InlinePanel>
                        <!-- the song playing: a title too long scrolls by itself -->
                        <TextBlock Classes="title" Text="{Binding Track.Title}" FontSize="15.5" TextTrimming="CharacterEllipsis"
                                   local:Marquee.IsEnabled="True" local:Marquee.Auto="{Binding Track.IsCurrent}"/>
                        <Border Margin="8,0,0,0" CornerRadius="4" Padding="5,1" Background="{DynamicResource Surface3Brush}" VerticalAlignment="Center"
                                IsVisible="{Binding Track.HasVideo}">
                            <TextBlock Text="{local:Icon E714}" Classes="glyph" FontSize="11" Foreground="{DynamicResource SubTextBrush}"/>
                        </Border>
                    </views:InlinePanel>
                    <Grid ColumnDefinitions="Auto,*" Margin="0,3,0,0">
                        <!-- the song playing: a small "sound" mark -->
                        <TextBlock Text="{local:Icon E995}" Classes="glyph" FontSize="12" Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,6,0"
                                   IsVisible="{Binding Track.IsCurrent}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Track.Artist}" FontSize="13.5" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </StackPanel>
                <TextBlock Grid.Column="3" Classes="glyph heart fav" Text="{local:Icon EB52}" FontSize="14" Margin="0,0,4,0" IsVisible="{Binding Track.IsFavorite}"/>
                <ContentControl Grid.Column="4" Content="{Binding Track}" ContentTemplate="{StaticResource TrackCloudCell}"/>
                <Button Grid.Column="5" Theme="{StaticResource TouchIcon}" Content="{local:Icon E712}" FontSize="18"
                        Command="{x:Static views:Commands.MoreCommand}" CommandParameter="{Binding $parent[Border]}"
                        IsVisible="{Binding !$parent[views:SongList].Reordering, FallbackValue=True}"/>
                <!-- arranging a playlist: the handle drags the song (like "Up next") -->
                <Border Grid.Column="5" Classes="handle" Width="44" Height="46" Background="Transparent"
                        IsVisible="{Binding $parent[views:SongList].Reordering, FallbackValue=False}">
                    <StackPanel Width="18" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4">
                        <Border Height="2" CornerRadius="1" Background="{DynamicResource SubTextBrush}"/>
                        <Border Height="2" CornerRadius="1" Background="{DynamicResource SubTextBrush}"/>
                        <Border Height="2" CornerRadius="1" Background="{DynamicResource SubTextBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- The same row for a plain TrackRow (the home's "added recently", the search): a tick while choosing. -->
    <DataTemplate x:Key="TrackRowTemplate" DataType="vm:TrackRow" x:DataType="vm:TrackRow" x:CompileBindings="True">
        <Border Classes="row" Classes.current="{Binding Track.IsCurrent}" Classes.gone="{Binding Track.IsUnavailable}" Padding="16,7,4,7"
                views:Touch.Menu="track" views:Touch.Tap="{Binding PlayCommand}" views:Selection.Tick="True">
            <Grid ColumnDefinitions="Auto,52,*,Auto,Auto,Auto">
                <Border Classes="tick" Margin="0,0,14,0">
                    <TextBlock Classes="glyph" Text="{local:Icon E73E}" FontSize="12" Foreground="White" HorizontalAlignment="Center"/>
                </Border>
                <ContentControl Grid.Column="1" Width="52" Height="52" Content="{Binding Track}" ContentTemplate="{StaticResource TrackCoverSmall}"/>
                <StackPanel Grid.Column="2" Margin="14,0,8,0" VerticalAlignment="Center">
                    <TextBlock Classes="title" Text="{Binding Track.Title}" FontSize="15.5" TextTrimming="CharacterEllipsis"
                               local:Marquee.IsEnabled="True" local:Marquee.Auto="{Binding Track.IsCurrent}"/>
                    <Grid ColumnDefinitions="Auto,*" Margin="0,3,0,0">
                        <TextBlock Text="{local:Icon E995}" Classes="glyph" FontSize="12" Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,6,0"
                                   IsVisible="{Binding Track.IsCurrent}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Track.Artist}" FontSize="13.5" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </StackPanel>
                <TextBlock Grid.Column="3" Classes="glyph heart fav" Text="{local:Icon EB52}" FontSize="14" Margin="0,0,4,0" IsVisible="{Binding Track.IsFavorite}"/>
                <ContentControl Grid.Column="4" Content="{Binding Track}" ContentTemplate="{StaticResource TrackCloudCell}"/>
                <Button Grid.Column="5" Theme="{StaticResource TouchIcon}" Content="{local:Icon E712}" FontSize="18"
                        Command="{x:Static views:Commands.MoreCommand}" CommandParameter="{Binding $parent[Border]}"/>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- A song in "next up" (QueueRow): the handle on the right drags it to another place. -->
    <DataTemplate x:Key="QueueRowTemplate" DataType="vm:QueueRow" x:DataType="vm:QueueRow" x:CompileBindings="True">
        <Border Classes="row qrow" Padding="12,6,4,6" views:Touch.Menu="queue" views:Touch.Tap="{Binding PlayCommand}" views:Selection.Tick="True">
            <Grid ColumnDefinitions="Auto,46,*,Auto,Auto">
                <Border Classes="tick" Margin="0,0,12,0">
                    <TextBlock Classes="glyph" Text="{local:Icon E73E}" FontSize="12" Foreground="White" HorizontalAlignment="Center"/>
                </Border>
                <ContentControl Grid.Column="1" Width="46" Height="46" Content="{Binding Track}" ContentTemplate="{StaticResource TrackCoverSmall}"/>
                <StackPanel Grid.Column="2" Margin="12,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Track.Title}" FontSize="15" TextTrimming="CharacterEllipsis"/>
                    <Grid ColumnDefinitions="Auto,*" Margin="0,2,0,0">
                        <!-- suggested online, or a song of the library in the cloud -->
                        <TextBlock Text="{local:Icon E93E}" Classes="glyph" FontSize="12" Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,6,0"
                                   IsVisible="{Binding IsRadio}"/>
                        <TextBlock Classes="glyph cloud" Classes.gone="{Binding Track.SignIsGone}" Classes.saved="{Binding Track.SignIsSaved}" FontSize="12" Margin="0,0,6,0"
                                   Text="{Binding Track.SignGlyph, Converter={x:Static views:Converters.Glyph}}" IsVisible="{Binding Track.ShowSign}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Track.Artist}" FontSize="13" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </StackPanel>
                <Button Grid.Column="3" Theme="{StaticResource TouchIcon}" Content="{local:Icon E711}" FontSize="15" Command="{Binding RemoveCommand}"/>
                <Border Grid.Column="4" Classes="handle" Width="44" Height="46" Background="Transparent">
                    <StackPanel Width="18" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4">
                        <Border Height="2" CornerRadius="1" Background="{DynamicResource MutedBrush}"/>
                        <Border Height="2" CornerRadius="1" Background="{DynamicResource MutedBrush}"/>
                        <Border Height="2" CornerRadius="1" Background="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- ============================================================ playlists, tags -->

    <DataTemplate x:Key="PlaylistRowTemplate" DataType="vm:PlaylistViewModel">
        <Border Classes="row" Padding="16,7,4,7" views:Touch.Menu="playlist" views:Selection.Tick="True"
                views:Touch.Tap="{Binding $parent[views:MainView].DataContext.OpenPlaylistCommand}">
            <Grid ColumnDefinitions="Auto,56,*,Auto">
                <Border Classes="tick" Margin="0,0,14,0">
                    <TextBlock Classes="glyph" Text="{local:Icon E73E}" FontSize="12" Foreground="White" HorizontalAlignment="Center"/>
                </Border>
                <ContentControl Grid.Column="1" Width="56" Height="56" Content="{Binding}" ContentTemplate="{StaticResource PlaylistCover}"/>
                <StackPanel Grid.Column="2" Margin="14,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="15.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="{local:Icon E995}" Classes="glyph" FontSize="12" Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,6,0"
                                   IsVisible="{Binding IsPlayingFrom}"/>
                        <TextBlock Text="{Binding DeviceGlyph, Converter={StaticResource Icon}}" Classes="glyph" FontSize="12" Foreground="{DynamicResource SubTextBrush}"
                                   Margin="0,0,6,0" VerticalAlignment="Center" IsVisible="{Binding HasDevice}"/>
                        <TextBlock Text="{Binding Subtitle}" FontSize="13.5" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="3" Theme="{StaticResource TouchIcon}" Content="{local:Icon E712}" FontSize="18"
                        Command="{x:Static views:Commands.MoreCommand}" CommandParameter="{Binding $parent[Border]}"/>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="TagRowTemplate" DataType="vm:TagViewModel">
        <Border Classes="row" Padding="16,7,4,7" views:Touch.Menu="tag"
                views:Touch.Tap="{Binding $parent[views:MainView].DataContext.OpenTagCommand}">
            <Grid ColumnDefinitions="56,*,Auto">
                <Border Width="56" Height="56" CornerRadius="8" Background="{DynamicResource Surface2Brush}">
                    <Ellipse Width="20" Height="20" Fill="{Binding Brush}"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="15.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="{Binding DeviceGlyph, Converter={StaticResource Icon}}" Classes="glyph" FontSize="12" Foreground="{DynamicResource SubTextBrush}"
                                   Margin="0,0,6,0" VerticalAlignment="Center" IsVisible="{Binding HasDevice}"/>
                        <TextBlock Text="{Binding CountText}" FontSize="13.5" Foreground="{DynamicResource SubTextBrush}"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="2" Theme="{StaticResource TouchIcon}" Content="{local:Icon E712}" FontSize="18"
                        Command="{x:Static views:Commands.MoreCommand}" CommandParameter="{Binding $parent[Border]}"/>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- The home's playlists: two per row, the cover and the name side by side (Spotify's). -->
    <DataTemplate x:Key="PlaylistTileTemplate" DataType="vm:PlaylistViewModel">
        <Border Classes="tile" CornerRadius="10" Height="60" ClipToBounds="True" views:Touch.Menu="playlist" views:Selection.Tick="True"
                views:Touch.Tap="{Binding $parent[views:MainView].DataContext.OpenPlaylistCommand}">
            <Grid ColumnDefinitions="60,*">
                <ContentControl Width="60" Height="60" Content="{Binding}" ContentTemplate="{StaticResource PlaylistCover}"/>
                <Border Classes="tick" Margin="0" HorizontalAlignment="Center">
                    <TextBlock Classes="glyph" Text="{local:Icon E73E}" FontSize="12" Foreground="White" HorizontalAlignment="Center"/>
                </Border>
                <DockPanel Grid.Column="1" Margin="12,0,10,0">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding DeviceGlyph, Converter={StaticResource Icon}}" Classes="glyph" FontSize="12"
                               Foreground="{DynamicResource SubTextBrush}" Margin="6,0,0,0" VerticalAlignment="Center" IsVisible="{Binding HasDevice}"/>
                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- A song card (listened recently, suggestions): the cover and the names under it; a cloud on the cover when it isn't
         saved on the phone (a tap on it saves it), a tick while choosing. -->
    <DataTemplate x:Key="TrackCardTemplate" DataType="vm:TrackViewModel">
        <Border Width="148" Margin="0,0,14,0" Background="Transparent" views:Touch.Menu="card" views:Selection.Tick="True"
                views:Touch.Tap="{Binding $parent[views:MainView].DataContext.PlayTrackCommand}">
            <StackPanel>
                <Panel Width="148" Height="148">
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TrackCoverMedium}"/>
                    <Border Width="38" Height="38" CornerRadius="19" Background="{DynamicResource AccentGradient}" HorizontalAlignment="Right"
                            VerticalAlignment="Bottom" Margin="0,0,8,8" IsVisible="{Binding IsCurrent}">
                        <TextBlock Classes="glyph" Text="{Binding IsPlaying, Converter={x:Static views:Converters.PlayGlyph}}" Foreground="{DynamicResource OnAccentBrush}"
                                   FontSize="15" HorizontalAlignment="Center"/>
                    </Border>
                    <!-- the song's sign on the cover (the exception to Settings › Download: TrackViewModel.ShowSign; a ring while it's saved) -->
                    <Border Width="30" Height="30" CornerRadius="15" Background="#A6000000" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7"
                            IsVisible="{Binding HasSign}">
                        <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Classes="glyph" Text="{Binding SignGlyph, Converter={x:Static views:Converters.Glyph}}" FontSize="14" Foreground="White"
                                       HorizontalAlignment="Center" IsVisible="{Binding ShowSign}"/>
                            <views:ProgressRing Width="18" Height="18" Value="{Binding SavePct}" IsIndeterminate="{Binding SaveIndeterminate}" Stroke="White"
                                                Track="#50FFFFFF" IsVisible="{Binding IsSaving}"/>
                        </Panel>
                    </Border>
                    <Border Classes="tick" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0">
                        <TextBlock Classes="glyph" Text="{local:Icon E73E}" FontSize="12" Foreground="White" HorizontalAlignment="Center"/>
                    </Border>
                </Panel>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Margin="2,9,2,1" TextTrimming="CharacterEllipsis"
                           local:Marquee.IsEnabled="True" local:Marquee.Auto="{Binding IsCurrent}"/>
                <TextBlock Text="{Binding Artist}" FontSize="12.5" Foreground="{DynamicResource SubTextBrush}" Margin="2,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- A mix of Home › For you (a shelf that scrolls sideways): its first song's cover with a band in its colour and its
         name; a tap plays it. -->
    <DataTemplate x:Key="MixCardTemplate" DataType="vm:MixViewModel">
        <Border Width="148" Margin="0,0,14,0" Background="Transparent" views:Touch.Tap="{Binding PlayCommand}">
            <StackPanel>
                <Panel Width="148" Height="148">
                    <ContentControl Content="{Binding Cover}" ContentTemplate="{StaticResource TrackCoverMedium}"/>
                    <Border VerticalAlignment="Bottom" CornerRadius="0,0,10,10" Background="{Binding Brush}" Padding="10,8,10,9">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph, Converter={StaticResource Icon}}" Classes="glyph" FontSize="14" Foreground="White"
                                       Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                </Panel>
                <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Foreground="{DynamicResource SubTextBrush}" Margin="2,9,2,0" TextWrapping="Wrap" MaxLines="2"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ============================================================ artists -->

    <!-- An artist in a list: its picture in a circle (or its initial on a colour of its own), its name; a tap opens its page,
         the button on the right follows it (a tick once followed). -->
    <DataTemplate x:Key="ArtistRowTemplate" DataType="vm:ArtistCardViewModel">
        <Border Classes="row" Padding="16,7,4,7" views:Touch.Tap="{Binding OpenCommand}" views:Touch.Menu="artist">
            <Grid ColumnDefinitions="56,*,Auto">
                <Panel Width="56" Height="56">
                    <Ellipse Fill="{Binding Brush}"/>
                    <TextBlock Text="{Binding Initial}" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <views:CoverImage IsCircle="True" Source="{Binding Picture}"/>
                    <Ellipse Width="13" Height="13" Fill="{DynamicResource AccentGradient}" Stroke="{DynamicResource BgBrush}" StrokeThickness="2"
                             HorizontalAlignment="Right" VerticalAlignment="Top" IsVisible="{Binding HasNew}"/>
                </Panel>
                <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="15.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="13.5" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"
                               IsVisible="{Binding HasSubtitle}"/>
                </StackPanel>
                <Button Grid.Column="2" Theme="{StaticResource TouchIcon}" Content="{Binding FollowGlyph, Converter={StaticResource Icon}}" FontSize="18"
                        Command="{Binding FollowCommand}"/>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- An internet radio (Library > Radio): its picture on its colour (or its initial), name, what it plays; a tap plays it
         live, the heart keeps it. -->
    <DataTemplate x:Key="StationRowTemplate" DataType="vm:StationViewModel">
        <Border Classes="row" Padding="16,7,4,7" views:Touch.Tap="{Binding PlayCommand}">
            <Border.Styles>
                <!-- (the full heart is in the filled font) -->
                <Style Selector="Button.saved">
                    <Setter Property="FontFamily" Value="{StaticResource IconFontFilled}"/>
                    <Setter Property="Foreground" Value="{DynamicResource PinkBrush}"/>
                </Style>
            </Border.Styles>
            <Grid ColumnDefinitions="56,*,Auto">
                <Border Width="56" Height="56" CornerRadius="8" Background="{Binding Brush}" ClipToBounds="True">
                    <Panel>
                        <TextBlock Text="{Binding Initial}" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding !HasPicture}"/>
                        <Image Source="{Binding Picture}" Stretch="Uniform" Margin="7"/>
                    </Panel>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" CornerRadius="6" Padding="6,1,6,2" Margin="0,0,7,0" Background="{DynamicResource AccentGradient}"
                                VerticalAlignment="Center" IsVisible="{Binding IsCurrent}">
                            <TextBlock Text="{local:T LIVE}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource OnAccentBrush}"/>
                        </Border>
                        <TextBlock Text="{Binding Name}" FontSize="15.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Subtitle}" FontSize="13.5" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"
                               IsVisible="{Binding HasSubtitle}"/>
                </StackPanel>
                <Button Grid.Column="2" Theme="{StaticResource TouchIcon}" Content="{Binding SaveGlyph, Converter={StaticResource Icon}}" FontSize="18"
                        Classes.saved="{Binding IsSaved}" Command="{Binding SaveCommand}"/>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- A saved internet radio on Home's shelf (sideways): its picture on its colour; a tap plays it live. -->
    <DataTemplate x:Key="StationCardTemplate" DataType="vm:StationViewModel">
        <Border Width="148" Margin="0,0,14,0" Background="Transparent" views:Touch.Tap="{Binding PlayCommand}">
            <StackPanel>
                <Border Width="148" Height="148" CornerRadius="8" Background="{Binding Brush}" ClipToBounds="True">
                    <Panel>
                        <TextBlock Text="{Binding Initial}" FontSize="48" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding !HasPicture}"/>
                        <Image Source="{Binding Picture}" Stretch="Uniform" Margin="20"/>
                        <Border CornerRadius="9" Padding="8,2,8,3" Margin="8" Background="{DynamicResource AccentGradient}" HorizontalAlignment="Left" VerticalAlignment="Top"
                                IsVisible="{Binding IsCurrent}">
                            <TextBlock Text="{local:T LIVE}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource OnAccentBrush}"/>
                        </Border>
                    </Panel>
                </Border>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Margin="2,9,2,1" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Foreground="{DynamicResource SubTextBrush}" Margin="2,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- A new album, EP or single of a followed artist (a shelf that scrolls sideways): its cover, "NEW" until seen; the button
         on it plays it without saving it. -->
    <DataTemplate x:Key="ReleaseCardTemplate" DataType="vm:ReleaseCardViewModel">
        <Border Width="148" Margin="0,0,14,0" Background="Transparent" views:Touch.Tap="{Binding OpenCommand}">
            <StackPanel>
                <Panel Width="148" Height="148">
                    <Border CornerRadius="8" Background="{DynamicResource PlaceholderGradient}" IsVisible="{Binding Cover, Converter={x:Static ObjectConverters.IsNull}}">
                        <TextBlock Text="{local:Icon EC4F}" Classes="glyph" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                    </Border>
                    <views:CoverImage CornerRadius="8" Source="{Binding Cover}"/>
                    <Border CornerRadius="9" Padding="8,2,8,3" Margin="8" Background="{DynamicResource AccentGradient}" HorizontalAlignment="Left" VerticalAlignment="Top"
                            IsVisible="{Binding IsNew}">
                        <TextBlock Text="{local:T NEW}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource OnAccentBrush}"/>
                    </Border>
                    <Button Theme="{StaticResource BigPlayButton}" Width="40" Height="40" FontSize="15" Content="{local:Icon E768}" Margin="0,0,7,7"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Command="{Binding PlayCommand}"/>
                </Panel>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Margin="2,9,2,1" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Artist}" FontSize="12.5" Foreground="{DynamicResource SubTextBrush}" Margin="2,0" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="2,1,2,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- An album or a playlist found online (an artist's page, the search's shelves): its cover; a tap opens it like its link,
         the button on it plays it without saving it. -->
    <DataTemplate x:Key="AlbumCardTemplate" DataType="vm:OnlineHitViewModel">
        <Border Width="148" Margin="0,0,14,0" Background="Transparent" views:Touch.Tap="{Binding DownloadCommand}" views:Touch.Menu="hit">
            <StackPanel>
                <Panel Width="148" Height="148">
                    <Border CornerRadius="8" Background="{DynamicResource PlaceholderGradient}" IsVisible="{Binding Thumb, Converter={x:Static ObjectConverters.IsNull}}">
                        <TextBlock Text="{local:Icon EC4F}" Classes="glyph" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                    </Border>
                    <views:CoverImage CornerRadius="8" Source="{Binding Thumb}"/>
                    <Button Theme="{StaticResource BigPlayButton}" Width="40" Height="40" FontSize="15" Content="{local:Icon E768}" Margin="0,0,7,7"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Command="{Binding PlayCommand}"/>
                </Panel>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Margin="2,9,2,1" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Foreground="{DynamicResource SubTextBrush}" Margin="2,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- A song found online (the search, an artist's popular songs): a tap plays it without saving it, its button downloads it
         (its card, as a pasted link); an album or a playlist the other way round. Pulled right: into the queue (RowSwipe). -->
    <DataTemplate x:Key="HitRowTemplate" DataType="vm:OnlineHitViewModel">
        <Border Classes="row" Padding="16,7,4,7" views:Touch.Tap="{Binding TapCommand}" views:Touch.Menu="hit">
            <Grid ColumnDefinitions="52,*,Auto">
                <Panel Width="52" Height="52">
                    <Border CornerRadius="6" Background="{DynamicResource PlaceholderGradient}">
                        <TextBlock Text="{local:Icon EC4F}" Classes="glyph" FontSize="18" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                    </Border>
                    <views:CoverImage CornerRadius="6" Source="{Binding Thumb}"/>
                </Panel>
                <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="13" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Ellipse Width="7" Height="7" Fill="{Binding ServiceBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Service}" FontSize="12" Margin="6,0,10,0" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DurationText}" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                        <Border CornerRadius="7" Padding="6,0" Margin="10,0,0,0" Background="{DynamicResource SuccessSoftBrush}" VerticalAlignment="Center" IsVisible="{Binding InLibrary}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{local:Icon E73E}" Classes="glyph" FontSize="9" Foreground="{DynamicResource SuccessBrush}"/>
                                <TextBlock Text="{local:T 'in library'}" FontSize="11" FontWeight="SemiBold" Margin="4,0,0,1" Foreground="{DynamicResource SuccessBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="2" Theme="{StaticResource TouchIcon}" Content="{Binding SideGlyph, Converter={StaticResource Icon}}" FontSize="18"
                        Command="{Binding SideCommand}"/>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- ============================================================ dialogs' rows (the computer apps' templates) -->

    <!-- A song to tick (the songs of a tag): like a list's songs being chosen, the round tick and the tinted row; a tap
         anywhere on the row ticks it. -->
    <DataTemplate x:Key="SongChoiceTemplate" DataType="vm:SongChoice" x:DataType="vm:SongChoice" x:CompileBindings="True">
        <Border Classes="row picking" Classes.picked="{Binding IsSelected}" Padding="8,7,12,7"
                views:Touch.Tap="{x:Static views:Commands.ToggleChoice}">
            <Grid ColumnDefinitions="Auto,52,*">
                <Border Classes="tick" Margin="0,0,14,0">
                    <TextBlock Classes="glyph" Text="{local:Icon E73E}" FontSize="12" Foreground="White" HorizontalAlignment="Center"/>
                </Border>
                <ContentControl Grid.Column="1" Width="52" Height="52" Content="{Binding Track}" ContentTemplate="{StaticResource TrackCoverSmall}"/>
                <StackPanel Grid.Column="2" Margin="14,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Track.Title}" FontSize="15.5" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Track.Artist}" FontSize="13.5" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis"
                               Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="PackSongTemplate">
        <Border Classes="pack" Classes.out="{Binding !IsIncluded}" CornerRadius="8" Padding="8,6">
            <Border.Styles>
                <Style Selector="Border.pack.out">
                    <Setter Property="Opacity" Value="0.4"/>
                </Style>
            </Border.Styles>
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Panel Width="40" Height="40">
                    <Border CornerRadius="6" Background="{DynamicResource PlaceholderGradient}">
                        <TextBlock Text="{local:Icon EC4F}" Classes="glyph" HorizontalAlignment="Center" FontSize="15" Foreground="{DynamicResource MutedBrush}"/>
                    </Border>
                    <views:CoverImage CornerRadius="6" Source="{Binding Cover}"/>
                </Panel>
                <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="14.5"/>
                    <TextBlock Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" FontSize="12.5" Foreground="{DynamicResource SubTextBrush}"/>
                </StackPanel>
                <Border Grid.Column="2" CornerRadius="10" Padding="8,3,10,4" Background="{DynamicResource Surface3Brush}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{Binding StateBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StateText}" FontSize="12" Margin="6,0,0,1" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
