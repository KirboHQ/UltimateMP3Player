<?xml version="1.0" encoding="utf-8"?>
<!-- The activity, the services and the share/open filters are declared in C# (attributes in MainActivity.cs and Platform\). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" android:installLocation="auto">
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <!-- music playing with the screen off or the app closed: the player's service, with its notification -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
  <!-- downloads going on when the app isn't on screen -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- updates from GitHub: Android asks before installing them -->
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

  <!-- the engines run from the app's own folder of native libraries: they must be extracted there -->
  <application android:label="Ultimate MP3 Player" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round"
               android:theme="@style/UmpTheme" android:extractNativeLibs="true" android:hasFragileUserData="true"
               android:allowBackup="false" android:usesCleartextTraffic="true" android:supportsRtl="true"
               android:largeHeap="true">
    <provider android:name="androidx.core.content.FileProvider" android:authorities="com.kirbohq.ultimatemp3player.files"
              android:exported="false" android:grantUriPermissions="true">
      <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
    </provider>
  </application>

  <queries>
    <!-- links opened in the browser, issues on GitHub -->
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <data android:scheme="https" />
    </intent>
  </queries>
</manifest>
