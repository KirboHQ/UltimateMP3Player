<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- Like the app while it starts (colors.xml: light, or dark at night), the status bar icons to match. -->
  <style name="UmpTheme" parent="Theme.AppCompat.NoActionBar">
    <item name="android:windowBackground">@color/ump_bg</item>
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@android:color/transparent</item>
    <item name="android:windowLightStatusBar">@bool/ump_light_bars</item>
    <item name="colorPrimary">@color/ump_accent</item>
    <item name="colorAccent">@color/ump_accent</item>
  </style>
</resources>
