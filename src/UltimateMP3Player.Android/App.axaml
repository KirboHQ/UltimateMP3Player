<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UltimateMP3Player"
             x:Class="UltimateMP3Player.App"
             RequestedThemeVariant="Dark"
             Name="Ultimate MP3 Player">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- the colours, buttons, fields and sliders of the computer apps, then what a phone does differently -->
                <ResourceInclude Source="avares://UltimateMP3Player/Theme.axaml"/>
                <ResourceInclude Source="avares://UltimateMP3Player/Mobile/MobileTheme.axaml"/>
                <ResourceInclude Source="avares://UltimateMP3Player/Mobile/Templates.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme/>
        <StyleInclude Source="avares://UltimateMP3Player/Mobile/MobileStyles.axaml"/>
    </Application.Styles>
</Application>
